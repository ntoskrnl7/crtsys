/** @brief Kind of rename/link destination carried by set-information. */
enum class destination_information_kind {
  none,
  rename,
  hard_link,
};

/**
 * @brief Validated read-only destination from FILE_RENAME/LINK_INFORMATION.
 */
class destination_information_view {
public:
  destination_information_view() noexcept = default;

  destination_information_kind kind() const noexcept { return kind_; }
  FILE_INFORMATION_CLASS information_class() const noexcept {
    return information_class_;
  }
  HANDLE root_directory() const noexcept { return root_directory_; }
  std::wstring_view name() const noexcept { return name_; }
  ULONG flags() const noexcept { return flags_; }
  bool extended() const noexcept { return extended_; }
  bool replace_if_exists() const noexcept { return (flags_ & 1UL) != 0; }
  explicit operator bool() const noexcept {
    return kind_ != destination_information_kind::none && !name_.empty();
  }

private:
  friend class set_information_parameters;

  destination_information_view(destination_information_kind kind,
                               FILE_INFORMATION_CLASS information_class,
                               HANDLE root_directory, std::wstring_view name,
                               ULONG flags, bool extended) noexcept
      : kind_(kind), information_class_(information_class),
        root_directory_(root_directory), name_(name), flags_(flags),
        extended_(extended) {}

  destination_information_kind kind_ = destination_information_kind::none;
  FILE_INFORMATION_CLASS information_class_ = FileDirectoryInformation;
  HANDLE root_directory_ = nullptr;
  std::wstring_view name_;
  ULONG flags_ = 0;
  bool extended_ = false;
};

/** @brief State controlled by one delete-disposition request. */
enum class disposition_state_kind {
  none,
  delete_disposition,
  delete_on_close,
};

/**
 * @brief Validated read-only FILE_DISPOSITION_INFORMATION[_EX] view.
 */
class disposition_information_view {
public:
  disposition_information_view() noexcept = default;

  FILE_INFORMATION_CLASS information_class() const noexcept {
    return information_class_;
  }
  disposition_state_kind state_kind() const noexcept { return state_kind_; }
  ULONG flags() const noexcept { return flags_; }
  bool extended() const noexcept { return extended_; }
  bool delete_requested() const noexcept {
    return (flags_ & FILE_DISPOSITION_DELETE) != 0;
  }
  bool posix_semantics() const noexcept {
    return (flags_ & FILE_DISPOSITION_POSIX_SEMANTICS) != 0;
  }
  bool force_image_section_check() const noexcept {
    return (flags_ & FILE_DISPOSITION_FORCE_IMAGE_SECTION_CHECK) != 0;
  }
  bool on_close() const noexcept {
    return (flags_ & FILE_DISPOSITION_ON_CLOSE) != 0;
  }
  bool ignore_readonly_attribute() const noexcept {
    return (flags_ & detail::disposition_ignore_readonly_attribute) != 0;
  }
  explicit operator bool() const noexcept {
    return state_kind_ != disposition_state_kind::none;
  }

private:
  friend class set_information_parameters;

  disposition_information_view(FILE_INFORMATION_CLASS information_class,
                               disposition_state_kind state_kind, ULONG flags,
                               bool extended) noexcept
      : information_class_(information_class), state_kind_(state_kind),
        flags_(flags), extended_(extended) {}

  FILE_INFORMATION_CLASS information_class_ = FileDirectoryInformation;
  disposition_state_kind state_kind_ = disposition_state_kind::none;
  ULONG flags_ = 0;
  bool extended_ = false;
};

/** @brief Typed view of IRP_MJ_SET_INFORMATION parameters. */
class set_information_parameters
    : public detail::operation_parameters<operation_id::set_information> {
  using base = detail::operation_parameters<operation_id::set_information>;

public:
  explicit set_information_parameters(PFLT_CALLBACK_DATA data) noexcept
      : base(data) {}
  explicit set_information_parameters(PFLT_IO_PARAMETER_BLOCK iopb) noexcept
      : base(iopb) {}

  ULONG length() const noexcept {
    return iopb() ? iopb()->Parameters.SetFileInformation.Length : 0;
  }

  FILE_INFORMATION_CLASS information_class() const noexcept {
    return iopb() ? iopb()->Parameters.SetFileInformation.FileInformationClass
                  : FileDirectoryInformation;
  }

  ntl::file parent_of_target() const noexcept {
    return ntl::file{iopb()
                         ? iopb()->Parameters.SetFileInformation.ParentOfTarget
                         : nullptr};
  }

  PVOID buffer() const noexcept {
    return iopb() ? iopb()->Parameters.SetFileInformation.InfoBuffer : nullptr;
  }

  bool replace_if_exists() const noexcept {
    return iopb() &&
           iopb()->Parameters.SetFileInformation.ReplaceIfExists != FALSE;
  }

  /**
   * @brief Validates and returns a rename or hard-link destination.
   *
   * The view is tied to the current callback and does not own the input
   * buffer.
   */
  destination_information_view destination() const noexcept {
    if (!iopb())
      return {};

    const FILE_INFORMATION_CLASS type = information_class();
    const bool rename =
        type == FileRenameInformation ||
        type == FileRenameInformationBypassAccessCheck ||
        type == FileRenameInformationEx ||
        type == FileRenameInformationExBypassAccessCheck;
    const bool link =
        type == FileLinkInformation || type == FileLinkInformationEx ||
        type == FileLinkInformationExBypassAccessCheck;
    if (!rename && !link)
      return {};

    const ULONG bytes = length();
    const std::size_t header =
        rename ? FIELD_OFFSET(FILE_RENAME_INFORMATION, FileName)
               : FIELD_OFFSET(FILE_LINK_INFORMATION, FileName);
    if (!buffer() || bytes < header)
      return {};

    HANDLE root = nullptr;
    ULONG name_bytes = 0;
    PWCHAR name = nullptr;
    ULONG flags = 0;
    const bool extended =
        type == FileRenameInformationEx ||
        type == FileRenameInformationExBypassAccessCheck ||
        type == FileLinkInformationEx ||
        type == FileLinkInformationExBypassAccessCheck;
    if (rename) {
      const auto *const information =
          static_cast<const FILE_RENAME_INFORMATION *>(buffer());
      root = information->RootDirectory;
      name_bytes = information->FileNameLength;
      name = const_cast<PWCHAR>(information->FileName);
      flags = extended ? *reinterpret_cast<const ULONG *>(information)
                       : (information->ReplaceIfExists ? 1UL : 0UL);
    } else {
      const auto *const information =
          static_cast<const FILE_LINK_INFORMATION *>(buffer());
      root = information->RootDirectory;
      name_bytes = information->FileNameLength;
      name = const_cast<PWCHAR>(information->FileName);
      flags = extended ? *reinterpret_cast<const ULONG *>(information)
                       : (information->ReplaceIfExists ? 1UL : 0UL);
    }

    if (name_bytes == 0 || (name_bytes % sizeof(wchar_t)) != 0 ||
        name_bytes > bytes - header)
      return {};
    return {rename ? destination_information_kind::rename
                   : destination_information_kind::hard_link,
            type, root,
            std::wstring_view{name, name_bytes / sizeof(wchar_t)}, flags,
            extended};
  }

  /**
   * @brief Validates and returns a legacy or extended delete disposition.
   *
   * The view copies the small disposition value and never exposes the native
   * callback buffer.
   */
  disposition_information_view disposition() const noexcept {
    if (!iopb() || !buffer())
      return {};

    const FILE_INFORMATION_CLASS type = information_class();
    if (type == FileDispositionInformation) {
      if (length() < sizeof(FILE_DISPOSITION_INFORMATION))
        return {};
      const auto *const information =
          static_cast<const FILE_DISPOSITION_INFORMATION *>(buffer());
      const ULONG flags =
          information->DeleteFile ? FILE_DISPOSITION_DELETE : 0UL;
      return {type, disposition_state_kind::delete_disposition, flags, false};
    }

    if (type == FileDispositionInformationEx) {
      if (length() < sizeof(FILE_DISPOSITION_INFORMATION_EX))
        return {};
      const auto *const information =
          static_cast<const FILE_DISPOSITION_INFORMATION_EX *>(buffer());
      const ULONG flags = information->Flags;
      return {type,
              (flags & FILE_DISPOSITION_ON_CLOSE) != 0
                  ? disposition_state_kind::delete_on_close
                  : disposition_state_kind::delete_disposition,
              flags, true};
    }
    return {};
  }

  void length(ULONG value) noexcept {
    if (!iopb())
      return;
    iopb()->Parameters.SetFileInformation.Length = value;
    dirty();
  }

  void buffer(PVOID value) noexcept {
    if (!iopb())
      return;
    iopb()->Parameters.SetFileInformation.InfoBuffer = value;
    dirty();
  }
};

/** @brief Typed view of IRP_MJ_DIRECTORY_CONTROL parameters. */
class directory_control_parameters
    : public detail::operation_parameters<operation_id::directory_control> {
  using base = detail::operation_parameters<operation_id::directory_control>;

public:
  explicit directory_control_parameters(PFLT_CALLBACK_DATA data) noexcept
      : base(data) {}
  explicit directory_control_parameters(PFLT_IO_PARAMETER_BLOCK iopb) noexcept
      : base(iopb) {}

  UCHAR minor_function() const noexcept {
    return iopb() ? iopb()->MinorFunction : 0xff;
  }

  bool is_query() const noexcept {
    return minor_function() == IRP_MN_QUERY_DIRECTORY;
  }

  bool is_notify() const noexcept {
    return minor_function() == IRP_MN_NOTIFY_CHANGE_DIRECTORY;
  }

  bool is_notify_ex() const noexcept {
#ifdef IRP_MN_NOTIFY_CHANGE_DIRECTORY_EX
    return minor_function() == IRP_MN_NOTIFY_CHANGE_DIRECTORY_EX;
#else
    return false;
#endif
  }

  ULONG length() const noexcept {
    if (!iopb())
      return 0;
    if (is_query())
      return iopb()->Parameters.DirectoryControl.QueryDirectory.Length;
    if (is_notify())
      return iopb()->Parameters.DirectoryControl.NotifyDirectory.Length;
    if (is_notify_ex())
      return iopb()->Parameters.DirectoryControl.NotifyDirectoryEx.Length;
    return 0;
  }

  PUNICODE_STRING file_name() const noexcept {
    return is_query()
               ? iopb()->Parameters.DirectoryControl.QueryDirectory.FileName
               : nullptr;
  }

  FILE_INFORMATION_CLASS information_class() const noexcept {
    return is_query() ? iopb()
                            ->Parameters.DirectoryControl.QueryDirectory
                            .FileInformationClass
                      : FileDirectoryInformation;
  }

  PVOID buffer() const noexcept {
    if (!iopb())
      return nullptr;
    if (is_query())
      return iopb()->Parameters.DirectoryControl.QueryDirectory.DirectoryBuffer;
    if (is_notify())
      return iopb()
          ->Parameters.DirectoryControl.NotifyDirectory.DirectoryBuffer;
    if (is_notify_ex())
      return iopb()
          ->Parameters.DirectoryControl.NotifyDirectoryEx.DirectoryBuffer;
    return nullptr;
  }

  PMDL mdl() const noexcept {
    if (!iopb())
      return nullptr;
    if (is_query())
      return iopb()->Parameters.DirectoryControl.QueryDirectory.MdlAddress;
    if (is_notify())
      return iopb()->Parameters.DirectoryControl.NotifyDirectory.MdlAddress;
    if (is_notify_ex())
      return iopb()->Parameters.DirectoryControl.NotifyDirectoryEx.MdlAddress;
    return nullptr;
  }

  /**
   * @brief Configures an IRP_MN_NOTIFY_CHANGE_DIRECTORY request.
   */
  void notification(PVOID buffer, ULONG length, ULONG completion_filter,
                    PMDL mdl = nullptr) noexcept {
    if (!iopb() || !is_notify())
      return;
    auto &notify = iopb()->Parameters.DirectoryControl.NotifyDirectory;
    notify.DirectoryBuffer = buffer;
    notify.Length = length;
    notify.CompletionFilter = completion_filter;
    notify.MdlAddress = mdl;
    dirty();
  }
};

/** @brief Typed view shared by file-system and device-control operations. */
template <operation_id Expected>
class control_parameters : public detail::operation_parameters<Expected> {
  static_assert(Expected == operation_id::file_system_control ||
                    Expected == operation_id::device_control ||
                    Expected == operation_id::internal_device_control,
                "control_parameters supports only FSCTL and IOCTL operations");
  using base = detail::operation_parameters<Expected>;

public:
  explicit control_parameters(PFLT_CALLBACK_DATA data) noexcept : base(data) {}
  explicit control_parameters(PFLT_IO_PARAMETER_BLOCK iopb) noexcept
      : base(iopb) {}

  /** @brief Returns true for the dedicated fast-I/O IOCTL layout. */
  bool is_fast_io() const noexcept {
    if constexpr (Expected == operation_id::file_system_control)
      return false;
    else
      return this->callback() && FLT_IS_FASTIO_OPERATION(this->callback());
  }

  ULONG code() const noexcept {
    if (!this->iopb())
      return 0;
    if constexpr (Expected == operation_id::file_system_control)
      return this->iopb()->Parameters.FileSystemControl.Common.FsControlCode;
    else if (is_fast_io())
      return this->iopb()->Parameters.DeviceIoControl.FastIo.IoControlCode;
    else
      return this->iopb()->Parameters.DeviceIoControl.Common.IoControlCode;
  }

  ULONG input_length() const noexcept {
    if (!this->iopb())
      return 0;
    if constexpr (Expected == operation_id::file_system_control)
      return this->iopb()
          ->Parameters.FileSystemControl.Common.InputBufferLength;
    else if (is_fast_io())
      return this->iopb()->Parameters.DeviceIoControl.FastIo.InputBufferLength;
    else
      return this->iopb()->Parameters.DeviceIoControl.Common.InputBufferLength;
  }

  ULONG output_length() const noexcept {
    if (!this->iopb())
      return 0;
    if constexpr (Expected == operation_id::file_system_control)
      return this->iopb()
          ->Parameters.FileSystemControl.Common.OutputBufferLength;
    else if (is_fast_io())
      return this->iopb()->Parameters.DeviceIoControl.FastIo.OutputBufferLength;
    else
      return this->iopb()->Parameters.DeviceIoControl.Common.OutputBufferLength;
  }

  ULONG method() const noexcept { return code() & 3UL; }

  PVOID input_buffer() const noexcept {
    if (!this->iopb())
      return nullptr;
    if constexpr (Expected == operation_id::file_system_control) {
      if (method() == METHOD_BUFFERED)
        return this->iopb()->Parameters.FileSystemControl.Buffered.SystemBuffer;
      if (method() == METHOD_NEITHER)
        return this->iopb()->Parameters.FileSystemControl.Neither.InputBuffer;
      return this->iopb()
          ->Parameters.FileSystemControl.Direct.InputSystemBuffer;
    } else {
      if (is_fast_io())
        return this->iopb()->Parameters.DeviceIoControl.FastIo.InputBuffer;
      if (method() == METHOD_BUFFERED)
        return this->iopb()->Parameters.DeviceIoControl.Buffered.SystemBuffer;
      if (method() == METHOD_NEITHER)
        return this->iopb()->Parameters.DeviceIoControl.Neither.InputBuffer;
      return this->iopb()->Parameters.DeviceIoControl.Direct.InputSystemBuffer;
    }
  }

  PVOID output_buffer() const noexcept {
    if (!this->iopb())
      return nullptr;
    if constexpr (Expected == operation_id::file_system_control) {
      if (method() == METHOD_BUFFERED)
        return this->iopb()->Parameters.FileSystemControl.Buffered.SystemBuffer;
      if (method() == METHOD_NEITHER)
        return this->iopb()->Parameters.FileSystemControl.Neither.OutputBuffer;
      return this->iopb()->Parameters.FileSystemControl.Direct.OutputBuffer;
    } else {
      if (is_fast_io())
        return this->iopb()->Parameters.DeviceIoControl.FastIo.OutputBuffer;
      if (method() == METHOD_BUFFERED)
        return this->iopb()->Parameters.DeviceIoControl.Buffered.SystemBuffer;
      if (method() == METHOD_NEITHER)
        return this->iopb()->Parameters.DeviceIoControl.Neither.OutputBuffer;
      return this->iopb()->Parameters.DeviceIoControl.Direct.OutputBuffer;
    }
  }

  PMDL output_mdl() const noexcept {
    if (!this->iopb() || is_fast_io() || method() == METHOD_BUFFERED)
      return nullptr;
    if constexpr (Expected == operation_id::file_system_control) {
      return method() == METHOD_NEITHER
                 ? this->iopb()
                       ->Parameters.FileSystemControl.Neither.OutputMdlAddress
                 : this->iopb()
                       ->Parameters.FileSystemControl.Direct.OutputMdlAddress;
    } else {
      return method() == METHOD_NEITHER
                 ? this->iopb()
                       ->Parameters.DeviceIoControl.Neither.OutputMdlAddress
                 : this->iopb()
                       ->Parameters.DeviceIoControl.Direct.OutputMdlAddress;
    }
  }

  /** Classifies the explicit volume lifecycle FSCTLs. */
  volume_control_request volume_request() const noexcept {
    if constexpr (Expected != operation_id::file_system_control) {
      return volume_control_request::other;
    } else {
      switch (code()) {
      case FSCTL_LOCK_VOLUME:
        return volume_control_request::lock;
      case FSCTL_UNLOCK_VOLUME:
        return volume_control_request::unlock;
      case FSCTL_DISMOUNT_VOLUME:
        return volume_control_request::dismount;
      default:
        return volume_control_request::other;
      }
    }
  }

  /** Returns whether this is the volume snapshot flush-and-hold IOCTL. */
  bool is_snapshot_flush_and_hold() const noexcept {
    if constexpr (Expected != operation_id::device_control)
      return false;
    else
      return code() == IOCTL_VOLSNAP_FLUSH_AND_HOLD_WRITES;
  }
};

using file_system_control_parameters =
    control_parameters<operation_id::file_system_control>;
using device_control_parameters =
    control_parameters<operation_id::device_control>;
using internal_device_control_parameters =
    control_parameters<operation_id::internal_device_control>;

/** @brief Typed view of IRP_MJ_PNP lifecycle requests. */
class pnp_parameters
    : public detail::operation_parameters<operation_id::pnp> {
  using base = detail::operation_parameters<operation_id::pnp>;

public:
  explicit pnp_parameters(PFLT_CALLBACK_DATA data) noexcept : base(data) {}
  explicit pnp_parameters(PFLT_IO_PARAMETER_BLOCK iopb) noexcept : base(iopb) {}

  pnp_request request() const noexcept {
    if (!iopb())
      return pnp_request::other;
    switch (iopb()->MinorFunction) {
    case IRP_MN_QUERY_REMOVE_DEVICE:
      return pnp_request::query_remove;
    case IRP_MN_CANCEL_REMOVE_DEVICE:
      return pnp_request::cancel_remove;
    case IRP_MN_SURPRISE_REMOVAL:
      return pnp_request::surprise_removal;
    default:
      return pnp_request::other;
    }
  }
};

/** @brief Empty parameter view for operations with no typed NTL fields. */
class no_parameters {
public:
  explicit no_parameters(PFLT_CALLBACK_DATA data) noexcept
      : iopb_(data ? data->Iopb : nullptr) {}
  explicit no_parameters(PFLT_IO_PARAMETER_BLOCK iopb) noexcept : iopb_(iopb) {}

  /** @brief Returns true when an IOPB is present. */
  explicit operator bool() const noexcept { return iopb_ != nullptr; }

private:
  PFLT_IO_PARAMETER_BLOCK iopb_ = nullptr;
};

/** @brief Maps a compile-time operation to its only legal parameter view. */
template <operation_id Value> struct operation_parameter_traits {
  using type = no_parameters;
};

template <> struct operation_parameter_traits<operation_id::create> {
  using type = create_parameters;
};

template <> struct operation_parameter_traits<operation_id::read> {
  using type = read_parameters;
};

template <> struct operation_parameter_traits<operation_id::write> {
  using type = write_parameters;
};

template <>
struct operation_parameter_traits<operation_id::network_query_open> {
  using type = network_query_open_parameters;
};

template <> struct operation_parameter_traits<operation_id::query_information> {
  using type = query_information_parameters;
};

template <> struct operation_parameter_traits<operation_id::set_information> {
  using type = set_information_parameters;
};

template <> struct operation_parameter_traits<operation_id::directory_control> {
  using type = directory_control_parameters;
};

template <>
struct operation_parameter_traits<operation_id::file_system_control> {
  using type = file_system_control_parameters;
};

template <> struct operation_parameter_traits<operation_id::device_control> {
  using type = device_control_parameters;
};

template <>
struct operation_parameter_traits<operation_id::internal_device_control> {
  using type = internal_device_control_parameters;
};

template <> struct operation_parameter_traits<operation_id::pnp> {
  using type = pnp_parameters;
};

template <operation_id Value>
using operation_parameters_t = typename operation_parameter_traits<Value>::type;

