/**
 * @brief Operation-typed view delivered only by an NTL safe post callback.
 *
 * Unlike callback_data, this type records that Filter Manager dispatched the
 * callback through FltDoCompletionProcessingWhenSafe and therefore guarantees
 * IRQL <= APC_LEVEL. The wrapped callback data remains owned by Filter Manager
 * and is valid only for the duration of the callback.
 */
template <operation_id Operation> class safe_post_operation {
public:
  /** @brief Returns the operation-typed callback data for ordinary accessors.
   */
  detail::callback_data_impl<Operation> data() const noexcept { return data_; }

private:
  friend class detail::safe_post_operation_access;

  explicit safe_post_operation(
      detail::callback_data_impl<Operation> data) noexcept
      : data_(data) {}

  detail::callback_data_impl<Operation> data_;
};

namespace detail {
/** @brief Constructs safe-post tokens only inside NTL's native trampoline. */
class safe_post_operation_access {
public:
  template <operation_id Operation>
  static safe_post_operation<Operation>
  make(callback_data_impl<Operation> data) noexcept {
    return safe_post_operation<Operation>{data};
  }
};
} // namespace detail

