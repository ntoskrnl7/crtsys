/**
 * @brief Read-only, operation-typed IOPB snapshot delivered after
 * IoCallDriver
 * returns.
 *
 * Filter Manager captures the IOPB when the
 * request is made. The view is valid
 * only during the operation-status
 * callback. parameters() returns a const
 * reference so the captured request
 * cannot be modified.
 */
template <operation_id Operation> class operation_status_snapshot {
public:
  using parameters_type = operation_parameters_t<Operation>;
  static constexpr operation_id operation = Operation;

  constexpr operation_id major_function() const noexcept { return Operation; }
  UCHAR minor_function() const noexcept {
    return value_ ? value_->MinorFunction : 0xff;
  }
  ULONG irp_flags() const noexcept { return value_ ? value_->IrpFlags : 0; }
  UCHAR operation_flags() const noexcept {
    return value_ ? value_->OperationFlags : 0;
  }
  ntl::file target_file() const noexcept {
    return ntl::file{value_ ? value_->TargetFileObject : nullptr};
  }
  instance target_instance() const noexcept {
    return instance{value_ ? value_->TargetInstance : nullptr};
  }
  const parameters_type &parameters() const noexcept { return parameters_; }
  explicit operator bool() const noexcept { return value_ != nullptr; }

private:
  template <operation_id, class> friend struct detail::operation_status_request;
  template <operation_id, auto>
  friend struct detail::stateless_operation_status_request;

  explicit operation_status_snapshot(PFLT_IO_PARAMETER_BLOCK value) noexcept
      : value_(value && value->MajorFunction == static_cast<UCHAR>(Operation)
                   ? value
                   : nullptr),
        parameters_(value_) {}

  PFLT_IO_PARAMETER_BLOCK value_ = nullptr;
  parameters_type parameters_;
};

/**
 * @brief Typed callback invoked with the immediate lower-stack return
 * status.
 *
 * State is constructed in nonpaged pool before the request and
 * destroyed
 * automatically after this callback, or immediately if the request
 * fails.
 */
template <operation_id Operation, class State>
using operation_status_callback = void (*)(
    operation_status_snapshot<Operation> snapshot, related_objects objects,
    ntl::status operation_status, State &state) noexcept;

/** @brief Typed operation-status callback with no per-request state. */
template <operation_id Operation>
using stateless_operation_status_callback =
    void (*)(operation_status_snapshot<Operation> snapshot,
             related_objects objects, ntl::status operation_status) noexcept;

namespace detail {

template <operation_id Operation, auto Callback>
struct stateless_operation_status_request {
  static void FLTAPI complete(PCFLT_RELATED_OBJECTS objects,
                              PFLT_IO_PARAMETER_BLOCK snapshot, NTSTATUS status,
                              PVOID) noexcept {
    Callback(operation_status_snapshot<Operation>{snapshot},
             related_objects{objects}, ntl::status{status});
  }
};

template <operation_id Operation, class State> struct operation_status_request {
  using callback_type = operation_status_callback<Operation, State>;

  template <class... Args>
  operation_status_request(callback_type callback, Args &&...args) noexcept
      : callback(callback), state(std::forward<Args>(args)...) {}

  static void FLTAPI complete(PCFLT_RELATED_OBJECTS objects,
                              PFLT_IO_PARAMETER_BLOCK snapshot, NTSTATUS status,
                              PVOID requester_context) noexcept {
    auto *const request =
        static_cast<operation_status_request *>(requester_context);
    if (!request)
      return;

    request->callback(operation_status_snapshot<Operation>{snapshot},
                      related_objects{objects}, ntl::status{status},
                      request->state);
    request->~operation_status_request();
    ntl::free_pool(request, operation_status_pool_tag);
  }

  callback_type callback;
  State state;
};

/**
 * @brief Non-owning mutable callback data for exactly one major operation.

 * * @tparam Operation Major operation selected by registration::on().
 * The
 * operation is part of the C++ type. parameters() therefore exposes only the
 * FLT_PARAMETERS member valid for that registration.
 */
template <operation_id Operation> class callback_data_impl {
public:
  /** @brief Parameter view associated with this callback operation. */
  using parameters_type = operation_parameters_t<Operation>;

  /** @brief Compile-time operation identifier. */
  static constexpr operation_id operation = Operation;

  /** @brief Wraps callback data owned by Filter Manager. */
  explicit callback_data_impl(PFLT_CALLBACK_DATA value) noexcept
      : value_(value) {}

  /** @brief Returns the operation selected by registration::on(). */
  constexpr operation_id major_function() const noexcept { return Operation; }

  /** @brief Returns the native minor-function identifier. */
  UCHAR minor_function() const noexcept {
    return value_ && value_->Iopb ? value_->Iopb->MinorFunction : 0xff;
  }
  void minor_function(UCHAR value) noexcept {
    if (!value_ || !value_->Iopb)
      return;
    value_->Iopb->MinorFunction = value;
    FltSetCallbackDataDirty(value_);
  }

  /** @brief Returns the IRP flags copied into the Filter Manager IOPB. */
  ULONG irp_flags() const noexcept {
    return value_ && value_->Iopb ? value_->Iopb->IrpFlags : 0;
  }
  void irp_flags(ULONG value) noexcept {
    if (!value_ || !value_->Iopb)
      return;
    value_->Iopb->IrpFlags = value;
    FltSetCallbackDataDirty(value_);
  }

  /** @brief Returns the operation-specific SL_* flags. */
  UCHAR operation_flags() const noexcept {
    return value_ && value_->Iopb ? value_->Iopb->OperationFlags : 0;
  }
  void operation_flags(UCHAR value) noexcept {
    if (!value_ || !value_->Iopb)
      return;
    value_->Iopb->OperationFlags = value;
    FltSetCallbackDataDirty(value_);
  }

  /** @brief Returns the target kernel FILE_OBJECT facade. */
  ntl::file target_file() const noexcept {
    return ntl::file{value_ && value_->Iopb ? value_->Iopb->TargetFileObject
                                            : nullptr};
  }

  /** @brief Returns the minifilter instance receiving this operation. */
  flt::instance target_instance() const noexcept {
    return flt::instance{value_ && value_->Iopb ? value_->Iopb->TargetInstance
                                                : nullptr};
  }

  /** @brief Returns the requestor processor mode. */
  KPROCESSOR_MODE requestor_mode() const noexcept {
    return value_ ? value_->RequestorMode : KernelMode;
  }

  /** @brief Returns true for an IRP-based operation. */
  bool is_irp_operation() const noexcept {
    return value_ && FLT_IS_IRP_OPERATION(value_);
  }

  /** @brief Returns true for a fast-I/O operation. */
  bool is_fast_io_operation() const noexcept {
    return value_ && FLT_IS_FASTIO_OPERATION(value_);
  }

  /** @brief Returns true for a file-system-filter callback operation. */
  bool is_fsfilter_operation() const noexcept {
    return value_ && FLT_IS_FS_FILTER_OPERATION(value_);
  }

  /** @brief Returns the current I/O completion status. */
  ntl::status io_status() const noexcept {
    return value_ ? value_->IoStatus.Status : STATUS_INVALID_PARAMETER;
  }

  /** @brief Returns the current I/O completion information value. */
  ULONG_PTR information() const noexcept {
    return value_ ? value_->IoStatus.Information : 0;
  }

  /**
   * @brief Updates the operation's native I/O completion result.
   *
   * This is valid in both pre-operation completion and post-operation failure
   * paths. It does not dirty operation parameters.
   */
  void set_io_status(ntl::status value, ULONG_PTR information = 0) noexcept {
    if (!value_)
      return;
    value_->IoStatus.Status = value;
    value_->IoStatus.Information = information;
  }

  /**
   * @brief Completes the operation in a pre-operation callback.
   * @param value Completion status.
   * @param information Operation-specific completion information.
   *
   * Return pre_result::complete from the callback after calling this method.
   */
  void complete(ntl::status value, ULONG_PTR information = 0) noexcept {
    set_io_status(value, information);
  }

  /** @brief Marks native I/O parameter modifications as dirty. */
  void mark_dirty() noexcept {
    if (value_)
      FltSetCallbackDataDirty(value_);
  }

  /**
   * @brief Queries cached Filter Manager name information.
   * @param options FLT_FILE_NAME_* format and query-method flags.
   * @return Owned name information, or the Filter Manager failure status.
   * @note Call only where FltGetFileNameInformation is legal, normally at
   * IRQL <= APC_LEVEL. The returned owner releases the reference.
   */
  ntl::result<name_information>
  try_query_name(FLT_FILE_NAME_OPTIONS options) const noexcept {
    if (!value_)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    PFLT_FILE_NAME_INFORMATION information = nullptr;
    const NTSTATUS result =
        FltGetFileNameInformation(value_, options, &information);
    if (!NT_SUCCESS(result))
      return ntl::unexpected(result);
    return ntl::ok(name_information{information});
  }

  /**
   * @brief Returns the only parameter view legal for this callback type.
   *
   * A create callback returns create_parameters, a write callback returns
   * write_parameters, and no read/write/create cross-accessor exists.
   */
  parameters_type parameters() const noexcept {
    return parameters_type{value_};
  }

  /**
   * @brief Requests lower-stack status without allocating per-request
   * state.
   *
   * Callback is a compile-time function pointer with the typed
   * snapshot,
   * related objects, and operation status parameters.
   */
  template <auto Callback>
  [[nodiscard]] ntl::status try_request_operation_status() const noexcept {
    using callback_type = stateless_operation_status_callback<Operation>;
    static_assert(
        std::is_convertible_v<decltype(Callback), callback_type>,
        "A stateless operation-status callback must be a captureless noexcept "
        "callback whose snapshot type matches this operation");

    callback_type callback = Callback;
    if (!value_ || !callback)
      return STATUS_INVALID_PARAMETER;

    using request_type =
        stateless_operation_status_request<Operation, Callback>;
    return FltRequestOperationStatusCallback(value_, &request_type::complete,
                                             nullptr);
  }

  /**
   * @brief Requests the status returned by the lower stack for this
   * operation.
   *
   * This helper is legal only while executing the
   * pre-operation callback for
   * an IRP-based request, and is not supported
   * for IRP_MJ_CLOSE. Filter Manager
   * enforces those native restrictions.
   * The typed State is kept in nonpaged
   * pool until the callback runs;
   * failure destroys it before returning.
   *
   * This is normally useful
   * only for oplock FSCTLs and directory-change
   * notifications, where
   * STATUS_PENDING is a meaningful lower-stack result.
   */
  template <class State, class... Args>
  [[nodiscard]] ntl::status try_request_operation_status(
      operation_status_callback<Operation, State> callback,
      Args &&...args) const noexcept {
    static_assert(!std::is_void_v<State>,
                  "Operation-status state must be an object type");
    static_assert(!std::is_array_v<State>,
                  "Operation-status state cannot be an array");
    static_assert(std::is_nothrow_constructible_v<State, Args...>,
                  "Operation-status state construction must be noexcept");
    static_assert(std::is_nothrow_destructible_v<State>,
                  "Operation-status state destruction must be noexcept");
    static_assert(alignof(State) <= MEMORY_ALLOCATION_ALIGNMENT,
                  "Operation-status state requires unsupported pool alignment");

    if (!value_ || !callback)
      return STATUS_INVALID_PARAMETER;

    using request_type = operation_status_request<Operation, State>;
    static_assert(alignof(request_type) <= MEMORY_ALLOCATION_ALIGNMENT,
                  "Operation-status request requires unsupported alignment");
    void *const storage =
        ntl::allocate_pool(sizeof(request_type), ntl::pool_kind::nonpaged,
                           ntl::pool_option::none, operation_status_pool_tag);
    if (!storage)
      return STATUS_INSUFFICIENT_RESOURCES;

    auto *const request =
        new (storage) request_type(callback, std::forward<Args>(args)...);
    const NTSTATUS result = FltRequestOperationStatusCallback(
        value_, &request_type::complete, request);
    if (!NT_SUCCESS(result)) {
      request->~request_type();
      ntl::free_pool(request, operation_status_pool_tag);
    }
    return result;
  }

  /**
   * @brief Returns the native Filter Manager I/O parameter block.
   *
   * @note This explicit escape hatch bypasses compile-time union selection.
   */
  PFLT_IO_PARAMETER_BLOCK native_iopb() const noexcept {
    return value_ ? value_->Iopb : nullptr;
  }

  /** @brief Returns the native callback-data pointer. */
  PFLT_CALLBACK_DATA native() const noexcept { return value_; }

private:
  PFLT_CALLBACK_DATA value_ = nullptr;
};

