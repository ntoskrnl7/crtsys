    return NDIS_TEST_SEND_AT_DISPATCH_LEVEL(flags_) != FALSE;
  }
  ntl::result<preserved_metadata_chain_view>
  try_preserve_metadata(
      ULONG pool_tag = ntl::pool_tag("mNdN")) const noexcept {
    return preserved_metadata_chain_view::try_create(
        packets_.native_handle(), pool_tag);
