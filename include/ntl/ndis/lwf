enum class filter_module_state : std::uint8_t {
  paused,
  running,
  pausing,
  detaching,
};

/**
 * @brief Owns one pass-through LWF registration and typed module callbacks.
 *
 * Module must be constructible from attach_event. Optional noexcept methods:
 * on_restart(restart_event), on_pause(pause_event), on_send(send_event),
 * on_send_complete(send_complete_event), on_receive(receive_event),
 * on_receive_return(return_receive_event), on_oid_request(oid_request_event),
 * on_oid_request_complete(oid_request_complete_event),
 * on_cancel_oid_request(cancel_oid_request_event),
 * on_direct_oid_request(direct_oid_request_event),
 * on_direct_oid_request_complete(direct_oid_request_complete_event),
 * on_cancel_direct_oid_request(cancel_direct_oid_request_event),
 * on_status(status_indication_event), on_device_pnp(device_pnp_event), and
 * on_net_pnp(net_pnp_event).
 * This monitor profile never transfers NBL ownership to Module. Forwarding,
 * completion, return, status/PnP propagation, pause, and detach remain
 * adapter-owned. on_pause returns void because an NDIS pause cannot fail.
 */
template <class Module> class lightweight_filter {
public:
  lightweight_filter(const lightweight_filter &) = delete;
  lightweight_filter &operator=(const lightweight_filter &) = delete;
  ~lightweight_filter() { reset(); }

  static ntl::result<std::shared_ptr<lightweight_filter>>
  try_create(PDRIVER_OBJECT driver,
             filter_driver_identity identity) noexcept {
    if (!driver || !identity.friendly_name ||
        !identity.unique_name || !identity.service_name)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    std::shared_ptr<lightweight_filter> self;
    try {
      self = std::shared_ptr<lightweight_filter>(
          new (std::nothrow) lightweight_filter());
    } catch (...) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    if (!self)
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);

    NDIS_FILTER_DRIVER_CHARACTERISTICS characteristics{};
    characteristics.Header.Type =
        NDIS_OBJECT_TYPE_FILTER_DRIVER_CHARACTERISTICS;
    characteristics.Header.Revision =
        NDIS_FILTER_CHARACTERISTICS_REVISION_2;
    characteristics.Header.Size =
        NDIS_SIZEOF_FILTER_DRIVER_CHARACTERISTICS_REVISION_2;
    characteristics.MajorNdisVersion = 6;
    characteristics.MinorNdisVersion = 30;
    characteristics.MajorDriverVersion =
        identity.major_driver_version;
    characteristics.MinorDriverVersion =
        identity.minor_driver_version;

    RtlInitUnicodeString(
        &characteristics.FriendlyName, identity.friendly_name);
    RtlInitUnicodeString(
        &characteristics.UniqueName, identity.unique_name);
    RtlInitUnicodeString(
        &characteristics.ServiceName, identity.service_name);
    characteristics.AttachHandler = &attach;
    characteristics.DetachHandler = &detach;
    characteristics.RestartHandler = &restart;
    characteristics.PauseHandler = &pause;
    characteristics.SendNetBufferListsHandler = &send;
    characteristics.SendNetBufferListsCompleteHandler =
        &send_complete;
    characteristics.ReceiveNetBufferListsHandler = &receive;
    characteristics.ReturnNetBufferListsHandler = &return_receive;
    characteristics.OidRequestHandler = &oid_request;
    characteristics.OidRequestCompleteHandler = &oid_request_complete;
    characteristics.CancelOidRequestHandler = &cancel_oid_request;
    characteristics.DevicePnPEventNotifyHandler = &device_pnp;
    characteristics.NetPnPEventHandler = &net_pnp;
    characteristics.StatusHandler = &status_indication;
    characteristics.DirectOidRequestHandler = &direct_oid_request;
    characteristics.DirectOidRequestCompleteHandler =
        &direct_oid_request_complete;
    characteristics.CancelDirectOidRequestHandler =
        &cancel_direct_oid_request;

    NDIS_HANDLE registration = nullptr;
    const NDIS_STATUS status = NdisFRegisterFilterDriver(
        driver, self.get(), &characteristics, &registration);
    if (status != NDIS_STATUS_SUCCESS)
      return ntl::unexpected(static_cast<NTSTATUS>(status));
    self->registration_ = registration;
    return ntl::ok(std::move(self));
  }

  void reset() noexcept {
    NDIS_HANDLE registration =
        std::exchange(registration_, nullptr);
    if (registration)
      NdisFDeregisterFilterDriver(registration);
  }

  std::size_t attached_modules() const noexcept {
    return attached_.load(std::memory_order_acquire);
  }

private:
  struct module_holder {
    template <class... Args>
    explicit module_holder(
        lightweight_filter &owner_value,
        NDIS_HANDLE filter_handle_value,
        Args &&...args)
        : owner(&owner_value),
          filter_handle(filter_handle_value),
          module(std::forward<Args>(args)...) {}

    lightweight_filter *owner = nullptr;
    NDIS_HANDLE filter_handle = nullptr;
    std::atomic<filter_module_state> state{
        filter_module_state::paused};
    Module module;
  };

  lightweight_filter() = default;

  static NDIS_STATUS attach(
      NDIS_HANDLE filter_handle, NDIS_HANDLE driver_context,
      NDIS_FILTER_ATTACH_PARAMETERS *parameters) noexcept {
    auto *owner =
        static_cast<lightweight_filter *>(driver_context);
    if (!owner || !filter_handle || !parameters)
      return NDIS_STATUS_INVALID_PARAMETER;

    module_holder *holder = nullptr;
    try {
      holder = new (std::nothrow) module_holder(
          *owner, filter_handle, attach_event(parameters));
    } catch (...) {
      return NDIS_STATUS_RESOURCES;
    }
    if (!holder)
      return NDIS_STATUS_RESOURCES;

    NDIS_FILTER_ATTRIBUTES attributes{};
    attributes.Header.Type = NDIS_OBJECT_TYPE_FILTER_ATTRIBUTES;
    attributes.Header.Revision =
        NDIS_FILTER_ATTRIBUTES_REVISION_1;
    attributes.Header.Size =
        NDIS_SIZEOF_FILTER_ATTRIBUTES_REVISION_1;
    const NDIS_STATUS status = NdisFSetAttributes(
        filter_handle, holder, &attributes);
    if (status != NDIS_STATUS_SUCCESS) {
      delete holder;
      return status;
    }
    owner->attached_.fetch_add(1, std::memory_order_acq_rel);
    return NDIS_STATUS_SUCCESS;
  }

  static void detach(NDIS_HANDLE module_context) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return;
    holder->state.store(
        filter_module_state::detaching,
        std::memory_order_release);
    lightweight_filter *const owner = holder->owner;
    delete holder;
    if (owner)
      owner->attached_.fetch_sub(1, std::memory_order_acq_rel);
  }

  static NDIS_STATUS restart(
      NDIS_HANDLE module_context,
      NDIS_FILTER_RESTART_PARAMETERS *parameters) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return NDIS_STATUS_INVALID_PARAMETER;
    if constexpr (requires(Module &module, restart_event event) {
                    module.on_restart(event);
                  }) {
      static_assert(noexcept(holder->module.on_restart(
                        restart_event(parameters))),
                    "Module::on_restart must be noexcept");
      const ntl::status result =
          holder->module.on_restart(restart_event(parameters));
      if (!result.is_ok())
        return static_cast<NDIS_STATUS>(
            static_cast<NTSTATUS>(result));
    }
    holder->state.store(
        filter_module_state::running,
        std::memory_order_release);
    return NDIS_STATUS_SUCCESS;
  }

  static NDIS_STATUS pause(
      NDIS_HANDLE module_context,
      NDIS_FILTER_PAUSE_PARAMETERS *parameters) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return NDIS_STATUS_INVALID_PARAMETER;
    holder->state.store(
        filter_module_state::pausing,
        std::memory_order_release);
    if constexpr (requires(Module &module, pause_event event) {
                    module.on_pause(event);
                  }) {
      static_assert(noexcept(holder->module.on_pause(
                        pause_event(parameters))),
                    "Module::on_pause must be noexcept");
      static_assert(std::is_same_v<
                        decltype(holder->module.on_pause(
                            pause_event(parameters))),
                        void>,
                    "Module::on_pause must return void because NDIS pause "
                    "requests cannot fail");
      holder->module.on_pause(pause_event(parameters));
    }
    holder->state.store(
        filter_module_state::paused,
        std::memory_order_release);
    return NDIS_STATUS_SUCCESS;
  }

  static void send(
      NDIS_HANDLE module_context, NET_BUFFER_LIST *packets,
      NDIS_PORT_NUMBER port, ULONG flags) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return;
    if (holder->state.load(std::memory_order_acquire) ==
        filter_module_state::running) {
      if constexpr (requires(Module &module, send_event event) {
                      module.on_send(event);
                    }) {
        static_assert(noexcept(holder->module.on_send(
                          send_event(packets, port, flags))),
                      "Module::on_send must be noexcept");
        holder->module.on_send(send_event(packets, port, flags));
      }
    }
    NdisFSendNetBufferLists(
        holder->filter_handle, packets, port, flags);
  }

  static void send_complete(
      NDIS_HANDLE module_context, NET_BUFFER_LIST *packets,
      ULONG flags) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return;
    const std::size_t restored_metadata_count =
        detail::restore_metadata_chain(
            packets,
            detail::nbl_metadata_snapshot::restore_point::send_complete);
    if constexpr (requires(
                      Module &module, send_complete_event event) {
                    module.on_send_complete(event);
                  }) {
      static_assert(noexcept(holder->module.on_send_complete(
                        send_complete_event(
                            packets, flags,
                            restored_metadata_count))),
                    "Module::on_send_complete must be noexcept");
      holder->module.on_send_complete(
          send_complete_event(
              packets, flags, restored_metadata_count));
    }
    NdisFSendNetBufferListsComplete(
        holder->filter_handle, packets, flags);
  }

  static void receive(
      NDIS_HANDLE module_context, NET_BUFFER_LIST *packets,
      NDIS_PORT_NUMBER port, ULONG count, ULONG flags) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return;
    if (holder->state.load(std::memory_order_acquire) ==
        filter_module_state::running) {
      if constexpr (requires(Module &module, receive_event event) {
                      module.on_receive(event);
                    }) {
        static_assert(noexcept(holder->module.on_receive(
                          receive_event(
                              packets, port, count, flags))),
                      "Module::on_receive must be noexcept");
        holder->module.on_receive(
            receive_event(packets, port, count, flags));
      }
    }
    NdisFIndicateReceiveNetBufferLists(
        holder->filter_handle, packets, port, count, flags);
    detail::complete_immediate_receive(
        flags,
        [packets]() noexcept {
          return detail::restore_metadata_chain(
              packets,
              detail::nbl_metadata_snapshot::restore_point::receive_return);
        },
        [holder, packets](
            ULONG return_flags, std::size_t restored) noexcept {
          notify_receive_return(
              *holder, packets, return_flags, true, restored);
        });
  }

  static void return_receive(
      NDIS_HANDLE module_context, NET_BUFFER_LIST *packets,
      ULONG flags) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder)
      return;
    const std::size_t restored_metadata_count =
        detail::restore_metadata_chain(
            packets,
            detail::nbl_metadata_snapshot::restore_point::receive_return);
    notify_receive_return(
        *holder, packets, flags, false, restored_metadata_count);
    NdisFReturnNetBufferLists(
        holder->filter_handle, packets, flags);
  }

  static void notify_receive_return(
      module_holder &holder, NET_BUFFER_LIST *packets,
      ULONG flags, bool immediate,
      std::size_t restored_metadata_count) noexcept {
    if constexpr (requires(
                      Module &module, return_receive_event event) {
                    module.on_receive_return(event);
                  }) {
      static_assert(noexcept(holder.module.on_receive_return(
                        return_receive_event(
                            packets, flags, immediate,
                            restored_metadata_count))),
                    "Module::on_receive_return must be noexcept");
      holder.module.on_receive_return(
          return_receive_event(
              packets, flags, immediate,
              restored_metadata_count));
    }
  }

  static NDIS_STATUS oid_request(
      NDIS_HANDLE module_context,
      NDIS_OID_REQUEST *request) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder || !request)
      return NDIS_STATUS_INVALID_PARAMETER;

    NDIS_OID_REQUEST *clone = nullptr;
    NDIS_STATUS status = detail::clone_oid_request(
        holder->filter_handle, request,
        ntl::pool_tag("oNdN"), &clone);
    if (status != NDIS_STATUS_SUCCESS)
      return status;

    return detail::forward_oid_clone(
        clone,
        [holder](NDIS_OID_REQUEST *observed) noexcept {
          if constexpr (requires(
                            Module &module, oid_request_event event) {
                          module.on_oid_request(event);
                        }) {
            static_assert(noexcept(holder->module.on_oid_request(
                              oid_request_event(observed))),
                          "Module::on_oid_request must be noexcept");
            holder->module.on_oid_request(
                oid_request_event(observed));
          }
        },
        [holder](NDIS_OID_REQUEST *submitted) noexcept {
          return NdisFOidRequest(holder->filter_handle, submitted);
        },
        [holder](NDIS_OID_REQUEST *completed,
                 NDIS_STATUS completed_status) noexcept {
          oid_request_complete(holder, completed, completed_status);
        });
  }

  static void oid_request_complete(
      NDIS_HANDLE module_context,
      NDIS_OID_REQUEST *request,
      NDIS_STATUS status) noexcept {
    auto *holder = static_cast<module_holder *>(module_context);
    if (!holder || !request)
      return;

    detail::complete_oid_clone(
        request, status,
        [holder](NDIS_OID_REQUEST *observed,
                 NDIS_STATUS observed_status) noexcept {
          if constexpr (requires(
                            Module &module,
                            oid_request_complete_event event) {
                          module.on_oid_request_complete(event);
                        }) {
            static_assert(noexcept(
                              holder->module.on_oid_request_complete(
                                  oid_request_complete_event(
                                      observed, observed_status))),
                          "Module::on_oid_request_complete must be noexcept");
            holder->module.on_oid_request_complete(
                oid_request_complete_event(observed, observed_status));
          }
        },
        [holder](NDIS_OID_REQUEST *completed) noexcept {
          return detail::release_oid_clone(
              holder->filter_handle, completed);
        },
        [holder](NDIS_OID_REQUEST *original,
                 NDIS_STATUS completed_status) noexcept {
          NdisFOidRequestComplete(
              holder->filter_handle, original, completed_status);
        });
  }

