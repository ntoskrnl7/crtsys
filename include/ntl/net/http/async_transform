inline async_request_rule_selector
async_request_rule_selector::when(predicate condition) const {
  if (!condition)
    throw std::invalid_argument("async HTTP request predicate is empty");
  const predicate previous = condition_;
  return async_request_rule_selector(
      state_, [previous, condition = std::move(condition)](
                      const request_message &message) {
        return previous(message) && condition(message);
      });
}

template <class Function>
async_request_rule_selector &
async_request_rule_selector::transform(Function &&function) {
  state_->require_mutable();
  using callback_type = std::decay_t<Function>;
  state_->request_rules.push_back(
      {condition_,
       [callback = callback_type(std::forward<Function>(function))](
           request_message &message, const async_policy_context &context) {
         return static_cast<rewrite_result>(callback(message, context));
       }});
  return *this;
}

template <class Function>
async_request_rule_selector &
async_request_rule_selector::decide(Function &&function) {
  using callback_type = std::decay_t<Function>;
  return transform(
      [callback = callback_type(std::forward<Function>(function))](
          request_message &message, const async_policy_context &context) {
        switch (static_cast<ntl::net::inspection::verdict>(
            callback(static_cast<const request_message &>(message), context))) {
        case ntl::net::inspection::verdict::permit:
          return rewrite_result::unchanged();
        case ntl::net::inspection::verdict::block:
          return rewrite_result::block();
        case ntl::net::inspection::verdict::drop_flow:
          return rewrite_result::drop();
        }
        return rewrite_result::block();
      });
}

inline async_response_rule_selector
async_response_rule_selector::when(predicate condition) const {
  if (!condition)
    throw std::invalid_argument("async HTTP response predicate is empty");
  const predicate previous = condition_;
  return async_response_rule_selector(
      state_, [previous, condition = std::move(condition)](
                      const request_message &request,
                      const response_message &response) {
        return previous(request, response) && condition(request, response);
      });
}

inline async_response_rule_selector async_response_rule_selector::html() const {
  return when([](const request_message &, const response_message &response) {
    const auto content_type = response.headers.first("content-type");
    return content_type &&
           transform_detail::html_content_type(*content_type);
  });
}

template <class Function>
async_response_rule_selector &
async_response_rule_selector::transform(Function &&function) {
  state_->require_mutable();
  using callback_type = std::decay_t<Function>;
  state_->response_rules.push_back(
