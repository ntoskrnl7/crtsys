class async_transform_pipeline::request_awaitable {
public:
  explicit request_awaitable(
      std::shared_ptr<operation<request_message>> operation) noexcept
      : operation_(std::move(operation)) {}
  bool await_ready() const noexcept { return false; }
  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    operation_->set_continuation(continuation);
    if (!operation_->submit())
      operation_->fail(async_transform_detail::completion_reason::overloaded,
                       STATUS_DEVICE_BUSY);
    operation_->arm_external_cancellation();
    return operation_->mark_suspended();
  }
  pipeline_outcome await_resume() { return operation_->take(); }

private:
  std::shared_ptr<operation<request_message>> operation_;
};

class async_transform_pipeline::response_awaitable {
public:
  explicit response_awaitable(
      std::shared_ptr<operation<response_message>> operation) noexcept
      : operation_(std::move(operation)) {}
  bool await_ready() const noexcept { return false; }
  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    operation_->set_continuation(continuation);
    if (!operation_->submit())
      operation_->fail(async_transform_detail::completion_reason::overloaded,
                       STATUS_DEVICE_BUSY);
    operation_->arm_external_cancellation();
    return operation_->mark_suspended();
  }
  pipeline_outcome await_resume() { return operation_->take(); }

private:
  std::shared_ptr<operation<response_message>> operation_;
};

inline async_transform_pipeline::request_awaitable
async_transform_pipeline::apply(request_message &message,
                                std::stop_token cancellation) {
  started_.store(true, std::memory_order_release);
  return request_awaitable(std::make_shared<operation<request_message>>(
      *this, message, message, cancellation));
}

inline async_transform_pipeline::response_awaitable
async_transform_pipeline::apply(const request_message &request,
                                response_message &message,
                                std::stop_token cancellation) {
  started_.store(true, std::memory_order_release);
  return response_awaitable(std::make_shared<operation<response_message>>(
      *this, request, message, message, cancellation));
}

inline async_request_rule_selector
async_request_rule_selector::when(predicate condition) const {
  if (!condition)
    throw std::invalid_argument("async HTTP request predicate is empty");
  const predicate previous = condition_;
  return async_request_rule_selector(
      *pipeline_, [previous, condition = std::move(condition)](
                      const request_message &message) {
        return previous(message) && condition(message);
      });
}

template <class Function>
async_request_rule_selector &
async_request_rule_selector::transform(Function &&function) {
  pipeline_->ensure_configurable();
  using callback_type = std::decay_t<Function>;
  pipeline_->request_rules_.push_back(
      {condition_,
       [callback = callback_type(std::forward<Function>(function))](
           request_message &message, const async_policy_context &context) {
         return static_cast<rewrite_result>(callback(message, context));
       }});
  return *this;
}

template <class Function>
async_request_rule_selector &
async_request_rule_selector::decide(Function &&function) {
  using callback_type = std::decay_t<Function>;
  return transform(
      [callback = callback_type(std::forward<Function>(function))](
          request_message &message, const async_policy_context &context) {
        switch (static_cast<ntl::net::inspection::verdict>(
            callback(static_cast<const request_message &>(message), context))) {
        case ntl::net::inspection::verdict::permit:
          return rewrite_result::unchanged();
        case ntl::net::inspection::verdict::block:
          return rewrite_result::block();
        case ntl::net::inspection::verdict::drop_flow:
          return rewrite_result::drop();
        }
        return rewrite_result::block();
      });
}

inline async_response_rule_selector
async_response_rule_selector::when(predicate condition) const {
  if (!condition)
    throw std::invalid_argument("async HTTP response predicate is empty");
  const predicate previous = condition_;
  return async_response_rule_selector(
      *pipeline_, [previous, condition = std::move(condition)](
                      const request_message &request,
                      const response_message &response) {
        return previous(request, response) && condition(request, response);
      });
}

inline async_response_rule_selector async_response_rule_selector::html() const {
  return when([](const request_message &, const response_message &response) {
    const auto content_type = response.headers.first("content-type");
    return content_type &&
           transform_detail::html_content_type(*content_type);
  });
}

template <class Function>
async_response_rule_selector &
async_response_rule_selector::transform(Function &&function) {
  pipeline_->ensure_configurable();
  using callback_type = std::decay_t<Function>;
  pipeline_->response_rules_.push_back(
      {condition_,
       [callback = callback_type(std::forward<Function>(function))](
           const request_message &request, response_message &message,
           const async_policy_context &context) {
         return static_cast<rewrite_result>(callback(request, message, context));
       }});
  return *this;
}

template <class Function>
async_response_rule_selector &
async_response_rule_selector::decide(Function &&function) {
  using callback_type = std::decay_t<Function>;
  return transform(
      [callback = callback_type(std::forward<Function>(function))](
          const request_message &request, response_message &message,
          const async_policy_context &context) {
        switch (static_cast<ntl::net::inspection::verdict>(callback(
            request, static_cast<const response_message &>(message), context))) {
        case ntl::net::inspection::verdict::permit:
          return rewrite_result::unchanged();
        case ntl::net::inspection::verdict::block:
          return rewrite_result::block();
        case ntl::net::inspection::verdict::drop_flow:
          return rewrite_result::drop();
        }
        return rewrite_result::block();
      });
}

