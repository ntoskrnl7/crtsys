class async_transform_policy_builder;
class async_transform_runtime;

class async_request_rule_selector {
public:
  using predicate = std::function<bool(const request_message &)>;
  async_request_rule_selector when(predicate condition) const;

  template <class Function>
  async_request_rule_selector &transform(Function &&function);
  template <class Function>
  async_request_rule_selector &decide(Function &&function);

private:
  friend class async_transform_policy_builder;
  async_request_rule_selector(
      std::shared_ptr<async_transform_detail::async_transform_policy_state>
          state,
                              predicate condition)
      : state_(std::move(state)), condition_(std::move(condition)) {}
  std::shared_ptr<async_transform_detail::async_transform_policy_state> state_;
  predicate condition_;
};

class async_response_rule_selector {
public:
  using predicate = std::function<bool(const request_message &,
                                       const response_message &)>;
  async_response_rule_selector when(predicate condition) const;
  async_response_rule_selector html() const;

  template <class Function>
  async_response_rule_selector &transform(Function &&function);
  template <class Function>
  async_response_rule_selector &decide(Function &&function);

private:
  friend class async_transform_policy_builder;
  async_response_rule_selector(
      std::shared_ptr<async_transform_detail::async_transform_policy_state>
          state,
                               predicate condition)
      : state_(std::move(state)), condition_(std::move(condition)) {}
  std::shared_ptr<async_transform_detail::async_transform_policy_state> state_;
  predicate condition_;
};

class async_transform_policy {
public:
  async_transform_policy() = delete;

private:
  friend class async_transform_policy_builder;
  friend class async_transform_runtime;
  explicit async_transform_policy(
      std::shared_ptr<const async_transform_detail::async_transform_policy_state>
          state) noexcept
      : state_(std::move(state)) {}
  std::shared_ptr<const async_transform_detail::async_transform_policy_state>
      state_;
};

class async_transform_policy_builder {
public:
  explicit async_transform_policy_builder(
      transform_limits limits = {}, async_transform_options options = {})
      : state_(std::make_shared<
               async_transform_detail::async_transform_policy_state>()) {
    transform_pipeline validation(limits);
    if (options.maximum_concurrency == 0 ||
        options.maximum_queue_depth == 0 ||
        options.timeout <= std::chrono::milliseconds::zero())
      throw std::invalid_argument("async HTTP transform options are invalid");
    state_->limits = limits;
    state_->options = options;
  }

  async_request_rule_selector requests() {
    return async_request_rule_selector(state_, [](const request_message &) {
      return true;
    });
  }
  async_response_rule_selector responses() {
    return async_response_rule_selector(
        state_, [](const request_message &, const response_message &) {
          return true;
        });
  }

  async_transform_policy build() && {
    state_->require_mutable();
    state_->built = true;
    return async_transform_policy(std::move(state_));
  }

private:
  std::shared_ptr<async_transform_detail::async_transform_policy_state> state_;
};

class async_transform_runtime {
public:
  static async_transform_runtime create(async_transform_policy policy) {
    return async_transform_runtime(async_transform_detail::pipeline_state::create(
        std::move(policy.state_)));
  }

  async_transform_runtime(const async_transform_runtime &) = delete;
  async_transform_runtime &operator=(const async_transform_runtime &) = delete;
  async_transform_runtime(async_transform_runtime &&other) noexcept
      : state_(other.state_.exchange({}, std::memory_order_acq_rel)) {}
  async_transform_runtime &operator=(async_transform_runtime &&other) noexcept {
    if (this != &other) {
      close();
      state_.store(other.state_.exchange({}, std::memory_order_acq_rel),
                   std::memory_order_release);
    }
    return *this;
  }
  ~async_transform_runtime() { close(); }

  /** Rejects new work; child callbacks keep native state until they drain. */
  void close() noexcept {
    auto state = state_.exchange({}, std::memory_order_acq_rel);
    if (state)
      state->close();
  }

  async_transform_statistics statistics() const noexcept {
    auto state = state_.load(std::memory_order_acquire);
    return state ? state->worker_executor.statistics()
                 : async_transform_statistics{};
  }

  template <class Message> class operation;

public:
  class borrowed_request_awaitable;
  class borrowed_response_awaitable;
  class owning_request_awaitable;
  class owning_response_awaitable;

  borrowed_request_awaitable apply_borrowed(
      request_message &message, std::stop_token cancellation = {});
  borrowed_response_awaitable apply_borrowed(
      const request_message &request, response_message &message,
      std::stop_token cancellation = {});

  owning_request_awaitable apply(
      request_message message, std::stop_token cancellation = {});
  owning_response_awaitable apply(
      request_message request, response_message message,
      std::stop_token cancellation = {});

private:
  explicit async_transform_runtime(
      std::shared_ptr<async_transform_detail::pipeline_state> state) noexcept
      : state_(std::move(state)) {}

  std::shared_ptr<async_transform_detail::pipeline_state>
  require_state() const {
    auto state = state_.load(std::memory_order_acquire);
    if (!state || state->closing.load(std::memory_order_acquire))
      throw std::logic_error("async HTTP transform runtime is closed");
    return state;
  }

  std::atomic<std::shared_ptr<async_transform_detail::pipeline_state>> state_;
};

template <> class async_transform_runtime::operation<request_message> final
    : public async_transform_detail::operation_base {
public:
  operation(std::shared_ptr<async_transform_detail::pipeline_state> state,
            request_message value,
            std::stop_token external)
      : operation_base(std::chrono::steady_clock::now() +
                       state->options.timeout),
        state_(std::move(state)), value_(std::move(value)),
        external_(external) {}

  void arm_external_cancellation() {
    if (external_.stop_possible()) {
      std::weak_ptr<operation> weak =
          std::static_pointer_cast<operation>(shared_from_this());
      external_callback_.emplace(
          external_, std::function<void()>([weak] {
            if (const auto current = weak.lock()) {
              current->fail(async_transform_detail::completion_reason::cancelled,
                            STATUS_CANCELLED);
              current->request_stop();
            }
          }));
    }
  }

  bool submit() noexcept {
    return state_->worker_executor.submit(shared_from_this());
  }

  bool start(std::coroutine_handle<> continuation) noexcept {
    arm_external_cancellation();
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return false;
      set_continuation(continuation);
      if (submit())
        return mark_suspended();
      outcome_ = failure(
          async_transform_detail::completion_reason::overloaded,
          STATUS_DEVICE_BUSY);
      std::coroutine_handle<> ignored;
      (void)complete_once(ignored);
    }
    state_->worker_executor.retired(
        this, async_transform_detail::completion_reason::overloaded);
    return false;
  }

  void execute(async_policy_context context) noexcept override {
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return;
      running_callback_ = true;
    }
    auto outcome = state_->run(value_, context);
    auto reason = async_transform_detail::completion_reason::normal;
    {
      std::lock_guard guard(completion_lock_);
      running_callback_ = false;
      if (completed())
        return;
      if (pending_failure_) {
        reason = pending_failure_->first;
        outcome = failure(pending_failure_->first,
                          pending_failure_->second);
      }
    }
    complete(std::move(outcome), reason);
  }
  void fail(async_transform_detail::completion_reason reason,
            NTSTATUS status) noexcept override {
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return;
      if (running_callback_) {
        pending_failure_ = std::pair{reason, status};
        return;
      }
    }
    complete(failure(reason, status), reason);
  }
  void abandon() noexcept {
    bool retired = false;
    {
      std::lock_guard guard(completion_lock_);
      retired = abandon_once();
    }
    if (retired) {
      request_stop();
      state_->worker_executor.retired(
          this, async_transform_detail::completion_reason::cancelled);
    }
  }
  pipeline_outcome take_borrowed(request_message &destination) {
    std::lock_guard guard(completion_lock_);
    if (outcome_.failure == STATUS_SUCCESS || outcome_.modified())
      destination = std::move(value_);
    return std::move(outcome_);
  }

  async_transform_result<request_message> take_owned() {
    std::lock_guard guard(completion_lock_);
    return {std::move(value_), std::move(outcome_)};
  }

private:
  pipeline_outcome failure(
      async_transform_detail::completion_reason reason,
      NTSTATUS status) const noexcept {
    transform_failure_policy policy = state_->policy->limits.on_failure;
    if (reason == async_transform_detail::completion_reason::cancelled ||
        reason == async_transform_detail::completion_reason::stopping)
      policy = state_->options.on_cancel;
    else if (reason == async_transform_detail::completion_reason::timed_out)
      policy = state_->options.on_timeout;
    else if (reason == async_transform_detail::completion_reason::overloaded)
      policy = state_->options.on_overload;
    return async_transform_detail::failure_outcome(policy, status);
  }

  void complete(pipeline_outcome outcome,
                async_transform_detail::completion_reason reason) noexcept {
    std::coroutine_handle<> continuation;
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return;
      outcome_ = std::move(outcome);
      if (!complete_once(continuation))
        return;
    }
    state_->worker_executor.retired(this, reason);
    if (continuation)
      continuation.resume();
  }
  std::shared_ptr<async_transform_detail::pipeline_state> state_;
  request_message value_;
  std::stop_token external_;
  std::optional<std::stop_callback<std::function<void()>>> external_callback_;
  std::mutex completion_lock_;
  std::optional<std::pair<async_transform_detail::completion_reason,
                          NTSTATUS>> pending_failure_;
  bool running_callback_ = false;
  pipeline_outcome outcome_{};
};

template <> class async_transform_runtime::operation<response_message> final
    : public async_transform_detail::operation_base {
public:
  operation(std::shared_ptr<async_transform_detail::pipeline_state> state,
            request_message request,
            response_message value, std::stop_token external)
      : operation_base(std::chrono::steady_clock::now() +
                       state->options.timeout),
        state_(std::move(state)), request_(std::move(request)),
        value_(std::move(value)), external_(external) {}

  void arm_external_cancellation() {
    if (external_.stop_possible()) {
      std::weak_ptr<operation> weak =
          std::static_pointer_cast<operation>(shared_from_this());
      external_callback_.emplace(
          external_, std::function<void()>([weak] {
            if (const auto current = weak.lock()) {
              current->fail(async_transform_detail::completion_reason::cancelled,
                            STATUS_CANCELLED);
              current->request_stop();
            }
          }));
    }
  }

  bool submit() noexcept {
    return state_->worker_executor.submit(shared_from_this());
  }

  bool start(std::coroutine_handle<> continuation) noexcept {
    arm_external_cancellation();
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return false;
      set_continuation(continuation);
      if (submit())
        return mark_suspended();
      outcome_ = failure(
          async_transform_detail::completion_reason::overloaded,
          STATUS_DEVICE_BUSY);
      std::coroutine_handle<> ignored;
      (void)complete_once(ignored);
    }
    state_->worker_executor.retired(
        this, async_transform_detail::completion_reason::overloaded);
    return false;
  }

  void execute(async_policy_context context) noexcept override {
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return;
      running_callback_ = true;
    }
    auto outcome = state_->run(request_, value_, context);
    auto reason = async_transform_detail::completion_reason::normal;
    {
      std::lock_guard guard(completion_lock_);
      running_callback_ = false;
      if (completed())
        return;
      if (pending_failure_) {
        reason = pending_failure_->first;
        outcome = failure(pending_failure_->first,
                          pending_failure_->second);
      }
    }
    complete(std::move(outcome), reason);
  }
  void fail(async_transform_detail::completion_reason reason,
            NTSTATUS status) noexcept override {
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return;
      if (running_callback_) {
        pending_failure_ = std::pair{reason, status};
        return;
      }
    }
    complete(failure(reason, status), reason);
  }
  void abandon() noexcept {
    bool retired = false;
    {
      std::lock_guard guard(completion_lock_);
      retired = abandon_once();
    }
    if (retired) {
      request_stop();
      state_->worker_executor.retired(
          this, async_transform_detail::completion_reason::cancelled);
    }
  }
  pipeline_outcome take_borrowed(response_message &destination) {
    std::lock_guard guard(completion_lock_);
    if (outcome_.failure == STATUS_SUCCESS || outcome_.modified())
      destination = std::move(value_);
    return std::move(outcome_);
  }

  async_transform_result<response_message> take_owned() {
    std::lock_guard guard(completion_lock_);
    return {std::move(value_), std::move(outcome_)};
  }

private:
  pipeline_outcome failure(
      async_transform_detail::completion_reason reason,
      NTSTATUS status) const noexcept {
    transform_failure_policy policy = state_->policy->limits.on_failure;
    if (reason == async_transform_detail::completion_reason::cancelled ||
        reason == async_transform_detail::completion_reason::stopping)
      policy = state_->options.on_cancel;
    else if (reason == async_transform_detail::completion_reason::timed_out)
      policy = state_->options.on_timeout;
    else if (reason == async_transform_detail::completion_reason::overloaded)
      policy = state_->options.on_overload;
    return async_transform_detail::failure_outcome(policy, status);
  }

  void complete(pipeline_outcome outcome,
                async_transform_detail::completion_reason reason) noexcept {
    std::coroutine_handle<> continuation;
    {
      std::lock_guard guard(completion_lock_);
      if (completed())
        return;
      outcome_ = std::move(outcome);
      if (!complete_once(continuation))
        return;
    }
    state_->worker_executor.retired(this, reason);
    if (continuation)
      continuation.resume();
  }
  std::shared_ptr<async_transform_detail::pipeline_state> state_;
  request_message request_;
  response_message value_;
  std::stop_token external_;
  std::optional<std::stop_callback<std::function<void()>>> external_callback_;
  std::mutex completion_lock_;
  std::optional<std::pair<async_transform_detail::completion_reason,
                          NTSTATUS>> pending_failure_;
  bool running_callback_ = false;
  pipeline_outcome outcome_{};
};

class async_transform_runtime::borrowed_request_awaitable {
public:
  explicit borrowed_request_awaitable(
      std::shared_ptr<operation<request_message>> operation,
      request_message &destination) noexcept
      : operation_(std::move(operation)), destination_(&destination) {}
  ~borrowed_request_awaitable() {
    if (operation_)
      operation_->abandon();
  }
  bool await_ready() const noexcept { return false; }
  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    return operation_->start(continuation);
  }
  pipeline_outcome await_resume() {
    return operation_->take_borrowed(*destination_);
  }

private:
  std::shared_ptr<operation<request_message>> operation_;
  request_message *destination_ = nullptr;
};

