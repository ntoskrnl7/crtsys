namespace ntl::net::http {

struct async_transform_options {
  std::size_t maximum_concurrency = 4;
  std::size_t maximum_queue_depth = 256;
  std::chrono::milliseconds timeout{5'000};
  transform_failure_policy on_cancel = transform_failure_policy::block;
  transform_failure_policy on_timeout = transform_failure_policy::block;
  transform_failure_policy on_overload = transform_failure_policy::block;
};

class async_policy_context {
public:
  async_policy_context(
      std::stop_token cancellation,
      std::chrono::steady_clock::time_point deadline) noexcept
      : cancellation_(cancellation), deadline_(deadline) {}

  std::stop_token cancellation() const noexcept { return cancellation_; }
  bool cancellation_requested() const noexcept {
    return cancellation_.stop_requested();
  }
  std::chrono::steady_clock::time_point deadline() const noexcept {
    return deadline_;
  }
  std::chrono::milliseconds remaining() const noexcept {
    const auto now = std::chrono::steady_clock::now();
    if (now >= deadline_)
      return std::chrono::milliseconds::zero();
    return std::chrono::duration_cast<std::chrono::milliseconds>(
        deadline_ - now);
  }

private:
  std::stop_token cancellation_;
  std::chrono::steady_clock::time_point deadline_{};
};

struct async_transform_statistics {
  std::uint64_t submitted = 0;
  std::uint64_t completed = 0;
  std::uint64_t cancelled = 0;
  std::uint64_t timed_out = 0;
  std::uint64_t overloaded = 0;
  std::size_t queued = 0;
  std::size_t running = 0;
};

template <class Message> struct async_transform_result {
  Message message;
  pipeline_outcome outcome;
};

namespace async_transform_detail {

enum class completion_reason : std::uint8_t {
  normal,
  cancelled,
  timed_out,
  overloaded,
  stopping,
};

class operation_base : public std::enable_shared_from_this<operation_base> {
public:
  enum class phase : std::uint8_t { submitting, suspended, completed };

  explicit operation_base(
      std::chrono::steady_clock::time_point deadline) noexcept
      : deadline_(deadline) {}
  virtual ~operation_base() = default;

  operation_base(const operation_base &) = delete;
  operation_base &operator=(const operation_base &) = delete;

  virtual void execute(async_policy_context context) noexcept = 0;
  virtual void fail(completion_reason reason, NTSTATUS status) noexcept = 0;

  bool completed() const noexcept {
    return phase_.load(std::memory_order_acquire) == phase::completed;
  }
  std::chrono::steady_clock::time_point deadline() const noexcept {
    return deadline_;
  }
  std::stop_token token() const noexcept { return cancellation_.get_token(); }
  void request_stop() noexcept { (void)cancellation_.request_stop(); }

  bool mark_timeout_requested() noexcept {
    bool expected = false;
    return timeout_requested_.compare_exchange_strong(
        expected, true, std::memory_order_acq_rel,
        std::memory_order_acquire);
  }

  void set_continuation(std::coroutine_handle<> continuation) noexcept {
    continuation_ = continuation;
  }

  bool mark_suspended() noexcept {
    phase expected = phase::submitting;
    return phase_.compare_exchange_strong(
        expected, phase::suspended,
        std::memory_order_acq_rel, std::memory_order_acquire);
  }

protected:
  bool complete_once(std::coroutine_handle<> &continuation) noexcept {
    const phase previous =
        phase_.exchange(phase::completed, std::memory_order_acq_rel);
    if (previous == phase::completed)
      return false;
    if (previous == phase::suspended)
      continuation = continuation_;
    return true;
  }

  bool abandon_once() noexcept {
    const phase previous =
        phase_.exchange(phase::completed, std::memory_order_acq_rel);
    continuation_ = {};
    return previous != phase::completed;
  }

private:
  std::chrono::steady_clock::time_point deadline_{};
  std::stop_source cancellation_;
  std::atomic<phase> phase_{phase::submitting};
  std::atomic<bool> timeout_requested_{false};
  std::coroutine_handle<> continuation_{};
};

class executor {
public:
  explicit executor(async_transform_options options)
      : options_(options) {
    if (options_.maximum_concurrency == 0 ||
        options_.maximum_queue_depth == 0 ||
        options_.timeout <= std::chrono::milliseconds::zero())
      throw std::invalid_argument("async HTTP transform options are invalid");
    workers_.reserve(options_.maximum_concurrency);
    for (std::size_t index = 0; index != options_.maximum_concurrency; ++index)
      workers_.emplace_back([this](std::stop_token stop) { worker(stop); });
    timer_ = std::jthread([this](std::stop_token stop) { monitor(stop); });
  }

  executor(const executor &) = delete;
  executor &operator=(const executor &) = delete;

  ~executor() { close(); }

  /** Idempotently rejects new work and completes every child operation. */
  void close() noexcept {
    std::unordered_set<std::shared_ptr<operation_base>> pending;
    {
      std::lock_guard guard(lock_);
      if (stopping_)
        return;
      stopping_ = true;
      pending.swap(operations_);
      queue_.clear();
    }
    for (const auto &operation : pending) {
      operation->fail(completion_reason::stopping, STATUS_CANCELLED);
      operation->request_stop();
    }
    for (auto &worker : workers_)
      worker.request_stop();
    timer_.request_stop();
    ready_.notify_all();
    timer_wakeup_.notify_all();
  }

  bool running_on_executor_thread() const noexcept {
    const auto current = std::this_thread::get_id();
    if (timer_.get_id() == current)
      return true;
    return std::any_of(workers_.begin(), workers_.end(),
                       [current](const auto &worker) {
                         return worker.get_id() == current;
                       });
  }

  bool submit(const std::shared_ptr<operation_base> &operation) noexcept {
    {
      std::lock_guard guard(lock_);
      if (stopping_ || queue_.size() >= options_.maximum_queue_depth) {
        ++overloaded_;
        return false;
      }
      ++submitted_;
      operations_.insert(operation);
      queue_.push_back(operation);
    }
    ready_.notify_one();
    timer_wakeup_.notify_one();
    return true;
  }

  void retired(operation_base *operation,
               completion_reason reason) noexcept {
    std::lock_guard guard(lock_);
    for (auto iterator = operations_.begin();
         iterator != operations_.end(); ++iterator) {
      if (iterator->get() == operation) {
        operations_.erase(iterator);
        break;
      }
    }
    const auto queued = std::find_if(
        queue_.begin(), queue_.end(), [operation](const auto &candidate) {
          return candidate.get() == operation;
        });
    if (queued != queue_.end())
      queue_.erase(queued);
    if (running_operations_.erase(operation) != 0 && running_ != 0)
      --running_;
    ++completed_;
    if (reason == completion_reason::cancelled)
      ++cancelled_;
    else if (reason == completion_reason::timed_out)
      ++timed_out_;
  }

  async_transform_statistics statistics() const noexcept {
    std::lock_guard guard(lock_);
    return {submitted_, completed_, cancelled_, timed_out_, overloaded_,
            queue_.size(), running_};
  }

private:
  void worker(std::stop_token stop) noexcept {
    while (!stop.stop_requested()) {
      std::shared_ptr<operation_base> operation;
      bool execute = false;
      {
        std::unique_lock guard(lock_);
        ready_.wait(guard, [&] {
          return stopping_ || stop.stop_requested() || !queue_.empty();
        });
        if (stopping_ || stop.stop_requested())
          return;
        operation = std::move(queue_.front());
        queue_.pop_front();
        if (!operation->completed()) {
          running_operations_.insert(operation.get());
          ++running_;
          execute = true;
        }
      }

      if (execute) {
        if (std::chrono::steady_clock::now() >= operation->deadline()) {
          operation->fail(completion_reason::timed_out, STATUS_IO_TIMEOUT);
          operation->request_stop();
        } else {
          operation->execute(
              async_policy_context(operation->token(), operation->deadline()));
        }
      }
    }
  }

  void monitor(std::stop_token stop) noexcept {
    while (!stop.stop_requested()) {
      std::shared_ptr<operation_base> expired;
      auto wake = std::chrono::steady_clock::now() +
                  std::chrono::milliseconds(100);
      {
        std::unique_lock guard(lock_);
        if (operations_.empty()) {
          timer_wakeup_.wait_for(guard, std::chrono::milliseconds(100));
        } else {
          for (const auto &operation : operations_)
            wake = (std::min)(wake, operation->deadline());
          timer_wakeup_.wait_until(guard, wake);
        }
        if (stopping_ || stop.stop_requested())
          return;
        const auto now = std::chrono::steady_clock::now();
        for (const auto &operation : operations_) {
          if (!operation->completed() && now >= operation->deadline() &&
              operation->mark_timeout_requested()) {
            expired = operation;
            break;
          }
        }
      }
      if (expired) {
        expired->fail(completion_reason::timed_out, STATUS_IO_TIMEOUT);
        expired->request_stop();
      }
    }
  }

  async_transform_options options_{};
  mutable std::mutex lock_;
  std::condition_variable ready_;
  std::condition_variable timer_wakeup_;
  std::deque<std::shared_ptr<operation_base>> queue_;
  std::unordered_set<std::shared_ptr<operation_base>> operations_;
  std::unordered_set<operation_base *> running_operations_;
  std::vector<std::jthread> workers_;
  std::jthread timer_;
  std::uint64_t submitted_ = 0;
  std::uint64_t completed_ = 0;
  std::uint64_t cancelled_ = 0;
  std::uint64_t timed_out_ = 0;
  std::uint64_t overloaded_ = 0;
  std::size_t running_ = 0;
  bool stopping_ = false;
};

inline pipeline_outcome failure_outcome(
    transform_failure_policy policy, NTSTATUS status) noexcept {
  return {policy == transform_failure_policy::forward_original
              ? rewrite_action::forward
              : rewrite_action::block,
          false, false, transformed_body_coding::preserve,
          std::nullopt, status};
}

struct async_request_rule {
  std::function<bool(const request_message &)> condition;
  std::function<rewrite_result(request_message &,
                               const async_policy_context &)> apply;
};

struct async_response_rule {
  std::function<bool(const request_message &, const response_message &)>
      condition;
  std::function<rewrite_result(const request_message &, response_message &,
                               const async_policy_context &)> apply;
};

/** Immutable rule graph shared by runtimes after the builder is consumed. */
struct async_transform_policy_state {
  transform_limits limits{};
  async_transform_options options{};
  std::vector<async_request_rule> request_rules;
  std::vector<async_response_rule> response_rules;
  bool built = false;

  void require_mutable() const {
    if (built)
      throw std::logic_error("async HTTP transform policy is already built");
  }
};

/** Native executor and immutable callbacks retained by every child. */
class pipeline_state {
public:
  static std::shared_ptr<pipeline_state>
  create(std::shared_ptr<const async_transform_policy_state> policy) {
    auto *cleanup = ntl::net::user::borrowed_runtime_cleanup_domain();
    if (!cleanup)
      throw std::bad_alloc();
    auto *raw = new pipeline_state(std::move(policy), *cleanup);
    try {
      return std::shared_ptr<pipeline_state>(
          raw, [](pipeline_state *state) noexcept {
            if (state->worker_executor.running_on_executor_thread()) {
              state->retire_from_worker();
              return;
            }
            delete state;
          });
    } catch (...) {
      delete raw;
      throw;
    }
  }

  pipeline_state(const pipeline_state &) = delete;
  pipeline_state &operator=(const pipeline_state &) = delete;

  void close() noexcept {
    closing.store(true, std::memory_order_release);
    worker_executor.close();
  }

  void retire_from_worker() noexcept {
    if (!cleanup_domain ||
        !cleanup_domain->retire_deferred(cleanup).is_ok())
      std::terminate();
  }

  static void cleanup_deferred(void *context) noexcept {
    delete static_cast<pipeline_state *>(context);
  }

  pipeline_outcome run(request_message &message,
                       const async_policy_context &context) const noexcept {
    try {
      transform_pipeline pipeline(policy->limits);
      for (const auto &rule : policy->request_rules) {
        pipeline.requests().when(rule.condition).transform(
            [&rule, &context](request_message &value) {
              return rule.apply(value, context);
            });
      }
      return pipeline.apply(message);
    } catch (const std::bad_alloc &) {
      return failure_outcome(policy->limits.on_failure,
                             STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return failure_outcome(policy->limits.on_failure,
                             STATUS_UNHANDLED_EXCEPTION);
    }
  }

  pipeline_outcome run(const request_message &request,
                       response_message &message,
                       const async_policy_context &context) const noexcept {
    try {
      transform_pipeline pipeline(policy->limits);
      for (const auto &rule : policy->response_rules) {
        pipeline.responses().when(rule.condition).transform(
            [&rule, &context](const request_message &value_request,
                              response_message &value) {
              return rule.apply(value_request, value, context);
            });
      }
      return pipeline.apply(request, message);
    } catch (const std::bad_alloc &) {
      return failure_outcome(policy->limits.on_failure,
                             STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return failure_outcome(policy->limits.on_failure,
                             STATUS_UNHANDLED_EXCEPTION);
    }
  }

  std::shared_ptr<const async_transform_policy_state> policy;
  const async_transform_options &options;
  std::atomic_bool closing{false};
  executor worker_executor;
  ntl::net::user::cleanup_domain *cleanup_domain = nullptr;
  ntl::net::user::cleanup_item cleanup{
      &pipeline_state::cleanup_deferred, this};

private:
  pipeline_state(std::shared_ptr<const async_transform_policy_state> policy_value,
                  ntl::net::user::cleanup_domain &cleanup_value)
      : policy(std::move(policy_value)), options(policy->options),
        worker_executor(options), cleanup_domain(&cleanup_value) {
    transform_pipeline validation(policy->limits);
    (void)validation;
  }
};

