inline std::shared_ptr<const transform_pipeline> owned_transforms(
    const std::shared_ptr<const inspection_policy> &policy) {
  if (!policy)
    throw std::invalid_argument("HTTP/1 inspection policy is null");
  return {policy, &policy->transforms_ref()};
}

template <http1_observer Observer>
void notify_request_event(Observer &observer,
                          const http1_request_event_view &event) noexcept {
  try {
    observer.on_request(event);
  } catch (...) {
    // Telemetry cannot replace policy or terminate message forwarding.
  }
}

template <http1_observer Observer>
void notify_response_event(Observer &observer,
                           const http1_response_event_view &event) noexcept {
  try {
    observer.on_response(event);
  } catch (...) {
    // Telemetry cannot replace policy or terminate message forwarding.
  }
}

template <http1_observer Observer>
void notify_context(Observer &observer,
                     const inspection_context_view &context) noexcept {
  try {
    observer.on_inspection(context);
  } catch (...) {
    // Telemetry cannot replace policy or terminate message forwarding.
  }
}

template <class Policy>
ntl::net::inspection::verdict
decide_context(Policy &policy, const inspection_context_view &context) {
  if constexpr (requires { policy.decide(context); })
    return static_cast<ntl::net::inspection::verdict>(
        policy.decide(context));
  else
    return static_cast<ntl::net::inspection::verdict>(
        std::invoke(policy, context));
}

template <class Policy, class Observer>
ntl::net::inspection::verdict inspect_message(
    Policy &policy, Observer &observer,
    const inspection_session_metadata &session,
    std::uint64_t exchange_id,
    const request_message &request,
    const response_message *response) {
  const auto inspect_stage = [&](inspection_stage stage,
                                 std::span<const std::byte> chunk) {
    const auto context = response
                             ? inspection_context_view::for_response(
                                   protocol::http1, 0, exchange_id, stage,
                                   session, request, *response, chunk)
                             : inspection_context_view::for_request(
                                   protocol::http1, 0, exchange_id, stage,
                                   session, request, chunk);
    notify_context(observer, context);
    return decide_context(policy, context);
  };
  auto verdict = inspect_stage(inspection_stage::headers, {});
  if (verdict != ntl::net::inspection::verdict::permit)
    return verdict;
  const auto body = response ? std::span<const std::byte>(response->body)
                             : std::span<const std::byte>(request.body);
  if (!body.empty()) {
    verdict = inspect_stage(inspection_stage::body_chunk, body);
    if (verdict != ntl::net::inspection::verdict::permit)
      return verdict;
  }
  return inspect_stage(inspection_stage::message_complete, {});
}

inline bool header_has_token(const header_collection &headers,
                             std::string_view name,
                             std::string_view token) noexcept {
  for (const auto &field : headers.fields()) {
    if (transform_detail::ascii_equal_ci(field.name, name) &&
        http1_transform_detail::contains_token_ci(field.value, token))
      return true;
  }
  return false;
}

inline std::optional<http1_tunnel_offer_view> tunnel_offer(
    const request_message &request, bool websocket_upgrade,
    std::string_view websocket_extensions) noexcept {
  if (websocket_upgrade)
    return http1_tunnel_offer_view{
        request, websocket_extensions, http1_tunnel_kind::websocket};
  if (transform_detail::ascii_equal_ci(request.method, "CONNECT"))
    return http1_tunnel_offer_view{
        request, websocket_extensions, http1_tunnel_kind::connect};
  if (header_has_token(request.headers, "connection", "upgrade") &&
      request.headers.first("upgrade"))
    return http1_tunnel_offer_view{
        request, websocket_extensions,
        http1_tunnel_kind::switch_protocol};
  return std::nullopt;
}

inline bool valid_tunnel_disposition(
    http1_tunnel_disposition disposition) noexcept {
  return disposition == http1_tunnel_disposition::reject ||
         disposition == http1_tunnel_disposition::inspect ||
         disposition == http1_tunnel_disposition::passthrough;
}

template <class Handler>
ntl::result<http1_tunnel_disposition> admit_tunnel(
    Handler &handler, const http1_tunnel_offer_view &offer) noexcept {
  if constexpr (requires { handler.admit(offer); }) {
    try {
      auto result = handler.admit(offer);
      if (!result)
        return ntl::unexpected(result.status());
      if (!valid_tunnel_disposition(*result))
        return ntl::unexpected(STATUS_INVALID_PARAMETER);
      return ntl::ok(*result);
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  } else {
    return ntl::ok(http1_tunnel_disposition::reject);
  }
}

inline bool response_is_close_delimited(
    const request_message &request,
    const response_message &response) noexcept {
  if (response_body_forbidden(request, response))
    return false;
  return !response.headers.first("content-length") &&
         !response.headers.first("transfer-encoding");
}

[[noreturn]] inline void throw_framing_error(NTSTATUS status) {
  int error = 13; // ERROR_INVALID_DATA
  switch (status) {
  case STATUS_BUFFER_OVERFLOW:
  case STATUS_BUFFER_TOO_SMALL:
    error = 111; // ERROR_BUFFER_OVERFLOW
    break;
  case STATUS_INSUFFICIENT_RESOURCES:
    error = 8; // ERROR_NOT_ENOUGH_MEMORY
    break;
  case STATUS_IO_TIMEOUT:
    error = 1460; // ERROR_TIMEOUT
    break;
  case STATUS_CANCELLED:
    error = 995; // ERROR_OPERATION_ABORTED
    break;
  case STATUS_NOT_SUPPORTED:
    error = 50; // ERROR_NOT_SUPPORTED
    break;
  default:
    break;
  }
  throw std::system_error(
      error, std::system_category(), "HTTP/1 framed stream");
}

template <class Stream> class framed_reader {
public:
  framed_reader(Stream &stream, http1_message_kind kind,
                http1_framing_limits framing_limits,
                std::size_t maximum_wire_message_size,
                std::size_t receive_chunk_size,
                http1_expect_continue_policy expect_continue =
                    http1_expect_continue_policy::reject)
      : stream_(&stream), framer_(kind, framing_limits),
        kind_(kind),
        maximum_wire_message_size_(maximum_wire_message_size),
        receive_chunk_size_(receive_chunk_size),
        expect_continue_(expect_continue) {
    if (maximum_wire_message_size_ == 0 || receive_chunk_size_ == 0)
      throw std::invalid_argument("invalid HTTP/1 framed reader limits");
  }

  void append_buffered(std::span<const std::byte> bytes) {
    if (bytes.size() > maximum_wire_message_size_ - buffer_.size())
      throw std::system_error(
          111, std::system_category(),
          "HTTP/1 carry-over exceeds its wire limit");
    buffer_.insert(buffer_.end(), bytes.begin(), bytes.end());
  }

  std::vector<std::byte> release_buffered() noexcept {
    return std::exchange(buffer_, {});
  }

  ntl::net::user::task<std::optional<std::vector<std::byte>>>
  read_or_eof() {
    for (;;) {
      const auto view = scatter_view::from_contiguous(
          std::span<const std::byte>(buffer_));
      const auto probe = framing::probe(
          framer_, view,
          {.maximum_frame_size = maximum_wire_message_size_});
      if (probe.state() == framing::probe_state::complete) {
        std::vector<std::byte> result(probe.frame_size());
        if (!result.empty())
          std::memcpy(result.data(), buffer_.data(), result.size());
        buffer_.erase(
            buffer_.begin(),
            buffer_.begin() + static_cast<std::ptrdiff_t>(result.size()));
        co_return result;
      }
      if (probe.state() == framing::probe_state::malformed)
        throw_framing_error(probe.error());

      if (kind_ == http1_message_kind::request) {
        const auto expectation = inspect_http1_request_expectation(view);
        if (expectation == http1_request_expectation::continue_100 &&
            !continue_sent_) {
          if (expect_continue_ !=
              http1_expect_continue_policy::local_continue)
            throw_framing_error(STATUS_NOT_SUPPORTED);
          constexpr std::string_view provisional =
              "HTTP/1.1 100 Continue\r\n\r\n";
          const auto wire = std::as_bytes(std::span<const char>(
              provisional.data(), provisional.size()));
          if (co_await stream_->write_all(wire) != wire.size())
            throw std::runtime_error(
                "HTTP/1 100 Continue response completed short");
          continue_sent_ = true;
        }
        if (expectation == http1_request_expectation::unsupported)
          throw_framing_error(STATUS_NOT_SUPPORTED);
        if (expectation == http1_request_expectation::malformed)
          throw_framing_error(STATUS_DATA_ERROR);
      }

      const std::size_t current = buffer_.size();
      if (current >= maximum_wire_message_size_)
        throw_framing_error(STATUS_BUFFER_OVERFLOW);
      const std::size_t room = maximum_wire_message_size_ - current;
      const std::size_t growth = (std::min)(receive_chunk_size_, room);
      const std::size_t target =
          (std::max)(probe.required_total(), current + growth);
      if (target <= current || target > maximum_wire_message_size_)
        throw_framing_error(STATUS_BUFFER_OVERFLOW);
      buffer_.resize(target);
      const std::size_t received = co_await stream_->read_some_borrowed(
          std::span<std::byte>(buffer_.data() + current, target - current));
      if (received > target - current)
        throw std::runtime_error("HTTP/1 stream returned an invalid size");
      buffer_.resize(current + received);
      if (received != 0)
        continue;
      if (current == 0)
        co_return std::nullopt;

      const auto final_view = scatter_view::from_contiguous(
          std::span<const std::byte>(buffer_));
      const auto final = framing::finish(
          framer_, final_view,
          {.maximum_frame_size = maximum_wire_message_size_});
      if (final.state() != framing::probe_state::complete)
        throw_framing_error(final.error());
      std::vector<std::byte> result(final.frame_size());
      if (!result.empty())
        std::memcpy(result.data(), buffer_.data(), result.size());
      buffer_.erase(
          buffer_.begin(),
          buffer_.begin() + static_cast<std::ptrdiff_t>(result.size()));
      co_return result;
    }
  }

private:
  Stream *stream_ = nullptr;
  http1_message_framer framer_;
  http1_message_kind kind_ = http1_message_kind::request;
  std::size_t maximum_wire_message_size_ = 0;
  std::size_t receive_chunk_size_ = 0;
  http1_expect_continue_policy expect_continue_ =
      http1_expect_continue_policy::reject;
  bool continue_sent_ = false;
  std::vector<std::byte> buffer_;
};

inline response_message forbidden_response() {
  response_message response;
  response.wire_protocol = protocol::http1;
  response.status = 403;
  response.headers.append(
      "content-type", "text/plain; charset=utf-8");
  constexpr std::string_view text = "Request blocked by policy.\n";
  response.body.assign(
      reinterpret_cast<const std::byte *>(text.data()),
      reinterpret_cast<const std::byte *>(text.data() + text.size()));
  return response;
}

template <class Stream>
ntl::net::user::task<unsigned> send_terminal_response(
    Stream &downstream, std::optional<response_message> response,
    const ntl::net::inspection::content_encoder_registry &encoders,
    const transform_limits &limits, bool response_to_head,
    response_message *sent) {
  auto message = response ? std::move(*response) : forbidden_response();
  message.wire_protocol = protocol::http1;
  const std::string original_coding =
      message.headers.joined("content-encoding");
  auto encoded = encode_body(
      message.headers, message.body, original_coding,
      transformed_body_coding::preserve, encoders, limits);
  if (!encoded)
    throw std::system_error(
        static_cast<int>(encoded.status()), std::system_category(),
        "HTTP/1 terminal response encoder rejected the body");
  auto wire = serialize_http1_response(
      message,
      response_to_head ? std::span<const std::byte>{}
                       : std::span<const std::byte>(*encoded),
      limits, response_to_head);
  if (!wire)
    throw std::system_error(
        static_cast<int>(wire.status()), std::system_category(),
        "HTTP/1 terminal response serializer rejected the message");
  if (co_await downstream.write_all(*wire) != wire->size())
    throw std::runtime_error("HTTP/1 terminal response completed short");
  if (sent)
    *sent = message;
  co_return message.status;
}

template <class Stream>
ntl::net::user::task<void> shutdown(Stream &stream) {
  try {
    co_await stream.shutdown();
  } catch (const std::system_error &error) {
    const int value = error.code().value();
    // A peer may close immediately after a complete HTTP exchange.  Treat
    // that as an orderly terminal state, while preserving every other error.
    if (value != 10058 && // WSAESHUTDOWN
        value != 10054 && // WSAECONNRESET
        value != 10053 && // WSAECONNABORTED
        value != 38)      // ERROR_HANDLE_EOF
      throw;
  }
}

template <class Stream>
ntl::net::user::task<void> drain_authenticated_close(Stream &stream) {
  if constexpr (requires {
                  stream.received_close_notify();
                  stream.read_some_borrowed(
                      std::declval<std::span<std::byte>>());
                }) {
    std::array<std::byte, 4096> discard{};
    while (!stream.received_close_notify()) {
      if (co_await stream.read_some_borrowed(discard) == 0)
        break;
    }
    if (!stream.received_close_notify())
      throw std::runtime_error(
          "TLS peer closed without close_notify");
  }
  co_return;
}

template <class Stream>
void close_transport(Stream &stream) noexcept {
  try {
    if constexpr (requires { stream.close(); }) {
      stream.close();
    } else if constexpr (requires { stream.cancel(); }) {
      (void)stream.cancel();
    }
  } catch (...) {
    // close() is a cancellation boundary and must remain noexcept.
  }
}

