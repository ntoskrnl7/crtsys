/**
 * @brief Owns one bounded persistent HTTP/1 inspection-proxy conversation.
 *
 * Stream must expose asynchronous read_some, write_all, and shutdown methods.
 * Policy remains in transform_pipeline.  Observer receives semantic messages;
 * UpgradeHandler receives the two live streams and all decrypted carry-over.
 */
template <class DownstreamStream, class UpstreamStream>
class http1_proxy_connection
    : public std::enable_shared_from_this<
          http1_proxy_connection<DownstreamStream, UpstreamStream>> {
public:
  http1_proxy_connection(
      std::shared_ptr<DownstreamStream> downstream,
      std::shared_ptr<UpstreamStream> upstream,
      std::shared_ptr<const transform_pipeline> transforms,
      std::shared_ptr<const ntl::net::inspection::content_decoder_registry>
          decoders,
      std::shared_ptr<const ntl::net::inspection::content_encoder_registry>
          encoders,
      http1_request_target_context target_context,
      http1_proxy_limits limits = {},
      inspection_session_metadata session = {})
      : downstream_(std::move(downstream)), upstream_(std::move(upstream)),
        transforms_(std::move(transforms)), decoders_(std::move(decoders)),
        encoders_(std::move(encoders)),
        origin_scheme_(target_context.origin_scheme), limits_(limits),
        session_(std::move(session)) {
    if (!downstream_ || !upstream_ || !transforms_ || !decoders_ ||
        !encoders_ || !limits_.valid() || !target_context.valid())
      throw std::invalid_argument("invalid HTTP/1 proxy limits");
    limits_.framing.allow_close_delimited_response = true;
  }

  http1_proxy_connection(
      std::shared_ptr<DownstreamStream> downstream,
      std::shared_ptr<UpstreamStream> upstream,
      std::shared_ptr<const inspection_policy> policy,
      http1_request_target_context target_context,
      http1_proxy_limits limits = {},
      inspection_session_metadata session = {})
      : http1_proxy_connection(
            std::move(downstream), std::move(upstream),
            http1_proxy_detail::owned_transforms(policy),
            policy ? policy->content_decoders() : nullptr,
            policy ? policy->content_encoders() : nullptr,
            target_context, limits, std::move(session)) {
    policy_ = std::move(policy);
    context_policy_ = &policy_->decisions_ref();
  }

  http1_proxy_connection(const http1_proxy_connection &) = delete;
  http1_proxy_connection &operator=(const http1_proxy_connection &) = delete;
  ~http1_proxy_connection() { close(); }

  /** Idempotently rejects a new run and wakes supported stream backends. */
  void close() noexcept {
    if (closed_.exchange(true, std::memory_order_acq_rel))
      return;
    http1_proxy_detail::close_transport(*downstream_);
    http1_proxy_detail::close_transport(*upstream_);
  }

  bool is_closed() const noexcept {
    return closed_.load(std::memory_order_acquire);
  }

  template <http1_observer Observer, class UpgradeHandler>
  ntl::net::user::task<http1_proxy_result>
  run(Observer observer, UpgradeHandler upgrade_handler) {
    begin_run();
    auto lifetime = this->shared_from_this();
    if (context_policy_)
      return run_owned(
          std::move(lifetime),
          std::cref(*context_policy_), std::move(observer),
          std::move(upgrade_handler));
    return run_owned(
        std::move(lifetime),
        permit_inspection_context{}, std::move(observer),
        std::move(upgrade_handler));
  }

  template <class ContextPolicy, http1_observer Observer,
            class UpgradeHandler>
  ntl::net::user::task<http1_proxy_result>
  run(ContextPolicy context_policy, Observer observer,
      UpgradeHandler upgrade_handler) {
    begin_run();
    return run_owned(
        this->shared_from_this(), std::move(context_policy),
        std::move(observer), std::move(upgrade_handler));
  }

private:
  void begin_run() {
    if (closed_.load(std::memory_order_acquire))
      throw std::system_error(
          995, std::system_category(), "HTTP/1 proxy is closed");
    if (started_.exchange(true, std::memory_order_acq_rel))
      throw std::system_error(
          995, std::system_category(), "HTTP/1 proxy already started");
    if (closed_.load(std::memory_order_acquire)) {
      started_.store(false, std::memory_order_release);
      throw std::system_error(
          995, std::system_category(), "HTTP/1 proxy closed while starting");
    }
  }

  template <class ContextPolicy, class Observer, class UpgradeHandler>
  ntl::net::user::task<http1_proxy_result>
  run_owned(
      std::shared_ptr<http1_proxy_connection> lifetime,
      ContextPolicy context_policy, Observer observer,
      UpgradeHandler upgrade_handler) {
    try {
      co_return co_await run_owned_impl(
          std::move(lifetime), std::move(context_policy),
          std::move(observer), std::move(upgrade_handler));
    } catch (...) {
      if (!closed_.load(std::memory_order_acquire))
        throw;
      http1_proxy_result result;
      result.termination = http1_proxy_termination::closed;
      co_return result;
    }
  }

  template <class ContextPolicy, class Observer, class UpgradeHandler>
  ntl::net::user::task<http1_proxy_result>
  run_owned_impl(
      std::shared_ptr<http1_proxy_connection> lifetime,
      ContextPolicy context_policy, Observer observer,
      UpgradeHandler upgrade_handler) {
    (void)lifetime;
    std::vector<std::byte> downstream_carry;
    std::vector<std::byte> upstream_carry;
    http1_proxy_result result;

    for (;;) {
      if (closed_.load(std::memory_order_acquire)) {
        result.termination = http1_proxy_termination::closed;
        break;
      }
      auto request_limits = limits_.framing;
      request_limits.allow_close_delimited_response = false;
      request_limits.response_body_forbidden = false;
      http1_proxy_detail::framed_reader<DownstreamStream> requests(
          *downstream_, http1_message_kind::request, request_limits,
          limits_.maximum_wire_message_size,
          limits_.request_receive_chunk_size, limits_.expect_continue);
      requests.append_buffered(downstream_carry);
      auto request_wire = co_await requests.read_or_eof();
      if (!request_wire) {
        result.termination = http1_proxy_termination::downstream_eof;
        break;
      }
      downstream_carry = requests.release_buffered();

      auto request = transform_http1_request(
          *request_wire, *transforms_, *decoders_, *encoders_,
          {origin_scheme_});
      if (!request)
        throw std::system_error(
            static_cast<int>(request.status()), std::system_category(),
            "HTTP/1 request transform rejected the message");
      auto contextual_request = ntl::net::inspection::verdict::permit;
      // A terminal transform is authoritative.  Running staged policy after
      // it could replace a caller-supplied response with the generic policy
      // block and would evaluate a message that will never be forwarded.
      if (request->outcome.action == rewrite_action::forward)
        contextual_request = http1_proxy_detail::inspect_message(
            context_policy, observer, session_,
            result.completed_exchanges + 1, request->message, nullptr);
      http1_proxy_detail::notify_request_event(
          observer, http1_request_event_view{
                        request->message, request_wire->size(),
                        request->websocket_upgrade});
      if (closed_.load(std::memory_order_acquire)) {
        result.termination = http1_proxy_termination::closed;
        break;
      }
      const bool request_closes = http1_proxy_detail::header_has_token(
          request->message.headers, "connection", "close");

      if (request->outcome.action == rewrite_action::drop ||
          contextual_request ==
              ntl::net::inspection::verdict::drop_flow) {
        result.termination = http1_proxy_termination::request_drop;
        break;
      }
      if (request->outcome.action != rewrite_action::forward ||
          contextual_request == ntl::net::inspection::verdict::block) {
        response_message sent;
        result.last_status =
            co_await http1_proxy_detail::send_terminal_response(
                *downstream_, std::move(request->outcome.response),
                *encoders_, transforms_->limits_ref(),
                request->message.method == "HEAD", &sent);
        http1_proxy_detail::notify_response_event(
            observer,
            http1_response_event_view{request->message, sent, 0, false, true,
                                 false});
        ++result.blocked_exchanges;
        ++result.completed_exchanges;
        const bool synthetic_closes =
            http1_proxy_detail::header_has_token(
                sent.headers, "connection", "close");
        if (request_closes || synthetic_closes) {
          result.termination = http1_proxy_termination::connection_close;
          break;
        }
        continue;
      }
      if (limits_.require_server_name_authority_binding &&
          transform_detail::ascii_equal_ci(origin_scheme_, "https") &&
          !authority_matches_tls_session(
              request->message.authority, session_)) {
        response_message sent;
        result.last_status =
            co_await http1_proxy_detail::send_terminal_response(
                *downstream_, std::nullopt, *encoders_,
                transforms_->limits_ref(),
                request->message.method == "HEAD",
                &sent);
        http1_proxy_detail::notify_response_event(
            observer,
            http1_response_event_view{request->message, sent, 0, false, true,
                                 false});
        ++result.blocked_exchanges;
        result.termination = http1_proxy_termination::terminal_response;
        break;
      }

      const auto offer = http1_proxy_detail::tunnel_offer(
          request->message, request->websocket_upgrade,
          request->websocket_extensions);
      std::optional<http1_tunnel_disposition> tunnel_disposition;
      if (offer) {
        auto admitted =
            http1_proxy_detail::admit_tunnel(upgrade_handler, *offer);
        if (!admitted)
          throw std::system_error(
              static_cast<int>(admitted.status()), std::system_category(),
              "HTTP/1 tunnel admission failed");
        tunnel_disposition = *admitted;
        if (*tunnel_disposition == http1_tunnel_disposition::reject) {
          response_message sent;
          result.last_status =
              co_await http1_proxy_detail::send_terminal_response(
                  *downstream_, std::nullopt, *encoders_,
                  transforms_->limits_ref(),
                  request->message.method == "HEAD",
                  &sent);
          http1_proxy_detail::notify_response_event(
              observer,
              http1_response_event_view{request->message, sent, 0, false, true,
                                   false});
          ++result.blocked_exchanges;
          result.termination = http1_proxy_termination::terminal_response;
          break;
        }
      }
      if (co_await upstream_->write_all(request->wire) !=
          request->wire.size())
        throw std::runtime_error("HTTP/1 upstream request completed short");

      auto response_limits = limits_.framing;
      response_limits.allow_close_delimited_response = true;
      response_limits.response_body_forbidden =
          request->message.method == "HEAD";
      response_limits.response_to_connect =
          transform_detail::ascii_equal_ci(
              request->message.method, "CONNECT");
      http1_proxy_detail::framed_reader<UpstreamStream> responses(
          *upstream_, http1_message_kind::response, response_limits,
          limits_.maximum_wire_message_size,
          limits_.response_receive_chunk_size);
      responses.append_buffered(upstream_carry);

      bool exchange_complete = false;
      bool response_closes = false;
      for (;;) {
        auto response_wire = co_await responses.read_or_eof();
        if (!response_wire)
          throw std::runtime_error(
              "HTTP/1 origin closed before its response");
        auto response = transform_http1_response(
            *response_wire, request->message, *transforms_,
            *decoders_, *encoders_);
        if (!response)
          throw std::system_error(
            static_cast<int>(response.status()), std::system_category(),
              "HTTP/1 response transform rejected the message (NTSTATUS " +
                  std::to_string(static_cast<unsigned long>(
                      static_cast<NTSTATUS>(response.status()))) + ")");
        const bool informational = response->message.status >= 100 &&
                                   response->message.status < 200 &&
                                   response->message.status != 101;

        auto contextual_response = ntl::net::inspection::verdict::permit;
        if (response->outcome.action == rewrite_action::forward)
          contextual_response = http1_proxy_detail::inspect_message(
              context_policy, observer, session_,
              result.completed_exchanges + 1, request->message,
              &response->message);
        if (closed_.load(std::memory_order_acquire)) {
          result.termination = http1_proxy_termination::closed;
          exchange_complete = true;
          break;
        }
        if (response->outcome.action == rewrite_action::drop ||
            contextual_response ==
                ntl::net::inspection::verdict::drop_flow) {
          upstream_carry = responses.release_buffered();
          result.termination = http1_proxy_termination::response_drop;
          exchange_complete = true;
          break;
        }
        if (response->outcome.action != rewrite_action::forward ||
            contextual_response == ntl::net::inspection::verdict::block) {
          const bool origin_response_closes =
              http1_proxy_detail::header_has_token(
                  response->message.headers, "connection", "close") ||
              http1_proxy_detail::response_is_close_delimited(
                  request->message, response->message);
          response_message sent;
          result.last_status =
              co_await http1_proxy_detail::send_terminal_response(
                  *downstream_, std::move(response->outcome.response),
                  *encoders_, transforms_->limits_ref(),
                  request->message.method == "HEAD", &sent);
          http1_proxy_detail::notify_response_event(
              observer,
              http1_response_event_view{request->message, sent, 0, false, true,
                                   false});
          upstream_carry = responses.release_buffered();
          ++result.blocked_exchanges;
          if (informational) {
            result.termination =
                http1_proxy_termination::terminal_response;
          } else {
            ++result.completed_exchanges;
            response_closes = origin_response_closes ||
                http1_proxy_detail::header_has_token(
                    sent.headers, "connection", "close");
          }
          exchange_complete = true;
          break;
        }

        if (co_await downstream_->write_all(response->wire) !=
            response->wire.size())
          throw std::runtime_error(
              "HTTP/1 downstream response completed short");
        http1_proxy_detail::notify_response_event(
            observer,
            http1_response_event_view{request->message, response->message,
                                 response->wire.size(), informational, false,
                                 response->websocket_upgrade});
        if (informational)
          continue;

        upstream_carry = responses.release_buffered();
        result.last_status = response->message.status;
        ++result.completed_exchanges;
        response_closes = http1_proxy_detail::header_has_token(
                              response->message.headers, "connection",
                              "close") ||
                          http1_proxy_detail::response_is_close_delimited(
                              request->message, response->message);

        const bool connect_tunnel =
            transform_detail::ascii_equal_ci(
                request->message.method, "CONNECT") &&
            response->message.status >= 200 &&
            response->message.status < 300;
        const bool switched_protocol = response->message.status == 101;
        if (response->websocket_upgrade || connect_tunnel ||
            switched_protocol) {
          if (response->websocket_upgrade && !request->websocket_upgrade)
            throw std::runtime_error(
                "origin switched protocols without a matching request");
          const auto tunnel_kind = response->websocket_upgrade
                                       ? http1_tunnel_kind::websocket
                                       : connect_tunnel
                                             ? http1_tunnel_kind::connect
                                             : http1_tunnel_kind::switch_protocol;
          if (!offer || !tunnel_disposition ||
              offer->kind != tunnel_kind)
            throw std::runtime_error(
                "origin switched protocols without an admitted matching request");
          http1_upgrade_context_view<DownstreamStream, UpstreamStream> context{
              *downstream_, *upstream_, request->message, response->message,
              downstream_carry, upstream_carry,
              request->websocket_extensions,
              response->websocket_extensions, tunnel_kind,
              *tunnel_disposition};
          co_await std::invoke(upgrade_handler, context);
          result.termination = http1_proxy_termination::upgraded;
          exchange_complete = true;
          break;
        }
        exchange_complete = true;
        break;
      }

      if (result.termination == http1_proxy_termination::request_drop ||
          result.termination == http1_proxy_termination::response_drop ||
          result.termination == http1_proxy_termination::terminal_response ||
          result.termination == http1_proxy_termination::upgraded ||
          result.termination == http1_proxy_termination::closed)
        break;
      if (!exchange_complete)
        throw std::logic_error("HTTP/1 exchange made no progress");
      if (request_closes || response_closes) {
        result.termination = http1_proxy_termination::connection_close;
        break;
      }
    }

    co_await http1_proxy_detail::shutdown(*downstream_);
    co_await http1_proxy_detail::shutdown(*upstream_);
    co_await http1_proxy_detail::drain_authenticated_close(*downstream_);
    co_await http1_proxy_detail::drain_authenticated_close(*upstream_);
    co_return result;
  }

  std::shared_ptr<DownstreamStream> downstream_;
  std::shared_ptr<UpstreamStream> upstream_;
  std::shared_ptr<const transform_pipeline> transforms_;
  std::shared_ptr<const inspection_policy> policy_;
  std::shared_ptr<const ntl::net::inspection::content_decoder_registry>
      decoders_;
  std::shared_ptr<const ntl::net::inspection::content_encoder_registry>
      encoders_;
  std::string origin_scheme_;
  http1_proxy_limits limits_{};
  inspection_session_metadata session_{};
  const decision_policy *context_policy_ = nullptr;
  std::atomic<bool> started_{false};
  std::atomic<bool> closed_{false};
};

} // namespace ntl::net::http
