/** Logical AND over independently reusable typed conditions. */
template <class... Predicates>
auto all_of(Predicates &&...predicates) {
  static_assert(sizeof...(Predicates) != 0,
                "all_of requires at least one HTTP inspection condition");
  return [conditions =
              std::tuple<std::decay_t<Predicates>...>(
                  std::forward<Predicates>(predicates)...)](
             const inspection_context_view &context) {
    return std::apply(
        [&](auto &...condition) {
          return (... && static_cast<bool>(
                             std::invoke(condition, context)));
        },
        conditions);
  };
}

/** Logical OR over independently reusable typed conditions. */
template <class... Predicates>
auto any_of(Predicates &&...predicates) {
  static_assert(sizeof...(Predicates) != 0,
                "any_of requires at least one HTTP inspection condition");
  return [conditions =
              std::tuple<std::decay_t<Predicates>...>(
                  std::forward<Predicates>(predicates)...)](
             const inspection_context_view &context) {
    return std::apply(
        [&](auto &...condition) {
          return (... || static_cast<bool>(
                             std::invoke(condition, context)));
        },
        conditions);
  };
}

/** Logical negation without erasing the concrete predicate type. */
template <class Predicate>
auto none_of(Predicate &&predicate) {
  return [condition =
              std::decay_t<Predicate>(std::forward<Predicate>(predicate))](
             const inspection_context_view &context) {
    return !static_cast<bool>(std::invoke(condition, context));
  };
}

