/** Requires at least one named field and accepts only if every value matches. */
template <class Predicate>
auto all_header_values(std::string name, Predicate &&predicate) {
  return [name = std::move(name),
          condition = std::decay_t<Predicate>(
              std::forward<Predicate>(predicate))](
             const inspection_context_view &context) {
    return detail::all_header_values(
        context.headers(), name, condition);
  };
}

/** Applies an application-defined predicate to each current-message field. */
template <class Predicate>
auto any_header(Predicate &&predicate) {
  return [condition =
              std::decay_t<Predicate>(std::forward<Predicate>(predicate))](
             const inspection_context_view &context) {
    const auto fields = context.headers().fields();
    return std::any_of(
        fields.begin(), fields.end(), [&](const header_field &field) {
          return static_cast<bool>(std::invoke(condition, field));
        });
  };
}

/** Applies an application-defined predicate to the associated request. */
template <class Predicate>
auto any_request_header(Predicate &&predicate) {
  return [condition =
              std::decay_t<Predicate>(std::forward<Predicate>(predicate))](
             const inspection_context_view &context) {
    const auto fields = context.request().headers.fields();
    return std::any_of(
        fields.begin(), fields.end(), [&](const header_field &field) {
          return static_cast<bool>(std::invoke(condition, field));
        });
  };
}

/** Applies an application-defined predicate to response fields, if present. */
template <class Predicate>
auto any_response_header(Predicate &&predicate) {
  return [condition =
              std::decay_t<Predicate>(std::forward<Predicate>(predicate))](
             const inspection_context_view &context) {
    if (!context.response())
      return false;
    const auto fields = context.response()->headers.fields();
    return std::any_of(
        fields.begin(), fields.end(), [&](const header_field &field) {
          return static_cast<bool>(std::invoke(condition, field));
        });
  };
}

inline auto header_name_starts_with(std::string prefix) {
  prefix = detail::normalized_header_name_prefix(std::move(prefix));
  return any_header(
      [prefix = std::move(prefix)](const header_field &field) noexcept {
        return field.name.starts_with(prefix);
      });
}

inline auto request_header_name_starts_with(std::string prefix) {
  prefix = detail::normalized_header_name_prefix(std::move(prefix));
  return any_request_header(
