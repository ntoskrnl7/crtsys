inline auto application_id_is(std::vector<std::byte> expected) {
  return [expected = std::move(expected)](
             const inspection_context_view &context) noexcept {
    const auto &actual = context.connection().application_id;
    return actual && actual->size() == expected.size() &&
           std::equal(actual->begin(), actual->end(), expected.begin());
  };
}

inline auto body_size_between(std::size_t minimum,
                              std::size_t maximum) {
  if (minimum > maximum)
    throw std::invalid_argument("invalid HTTP body size range");
  return [minimum, maximum](const inspection_context_view &context) noexcept {
    const auto size = context.body().size();
    return size >= minimum && size <= maximum;
  };
}

inline bool contains_bytes(std::span<const std::byte> bytes,
                           std::string_view expected) noexcept {
  return std::search(
             bytes.begin(), bytes.end(),
             reinterpret_cast<const std::byte *>(expected.data()),
             reinterpret_cast<const std::byte *>(
                 expected.data() + expected.size())) != bytes.end();
}

/** Searches only this callback chunk; it does not span chunk boundaries. */
inline auto current_body_chunk_contains(std::string expected) {
  return [expected = std::move(expected)](
             const inspection_context_view &context) noexcept {
    return context.stage() == inspection_stage::body_chunk &&
           contains_bytes(context.body_chunk(), expected);
  };
}

inline auto complete_body_contains(std::string expected) {
  return [expected = std::move(expected)](
             const inspection_context_view &context) noexcept {
    return context.stage() == inspection_stage::message_complete &&
           contains_bytes(context.body(), expected);
  };
}

