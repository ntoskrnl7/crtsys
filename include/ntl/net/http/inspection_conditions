inline std::string normalized_header_name_prefix(std::string prefix) {
  if (prefix.empty())
    throw std::invalid_argument("HTTP header-name prefix is empty");
  prefix = transform_detail::normalized_name(std::move(prefix));
  if (!transform_detail::is_token(prefix))
    throw std::invalid_argument("HTTP header-name prefix is invalid");
  return prefix;
}

inline bool has_header_value(
    const header_collection &headers, std::string_view name,
    std::string_view expected, bool value_case_insensitive) noexcept {
  for (const auto &field : headers.fields()) {
    if (!transform_detail::ascii_equal_ci(field.name, name))
      continue;
    if (value_case_insensitive
            ? transform_detail::ascii_equal_ci(field.value, expected)
            : field.value == expected)
      return true;
  }
  return false;
}

inline std::size_t header_count(
    const header_collection &headers, std::string_view name) noexcept {
  return static_cast<std::size_t>(std::count_if(
      headers.fields().begin(), headers.fields().end(),
      [&](const header_field &field) noexcept {
        return transform_detail::ascii_equal_ci(field.name, name);
      }));
}

template <class Predicate>
bool all_header_values(
    const header_collection &headers, std::string_view name,
    Predicate &predicate) {
  bool found = false;
  for (const auto &field : headers.fields()) {
    if (!transform_detail::ascii_equal_ci(field.name, name))
      continue;
    found = true;
    if (!static_cast<bool>(std::invoke(predicate, field.value)))
      return false;
  }
  return found;
}

