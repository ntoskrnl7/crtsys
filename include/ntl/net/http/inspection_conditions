inline auto response_status_is(unsigned expected) noexcept {
  return [expected](const inspection_context_view &context) noexcept {
    return context.response() && context.response()->status == expected;
  };
}

inline auto response_status_between(unsigned first,
                                    unsigned last) {
  if (first > last || first < 100 || last > 999)
    throw std::invalid_argument("invalid HTTP response status range");
  return [first, last](const inspection_context_view &context) noexcept {
    return context.response() && context.response()->status >= first &&
           context.response()->status <= last;
  };
}

