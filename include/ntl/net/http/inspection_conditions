/** Applies an arbitrary predicate to current-message trailer fields. */
template <class Predicate>
auto any_trailer(Predicate &&predicate) {
  return [condition =
              std::decay_t<Predicate>(std::forward<Predicate>(predicate))](
             const inspection_context_view &context) {
    return std::any_of(
        context.trailers().begin(), context.trailers().end(),
        [&](const header_field &field) {
          return static_cast<bool>(std::invoke(condition, field));
        });
  };
}

inline auto trailer_present(std::string name) {
  return any_trailer(
      [name = std::move(name)](const header_field &field) noexcept {
        return transform_detail::ascii_equal_ci(field.name, name);
      });
}

inline auto trailer_is(std::string name, std::string expected) {
  return any_trailer(
      [name = std::move(name), expected = std::move(expected)](
          const header_field &field) noexcept {
        return transform_detail::ascii_equal_ci(field.name, name) &&
               field.value == expected;
      });
}

