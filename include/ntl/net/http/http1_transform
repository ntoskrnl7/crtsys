namespace ntl::net::http {

/** Transport facts required to interpret an HTTP/1 origin-form target. */
struct http1_request_target_context {
  std::string origin_scheme;

  bool valid() const noexcept {
    return transform_detail::is_scheme(origin_scheme);
  }
};

template <class Message>
struct http1_parsed_message {
  explicit http1_parsed_message(
      message_memory_ref memory = {})
      : message(memory), encoded_body(memory.resource),
        original_content_encoding(memory.resource),
        websocket_extensions(memory.resource) {}

  Message message;
  message_body encoded_body;
  message_string original_content_encoding;
  bool chunked = false;
  bool absolute_form = false;
  bool websocket_upgrade = false;
  message_string websocket_extensions;
};

using http1_parsed_request =
    http1_parsed_message<request_message>;
using http1_parsed_response =
    http1_parsed_message<response_message>;

struct http1_transformed_request {
  explicit http1_transformed_request(
      message_memory_ref memory = {})
      : message(memory), wire(memory.resource),
        websocket_extensions(memory.resource) {}

  request_message message;
  pipeline_outcome outcome;
  message_body wire;
  bool absolute_form = false;
  bool websocket_upgrade = false;
  message_string websocket_extensions;
};

struct http1_transformed_response {
  explicit http1_transformed_response(
      message_memory_ref memory = {})
      : message(memory), wire(memory.resource),
        websocket_extensions(memory.resource) {}

  response_message message;
  pipeline_outcome outcome;
  message_body wire;
  bool websocket_upgrade = false;
  message_string websocket_extensions;
};

namespace http1_transform_detail {

inline std::string_view trim_ows(
    std::string_view value) noexcept {
  while (!value.empty() &&
         (value.front() == ' ' || value.front() == '\t'))
    value.remove_prefix(1);
  while (!value.empty() &&
         (value.back() == ' ' || value.back() == '\t'))
    value.remove_suffix(1);
  return value;
}

inline bool contains_token_ci(
    std::string_view value, std::string_view token) noexcept {
  std::size_t position = 0;
  while (position <= value.size()) {
    const std::size_t comma = value.find(',', position);
    const std::size_t end =
        comma == std::string_view::npos ? value.size() : comma;
    if (transform_detail::ascii_equal_ci(
            trim_ows(value.substr(position, end - position)),
            token))
      return true;
    if (comma == std::string_view::npos)
      break;
    position = comma + 1;
  }
  return false;
}

struct wire_parts {
  explicit wire_parts(message_memory_ref memory = {})
      : headers(memory.resource), trailers(memory.resource) {}

  std::string_view start_line;
  header_list headers;
  std::span<const std::byte> body_wire;
  header_list trailers;
  bool chunked = false;
  bool has_transfer_encoding = false;
  bool has_content_length = false;
  std::size_t content_length = 0;
};

struct parsed_request_head {
  explicit parsed_request_head(message_memory_ref memory = {})
      : message(memory) {}

  request_message message;
  bool absolute_form = false;
};

/** Shared request-target parser for complete and streaming HTTP/1 adapters. */
template <class Parts>
ntl::result<parsed_request_head> parse_request_head(
    Parts &&parts, http1_request_target_context target_context,
    const transform_limits &limits, message_memory_ref memory = {}) noexcept {
  if (!target_context.valid())
    return ntl::unexpected(STATUS_INVALID_PARAMETER);
  try {
    const std::size_t first_space = parts.start_line.find(' ');
    const std::size_t last_space = parts.start_line.rfind(' ');
    if (first_space == std::string_view::npos || last_space == first_space ||
        parts.start_line.substr(last_space + 1) != "HTTP/1.1")
      return ntl::unexpected(STATUS_DATA_ERROR);

    if (!memory.valid())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    parsed_request_head result(memory);
    auto &message = result.message;
    message.wire_protocol = protocol::http1;
    message.method.assign(parts.start_line.substr(0, first_space));
    if (!transform_detail::is_token(message.method))
      return ntl::unexpected(STATUS_DATA_ERROR);
    const std::string_view request_target = parts.start_line.substr(
        first_space + 1, last_space - first_space - 1);
    if (!transform_detail::valid_uri_component(request_target) ||
        request_target.find('#') != std::string_view::npos)
      return ntl::unexpected(STATUS_DATA_ERROR);

    std::string_view host;
    std::size_t host_count = 0;
    for (const auto &field : parts.headers) {
      if (field.name != "host")
        continue;
      host = field.value;
      ++host_count;
    }
    if (host_count != 1 || !transform_detail::valid_uri_component(host))
      return ntl::unexpected(STATUS_DATA_ERROR);

    if (message.method == "CONNECT") {
      if (!transform_detail::ascii_equal_ci(host, request_target) ||
          request_target.find_first_of("/?") != std::string_view::npos)
        return ntl::unexpected(STATUS_DATA_ERROR);
      message.authority.assign(request_target);
      message.scheme.clear();
      message.path.clear();
    } else if (const std::size_t scheme_end = request_target.find("://");
               scheme_end != std::string_view::npos) {
      const std::string_view target_scheme = request_target.substr(0, scheme_end);
      if (!transform_detail::is_scheme(target_scheme) ||
          !transform_detail::ascii_equal_ci(
              target_scheme, target_context.origin_scheme))
        return ntl::unexpected(STATUS_DATA_ERROR);
      const std::size_t authority_start = scheme_end + 3;
      const std::size_t authority_end =
          request_target.find_first_of("/?", authority_start);
      const std::string_view authority = request_target.substr(
          authority_start,
          authority_end == std::string_view::npos
              ? std::string_view::npos
              : authority_end - authority_start);
      if (!transform_detail::valid_uri_component(authority) ||
          !transform_detail::ascii_equal_ci(host, authority))
        return ntl::unexpected(STATUS_DATA_ERROR);
      message.scheme =
          transform_detail::normalized_name(std::string(target_scheme));
      message.authority.assign(authority);
      if (authority_end == std::string_view::npos) {
        message.path = "/";
      } else if (request_target[authority_end] == '?') {
        message.path = "/";
        message.path.append(request_target.substr(authority_end));
      } else {
        message.path.assign(request_target.substr(authority_end));
      }
      result.absolute_form = true;
    } else {
      if (!(request_target.starts_with('/') ||
            (message.method == "OPTIONS" && request_target == "*")))
        return ntl::unexpected(STATUS_DATA_ERROR);
      message.scheme = transform_detail::normalized_name(
          std::string(target_context.origin_scheme));
      message.authority.assign(host);
      message.path.assign(request_target);
    }

    message.headers = header_collection(
        std::forward<Parts>(parts).headers);
    const ntl::status valid = message.headers.validate(protocol::http1, limits);
    if (!valid.is_ok())
      return ntl::unexpected(valid);
    return ntl::ok(std::move(result));
  } catch (const std::invalid_argument &) {
    return ntl::unexpected(STATUS_DATA_ERROR);
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

/** Parses one complete HTTP/1 head without requiring its body bytes. */
inline ntl::result<wire_parts>
parse_head(std::span<const std::byte> wire,
           const transform_limits &limits,
           message_memory_ref memory = {}) noexcept {
  try {
    if (!memory.valid())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (wire.empty() || wire.size() > limits.maximum_header_bytes)
      return ntl::unexpected(
          wire.empty() ? STATUS_INVALID_PARAMETER : STATUS_BUFFER_OVERFLOW);
    const std::string_view text(
        reinterpret_cast<const char *>(wire.data()), wire.size());
    const std::size_t first_line_end = text.find("\r\n");
    const std::size_t header_end = text.find("\r\n\r\n");
    if (first_line_end == std::string_view::npos ||
        header_end == std::string_view::npos ||
        first_line_end > header_end || header_end + 4 != wire.size())
      return ntl::unexpected(STATUS_DATA_ERROR);

    wire_parts result(memory);
    result.start_line = text.substr(0, first_line_end);
    std::size_t position = first_line_end + 2;
    std::size_t header_bytes = 0;
    while (position < header_end) {
      const std::size_t line_end = text.find("\r\n", position);
      const std::size_t colon = text.find(':', position);
      if (line_end == std::string_view::npos || line_end > header_end ||
          colon == std::string_view::npos || colon >= line_end)
        return ntl::unexpected(STATUS_DATA_ERROR);
      message_string name(
          text.substr(position, colon - position), memory.resource);
      message_string value(
          trim_ows(text.substr(colon + 1, line_end - colon - 1)),
          memory.resource);
      name = transform_detail::normalized_name(std::move(name));
      if (!transform_detail::is_token(name) ||
          !transform_detail::valid_field_value(value) ||
          name.size() > limits.maximum_header_bytes - header_bytes ||
          value.size() > limits.maximum_header_bytes - header_bytes -
                             name.size())
        return ntl::unexpected(STATUS_DATA_ERROR);
      header_bytes += name.size() + value.size();
      if (name == "transfer-encoding") {
        // This layer implements only the chunked transfer coding.  Accepting
        // a chain such as `gzip, chunked` and removing only chunked would
        // expose transfer-coded bytes as semantic content and could corrupt
        // a transformed message, so unsupported chains fail before policy.
        if (result.has_transfer_encoding ||
            !transform_detail::ascii_equal_ci(trim_ows(value), "chunked"))
          return ntl::unexpected(STATUS_NOT_SUPPORTED);
        result.has_transfer_encoding = true;
        result.chunked = true;
      }
      if (name == "content-length") {
        std::size_t parsed_length = 0;
        const auto parsed = std::from_chars(
            value.data(), value.data() + value.size(), parsed_length);
        if (result.has_content_length || value.empty() ||
            parsed.ec != std::errc{} ||
            parsed.ptr != value.data() + value.size())
          return ntl::unexpected(STATUS_DATA_ERROR);
        result.has_content_length = true;
        result.content_length = parsed_length;
      }
      result.headers.push_back(
          {std::move(name), std::move(value), false});
      if (result.headers.size() > limits.maximum_header_count)
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
      position = line_end + 2;
    }
    if (result.chunked && result.has_content_length)
      return ntl::unexpected(STATUS_DATA_ERROR);
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<message_body>
decode_chunked(
    std::span<const std::byte> encoded,
    header_list &trailers,
    const transform_limits &limits,
    message_memory_ref memory = {}) noexcept {
  try {
    if (!memory.valid())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    const std::string_view text(
        reinterpret_cast<const char *>(encoded.data()),
        encoded.size());
    message_body decoded(memory.resource);
    std::size_t position = 0;
    for (;;) {
      const std::size_t line_end = text.find("\r\n", position);
      if (line_end == std::string_view::npos)
        return ntl::unexpected(STATUS_END_OF_FILE);
      std::string_view size_text =
          text.substr(position, line_end - position);
      const std::size_t extension = size_text.find(';');
      if (extension != std::string_view::npos)
        size_text = size_text.substr(0, extension);
      size_text = trim_ows(size_text);
      std::size_t size = 0;
      const auto parsed = std::from_chars(
          size_text.data(), size_text.data() + size_text.size(),
          size, 16);
      if (size_text.empty() || parsed.ec != std::errc{} ||
          parsed.ptr != size_text.data() + size_text.size())
        return ntl::unexpected(STATUS_DATA_ERROR);
      position = line_end + 2;
      if (size == 0)
        break;
      if (position > encoded.size() ||
          size > encoded.size() - position ||
          size > limits.maximum_encoded_body_bytes -
                     decoded.size() ||
          encoded.size() - position - size < 2 ||
          encoded[position + size] != std::byte{'\r'} ||
          encoded[position + size + 1] != std::byte{'\n'})
        return ntl::unexpected(STATUS_DATA_ERROR);
      decoded.insert(
          decoded.end(), encoded.begin() +
                             static_cast<std::ptrdiff_t>(position),
          encoded.begin() +
              static_cast<std::ptrdiff_t>(position + size));
      position += size + 2;
    }

    for (;;) {
      const std::size_t line_end = text.find("\r\n", position);
      if (line_end == std::string_view::npos)
        return ntl::unexpected(STATUS_END_OF_FILE);
      if (line_end == position) {
        position += 2;
        break;
      }
      const std::size_t colon = text.find(':', position);
      if (colon == std::string_view::npos || colon >= line_end)
        return ntl::unexpected(STATUS_DATA_ERROR);
      message_string name(
          text.substr(position, colon - position), memory.resource);
      message_string value(
          trim_ows(text.substr(colon + 1, line_end - colon - 1)),
          memory.resource);
      name = transform_detail::normalized_name(std::move(name));
      if (!transform_detail::is_token(name) ||
          !transform_detail::valid_field_value(value))
        return ntl::unexpected(STATUS_DATA_ERROR);
      trailers.push_back(
          {std::move(name), std::move(value), false});
      if (trailers.size() > limits.maximum_header_count)
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
      position = line_end + 2;
    }
    if (position != encoded.size())
      return ntl::unexpected(STATUS_DATA_ERROR);
    const ntl::status valid = ntl::net::http::validate_trailers(
        trailers, protocol::http1, limits);
    if (!valid.is_ok())
      return ntl::unexpected(valid);
    return ntl::ok(std::move(decoded));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<wire_parts>
parse_wire(std::span<const std::byte> wire,
           const transform_limits &limits,
           bool body_forbidden = false,
           message_memory_ref memory = {}) noexcept {
  try {
    if (!memory.valid())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (wire.empty() ||
        wire.size() >
            limits.maximum_header_bytes +
                limits.maximum_encoded_body_bytes +
                256 * 1024)
      return ntl::unexpected(
          wire.empty() ? STATUS_INVALID_PARAMETER
                       : STATUS_BUFFER_OVERFLOW);
    const std::string_view text(
        reinterpret_cast<const char *>(wire.data()), wire.size());
    const std::size_t first_line_end = text.find("\r\n");
    const std::size_t header_end = text.find("\r\n\r\n");
    if (first_line_end == std::string_view::npos ||
        header_end == std::string_view::npos ||
        first_line_end > header_end ||
        header_end + 4 > limits.maximum_header_bytes)
      return ntl::unexpected(STATUS_DATA_ERROR);

    wire_parts result(memory);
    result.start_line = text.substr(0, first_line_end);
    std::size_t position = first_line_end + 2;
    std::size_t header_bytes = 0;
    bool content_length_seen = false;
    std::size_t content_length = 0;
    while (position < header_end) {
      const std::size_t line_end = text.find("\r\n", position);
      const std::size_t colon = text.find(':', position);
      if (line_end == std::string_view::npos ||
          line_end > header_end ||
          colon == std::string_view::npos || colon >= line_end)
        return ntl::unexpected(STATUS_DATA_ERROR);
      message_string name(
          text.substr(position, colon - position), memory.resource);
      message_string value(
          trim_ows(text.substr(colon + 1, line_end - colon - 1)),
          memory.resource);
      name = transform_detail::normalized_name(std::move(name));
      if (!transform_detail::is_token(name) ||
          !transform_detail::valid_field_value(value) ||
          name.size() >
              limits.maximum_header_bytes - header_bytes ||
          value.size() >
              limits.maximum_header_bytes - header_bytes -
                  name.size())
        return ntl::unexpected(STATUS_DATA_ERROR);
      header_bytes += name.size() + value.size();
      if (name == "transfer-encoding") {
        if (result.has_transfer_encoding ||
            !transform_detail::ascii_equal_ci(trim_ows(value), "chunked"))
          return ntl::unexpected(STATUS_NOT_SUPPORTED);
        result.has_transfer_encoding = true;
        result.chunked = true;
      }
      if (name == "content-length") {
        std::size_t parsed_length = 0;
        const auto parsed = std::from_chars(
            value.data(), value.data() + value.size(),
            parsed_length);
        if (content_length_seen || value.empty() ||
            parsed.ec != std::errc{} ||
            parsed.ptr != value.data() + value.size())
          return ntl::unexpected(STATUS_DATA_ERROR);
        content_length_seen = true;
        content_length = parsed_length;
      }
      result.headers.push_back(
          {std::move(name), std::move(value), false});
      if (result.headers.size() >
          limits.maximum_header_count)
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
      position = line_end + 2;
    }
    if (result.chunked && content_length_seen)
      return ntl::unexpected(STATUS_DATA_ERROR);

    const auto body_wire = wire.subspan(header_end + 4);
    if (body_forbidden &&
        (result.chunked || !body_wire.empty()))
      return ntl::unexpected(STATUS_DATA_ERROR);
    if (!body_forbidden && !result.chunked &&
        content_length_seen &&
        content_length != body_wire.size())
      return ntl::unexpected(STATUS_DATA_ERROR);
    result.body_wire = body_wire;
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<message_body>
transfer_decode_body(
    wire_parts &parts,
    const transform_limits &limits,
    message_memory_ref memory = {}) noexcept {
  if (!parts.chunked) {
    try {
      if (!memory.valid())
        return ntl::unexpected(STATUS_INVALID_PARAMETER);
      return ntl::ok(message_body(
          parts.body_wire.begin(), parts.body_wire.end(), memory.resource));
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }
  return decode_chunked(
      parts.body_wire, parts.trailers, limits, memory);
}

inline std::string reason_phrase(unsigned status) {
  switch (status) {
  case 100:
    return "Continue";
  case 101:
    return "Switching Protocols";
  case 200:
    return "OK";
  case 201:
    return "Created";
  case 204:
    return "No Content";
  case 301:
    return "Moved Permanently";
  case 302:
    return "Found";
  case 304:
    return "Not Modified";
  case 400:
    return "Bad Request";
  case 403:
    return "Forbidden";
  case 404:
    return "Not Found";
  case 421:
    return "Misdirected Request";
  case 500:
    return "Internal Server Error";
  case 502:
    return "Bad Gateway";
  default:
    return "Status";
  }
}

inline bool bodyless_response_status(
    std::span<const std::byte> wire) noexcept {
  const std::string_view text(
      reinterpret_cast<const char *>(wire.data()), wire.size());
  if (text.size() < 12 || !text.starts_with("HTTP/1.") ||
      text[8] != ' ')
    return false;
  unsigned status = 0;
  const auto parsed = std::from_chars(
      text.data() + 9, text.data() + 12, status);
  return parsed.ec == std::errc{} &&
         parsed.ptr == text.data() + 12 &&
         ((status >= 100 && status < 200) ||
          status == 204 || status == 304);
}

inline bool successful_connect_response_status(
    std::span<const std::byte> wire) noexcept {
  const std::string_view text(
      reinterpret_cast<const char *>(wire.data()), wire.size());
  if (text.size() < 12 || !text.starts_with("HTTP/1.") ||
      text[8] != ' ')
    return false;
  unsigned status = 0;
  const auto parsed = std::from_chars(
      text.data() + 9, text.data() + 12, status);
  return parsed.ec == std::errc{} &&
         parsed.ptr == text.data() + 12 &&
         status >= 200 && status < 300;
}

inline ntl::status validate_trailers(
    std::span<const header_field> trailers,
    const transform_limits &limits) noexcept {
  return ntl::net::http::validate_trailers(
      trailers, protocol::http1, limits);
}

inline ntl::result<message_body>
serialize(
    message_string start_line,
    header_collection headers,
    std::span<const std::byte> body,
    std::span<const header_field> trailers,
    const transform_limits &limits,
    bool body_forbidden = false,
    bool preserve_content_length = false,
    message_memory_ref memory = {}) noexcept {
  try {
    const ntl::status valid =
        headers.validate(protocol::http1, limits);
    const ntl::status valid_trailers =
        validate_trailers(trailers, limits);
    if (!valid.is_ok())
      return ntl::unexpected(valid);
    if (!valid_trailers.is_ok())
      return ntl::unexpected(valid_trailers);
    if (body.size() > limits.maximum_encoded_body_bytes)
      return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
    if (body_forbidden &&
        (!body.empty() || !trailers.empty()))
      return ntl::unexpected(STATUS_DATA_ERROR);
    if (start_line.empty() ||
        limits.maximum_header_bytes < 2 ||
        start_line.size() >
            limits.maximum_header_bytes - 2)
      return ntl::unexpected(
          start_line.empty() ? STATUS_DATA_ERROR
                             : STATUS_BUFFER_OVERFLOW);
    for (const unsigned char character : start_line) {
      if (character == 0x7f || character < 0x20)
        return ntl::unexpected(STATUS_DATA_ERROR);
    }

    const bool chunked = !body_forbidden && !trailers.empty();
    headers.erase("transfer-encoding");
    if (!body_forbidden || !preserve_content_length)
      headers.erase("content-length");
    if (body_forbidden) {
      // HEAD and 304 may retain representation metadata, but no body bytes.
    } else if (chunked) {
      headers.append("transfer-encoding", "chunked");
    } else {
      headers.append(
          "content-length", std::to_string(body.size()));
    }

    message_string head(std::move(start_line), memory.resource);
    head.append("\r\n");
    for (const auto &field : headers.fields()) {
      head.append(field.name);
      head.append(": ");
      head.append(field.value);
      head.append("\r\n");
    }
    head.append("\r\n");

    message_body output(memory.resource);
    output.reserve(
        head.size() + body.size() +
        (chunked ? limits.maximum_header_bytes : 0));
    output.insert(
        output.end(),
        reinterpret_cast<const std::byte *>(head.data()),
        reinterpret_cast<const std::byte *>(
            head.data() + head.size()));
    if (!chunked) {
      output.insert(output.end(), body.begin(), body.end());
      return ntl::ok(std::move(output));
    }

    if (!body.empty()) {
      char size_text[
          sizeof(std::size_t) * 2 + 1]{};
      const auto converted = std::to_chars(
          size_text, size_text + sizeof(size_text) - 1,
          body.size(), 16);
      output.insert(
          output.end(),
          reinterpret_cast<const std::byte *>(size_text),
          reinterpret_cast<const std::byte *>(converted.ptr));
      output.push_back(std::byte{'\r'});
      output.push_back(std::byte{'\n'});
      output.insert(output.end(), body.begin(), body.end());
      output.push_back(std::byte{'\r'});
      output.push_back(std::byte{'\n'});
    }
    output.push_back(std::byte{'0'});
    output.push_back(std::byte{'\r'});
    output.push_back(std::byte{'\n'});
    for (const auto &field : trailers) {
      output.insert(
          output.end(),
          reinterpret_cast<const std::byte *>(field.name.data()),
          reinterpret_cast<const std::byte *>(
              field.name.data() + field.name.size()));
      output.push_back(std::byte{':'});
      output.push_back(std::byte{' '});
      output.insert(
          output.end(),
          reinterpret_cast<const std::byte *>(field.value.data()),
          reinterpret_cast<const std::byte *>(
              field.value.data() + field.value.size()));
      output.push_back(std::byte{'\r'});
      output.push_back(std::byte{'\n'});
    }
    output.push_back(std::byte{'\r'});
    output.push_back(std::byte{'\n'});
    return ntl::ok(std::move(output));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline bool websocket_upgrade(
    unsigned status, const header_collection &headers) noexcept {
  const auto connection = headers.first("connection");
  const auto upgrade = headers.first("upgrade");
  return status == 101 && connection && upgrade &&
         contains_token_ci(*connection, "upgrade") &&
         transform_detail::ascii_equal_ci(*upgrade, "websocket");
}

} // namespace http1_transform_detail

inline ntl::result<http1_parsed_request>
parse_http1_request(
    std::span<const std::byte> wire,
    const ntl::net::inspection::content_decoder_registry
        &decoders,
    http1_request_target_context target_context,
    const transform_limits &limits = {},
    message_memory_ref memory = {}) noexcept {
  if (!target_context.valid() || !memory.valid())
    return ntl::unexpected(STATUS_INVALID_PARAMETER);
  auto parts =
      http1_transform_detail::parse_wire(wire, limits, false, memory);
  if (!parts)
    return ntl::unexpected(parts.status());
  try {
    auto parsed_head = http1_transform_detail::parse_request_head(
        std::move(*parts), target_context, limits, memory);
    if (!parsed_head)
      return ntl::unexpected(parsed_head.status());
    request_message message = std::move(parsed_head->message);

    auto transfer_body =
        http1_transform_detail::transfer_decode_body(
            *parts, limits, memory);
    if (!transfer_body)
      return ntl::unexpected(transfer_body.status());
    auto decoded = decode_body(
        message.headers, *transfer_body, decoders, limits);
    if (!decoded)
      return ntl::unexpected(decoded.status());
    message.body = decoded->bytes;
    message.trailers = std::move(parts->trailers);

    http1_parsed_request result(memory);
    result.message = std::move(message);
    result.encoded_body = std::move(*transfer_body);
    result.original_content_encoding =
        std::move(decoded->original_content_encoding);
    result.chunked = parts->chunked;
    result.absolute_form = parsed_head->absolute_form;
    const auto connection =
        result.message.headers.first("connection");
    const auto upgrade =
        result.message.headers.first("upgrade");
    result.websocket_upgrade =
        connection && upgrade &&
        http1_transform_detail::contains_token_ci(
            *connection, "upgrade") &&
        transform_detail::ascii_equal_ci(
            *upgrade, "websocket");
    if (const auto extensions = result.message.headers.first(
            "sec-websocket-extensions"))
      result.websocket_extensions.assign(*extensions);
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<http1_parsed_response>
parse_http1_response(
    std::span<const std::byte> wire,
    const ntl::net::inspection::content_decoder_registry
        &decoders,
    const transform_limits &limits = {},
    bool response_to_head = false,
    bool response_to_connect = false,
    message_memory_ref memory = {}) noexcept {
  if (!memory.valid())
    return ntl::unexpected(STATUS_INVALID_PARAMETER);
  const bool body_forbidden =
      response_to_head ||
      http1_transform_detail::bodyless_response_status(wire) ||
      (response_to_connect &&
       http1_transform_detail::successful_connect_response_status(wire));
  auto parts =
      http1_transform_detail::parse_wire(
          wire, limits, body_forbidden, memory);
  if (!parts)
    return ntl::unexpected(parts.status());
  try {
    if (!parts->start_line.starts_with("HTTP/1.") ||
        parts->start_line.size() < 12 ||
        parts->start_line[8] != ' ')
      return ntl::unexpected(STATUS_DATA_ERROR);
    const std::size_t status_end =
        parts->start_line.find(' ', 9);
    const std::string_view status_text =
        parts->start_line.substr(
            9, status_end == std::string_view::npos
                   ? std::string_view::npos
                   : status_end - 9);
    unsigned status = 0;
    const auto parsed = std::from_chars(
        status_text.data(),
        status_text.data() + status_text.size(), status);
    if (status_text.size() != 3 || parsed.ec != std::errc{} ||
        parsed.ptr != status_text.data() + status_text.size() ||
        status < 100 || status > 999)
      return ntl::unexpected(STATUS_DATA_ERROR);

    response_message message(memory);
    message.wire_protocol = protocol::http1;
    message.status = status;
    if (status_end != std::string_view::npos)
      message.reason.assign(
          parts->start_line.substr(status_end + 1));
    message.headers =
        header_collection(std::move(parts->headers));
    auto transfer_body =
        http1_transform_detail::transfer_decode_body(
            *parts, limits, memory);
    if (!transfer_body)
      return ntl::unexpected(transfer_body.status());
    decoded_body decoded;
    if (body_forbidden) {
      decoded.original_content_encoding =
          message.headers.joined("content-encoding");
    } else {
      auto result = decode_body(
          message.headers, *transfer_body, decoders, limits);
      if (!result)
        return ntl::unexpected(result.status());
      decoded = std::move(*result);
    }
    message.body = decoded.bytes;
    message.trailers = std::move(parts->trailers);

    http1_parsed_response result(memory);
    result.message = std::move(message);
    result.encoded_body = std::move(*transfer_body);
    result.original_content_encoding =
        std::move(decoded.original_content_encoding);
    result.chunked = parts->chunked;
    result.websocket_upgrade =
        http1_transform_detail::websocket_upgrade(
            result.message.status, result.message.headers);
    if (const auto extensions = result.message.headers.first(
            "sec-websocket-extensions"))
      result.websocket_extensions.assign(*extensions);
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<message_body>
serialize_http1_request(
    const request_message &message,
    std::span<const std::byte> encoded_body,
    const transform_limits &limits = {},
    message_memory_ref memory = {}) noexcept {
  try {
    const bool connect = message.method == "CONNECT";
    if (!transform_detail::is_token(message.method) ||
        !transform_detail::valid_uri_component(
            message.authority) ||
        (!connect &&
         !transform_detail::valid_uri_component(message.path)) ||
        (connect &&
         (!message.scheme.empty() || !message.path.empty())) ||
        message.extended_protocol)
      return ntl::unexpected(STATUS_DATA_ERROR);
    header_collection headers(message.headers, memory.resource);
    headers.set("host", message.authority);
    const std::string_view target =
        connect ? std::string_view(message.authority)
                : std::string_view(message.path);
    message_string start_line(memory.resource);
    start_line.reserve(
        message.method.size() + target.size() + 11);
    start_line.append(message.method);
    start_line.push_back(' ');
    start_line.append(target);
    start_line.append(" HTTP/1.1");
    return http1_transform_detail::serialize(
        std::move(start_line),
        std::move(headers), encoded_body,
        message.trailers, limits, false, false, memory);
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<message_body>
serialize_http1_response(
    const response_message &message,
    std::span<const std::byte> encoded_body,
    const transform_limits &limits = {},
    bool response_to_head = false,
    bool response_to_connect = false,
    message_memory_ref memory = {}) noexcept {
  try {
    if (message.status < 100 || message.status > 999 ||
        !transform_detail::valid_field_value(message.reason))
      return ntl::unexpected(STATUS_DATA_ERROR);
    const std::string reason_text = message.reason.empty()
                                        ? http1_transform_detail::reason_phrase(
                                              message.status)
                                        : std::string(message.reason.begin(),
                                                      message.reason.end());
    const bool body_forbidden =
        response_to_head ||
        (message.status >= 100 && message.status < 200) ||
        message.status == 204 || message.status == 304 ||
        (response_to_connect && message.status >= 200 &&
         message.status < 300);
    const bool preserve_content_length =
        response_to_head || message.status == 304;
    message_string start_line(memory.resource);
    start_line.append("HTTP/1.1 ");
    start_line.append(std::to_string(message.status));
    start_line.push_back(' ');
    start_line.append(reason_text);
    return http1_transform_detail::serialize(
        std::move(start_line),
        header_collection(message.headers, memory.resource), encoded_body,
        message.trailers, limits, body_forbidden,
        preserve_content_length, memory);
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<http1_transformed_request>
transform_http1_request(
    std::span<const std::byte> original_wire,
    const transform_pipeline &pipeline,
    const ntl::net::inspection::content_decoder_registry
        &decoders,
    const ntl::net::inspection::content_encoder_registry
        &encoders,
    http1_request_target_context target_context,
    message_memory_ref memory = {}) noexcept {
  auto parsed = parse_http1_request(
      original_wire, decoders, target_context, pipeline.limits_ref(), memory);
  if (!parsed)
    return ntl::unexpected(parsed.status());
  http1_transformed_request result(memory);
  result.message = std::move(parsed->message);
  result.websocket_upgrade = parsed->websocket_upgrade;
  result.websocket_extensions =
      std::move(parsed->websocket_extensions);
  result.absolute_form = parsed->absolute_form;
  result.outcome = pipeline.apply(result.message);
  if (result.outcome.action != rewrite_action::forward)
    return ntl::ok(std::move(result));
  if (!result.outcome.modified() && !result.absolute_form) {
    try {
      result.wire.assign(
          original_wire.begin(), original_wire.end());
      return ntl::ok(std::move(result));
    } catch (...) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
  }

  std::vector<std::byte> encoded_body;
  if (result.outcome.body_modified) {
    auto encoded = encode_body(
        result.message.headers, result.message.body,
        parsed->original_content_encoding,
        result.outcome.body_coding, encoders,
        pipeline.limits_ref());
    if (!encoded)
      return ntl::unexpected(encoded.status());
    encoded_body = std::move(*encoded);
  } else {
    encoded_body.assign(
        std::make_move_iterator(parsed->encoded_body.begin()),
        std::make_move_iterator(parsed->encoded_body.end()));
  }
  auto wire = serialize_http1_request(
      result.message, encoded_body, pipeline.limits_ref(), memory);
  if (!wire)
    return ntl::unexpected(wire.status());
  result.wire = std::move(*wire);
  return ntl::ok(std::move(result));
}

inline ntl::result<http1_transformed_response>
transform_http1_response(
    std::span<const std::byte> original_wire,
    const request_message &request,
    const transform_pipeline &pipeline,
    const ntl::net::inspection::content_decoder_registry
        &decoders,
    const ntl::net::inspection::content_encoder_registry
        &encoders,
    message_memory_ref memory = {}) noexcept {
  auto parsed = parse_http1_response(
      original_wire, decoders, pipeline.limits_ref(),
      transform_detail::ascii_equal_ci(request.method, "HEAD"),
      transform_detail::ascii_equal_ci(request.method, "CONNECT"),
      memory);
  if (!parsed)
    return ntl::unexpected(parsed.status());
  http1_transformed_response result(memory);
  result.message = std::move(parsed->message);
  result.websocket_upgrade = parsed->websocket_upgrade;
  result.websocket_extensions =
      std::move(parsed->websocket_extensions);
  result.outcome = pipeline.apply(request, result.message);
  if (result.outcome.action != rewrite_action::forward)
    return ntl::ok(std::move(result));
  if (!result.outcome.modified()) {
    try {
      result.wire.assign(
          original_wire.begin(), original_wire.end());
      return ntl::ok(std::move(result));
    } catch (...) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
  }

  std::vector<std::byte> encoded_body;
  if (result.outcome.body_modified) {
    auto encoded = encode_body(
        result.message.headers, result.message.body,
        parsed->original_content_encoding,
        result.outcome.body_coding, encoders,
        pipeline.limits_ref());
    if (!encoded)
      return ntl::unexpected(encoded.status());
    encoded_body = std::move(*encoded);
  } else {
    encoded_body.assign(
        std::make_move_iterator(parsed->encoded_body.begin()),
        std::make_move_iterator(parsed->encoded_body.end()));
  }
  auto wire = serialize_http1_response(
      result.message, encoded_body, pipeline.limits_ref(),
      transform_detail::ascii_equal_ci(request.method, "HEAD"),
      transform_detail::ascii_equal_ci(request.method, "CONNECT"), memory);
  if (!wire)
    return ntl::unexpected(wire.status());
  result.wire = std::move(*wire);
  return ntl::ok(std::move(result));
}

