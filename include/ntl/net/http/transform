namespace ntl::net::http {

enum class protocol : std::uint8_t {
  http1 = 1,
  http2 = 2,
  http3 = 3,
};

enum class transform_failure_policy : std::uint8_t {
  block = 1,
  forward_original = 2,
};

enum class transformed_body_coding : std::uint8_t {
  identity = 1,
  preserve = 2,
};

struct transform_limits {
  std::size_t maximum_header_count = 256;
  std::size_t maximum_header_bytes = 64 * 1024;
  std::size_t maximum_encoded_body_bytes = 4 * 1024 * 1024;
  std::size_t maximum_decoded_body_bytes = 16 * 1024 * 1024;
  std::size_t maximum_expansion_ratio = 64;
  std::size_t maximum_coding_layers = 4;
  transform_failure_policy on_failure =
      transform_failure_policy::block;
};

using message_string = std::pmr::string;

template <class Value>
class message_vector
    : public std::vector<Value, std::pmr::polymorphic_allocator<Value>> {
  using base =
      std::vector<Value, std::pmr::polymorphic_allocator<Value>>;

public:
  using base::base;
  using base::operator=;

  message_vector() = default;
  message_vector(const message_vector &) = default;
  message_vector(message_vector &&) noexcept = default;
  message_vector &operator=(const message_vector &) = default;
  message_vector &operator=(message_vector &&) noexcept = default;

  template <class Allocator>
  message_vector(const std::vector<Value, Allocator> &other,
                 std::pmr::memory_resource *resource =
                     std::pmr::get_default_resource())
      : base(other.begin(), other.end(), resource) {}

  template <class Allocator>
  message_vector(std::vector<Value, Allocator> &&other,
                 std::pmr::memory_resource *resource =
                     std::pmr::get_default_resource())
      : base(std::make_move_iterator(other.begin()),
             std::make_move_iterator(other.end()), resource) {}

  template <class Allocator>
  message_vector &operator=(const std::vector<Value, Allocator> &other) {
    this->assign(other.begin(), other.end());
    return *this;
  }

  template <class Allocator>
  message_vector &operator=(std::vector<Value, Allocator> &&other) {
    this->assign(std::make_move_iterator(other.begin()),
                 std::make_move_iterator(other.end()));
    return *this;
  }
};

/**
 * @brief Explicit borrowed allocator binding for one semantic HTTP message.
 *
 * User-mode callers normally use the default constructor, whose process-wide
 * PMR resource has static lifetime. Kernel hot paths pass this explicitly
 * named reference to a leased fixed or byte-budgeted resource. The referenced
 * resource must outlive only messages constructed with this binding.
 */
struct message_memory_ref {
  std::pmr::memory_resource *resource =
      std::pmr::get_default_resource();

  bool valid() const noexcept { return resource != nullptr; }
};

template <class Traits, class Allocator>
  requires(!std::is_same_v<
           Allocator, std::pmr::polymorphic_allocator<char>>)
bool operator==(const message_string &left,
                const std::basic_string<char, Traits, Allocator> &right) {
  return std::string_view(left.data(), left.size()) ==
         std::string_view(right.data(), right.size());
}

template <class Traits, class Allocator>
  requires(!std::is_same_v<
           Allocator, std::pmr::polymorphic_allocator<char>>)
bool operator==(const std::basic_string<char, Traits, Allocator> &left,
                const message_string &right) {
  return right == left;
}

template <class Value, class Allocator>
  requires(!std::is_same_v<
           Allocator, std::pmr::polymorphic_allocator<Value>>)
bool operator==(const message_vector<Value> &left,
                const std::vector<Value, Allocator> &right) {
  return std::equal(left.begin(), left.end(), right.begin(), right.end());
}

template <class Value, class Allocator>
  requires(!std::is_same_v<
           Allocator, std::pmr::polymorphic_allocator<Value>>)
bool operator==(const std::vector<Value, Allocator> &left,
                const message_vector<Value> &right) {
  return right == left;
}

using message_body = message_vector<std::byte>;

struct header_field {
  using allocator_type = std::pmr::polymorphic_allocator<std::byte>;

  header_field() : header_field(allocator_type{}) {}
  explicit header_field(allocator_type allocator)
      : name(allocator.resource()), value(allocator.resource()) {}
  header_field(std::string_view field_name, std::string_view field_value,
               bool field_sensitive = false,
               allocator_type allocator = {})
      : name(field_name, allocator.resource()),
        value(field_value, allocator.resource()),
        sensitive(field_sensitive) {}
  header_field(std::allocator_arg_t, allocator_type allocator)
      : header_field(allocator) {}
  header_field(std::allocator_arg_t, allocator_type allocator,
               std::string_view field_name,
               std::string_view field_value,
               bool field_sensitive = false)
      : header_field(field_name, field_value, field_sensitive, allocator) {}
  header_field(const header_field &other)
      : header_field(other, allocator_type{other.resource()}) {}
  header_field(const header_field &other, allocator_type allocator)
      : name(other.name, allocator.resource()),
        value(other.value, allocator.resource()),
        sensitive(other.sensitive) {}
  header_field(std::allocator_arg_t, allocator_type allocator,
               const header_field &other)
      : header_field(other, allocator) {}
  header_field(header_field &&) noexcept = default;
  header_field(header_field &&other, allocator_type allocator)
      : name(std::move(other.name), allocator.resource()),
        value(std::move(other.value), allocator.resource()),
        sensitive(other.sensitive) {}
  header_field(std::allocator_arg_t, allocator_type allocator,
               header_field &&other)
      : header_field(std::move(other), allocator) {}
  header_field &operator=(const header_field &) = default;
  header_field &operator=(header_field &&) noexcept = default;

  std::pmr::memory_resource *resource() const noexcept {
    return name.get_allocator().resource();
  }

  message_string name;
  message_string value;
  bool sensitive = false;
};

using header_list = message_vector<header_field>;

namespace transform_detail {

inline unsigned char ascii_lower(unsigned char value) noexcept {
  return value >= 'A' && value <= 'Z'
             ? static_cast<unsigned char>(value + ('a' - 'A'))
             : value;
}

inline bool ascii_equal_ci(
    std::string_view left, std::string_view right) noexcept {
  if (left.size() != right.size())
    return false;
  for (std::size_t index = 0; index != left.size(); ++index) {
    if (ascii_lower(static_cast<unsigned char>(left[index])) !=
        ascii_lower(static_cast<unsigned char>(right[index])))
      return false;
  }
  return true;
}

inline bool is_token_character(unsigned char character) noexcept {
  return (character >= 'A' && character <= 'Z') ||
         (character >= 'a' && character <= 'z') ||
         (character >= '0' && character <= '9') ||
         std::string_view("!#$%&'*+-.^_`|~").find(
             static_cast<char>(character)) != std::string_view::npos;
}

inline bool is_token(std::string_view value) noexcept {
  if (value.empty())
    return false;
  for (const unsigned char character : value) {
    if (!is_token_character(character))
      return false;
  }
  return true;
}

inline bool is_scheme(std::string_view value) noexcept {
  if (value.empty() ||
      !((value.front() >= 'A' && value.front() <= 'Z') ||
        (value.front() >= 'a' && value.front() <= 'z')))
    return false;
  for (const unsigned char character : value) {
    if (!((character >= 'A' && character <= 'Z') ||
          (character >= 'a' && character <= 'z') ||
          (character >= '0' && character <= '9') ||
          character == '+' || character == '-' ||
          character == '.'))
      return false;
  }
  return true;
}

inline bool valid_field_value(
    std::string_view value) noexcept {
  for (const unsigned char character : value) {
    if (character == '\r' || character == '\n' ||
        character == 0x7f ||
        (character < 0x20 && character != '\t'))
      return false;
  }
  return true;
}

inline bool valid_uri_component(
    std::string_view value) noexcept {
  if (value.empty())
    return false;
  for (const unsigned char character : value) {
    if (character <= 0x20 || character == 0x7f)
      return false;
  }
  return true;
}

inline bool forbidden_h2_h3_header(
    std::string_view name, std::string_view value) noexcept;

inline bool forbidden_trailer(
    std::string_view name, protocol wire_protocol) noexcept {
  if (name == "content-length" ||
      name == "transfer-encoding" || name == "trailer" ||
      name == "host" || name == "connection" ||
      name == "proxy-connection" || name == "keep-alive" ||
      name == "upgrade")
    return true;
  return wire_protocol != protocol::http1 &&
         forbidden_h2_h3_header(name, {});
}

inline bool forbidden_h2_h3_header(
    std::string_view name, std::string_view value) noexcept {
  if (name == "connection" || name == "proxy-connection" ||
      name == "keep-alive" || name == "transfer-encoding" ||
      name == "upgrade")
    return true;
  return name == "te" && !ascii_equal_ci(value, "trailers");
}

template <class String>
inline String normalized_name(String value) {
  for (char &character : value) {
    if (character >= 'A' && character <= 'Z')
      character = static_cast<char>(character + ('a' - 'A'));
  }
  return value;
}

inline bool html_content_type(std::string_view value) noexcept {
  const std::size_t separator = value.find(';');
  value = value.substr(0, separator);
  while (!value.empty() &&
         (value.front() == ' ' || value.front() == '\t'))
    value.remove_prefix(1);
  while (!value.empty() &&
         (value.back() == ' ' || value.back() == '\t'))
    value.remove_suffix(1);
  return ascii_equal_ci(value, "text/html") ||
         ascii_equal_ci(value, "application/xhtml+xml");
}

} // namespace transform_detail

/**
 * @brief Owning, normalized ordinary HTTP header fields.
 *
 * HTTP/2 and HTTP/3 pseudo-fields remain typed members of request_message and
 * response_message and cannot be inserted through this collection.
 */
class header_collection {
public:
  header_collection()
      : header_collection(std::pmr::get_default_resource()) {}
  explicit header_collection(std::pmr::memory_resource *resource)
      : fields_(resource) {}
  explicit header_collection(header_list fields)
      : fields_(std::move(fields)) {
    for (auto &field : fields_)
      field.name =
          transform_detail::normalized_name(std::move(field.name));
  }
  template <class Allocator>
  explicit header_collection(
      std::vector<header_field, Allocator> fields,
      std::pmr::memory_resource *resource =
          std::pmr::get_default_resource())
      : fields_(std::move(fields), resource) {
    for (auto &field : fields_)
      field.name =
          transform_detail::normalized_name(std::move(field.name));
  }
  header_collection(const header_collection &other)
      : header_collection(other, other.resource()) {}
  header_collection(const header_collection &other,
                    std::pmr::memory_resource *resource)
      : fields_(other.fields_.begin(), other.fields_.end(), resource) {}
  header_collection(header_collection &&) noexcept = default;
  header_collection &operator=(const header_collection &) = default;
  header_collection &operator=(header_collection &&) noexcept = default;

  std::pmr::memory_resource *resource() const noexcept {
    return fields_.get_allocator().resource();
  }

  std::span<const header_field> fields() const noexcept {
    return fields_;
  }

  std::size_t size() const noexcept { return fields_.size(); }
  bool empty() const noexcept { return fields_.empty(); }

  std::optional<std::string_view>
  first(std::string_view name) const noexcept {
    for (const auto &field : fields_) {
      if (transform_detail::ascii_equal_ci(field.name, name))
        return field.value;
    }
    return std::nullopt;
  }

  std::string joined(std::string_view name) const {
    std::string result;
    for (const auto &field : fields_) {
      if (!transform_detail::ascii_equal_ci(field.name, name))
        continue;
      if (!result.empty())
        result.append(", ");
      result.append(field.value);
    }
    return result;
  }

  bool contains(std::string_view name) const noexcept {
    return first(name).has_value();
  }

  void append(std::string_view name, std::string_view value,
              bool sensitive = false) {
    message_string normalized(name, resource());
    normalized = transform_detail::normalized_name(std::move(normalized));
    if (!transform_detail::is_token(normalized) ||
        !transform_detail::valid_field_value(value))
      throw std::invalid_argument("invalid HTTP header field");
    fields_.emplace_back(
        std::move(normalized), value, sensitive);
  }

  void set(std::string_view name, std::string_view value,
           bool sensitive = false) {
    message_string normalized(name, resource());
    normalized = transform_detail::normalized_name(std::move(normalized));
    if (!transform_detail::is_token(normalized) ||
        !transform_detail::valid_field_value(value))
      throw std::invalid_argument("invalid HTTP header field");
    erase(normalized);
    fields_.emplace_back(
        std::move(normalized), value, sensitive);
  }

  std::size_t erase(std::string_view name) noexcept {
    const auto original = fields_.size();
    fields_.erase(
        std::remove_if(
            fields_.begin(), fields_.end(),
            [&](const header_field &field) noexcept {
              return transform_detail::ascii_equal_ci(
                  field.name, name);
            }),
        fields_.end());
    return original - fields_.size();
  }

  ntl::status validate(protocol wire_protocol,
                       const transform_limits &limits) const noexcept {
    if (limits.maximum_header_count == 0 ||
        limits.maximum_header_bytes == 0 ||
        fields_.size() > limits.maximum_header_count)
      return fields_.size() > limits.maximum_header_count
                 ? ntl::status(STATUS_BUFFER_OVERFLOW)
                 : ntl::status(STATUS_INVALID_PARAMETER);

    std::size_t bytes = 0;
    bool content_length_seen = false;
    for (const auto &field : fields_) {
      if (!transform_detail::is_token(field.name) ||
          field.name.front() == ':' ||
          !transform_detail::valid_field_value(field.value) ||
          field.name.size() >
              limits.maximum_header_bytes - bytes ||
          field.value.size() >
              limits.maximum_header_bytes - bytes -
                  field.name.size())
        return STATUS_DATA_ERROR;
      bytes += field.name.size() + field.value.size();

      if (wire_protocol != protocol::http1) {
        for (const unsigned char character : field.name) {
          if (character >= 'A' && character <= 'Z')
            return STATUS_DATA_ERROR;
        }
        if (transform_detail::forbidden_h2_h3_header(
                field.name, field.value))
          return STATUS_DATA_ERROR;
      }

      if (field.name == "content-length") {
        if (content_length_seen)
          return STATUS_DATA_ERROR;
        content_length_seen = true;
        std::size_t ignored = 0;
        const auto parsed = std::from_chars(
            field.value.data(),
            field.value.data() + field.value.size(), ignored);
        if (field.value.empty() || parsed.ec != std::errc{} ||
            parsed.ptr != field.value.data() + field.value.size())
          return STATUS_DATA_ERROR;
      }
    }
    return ntl::status::ok();
  }

private:
  header_list fields_;
};

namespace transform_detail {

inline bool ows(unsigned char value) noexcept {
  return value == ' ' || value == '\t';
}

inline ntl::status collect_connection_options(
    const header_collection &headers,
    std::pmr::vector<std::pmr::string> &options) noexcept {
  try {
    for (const auto &field : headers.fields()) {
      if (!ascii_equal_ci(field.name, "connection"))
        continue;

      std::string_view value = field.value;
      std::size_t position = 0;
      bool saw_option = false;
      while (position < value.size()) {
        while (position < value.size() &&
               ows(static_cast<unsigned char>(value[position])))
          ++position;
        const std::size_t start = position;
        while (position < value.size() &&
               is_token_character(
                   static_cast<unsigned char>(value[position])))
          ++position;
        if (start == position)
          return STATUS_DATA_ERROR;

        const std::string_view option = value.substr(start, position - start);
        const bool duplicate = std::any_of(
            options.begin(), options.end(),
            [option](const std::pmr::string &existing) noexcept {
              return ascii_equal_ci(existing, option);
            });
        if (!duplicate)
          options.emplace_back(normalized_name(std::pmr::string(
              option, options.get_allocator().resource())));
        saw_option = true;

        while (position < value.size() &&
               ows(static_cast<unsigned char>(value[position])))
          ++position;
        if (position == value.size())
          break;
        if (value[position] != ',')
          return STATUS_DATA_ERROR;
        ++position;
        if (position == value.size())
          return STATUS_DATA_ERROR;
      }
      if (!saw_option)
        return STATUS_DATA_ERROR;
    }
    return ntl::status::ok();
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

inline void erase_trailer(
    header_list &trailers, std::string_view name) noexcept {
  trailers.erase(
      std::remove_if(
          trailers.begin(), trailers.end(),
          [name](const header_field &field) noexcept {
            return ascii_equal_ci(field.name, name);
          }),
      trailers.end());
}

inline bool only_trailers_te(const header_collection &headers) noexcept {
  bool found = false;
  for (const auto &field : headers.fields()) {
    if (!ascii_equal_ci(field.name, "te"))
      continue;
    found = true;
    std::string_view value = field.value;
    std::size_t position = 0;
    bool saw_token = false;
    while (position < value.size()) {
      while (position < value.size() &&
             ows(static_cast<unsigned char>(value[position])))
        ++position;
      const std::size_t start = position;
      while (position < value.size() &&
             is_token_character(
                 static_cast<unsigned char>(value[position])))
        ++position;
      if (start == position ||
          !ascii_equal_ci(value.substr(start, position - start), "trailers"))
        return false;
      saw_token = true;
      while (position < value.size() &&
             ows(static_cast<unsigned char>(value[position])))
        ++position;
      if (position == value.size())
        break;
      if (value[position] != ',')
        return false;
      ++position;
      if (position == value.size())
        return false;
    }
    if (!saw_token)
      return false;
  }
  return found;
}

} // namespace transform_detail

/**
 * @brief Adapts ordinary fields when an intermediary changes HTTP versions.
 *
 * HTTP/1 Connection options and hop-by-hop fields belong to one transport hop
 * and must never enter an HTTP/2 or HTTP/3 field section.  The operation also
 * removes fields named by Connection, including matching trailer fields.  A
 * malformed Connection option list fails closed instead of being forwarded.
 */
inline ntl::status adapt_forwarded_headers(
    header_collection &headers, header_list &trailers,
    protocol source, protocol destination) noexcept {
  if (source != protocol::http1 || destination == protocol::http1)
    return ntl::status::ok();

  try {
    std::pmr::vector<std::pmr::string> connection_options(
        headers.resource());
    const ntl::status collected = transform_detail::collect_connection_options(
        headers, connection_options);
    if (!collected.is_ok())
      return collected;

    for (const auto &option : connection_options) {
      (void)headers.erase(option);
      transform_detail::erase_trailer(trailers, option);
    }

    const bool retain_te = transform_detail::only_trailers_te(headers);
    constexpr std::array<std::string_view, 5> hop_by_hop{
        "connection", "keep-alive", "proxy-connection",
        "transfer-encoding", "upgrade"};
    for (const std::string_view name : hop_by_hop) {
      (void)headers.erase(name);
      transform_detail::erase_trailer(trailers, name);
    }
    (void)headers.erase("te");
    transform_detail::erase_trailer(trailers, "te");
    if (retain_te)
      headers.append("te", "trailers");
    return ntl::status::ok();
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

inline ntl::status validate_trailers(
    std::span<const header_field> trailers,
    protocol wire_protocol,
    const transform_limits &limits) noexcept {
  if (trailers.size() > limits.maximum_header_count)
    return STATUS_BUFFER_OVERFLOW;
  std::size_t bytes = 0;
  for (const auto &field : trailers) {
    if (!transform_detail::is_token(field.name) ||
        field.name.front() == ':' ||
        !transform_detail::valid_field_value(field.value) ||
        transform_detail::forbidden_trailer(
            field.name, wire_protocol) ||
        field.name.size() >
            limits.maximum_header_bytes - bytes ||
        field.value.size() >
            limits.maximum_header_bytes - bytes -
                field.name.size())
      return STATUS_DATA_ERROR;
    if (wire_protocol != protocol::http1) {
      for (const unsigned char character : field.name) {
        if (character >= 'A' && character <= 'Z')
          return STATUS_DATA_ERROR;
      }
    }
    bytes += field.name.size() + field.value.size();
  }
  return ntl::status::ok();
}

struct request_message {
  request_message() : request_message(message_memory_ref{}) {}
  explicit request_message(message_memory_ref memory)
      : request_message(require_resource(memory.resource), resource_tag{}) {}
  request_message(const request_message &other)
      : request_message(other, message_memory_ref{}) {}
  request_message(const request_message &other, message_memory_ref memory)
      : request_message(other, require_resource(memory.resource),
                        resource_tag{}) {}
  request_message(request_message &&) noexcept = default;
  request_message &operator=(const request_message &) = default;
  request_message &operator=(request_message &&) noexcept = default;

  std::pmr::memory_resource *resource() const noexcept {
    return body.get_allocator().resource();
  }

private:
  struct resource_tag {};
  static std::pmr::memory_resource *
  require_resource(std::pmr::memory_resource *resource) {
    if (!resource)
      throw std::invalid_argument("HTTP message memory resource is null");
    return resource;
  }
  request_message(std::pmr::memory_resource *resource, resource_tag)
      : method(resource), scheme("https", resource), authority(resource),
        path("/", resource), headers(resource), body(resource),
        trailers(resource) {}
  request_message(const request_message &other,
                  std::pmr::memory_resource *resource, resource_tag)
      : wire_protocol(other.wire_protocol), method(other.method, resource),
        scheme(other.scheme, resource), authority(other.authority, resource),
        path(other.path, resource), headers(other.headers, resource),
        body(other.body.begin(), other.body.end(), resource),
        trailers(other.trailers.begin(), other.trailers.end(), resource) {
    if (other.extended_protocol)
      extended_protocol.emplace(*other.extended_protocol, resource);
  }

public:
  protocol wire_protocol = protocol::http1;
  message_string method;
  message_string scheme;
  message_string authority;
  message_string path;
  std::optional<message_string> extended_protocol;
  header_collection headers;
  message_body body;
  header_list trailers;
};

struct response_message {
  response_message() : response_message(message_memory_ref{}) {}
  explicit response_message(message_memory_ref memory)
      : response_message(require_resource(memory.resource), resource_tag{}) {}
  response_message(const response_message &other)
      : response_message(other, message_memory_ref{}) {}
  response_message(const response_message &other, message_memory_ref memory)
      : response_message(other, require_resource(memory.resource),
                         resource_tag{}) {}
  response_message(response_message &&) noexcept = default;
  response_message &operator=(const response_message &) = default;
  response_message &operator=(response_message &&) noexcept = default;

  std::pmr::memory_resource *resource() const noexcept {
    return body.get_allocator().resource();
  }

private:
  struct resource_tag {};
  static std::pmr::memory_resource *
  require_resource(std::pmr::memory_resource *resource) {
    if (!resource)
      throw std::invalid_argument("HTTP message memory resource is null");
    return resource;
  }
  response_message(std::pmr::memory_resource *resource, resource_tag)
      : reason(resource), headers(resource), body(resource),
        trailers(resource) {}
  response_message(const response_message &other,
                   std::pmr::memory_resource *resource, resource_tag)
      : wire_protocol(other.wire_protocol), status(other.status),
        reason(other.reason, resource), headers(other.headers, resource),
        body(other.body.begin(), other.body.end(), resource),
        trailers(other.trailers.begin(), other.trailers.end(), resource) {}

public:
  protocol wire_protocol = protocol::http1;
  unsigned status = 200;
  message_string reason;
  header_collection headers;
  message_body body;
  header_list trailers;
};

inline ntl::status adapt_forwarded_message(
    request_message &message, protocol destination) noexcept {
  const protocol source = message.wire_protocol;
  const ntl::status adapted = adapt_forwarded_headers(
      message.headers, message.trailers, source, destination);
  if (!adapted.is_ok())
    return adapted;
  if (source == protocol::http1 && destination != protocol::http1)
    (void)message.headers.erase("host");
  message.wire_protocol = destination;
  return ntl::status::ok();
}

inline ntl::status adapt_forwarded_message(
    response_message &message, protocol destination) noexcept {
  const ntl::status adapted = adapt_forwarded_headers(
      message.headers, message.trailers,
      message.wire_protocol, destination);
  if (!adapted.is_ok())
    return adapted;
  message.wire_protocol = destination;
  return ntl::status::ok();
}

inline bool response_body_forbidden(
    const request_message &request,
    const response_message &response) noexcept {
  return transform_detail::ascii_equal_ci(
             request.method, "HEAD") ||
         (response.status >= 100 && response.status < 200) ||
         response.status == 204 || response.status == 304 ||
         (transform_detail::ascii_equal_ci(
              request.method, "CONNECT") &&
          response.status >= 200 && response.status < 300);
}

enum class rewrite_action : std::uint8_t {
  forward = 1,
  block = 2,
  drop = 3,
  respond = 4,
};

enum class rewrite_change : std::uint8_t {
  none = 0,
  headers = 1,
  body = 2,
};

class rewrite_result {
public:
  static rewrite_result unchanged() noexcept {
    return rewrite_result(
        rewrite_action::forward, rewrite_change::none);
  }

  static rewrite_result headers_changed() noexcept {
    return rewrite_result(
        rewrite_action::forward, rewrite_change::headers);
  }

  static rewrite_result replace_body(
      message_body body,
      transformed_body_coding coding =
          transformed_body_coding::preserve) {
    rewrite_result result(
        rewrite_action::forward, rewrite_change::body);
    result.body_ = std::move(body);
    result.coding_ = coding;
    return result;
  }

  template <class Allocator>
  static rewrite_result replace_body(
      std::vector<std::byte, Allocator> body,
      transformed_body_coding coding =
          transformed_body_coding::preserve) {
    message_body converted;
    converted.assign(
        std::make_move_iterator(body.begin()),
        std::make_move_iterator(body.end()));
    return replace_body(std::move(converted), coding);
  }

  /** The callback already rewrote message.body using its bound allocator. */
  static rewrite_result body_changed(
      transformed_body_coding coding =
          transformed_body_coding::preserve) noexcept {
    rewrite_result result(
        rewrite_action::forward, rewrite_change::body);
    result.body_supplied_ = false;
    result.coding_ = coding;
    return result;
  }

  static rewrite_result replace_text(
      std::string text,
      transformed_body_coding coding =
          transformed_body_coding::preserve) {
    message_body body(text.size());
    std::transform(
        text.begin(), text.end(), body.begin(),
        [](char value) noexcept {
          return static_cast<std::byte>(
              static_cast<unsigned char>(value));
        });
    return replace_body(std::move(body), coding);
  }

  static rewrite_result block() noexcept {
    return rewrite_result(
        rewrite_action::block, rewrite_change::none);
  }

  static rewrite_result drop() noexcept {
    return rewrite_result(
        rewrite_action::drop, rewrite_change::none);
  }

  static rewrite_result respond(response_message response) {
    rewrite_result result(
        rewrite_action::respond, rewrite_change::none);
    result.response_ = std::move(response);
    return result;
  }

  rewrite_action action() const noexcept { return action_; }
  rewrite_change change() const noexcept { return change_; }
  transformed_body_coding coding() const noexcept {
    return coding_;
  }
  message_body release_body() noexcept {
    return std::move(body_);
  }
  bool body_supplied() const noexcept { return body_supplied_; }
  std::optional<response_message>
  release_response() noexcept {
    return std::move(response_);
  }

private:
  rewrite_result(rewrite_action action,
                 rewrite_change change) noexcept
      : action_(action), change_(change) {}

  rewrite_action action_ = rewrite_action::block;
  rewrite_change change_ = rewrite_change::none;
  transformed_body_coding coding_ =
      transformed_body_coding::preserve;
  message_body body_;
  bool body_supplied_ = true;
  std::optional<response_message> response_;
};

struct pipeline_outcome {
  static constexpr std::size_t no_terminal_rule =
      (std::numeric_limits<std::size_t>::max)();

  rewrite_action action = rewrite_action::forward;
  bool headers_modified = false;
  bool body_modified = false;
  transformed_body_coding body_coding =
      transformed_body_coding::preserve;
  std::optional<response_message> response;
  NTSTATUS failure = STATUS_SUCCESS;
  std::size_t terminal_rule_index = no_terminal_rule;

  bool modified() const noexcept {
    return headers_modified || body_modified;
  }
};

class transform_pipeline;
struct transform_pipeline_state;

class request_rule_selector {
public:
  using predicate =
      std::function<bool(const request_message &)>;

  request_rule_selector when(predicate condition) const;

  template <class Function>
  request_rule_selector &inspect(Function &&function);

  template <class Function>
  request_rule_selector &transform(Function &&function);

  template <class Function>
  request_rule_selector &decide(Function &&function) {
    return inspect(std::forward<Function>(function));
  }

private:
  friend class transform_pipeline;
  request_rule_selector(
                        std::shared_ptr<transform_pipeline_state> state,
                        predicate condition)
      : state_(std::move(state)),
        condition_(std::move(condition)) {}

  std::shared_ptr<transform_pipeline_state> state_;
  predicate condition_;
};

class response_rule_selector {
public:
  using predicate = std::function<bool(
      const request_message &, const response_message &)>;

  response_rule_selector when(predicate condition) const;
  response_rule_selector html() const;

  template <class Function>
  response_rule_selector &inspect(Function &&function);

  template <class Function>
  response_rule_selector &transform(Function &&function);

  template <class Function>
  response_rule_selector &decide(Function &&function) {
    return inspect(std::forward<Function>(function));
  }

private:
  friend class transform_pipeline;
  response_rule_selector(
                         std::shared_ptr<transform_pipeline_state> state,
                         predicate condition)
      : state_(std::move(state)),
        condition_(std::move(condition)) {}

  std::shared_ptr<transform_pipeline_state> state_;
  predicate condition_;
};

struct transform_pipeline_state {
  struct request_rule {
    request_rule_selector::predicate condition;
    std::function<rewrite_result(request_message &)> apply;
  };

  struct response_rule {
    response_rule_selector::predicate condition;
    std::function<rewrite_result(
        const request_message &, response_message &)> apply;
  };

  explicit transform_pipeline_state(transform_limits configured_limits)
      : limits(configured_limits) {}

  transform_limits limits;
  std::vector<request_rule> request_rules;
  std::vector<response_rule> response_rules;
};

/**
 * @brief Ordered, fail-closed semantic HTTP policy.
 *
 * Rules are configured before concurrent use. Each apply call owns its message
 * and therefore may run concurrently with other calls after configuration.
 */
class transform_pipeline {
public:
  explicit transform_pipeline(
      transform_limits limits = {})
      : state_(std::make_shared<transform_pipeline_state>(limits)) {
    if (!valid_limits())
      throw std::invalid_argument(
          "HTTP transform pipeline limits are invalid");
  }

  request_rule_selector requests() {
    return request_rule_selector(
        state_, [](const request_message &) { return true; });
  }

  response_rule_selector responses() {
    return response_rule_selector(
        state_,
        [](const request_message &,
           const response_message &) { return true; });
  }

  const transform_limits &limits_ref() const noexcept {
    return state_->limits;
  }

  pipeline_outcome
  apply(request_message &message) const noexcept {
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    return apply_with_kernel_stack(
        [this, &message]() noexcept {
          return apply_request_on_current_stack(message);
        });
#else
    return apply_request_on_current_stack(message);
#endif
  }

  pipeline_outcome
  apply(const request_message &request,
        response_message &message) const noexcept {
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    return apply_with_kernel_stack(
        [this, &request, &message]() noexcept {
          return apply_response_on_current_stack(request, message);
        });
#else
    return apply_response_on_current_stack(request, message);
#endif
  }

private:
  pipeline_outcome
  apply_request_on_current_stack(
      request_message &message) const noexcept {
    std::optional<request_message> original;
    const auto state = state_;
    if (state->limits.on_failure ==
        transform_failure_policy::forward_original) {
      try {
        original = message;
      } catch (...) {
        return failure(STATUS_INSUFFICIENT_RESOURCES);
      }
    }
    pipeline_outcome outcome;
    try {
      const ntl::status valid = validate(message);
      if (!valid.is_ok())
        return restore_or_fail(
            message, std::move(original),
            static_cast<NTSTATUS>(valid));
      for (std::size_t rule_index = 0;
           rule_index != state->request_rules.size(); ++rule_index) {
        const auto &rule = state->request_rules[rule_index];
        if (!rule.condition(message))
          continue;
        rewrite_result result = rule.apply(message);
        const ntl::status applied =
            merge(message, std::move(result), outcome);
        if (!applied.is_ok())
          return restore_or_fail(
              message, std::move(original),
              static_cast<NTSTATUS>(applied));
        if (outcome.response &&
            response_body_forbidden(
                message, *outcome.response) &&
            (!outcome.response->body.empty() ||
             !outcome.response->trailers.empty()))
          return restore_or_fail(
              message, std::move(original),
              STATUS_DATA_ERROR);
        if (outcome.action != rewrite_action::forward) {
          outcome.terminal_rule_index = rule_index;
          return outcome;
        }
      }
      return outcome;
    } catch (const std::bad_alloc &) {
      return restore_or_fail(
          message, std::move(original),
          STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return restore_or_fail(
          message, std::move(original),
          STATUS_UNHANDLED_EXCEPTION);
    }
  }

  pipeline_outcome
  apply_response_on_current_stack(
      const request_message &request,
      response_message &message) const noexcept {
    std::optional<response_message> original;
    const auto state = state_;
    if (state->limits.on_failure ==
        transform_failure_policy::forward_original) {
      try {
        original = message;
      } catch (...) {
        return failure(STATUS_INSUFFICIENT_RESOURCES);
      }
    }
    pipeline_outcome outcome;
    try {
      const ntl::status valid = validate(message);
      if (!valid.is_ok() ||
          response_body_forbidden(request, message) &&
              (!message.body.empty() ||
               !message.trailers.empty()))
        return restore_or_fail(
            message, std::move(original),
            valid.is_ok() ? STATUS_DATA_ERROR
                          : static_cast<NTSTATUS>(valid));
      for (std::size_t rule_index = 0;
           rule_index != state->response_rules.size(); ++rule_index) {
        const auto &rule = state->response_rules[rule_index];
        if (!rule.condition(request, message))
          continue;
        rewrite_result result =
            rule.apply(request, message);
        const ntl::status applied =
            merge(message, std::move(result), outcome);
        if (!applied.is_ok())
          return restore_or_fail(
              message, std::move(original),
              static_cast<NTSTATUS>(applied));
        if ((response_body_forbidden(request, message) &&
             (!message.body.empty() ||
              !message.trailers.empty())) ||
            (outcome.response &&
             response_body_forbidden(
                 request, *outcome.response) &&
             (!outcome.response->body.empty() ||
              !outcome.response->trailers.empty())))
          return restore_or_fail(
              message, std::move(original),
              STATUS_DATA_ERROR);
        if (outcome.action != rewrite_action::forward) {
          outcome.terminal_rule_index = rule_index;
          return outcome;
        }
      }
      return outcome;
    } catch (const std::bad_alloc &) {
      return restore_or_fail(
          message, std::move(original),
          STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return restore_or_fail(
          message, std::move(original),
          STATUS_UNHANDLED_EXCEPTION);
    }
  }

  friend class request_rule_selector;
  friend class response_rule_selector;

#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
  /**
   * Kernel coroutine resume frames can already consume a material portion of
   * the fixed kernel stack.  A policy may then nest protocol adapters (for
   * example HTTP -> gRPC -> content decoder) and pool verification adds more
   * call depth.  Keep that synchronous policy work behind one internal stack
   * budget so callers never need to remember KeExpandKernelStackAndCalloutEx.
   * Expansion failure does not run the callback and is mapped through the
   * pipeline's configured failure policy.
   */
  template <class Function>
  pipeline_outcome
  apply_with_kernel_stack(Function &&function) const noexcept {
    static_assert(std::is_nothrow_invocable_r_v<
                  pipeline_outcome, Function &>);
    static_assert(std::is_nothrow_move_assignable_v<
                  pipeline_outcome>);

    if (ntl::current_irql() != ntl::irql::passive)
      return failure(STATUS_INVALID_DEVICE_STATE);

    pipeline_outcome outcome = failure(STATUS_UNSUCCESSFUL);
    try {
      ntl::net::kernel::dispatcher_executor::invoke(
          [&function, &outcome]() noexcept {
            outcome = function();
          });
      return outcome;
    } catch (const ntl::exception &error) {
      return failure(
          static_cast<NTSTATUS>(error.get_status()));
    } catch (const std::bad_alloc &) {
      return failure(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return failure(STATUS_UNHANDLED_EXCEPTION);
    }
  }

#endif

  bool valid_limits() const noexcept {
    return state_->limits.maximum_header_count != 0 &&
           state_->limits.maximum_header_bytes != 0 &&
           state_->limits.maximum_encoded_body_bytes != 0 &&
           state_->limits.maximum_decoded_body_bytes != 0 &&
           state_->limits.maximum_expansion_ratio != 0 &&
           state_->limits.maximum_coding_layers != 0;
  }

  ntl::status validate(
      const request_message &message) const noexcept {
    const bool connect = message.method == "CONNECT";
    const bool extended_connect =
        connect && message.extended_protocol.has_value();
    const bool start_line_bounded =
        message.method.size() <= state_->limits.maximum_header_bytes &&
        message.scheme.size() <=
            state_->limits.maximum_header_bytes -
                message.method.size() &&
        message.authority.size() <=
            state_->limits.maximum_header_bytes -
                message.method.size() -
                message.scheme.size() &&
        message.path.size() <=
            state_->limits.maximum_header_bytes -
                message.method.size() -
                message.scheme.size() -
                message.authority.size();
    if (!transform_detail::is_token(message.method) ||
        !transform_detail::valid_uri_component(
            message.authority) ||
        (!connect &&
         (!transform_detail::is_scheme(message.scheme) ||
          !transform_detail::valid_uri_component(
              message.path))) ||
        (connect && !extended_connect &&
         (!message.scheme.empty() || !message.path.empty())) ||
        (extended_connect &&
         (!transform_detail::is_scheme(message.scheme) ||
          !transform_detail::valid_uri_component(message.path) ||
          !transform_detail::is_token(
              *message.extended_protocol))) ||
        (message.wire_protocol == protocol::http1 &&
         message.extended_protocol.has_value()) ||
        !start_line_bounded ||
        message.body.size() >
            state_->limits.maximum_decoded_body_bytes)
      return STATUS_DATA_ERROR;
    const ntl::status headers = message.headers.validate(
        message.wire_protocol, state_->limits);
    if (!headers.is_ok())
      return headers;
    return validate_trailers(
        message.trailers, message.wire_protocol, state_->limits);
  }

  ntl::status validate(
      const response_message &message) const noexcept {
    if (message.status < 100 || message.status > 999 ||
        !transform_detail::valid_field_value(message.reason) ||
        message.reason.size() >
            state_->limits.maximum_header_bytes ||
        message.body.size() >
            state_->limits.maximum_decoded_body_bytes)
      return STATUS_DATA_ERROR;
    const ntl::status headers = message.headers.validate(
        message.wire_protocol, state_->limits);
    if (!headers.is_ok())
      return headers;
    return validate_trailers(
        message.trailers, message.wire_protocol, state_->limits);
  }

  template <class Message>
  ntl::status merge(Message &message,
                    rewrite_result &&result,
                    pipeline_outcome &outcome) const {
    outcome.action = result.action();
    switch (result.change()) {
    case rewrite_change::none:
      break;
    case rewrite_change::headers:
      outcome.headers_modified = true;
      break;
    case rewrite_change::body:
      if (result.body_supplied())
        message.body = result.release_body();
      if (message.body.size() >
          state_->limits.maximum_decoded_body_bytes)
        return STATUS_BUFFER_OVERFLOW;
      outcome.body_modified = true;
      outcome.headers_modified = true;
      outcome.body_coding = result.coding();
      synchronize_body_headers(
          message.headers, message.body.size(),
          result.coding());
      if constexpr (std::is_same_v<Message, response_message>) {
        remove_invalidated_validators(message.headers);
        remove_invalidated_validators(message.trailers);
      }
      break;
    }
    outcome.response = result.release_response();
    if (outcome.response) {
      outcome.response->wire_protocol = message.wire_protocol;
      const ntl::status valid = validate(*outcome.response);
      if (!valid.is_ok())
        return valid;
    }
    return validate(message);
  }

  static void synchronize_body_headers(
      header_collection &headers, std::size_t body_size,
      transformed_body_coding coding) {
    headers.erase("transfer-encoding");
    headers.set("content-length", std::to_string(body_size));
    if (coding == transformed_body_coding::identity)
      headers.erase("content-encoding");
  }

  static void remove_invalidated_validators(
      header_collection &headers) noexcept {
    (void)headers.erase("content-md5");
    (void)headers.erase("digest");
    (void)headers.erase("etag");
  }

  static void remove_invalidated_validators(
      header_list &trailers) noexcept {
    trailers.erase(
        std::remove_if(
            trailers.begin(), trailers.end(),
            [](const header_field &field) noexcept {
              return transform_detail::ascii_equal_ci(
                         field.name, "content-md5") ||
                     transform_detail::ascii_equal_ci(
                         field.name, "digest") ||
                     transform_detail::ascii_equal_ci(
                         field.name, "etag");
            }),
        trailers.end());
  }

  pipeline_outcome failure(NTSTATUS status) const noexcept {
    return {
        state_->limits.on_failure ==
                transform_failure_policy::forward_original
            ? rewrite_action::forward
            : rewrite_action::block,
        false, false,
        transformed_body_coding::preserve,
        std::nullopt, status};
  }

  template <class Message>
  pipeline_outcome restore_or_fail(
      Message &message, std::optional<Message> original,
      NTSTATUS status) const noexcept {
    if (original) {
      message = std::move(*original);
      return {
          rewrite_action::forward, false, false,
          transformed_body_coding::preserve,
          std::nullopt, status};
    }
    return failure(status);
  }

  std::shared_ptr<transform_pipeline_state> state_;
};

inline request_rule_selector
request_rule_selector::when(predicate condition) const {
  if (!condition)
    throw std::invalid_argument(
        "HTTP request rule predicate is empty");
  const predicate previous = condition_;
  return request_rule_selector(
      state_,
      [previous, condition = std::move(condition)](
          const request_message &message) {
        return previous(message) && condition(message);
      });
}

template <class Function>
request_rule_selector &
request_rule_selector::inspect(Function &&function) {
  using function_type = std::decay_t<Function>;
  state_->request_rules.push_back({
      condition_,
      [callback = function_type(
           std::forward<Function>(function))](
          request_message &message) {
        const auto verdict = static_cast<
            ntl::net::inspection::verdict>(
                callback(
                    static_cast<const request_message &>(
                        message)));
        switch (verdict) {
        case ntl::net::inspection::verdict::permit:
          return rewrite_result::unchanged();
        case ntl::net::inspection::verdict::block:
          return rewrite_result::block();
        case ntl::net::inspection::verdict::drop_flow:
          return rewrite_result::drop();
        }
        return rewrite_result::block();
      }});
  return *this;
}

template <class Function>
request_rule_selector &
request_rule_selector::transform(Function &&function) {
  using function_type = std::decay_t<Function>;
  state_->request_rules.push_back({
      condition_,
      [callback = function_type(
           std::forward<Function>(function))](
          request_message &message) {
        return static_cast<rewrite_result>(
            callback(message));
      }});
  return *this;
}

inline response_rule_selector
response_rule_selector::when(predicate condition) const {
  if (!condition)
    throw std::invalid_argument(
        "HTTP response rule predicate is empty");
  const predicate previous = condition_;
  return response_rule_selector(
      state_,
      [previous, condition = std::move(condition)](
          const request_message &request,
          const response_message &response) {
        return previous(request, response) &&
               condition(request, response);
      });
}

inline response_rule_selector
response_rule_selector::html() const {
  return when(
      [](const request_message &,
         const response_message &response) {
        const auto content_type =
            response.headers.first("content-type");
        return content_type &&
               transform_detail::html_content_type(
                   *content_type);
      });
}

template <class Function>
response_rule_selector &
response_rule_selector::inspect(Function &&function) {
  using function_type = std::decay_t<Function>;
  state_->response_rules.push_back({
      condition_,
      [callback = function_type(
           std::forward<Function>(function))](
          const request_message &request,
          response_message &message) {
        const auto verdict = static_cast<
            ntl::net::inspection::verdict>(
                callback(
                    request,
                    static_cast<const response_message &>(
                        message)));
        switch (verdict) {
        case ntl::net::inspection::verdict::permit:
          return rewrite_result::unchanged();
        case ntl::net::inspection::verdict::block:
          return rewrite_result::block();
        case ntl::net::inspection::verdict::drop_flow:
          return rewrite_result::drop();
        }
        return rewrite_result::block();
      }});
  return *this;
}

template <class Function>
response_rule_selector &
response_rule_selector::transform(Function &&function) {
  using function_type = std::decay_t<Function>;
  state_->response_rules.push_back({
      condition_,
      [callback = function_type(
           std::forward<Function>(function))](
          const request_message &request,
          response_message &message) {
        return static_cast<rewrite_result>(
            callback(request, message));
      }});
  return *this;
}

struct decoded_body {
  std::vector<std::byte> bytes;
  std::string original_content_encoding;
};

inline ntl::result<decoded_body>
decode_body(
    const header_collection &headers,
    std::span<const std::byte> encoded,
    const ntl::net::inspection::content_decoder_registry
        &decoders,
    const transform_limits &limits = {}) noexcept {
  if (encoded.size() > limits.maximum_encoded_body_bytes)
    return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
  try {
    decoded_body result;
    result.original_content_encoding =
        headers.joined("content-encoding");
    if (result.original_content_encoding.empty() ||
        transform_detail::ascii_equal_ci(
            result.original_content_encoding, "identity")) {
      result.bytes.assign(encoded.begin(), encoded.end());
      return ntl::ok(std::move(result));
    }
    auto decoded =
        ntl::net::inspection::decode_content_encoding(
            decoders,
            ntl::net::scatter_view::from_contiguous(encoded),
            result.original_content_encoding,
            {.maximum_encoded_size =
                 limits.maximum_encoded_body_bytes,
             .maximum_decoded_size =
                 limits.maximum_decoded_body_bytes,
             .maximum_expansion_ratio =
                 limits.maximum_expansion_ratio,
             .maximum_coding_layers =
                 limits.maximum_coding_layers});
    if (!decoded)
      return ntl::unexpected(decoded.status());
    result.bytes = std::move(*decoded);
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<std::vector<std::byte>>
encode_body(
    header_collection &headers,
    std::span<const std::byte> decoded,
    std::string_view original_content_encoding,
    transformed_body_coding coding,
    const ntl::net::inspection::content_encoder_registry
        &encoders,
    const transform_limits &limits = {}) noexcept {
  if (decoded.size() > limits.maximum_decoded_body_bytes)
    return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
  try {
    std::vector<std::byte> output;
    if (coding == transformed_body_coding::preserve &&
        !original_content_encoding.empty() &&
        !transform_detail::ascii_equal_ci(
            original_content_encoding, "identity")) {
      auto encoded =
          ntl::net::inspection::encode_content_encoding(
              encoders, decoded, original_content_encoding,
              {.maximum_input_size =
                   limits.maximum_decoded_body_bytes,
               .maximum_encoded_size =
                   limits.maximum_encoded_body_bytes,
               .maximum_coding_layers =
                   limits.maximum_coding_layers});
      if (!encoded)
        return ntl::unexpected(encoded.status());
      output = std::move(*encoded);
      headers.set(
          "content-encoding",
          std::string(original_content_encoding));
    } else {
      if (decoded.size() >
          limits.maximum_encoded_body_bytes)
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
      output.assign(decoded.begin(), decoded.end());
      headers.erase("content-encoding");
    }
    headers.erase("transfer-encoding");
    headers.set(
        "content-length", std::to_string(output.size()));
    return ntl::ok(std::move(output));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

