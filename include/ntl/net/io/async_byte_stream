struct read_options {
  std::chrono::milliseconds timeout = (std::chrono::milliseconds::max)();
};

namespace detail {

class byte_stream_state {
public:
  byte_stream_state(ntl::net::owned_bytes &&storage,
                    WORK_QUEUE_TYPE queue_type) noexcept
      : storage_(std::move(storage)), queue_type_(queue_type) {
    KeInitializeSpinLock(&lock_);
    KeInitializeEvent(&idle_, NotificationEvent, TRUE);
    KeInitializeTimer(&timer_);
    KeInitializeDpc(&timer_dpc_, &byte_stream_state::timer_expired, this);
#ifdef _MSC_VER
#pragma warning(push)
#pragma warning(disable : 4996)
#endif
    ExInitializeWorkItem(&resume_work_, &byte_stream_state::resume_waiter,
                         this);
    ExInitializeWorkItem(&idle_resume_work_,
                         &byte_stream_state::resume_idle_waiter, this);
#ifdef _MSC_VER
#pragma warning(pop)
#endif
  }

  byte_stream_state(const byte_stream_state &) = delete;
  byte_stream_state &operator=(const byte_stream_state &) = delete;

  void add_ref() noexcept {
    references_.fetch_add(1, std::memory_order_relaxed);
  }

  void release() noexcept {
    if (references_.fetch_sub(1, std::memory_order_acq_rel) == 1) {
      ntl::pool_deleter<byte_stream_state>{ntl::pool_tag("sAtN"),
                                           ntl::pool_kind::nonpaged}(this);
    }
  }

  std::size_t capacity() const noexcept { return storage_.size(); }

  std::size_t buffered_size() noexcept {
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    const std::size_t result = size_;
    KeReleaseSpinLock(&lock_, old_irql);
    return result;
  }

  ntl::status append(ntl::net::scatter_view source) noexcept {
    if (!source)
      return STATUS_INVALID_PARAMETER;
    if (source.empty())
      return ntl::status::ok();

    bool queue_resume = false;
    bool release_timer_reference = false;
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);

    if (closed_) {
      KeReleaseSpinLock(&lock_, old_irql);
      return STATUS_DELETE_PENDING;
    }
    if (source.size() > capacity() - size_) {
      KeReleaseSpinLock(&lock_, old_irql);
      return STATUS_BUFFER_OVERFLOW;
    }

    std::size_t tail = (head_ + size_) % capacity();
    std::size_t appended = 0;
    const ntl::status copied =
        source.for_each_chunk([&](std::span<const std::byte> chunk) noexcept {
          std::size_t consumed = 0;
          while (consumed != chunk.size()) {
            const std::size_t contiguous =
                (std::min)(chunk.size() - consumed, capacity() - tail);
            std::memcpy(storage_.data() + tail, chunk.data() + consumed,
                        contiguous);
            consumed += contiguous;
            appended += contiguous;
            tail = (tail + contiguous) % capacity();
          }
        });
    if (!copied.is_ok() || appended != source.size()) {
      KeReleaseSpinLock(&lock_, old_irql);
      return copied.is_ok() ? ntl::status{STATUS_DATA_ERROR} : copied;
    }

    size_ += appended;
    if (waiter_ && size_ >= requested_) {
      queue_resume = complete_wait_locked(ntl::status::ok(), true,
                                          release_timer_reference);
    }
    update_idle_locked();
    KeReleaseSpinLock(&lock_, old_irql);

    if (queue_resume)
      queue_resume_work();
    if (release_timer_reference)
      release();
    return ntl::status::ok();
  }

  void close(ntl::status status) noexcept {
    bool queue_resume = false;
    bool release_timer_reference = false;
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (!closed_) {
      closed_ = true;
      close_status_ = status;
      if (waiter_ && size_ < requested_) {
        queue_resume =
            complete_wait_locked(status, true, release_timer_reference);
      }
    }
    update_idle_locked();
    KeReleaseSpinLock(&lock_, old_irql);

    if (queue_resume)
      queue_resume_work();
    if (release_timer_reference)
      release();
  }

  bool ready(std::size_t requested, read_options options,
             ntl::status &status) noexcept {
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    bool result = false;
    const bool reader_in_flight =
        waiter_ || ready_continuation_ || resume_queued_;

    // Force await_suspend() to perform the continuation-aware ownership
    // check while another read is registered or resuming.
    if (reader_in_flight) {
      result = false;
    } else if (requested > capacity()) {
      status = STATUS_BUFFER_OVERFLOW;
      result = true;
    } else if (size_ >= requested) {
      status = ntl::status::ok();
      result = true;
    } else if (closed_) {
      status = close_status_;
      result = true;
    } else if (options.timeout <= std::chrono::milliseconds::zero()) {
      status = STATUS_IO_TIMEOUT;
      result = true;
    }
    KeReleaseSpinLock(&lock_, old_irql);
    return result;
  }

  bool begin_wait(std::coroutine_handle<> continuation, std::size_t requested,
                  read_options options, ntl::status *completion) noexcept {
    if (!completion)
      return false;

    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    const bool another_reader =
        waiter_ || ready_continuation_ || resume_queued_;
    if (another_reader) {
      *completion = STATUS_DEVICE_BUSY;
      KeReleaseSpinLock(&lock_, old_irql);
      return false;
    }
    if (requested > capacity()) {
      *completion = STATUS_BUFFER_OVERFLOW;
      KeReleaseSpinLock(&lock_, old_irql);
      return false;
    }
    if (size_ >= requested) {
      *completion = ntl::status::ok();
      KeReleaseSpinLock(&lock_, old_irql);
      return false;
    }
    if (closed_) {
      *completion = close_status_;
      KeReleaseSpinLock(&lock_, old_irql);
      return false;
    }
    if (options.timeout <= std::chrono::milliseconds::zero()) {
      *completion = STATUS_IO_TIMEOUT;
      KeReleaseSpinLock(&lock_, old_irql);
      return false;
    }

    waiter_ = continuation;
    waiter_status_ = completion;
    requested_ = requested;
    *completion = STATUS_PENDING;
    KeClearEvent(&idle_);

    if (options.timeout != (std::chrono::milliseconds::max)()) {
      const auto count = options.timeout.count();
      const auto maximum = (std::numeric_limits<LONGLONG>::max)() / 10000;
      const LONGLONG milliseconds =
          count > maximum ? maximum : static_cast<LONGLONG>(count);
      schedule_wait_timer_locked(continuation, milliseconds);
    }

    KeReleaseSpinLock(&lock_, old_irql);
    return true;
  }

  ntl::status consume(std::span<std::byte> destination) noexcept {
    if (destination.size() > capacity())
      return STATUS_BUFFER_OVERFLOW;

    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (size_ < destination.size()) {
      const ntl::status result =
          closed_ ? close_status_ : ntl::status{STATUS_BUFFER_TOO_SMALL};
      KeReleaseSpinLock(&lock_, old_irql);
      return result;
    }

    std::size_t copied = 0;
    while (copied != destination.size()) {
      const std::size_t contiguous =
          (std::min)(destination.size() - copied, capacity() - head_);
      std::memcpy(destination.data() + copied, storage_.data() + head_,
                  contiguous);
      copied += contiguous;
      head_ = (head_ + contiguous) % capacity();
      size_ -= contiguous;
    }
    KeReleaseSpinLock(&lock_, old_irql);
    return ntl::status::ok();
  }

  ntl::result<std::size_t>
  consume_some(std::span<std::byte> destination) noexcept {
    if (destination.empty())
      return ntl::ok(std::size_t{0});

    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (size_ == 0) {
      const ntl::status status =
          closed_ ? close_status_ : ntl::status{STATUS_BUFFER_TOO_SMALL};
      KeReleaseSpinLock(&lock_, old_irql);
      return ntl::unexpected(status);
    }

    const std::size_t requested = (std::min)(destination.size(), size_);
    std::size_t copied = 0;
    while (copied != requested) {
      const std::size_t contiguous =
          (std::min)(requested - copied, capacity() - head_);
      std::memcpy(destination.data() + copied, storage_.data() + head_,
                  contiguous);
      copied += contiguous;
      head_ = (head_ + contiguous) % capacity();
      size_ -= contiguous;
    }
    KeReleaseSpinLock(&lock_, old_irql);
    return ntl::ok(copied);
  }

  void abandon(std::coroutine_handle<> continuation) noexcept {
    bool release_timer_reference = false;
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (waiter_ == continuation) {
      waiter_ = {};
      waiter_status_ = nullptr;
      requested_ = 0;
      release_timer_reference = cancel_wait_timer_locked(continuation);
    }
    if (ready_continuation_ == continuation)
      ready_continuation_ = {};
    update_idle_locked();
    KeReleaseSpinLock(&lock_, old_irql);
    if (release_timer_reference)
      release();
  }

  ntl::status wait_for_idle() noexcept {
    if (KeGetCurrentIrql() != PASSIVE_LEVEL)
      return STATUS_INVALID_DEVICE_STATE;
    return KeWaitForSingleObject(&idle_, Executive, KernelMode, FALSE, nullptr);
  }

  /**
   * Completes only the currently suspended read without closing the stream.
   *
   * This is used by bidirectional protocols when one direction reaches a
   * graceful terminal condition and the sibling read must be joined before a
   * protocol close-notify can be written. Buffered bytes and future reads are
   * preserved.
   */
  void cancel_pending_read(
      ntl::status status = STATUS_CANCELLED) noexcept {
    bool queue_resume = false;
    bool release_timer_reference = false;
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (waiter_)
      queue_resume = complete_wait_locked(status, true,
                                          release_timer_reference);
    update_idle_locked();
    KeReleaseSpinLock(&lock_, old_irql);

    if (queue_resume)
      queue_resume_work();
    if (release_timer_reference)
      release();
  }

  bool begin_idle_wait(std::coroutine_handle<> continuation,
                       ntl::status *completion) noexcept {
    if (!continuation || !completion)
      return false;

    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (idle_waiter_ || idle_ready_continuation_ || idle_resume_queued_ ||
        idle_resume_active_) {
      *completion = STATUS_DEVICE_BUSY;
      KeReleaseSpinLock(&lock_, old_irql);
      return false;
    }
    idle_waiter_ = continuation;
    idle_waiter_status_ = completion;
    *completion = STATUS_PENDING;
    update_idle_locked();
    KeReleaseSpinLock(&lock_, old_irql);
    // Even an already-idle stream resumes through idle_resume_work_. This
    // mandatory scheduling boundary prevents a coroutine from synchronously
    // waiting for the resume callback which is currently executing it.
    return true;
  }

  void abandon_idle_wait(std::coroutine_handle<> continuation) noexcept {
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (idle_waiter_ == continuation) {
      idle_waiter_ = {};
      idle_waiter_status_ = nullptr;
    }
    if (idle_ready_continuation_ == continuation)
      idle_ready_continuation_ = {};
    update_idle_locked();
    KeReleaseSpinLock(&lock_, old_irql);
  }

private:
  ~byte_stream_state() = default;
  friend class ntl::pool_deleter<byte_stream_state>;

  void schedule_wait_timer_locked(std::coroutine_handle<> continuation,
                                  LONGLONG milliseconds) noexcept {
    NT_ASSERT(continuation);
    NT_ASSERT(milliseconds > 0);
    if (timer_reference_) {
      // KeCancelTimer() can report that an earlier DPC has already been
      // queued. Defer rearming the embedded timer until that DPC owns it.
      NT_ASSERT(!timer_continuation_);
      timer_rearm_continuation_ = continuation;
      timer_rearm_milliseconds_ = milliseconds;
      return;
    }

    LARGE_INTEGER due_time{};
    due_time.QuadPart = -milliseconds * 10000;
    add_ref();
    timer_reference_ = true;
    timer_continuation_ = continuation;
    (void)KeSetTimer(&timer_, due_time, &timer_dpc_);
  }

  bool cancel_wait_timer_locked(std::coroutine_handle<> continuation) noexcept {
    if (timer_rearm_continuation_ == continuation) {
      timer_rearm_continuation_ = {};
      timer_rearm_milliseconds_ = 0;
    }
    if (!timer_reference_ || timer_continuation_ != continuation)
      return false;

    timer_continuation_ = {};
    if (!KeCancelTimer(&timer_))
      return false;
    timer_reference_ = false;
    return true;
  }

  bool complete_wait_locked(ntl::status status, bool cancel_timer,
                            bool &release_timer_reference) noexcept {
    if (!waiter_)
      return false;
    NT_ASSERT(!ready_continuation_);
    if (waiter_status_)
      *waiter_status_ = status;
    const std::coroutine_handle<> continuation = waiter_;
    ready_continuation_ = continuation;
    waiter_ = {};
    waiter_status_ = nullptr;
    requested_ = 0;
    if (cancel_timer)
      release_timer_reference = cancel_wait_timer_locked(continuation);
    if (resume_queued_ || resume_active_)
      return false;
    resume_queued_ = true;
    add_ref();
    return true;
  }

  bool io_idle_locked() const noexcept {
    return !waiter_ && !ready_continuation_ && !resume_queued_ &&
           !resume_active_ && !timer_reference_;
  }

  void update_idle_locked() noexcept {
    const bool io_idle = io_idle_locked();
    if (io_idle && idle_waiter_ && !idle_ready_continuation_ &&
        !idle_resume_queued_ && !idle_resume_active_) {
      idle_ready_continuation_ = std::exchange(idle_waiter_, {});
      if (idle_waiter_status_)
        *idle_waiter_status_ = ntl::status::ok();
      idle_waiter_status_ = nullptr;
      idle_resume_queued_ = true;
      add_ref();
      queue_idle_resume_work();
    }

    if (io_idle && !idle_waiter_ && !idle_ready_continuation_ &&
        !idle_resume_queued_ && !idle_resume_active_) {
      KeSetEvent(&idle_, IO_NO_INCREMENT, FALSE);
    } else {
      KeClearEvent(&idle_);
    }
  }

  void queue_resume_work() noexcept {
#ifdef _MSC_VER
#pragma warning(push)
#pragma warning(disable : 4996)
#endif
    ExQueueWorkItem(&resume_work_, queue_type_);
#ifdef _MSC_VER
#pragma warning(pop)
#endif
  }

  void queue_idle_resume_work() noexcept {
#ifdef _MSC_VER
#pragma warning(push)
#pragma warning(disable : 4996)
#endif
    ExQueueWorkItem(&idle_resume_work_, queue_type_);
#ifdef _MSC_VER
#pragma warning(pop)
#endif
  }

  static void resume_waiter(void *context) noexcept {
    auto *const self = static_cast<byte_stream_state *>(context);
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&self->lock_, &old_irql);
    self->resume_queued_ = false;
    self->resume_active_ = true;

    for (;;) {
      const std::coroutine_handle<> continuation =
          std::exchange(self->ready_continuation_, {});
      self->active_continuation_ = continuation;
      self->update_idle_locked();
      KeReleaseSpinLock(&self->lock_, old_irql);

      if (continuation)
        continuation.resume();

      KeAcquireSpinLock(&self->lock_, &old_irql);
      self->active_continuation_ = {};
      if (!self->ready_continuation_) {
        self->resume_active_ = false;
        self->update_idle_locked();
        KeReleaseSpinLock(&self->lock_, old_irql);
        self->release();
        return;
      }
    }
  }

  static void resume_idle_waiter(void *context) noexcept {
    auto *const self = static_cast<byte_stream_state *>(context);
    std::coroutine_handle<> continuation{};
    KIRQL old_irql = 0;
    KeAcquireSpinLock(&self->lock_, &old_irql);
    self->idle_resume_queued_ = false;
    self->idle_resume_active_ = true;
    continuation = std::exchange(self->idle_ready_continuation_, {});
    self->update_idle_locked();
    KeReleaseSpinLock(&self->lock_, old_irql);

    if (continuation)
      continuation.resume();

    KeAcquireSpinLock(&self->lock_, &old_irql);
    self->idle_resume_active_ = false;
    self->update_idle_locked();
    KeReleaseSpinLock(&self->lock_, old_irql);
    self->release();
  }

  static void timer_expired(KDPC *, void *context, void *, void *) noexcept {
    auto *const self = static_cast<byte_stream_state *>(context);
    bool queue_resume = false;
    bool release_timer_reference = false;

    KIRQL old_irql = 0;
    KeAcquireSpinLock(&self->lock_, &old_irql);
    if (self->timer_reference_) {
      const std::coroutine_handle<> expired =
          std::exchange(self->timer_continuation_, {});
      if (expired && self->waiter_ == expired) {
        bool ignored_timer_release = false;
        queue_resume = self->complete_wait_locked(STATUS_IO_TIMEOUT, false,
                                                  ignored_timer_release);
      }

      if (self->timer_rearm_continuation_ &&
          self->waiter_ == self->timer_rearm_continuation_) {
        LARGE_INTEGER due_time{};
        due_time.QuadPart = -self->timer_rearm_milliseconds_ * 10000;
        self->timer_continuation_ =
            std::exchange(self->timer_rearm_continuation_, {});
        self->timer_rearm_milliseconds_ = 0;
        (void)KeSetTimer(&self->timer_, due_time, &self->timer_dpc_);
      } else {
        self->timer_rearm_continuation_ = {};
        self->timer_rearm_milliseconds_ = 0;
        self->timer_reference_ = false;
        release_timer_reference = true;
      }
    }
    self->update_idle_locked();
    KeReleaseSpinLock(&self->lock_, old_irql);

    if (queue_resume)
      self->queue_resume_work();
    if (release_timer_reference)
      self->release();
  }

  std::atomic<std::uint32_t> references_{1};
  ntl::net::owned_bytes storage_;
  KSPIN_LOCK lock_{};
  KEVENT idle_{};
  KTIMER timer_{};
  KDPC timer_dpc_{};
  WORK_QUEUE_ITEM resume_work_{};
  WORK_QUEUE_ITEM idle_resume_work_{};
  WORK_QUEUE_TYPE queue_type_ = DelayedWorkQueue;

  std::size_t head_ = 0;
  std::size_t size_ = 0;
  std::size_t requested_ = 0;
  std::coroutine_handle<> waiter_{};
  std::coroutine_handle<> ready_continuation_{};
  std::coroutine_handle<> active_continuation_{};
  std::coroutine_handle<> idle_waiter_{};
  std::coroutine_handle<> idle_ready_continuation_{};
  std::coroutine_handle<> timer_continuation_{};
  std::coroutine_handle<> timer_rearm_continuation_{};
  ntl::status *waiter_status_ = nullptr;
  ntl::status *idle_waiter_status_ = nullptr;
  LONGLONG timer_rearm_milliseconds_ = 0;
  bool resume_queued_ = false;
  bool resume_active_ = false;
  bool idle_resume_queued_ = false;
  bool idle_resume_active_ = false;
  bool timer_reference_ = false;
  bool closed_ = false;
  ntl::status close_status_{STATUS_END_OF_FILE};
};

class read_awaiter_base {
public:
  read_awaiter_base(byte_stream_state *state, std::size_t requested,
                    read_options options,
                    std::shared_ptr<void> owning_lifetime = {}) noexcept
      : state_(state), requested_(requested), options_(options),
        owning_lifetime_(std::move(owning_lifetime)) {
    if (state_)
      state_->add_ref();
  }

  read_awaiter_base(const read_awaiter_base &) = delete;
  read_awaiter_base &operator=(const read_awaiter_base &) = delete;
  read_awaiter_base(read_awaiter_base &&) = delete;
  read_awaiter_base &operator=(read_awaiter_base &&) = delete;

  ~read_awaiter_base() {
    if (state_) {
      if (registered_)
        state_->abandon(continuation_);
      state_->release();
    }
  }

  bool await_ready() noexcept {
    if (!state_) {
      status_ = STATUS_INVALID_DEVICE_STATE;
      return true;
    }
    return state_->ready(requested_, options_, status_);
  }

  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    continuation_ = continuation;
    // Publish every awaiter field before the continuation becomes visible to
    // a producer. A completion worker is allowed to resume and destroy this
    // coroutine frame as soon as begin_wait() releases the state lock, so the
    // awaiter must not touch *this after that call starts.
    registered_ = true;
    return state_->begin_wait(continuation, requested_, options_, &status_);
  }

protected:
  ntl::status finish_wait() noexcept {
    registered_ = false;
    return status_;
  }

  byte_stream_state *state_ = nullptr;
  std::size_t requested_ = 0;

private:
  read_options options_{};
  std::coroutine_handle<> continuation_{};
  ntl::status status_{STATUS_PENDING};
  bool registered_ = false;
  std::shared_ptr<void> owning_lifetime_;
};

class cancel_and_drain_awaiter final {
public:
  explicit cancel_and_drain_awaiter(byte_stream_state *state) noexcept
      : state_(state) {
    if (state_) {
      state_->add_ref();
      state_->close(STATUS_CANCELLED);
    }
  }
  cancel_and_drain_awaiter(const cancel_and_drain_awaiter &) = delete;
  cancel_and_drain_awaiter &
  operator=(const cancel_and_drain_awaiter &) = delete;
  cancel_and_drain_awaiter(cancel_and_drain_awaiter &&) = delete;
  cancel_and_drain_awaiter &operator=(cancel_and_drain_awaiter &&) = delete;
  ~cancel_and_drain_awaiter() {
    if (state_) {
      if (registered_)
        state_->abandon_idle_wait(continuation_);
      state_->release();
    }
  }

  bool await_ready() noexcept {
    if (state_)
      return false;
    status_ = STATUS_INVALID_DEVICE_STATE;
    return true;
  }
  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    continuation_ = continuation;
    // An already-idle stream queues its resume worker inside
    // begin_idle_wait(). Commit before publishing the continuation and make
    // the registration call the final operation: the worker may complete and
    // destroy this frame before begin_idle_wait() returns on this CPU.
    registered_ = true;
    return state_->begin_idle_wait(continuation, &status_);
  }
  ntl::status await_resume() noexcept {
    registered_ = false;
    return status_;
  }

private:
  byte_stream_state *state_ = nullptr;
  std::coroutine_handle<> continuation_{};
  ntl::status status_{STATUS_PENDING};
  bool registered_ = false;
};

class read_into_awaiter final : public read_awaiter_base {
public:
  read_into_awaiter(byte_stream_state *state, std::span<std::byte> destination,
                    read_options options,
                    std::shared_ptr<void> owning_lifetime = {}) noexcept
      : read_awaiter_base(state, destination.size(), options,
                          std::move(owning_lifetime)),
        destination_(destination) {}

  ntl::status await_resume() noexcept {
    const ntl::status status = finish_wait();
    if (!status.is_ok())
      return status;
    return state_->consume(destination_);
  }

private:
  std::span<std::byte> destination_;
};

class read_some_awaiter final : public read_awaiter_base {
public:
  read_some_awaiter(byte_stream_state *state, std::span<std::byte> destination,
                    read_options options,
                    std::shared_ptr<void> owning_lifetime = {}) noexcept
      : read_awaiter_base(state, destination.empty() ? 0 : 1, options,
                          std::move(owning_lifetime)),
        destination_(destination) {}

  ntl::result<std::size_t> await_resume() noexcept {
    const ntl::status status = finish_wait();
    if (!status.is_ok())
      return ntl::unexpected(status);
    return state_->consume_some(destination_);
  }

private:
  std::span<std::byte> destination_;
};

template <class T> class read_value_awaiter final : public read_awaiter_base {
public:
  static_assert(std::is_trivially_copyable_v<T>,
                "read_exactly<T> requires a trivially copyable type");

  read_value_awaiter(byte_stream_state *state, read_options options,
                     std::shared_ptr<void> owning_lifetime = {}) noexcept
      : read_awaiter_base(state, sizeof(T), options,
                          std::move(owning_lifetime)) {}

  ntl::result<T> await_resume() noexcept {
    const ntl::status status = finish_wait();
    if (!status.is_ok())
      return ntl::unexpected(status);
    const ntl::status consumed =
        state_->consume(std::as_writable_bytes(std::span<T>(&value_, 1)));
    if (!consumed.is_ok())
      return ntl::unexpected(consumed);
    return ntl::ok(value_);
  }

private:
  T value_{};
};

} // namespace detail

/**
 * @brief Fixed-capacity, single-reader coroutine byte stream.
 *
 * Producers may append fragmented callback data without retaining it. Awaited
 * continuations always resume on the selected system work queue at
 * PASSIVE_LEVEL. One coroutine may wait at a time; a competing waiter
 * completes with STATUS_DEVICE_BUSY.
 *
 * This is the low-level producer/consumer primitive. A pending awaiter owns the
 * stream state, and an optional owning_lifetime retains its surrounding
 * operation, but destination spans still remain caller-owned through
 * await_resume(). Normal transport and TLS code should use
 * async_transport_stream, with_async_transport(), or with_tls_connection();
 * those owning facades cancel and join callbacks automatically. A custom
 * low-level coroutine may use cancel_and_drain() when it deliberately manages
 * its own structured task lifetime. The awaiter always crosses a work-queue
 * boundary so it cannot synchronously wait for its own resume callback.
 */
class async_byte_stream {
public:
  async_byte_stream() noexcept = default;
  async_byte_stream(const async_byte_stream &) = delete;
  async_byte_stream &operator=(const async_byte_stream &) = delete;

  async_byte_stream(async_byte_stream &&other) noexcept
      : state_(std::exchange(other.state_, nullptr)) {}

  async_byte_stream &operator=(async_byte_stream &&other) noexcept {
    if (this != &other) {
      reset();
      state_ = std::exchange(other.state_, nullptr);
    }
    return *this;
  }

  ~async_byte_stream() { reset(); }

  static ntl::result<async_byte_stream>
  try_create(std::size_t capacity,
             WORK_QUEUE_TYPE queue_type = DelayedWorkQueue) noexcept {
    if (capacity == 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    auto storage = ntl::net::owned_bytes::try_allocate(
        capacity, ntl::net::buffer_limits{capacity}, ntl::pool_tag("qAtN"));
    if (!storage)
      return ntl::unexpected(storage.status());

    auto state = ntl::try_make_pool<detail::byte_stream_state>(
        ntl::pool_kind::nonpaged, ntl::pool_option::none, ntl::pool_tag("sAtN"),
        std::move(*storage), queue_type);
    if (!state)
      return ntl::unexpected(state.status());
    return ntl::ok(async_byte_stream(state->release()));
  }

  explicit operator bool() const noexcept { return state_ != nullptr; }
  std::size_t capacity() const noexcept {
    return state_ ? state_->capacity() : 0;
  }
  std::size_t buffered_size() const noexcept {
    return state_ ? state_->buffered_size() : 0;
  }

  ntl::status append_received_data(ntl::net::scatter_view data) noexcept {
    return state_ ? state_->append(data)
                  : ntl::status{STATUS_INVALID_DEVICE_STATE};
  }

  detail::read_into_awaiter
  read_exactly_borrowed(std::span<std::byte> destination,
                        read_options options = {},
                        std::shared_ptr<void> owning_lifetime = {}) noexcept {
    return detail::read_into_awaiter(state_, destination, options,
                                     std::move(owning_lifetime));
  }

  detail::read_some_awaiter
  read_some_borrowed(std::span<std::byte> destination,
                     read_options options = {},
                     std::shared_ptr<void> owning_lifetime = {}) noexcept {
    return detail::read_some_awaiter(state_, destination, options,
                                     std::move(owning_lifetime));
  }

  template <class T>
  detail::read_value_awaiter<T>
  read_exactly(read_options options = {},
               std::shared_ptr<void> owning_lifetime = {}) noexcept {
    return detail::read_value_awaiter<T>(state_, options,
                                         std::move(owning_lifetime));
  }

  void close(ntl::status status = STATUS_END_OF_FILE) noexcept {
    if (state_)
      state_->close(status);
  }

  void cancel() noexcept {
    if (state_)
      state_->close(STATUS_CANCELLED);
  }

  [[nodiscard]] detail::cancel_and_drain_awaiter
  cancel_and_drain() noexcept {
    return detail::cancel_and_drain_awaiter(state_);
  }

  /** Wakes one pending read while keeping buffered data and the stream open. */
  void cancel_pending_read(
      ntl::status status = STATUS_CANCELLED) noexcept {
    if (state_)
      state_->cancel_pending_read(status);
  }

  void reset() noexcept {
    detail::byte_stream_state *const state = std::exchange(state_, nullptr);
    if (state) {
      state->close(STATUS_CANCELLED);
      state->release();
    }
  }

private:
  explicit async_byte_stream(detail::byte_stream_state *state) noexcept
      : state_(state) {}

  detail::byte_stream_state *state_ = nullptr;
};

