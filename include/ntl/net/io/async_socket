/** Lifetime-safe awaiter for one or more stream-socket transfers. */
class detail_socket_operation {
public:
  using transfer_kind = detail::socket_transfer_kind;

  detail_socket_operation(
      std::shared_ptr<detail::async_socket_state> socket,
      std::span<std::byte> bytes, transfer_kind kind)
      : state_(std::make_shared<detail::socket_transfer_state>(
            std::move(socket), bytes, kind)) {}
  detail_socket_operation(
      std::shared_ptr<detail::async_socket_state> socket,
      std::span<const std::byte> bytes, transfer_kind kind)
      : state_(std::make_shared<detail::socket_transfer_state>(
            std::move(socket), bytes, kind)) {}
  detail_socket_operation(const detail_socket_operation &) = delete;
  detail_socket_operation &operator=(const detail_socket_operation &) = delete;
  detail_socket_operation(detail_socket_operation &&) noexcept = default;
  detail_socket_operation &operator=(detail_socket_operation &&) noexcept =
      default;
  ~detail_socket_operation() {
    if (state_)
      state_->abandon();
  }

  bool await_ready() noexcept { return state_->ready(); }
  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    return state_->start(continuation);
  }
  std::size_t await_resume() {
    auto state = std::exchange(state_, {});
    return state->result();
  }

private:
  std::shared_ptr<detail::socket_transfer_state> state_;
};

/** Lifetime-safe awaiter for one ConnectEx operation. */
class detail_socket_connect_operation {
public:
  detail_socket_connect_operation(
      std::shared_ptr<detail::async_socket_state> socket,
      const sockaddr *address, int address_size)
      : state_(std::make_shared<detail::socket_connect_state>(
            std::move(socket), address, address_size)) {}
  detail_socket_connect_operation(const detail_socket_connect_operation &) =
      delete;
  detail_socket_connect_operation &operator=(
      const detail_socket_connect_operation &) = delete;
  detail_socket_connect_operation(detail_socket_connect_operation &&) noexcept =
      default;
  detail_socket_connect_operation &operator=(
      detail_socket_connect_operation &&) noexcept = default;
  ~detail_socket_connect_operation() {
    if (state_)
      state_->abandon();
  }

  bool await_ready() noexcept { return state_->ready(); }
  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    return state_->start(continuation);
  }
  void await_resume() {
    auto state = std::exchange(state_, {});
    state->result();
  }

private:
  std::shared_ptr<detail::socket_connect_state> state_;
};

/** Move-only owning facade for one overlapped socket. */
class async_socket {
public:
  async_socket() noexcept = default;

  async_socket(io_completion_context &context, SOCKET socket) {
    if (socket == INVALID_SOCKET)
      throw std::system_error(WSAENOTSOCK, std::system_category(),
                              "async_socket");
    auto runtime = context.state_.load(std::memory_order_acquire);
    if (!runtime || runtime->closing()) {
      (void)::closesocket(socket);
      throw std::system_error(ERROR_OPERATION_ABORTED,
                              std::system_category(),
                              "async_socket runtime is closing");
    }
    auto state = std::make_shared<detail::async_socket_state>(runtime, socket);
    try {
      runtime->associate(state, socket);
    } catch (...) {
      state->close();
      throw;
    }
    state_.store(std::move(state), std::memory_order_release);
  }

  async_socket(const async_socket &) = delete;
  async_socket &operator=(const async_socket &) = delete;
  async_socket(async_socket &&other) noexcept
      : state_(other.state_.exchange(
            {}, std::memory_order_acq_rel)) {}
  async_socket &operator=(async_socket &&other) noexcept {
    if (this != &other) {
      release_owner();
      state_.store(
          other.state_.exchange({}, std::memory_order_acq_rel),
          std::memory_order_release);
    }
    return *this;
  }

  ~async_socket() { release_owner(); }

  explicit operator bool() const noexcept {
    auto state = state_.load(std::memory_order_acquire);
    return state && state->borrowed_native_handle() != INVALID_SOCKET;
  }

  /** Borrowed snapshot; it may become invalid immediately after return. */
  SOCKET borrowed_native_handle() const noexcept {
    auto state = state_.load(std::memory_order_acquire);
    return state ? state->borrowed_native_handle() : INVALID_SOCKET;
  }

  /** Returns another owning facade for the same native socket state. */
  async_socket share() const noexcept {
    auto state = state_.load(std::memory_order_acquire);
    if (state)
      state->add_owner();
    return async_socket(std::move(state), adopt_owner_t{});
  }

  detail_socket_operation
  read_some_borrowed(std::span<std::byte> destination) {
    return detail_socket_operation(
        state_.load(std::memory_order_acquire), destination,
        detail_socket_operation::transfer_kind::read_some);
  }

  detail_socket_operation
  read_exactly_borrowed(std::span<std::byte> destination) {
    return detail_socket_operation(
        state_.load(std::memory_order_acquire), destination,
        detail_socket_operation::transfer_kind::read_exactly);
  }

  detail_socket_operation write_all(std::span<const std::byte> source) {
    return detail_socket_operation(
        state_.load(std::memory_order_acquire), source,
        detail_socket_operation::transfer_kind::write_all);
  }

  detail_socket_connect_operation connect(const sockaddr *address,
                                           int address_size) {
    return detail_socket_connect_operation(
        state_.load(std::memory_order_acquire), address, address_size);
  }

  bool cancel() noexcept {
    auto state = state_.load(std::memory_order_acquire);
    return state && state->cancel();
  }

  void close() noexcept {
    auto state = state_.exchange({}, std::memory_order_acq_rel);
    if (state) {
      state->close();
      state->release_owner();
    }
  }

private:
  template <class> friend class async_framed_stream;

  struct adopt_owner_t {};
  async_socket(std::shared_ptr<detail::async_socket_state> state,
               adopt_owner_t) noexcept
      : state_(std::move(state)) {}

  void release_owner() noexcept {
    auto state = state_.exchange({}, std::memory_order_acq_rel);
    if (state)
      state->release_owner();
  }

  std::atomic<std::shared_ptr<detail::async_socket_state>> state_;
};

