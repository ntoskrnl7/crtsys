namespace ntl::net {

template <class Framer> class tls_framed_stream;

/** Owning result for one complete framed message. */
class framed_message {
public:
  framed_message() = default;

  std::span<const std::byte> frame() const noexcept { return bytes_; }
  std::span<const std::byte> content() const noexcept {
    if (content_offset_ > bytes_.size() ||
        content_size_ > bytes_.size() - content_offset_)
      return {};
    return std::span<const std::byte>(bytes_.data() + content_offset_,
                                      content_size_);
  }
  bool empty() const noexcept { return bytes_.empty(); }
  std::size_t size() const noexcept { return bytes_.size(); }

private:
  template <class> friend class async_framed_stream;
  template <class> friend class tls_framed_stream;

  framed_message(std::vector<std::byte> bytes, std::size_t content_offset,
                 std::size_t content_size) noexcept
      : bytes_(std::move(bytes)), content_offset_(content_offset),
        content_size_(content_size) {}

  std::vector<std::byte> bytes_;
  std::size_t content_offset_ = 0;
  std::size_t content_size_ = 0;
};

/**
 * @brief Bounded single-reader framed stream that owns its async socket.
 *
 * A read task retains the stream state through completion. Destroying or
 * closing the facade cancels the native socket, while the callback continues
 * to reference valid state until IOCP reports completion.
 */
#if defined(_MSC_VER) && defined(_M_ARM64)
#pragma warning(push)
// MSVC's ARM64 atomic storage is over-aligned. shared_state is private and its
// intentional tail padding is never part of a wire or public binary layout.
#pragma warning(disable : 4324)
#endif
template <class Framer> class async_framed_stream {
public:
  async_framed_stream(async_socket socket, Framer framer,
                      ntl::net::framing::frame_limits limits = {},
                      std::size_t receive_chunk_size = 4096) {
    if (!socket || limits.maximum_frame_size == 0 ||
        receive_chunk_size == 0)
      throw std::invalid_argument(
          "async_framed_stream requires a socket and positive limits");
    state_ = std::make_shared<shared_state>(
        std::move(socket), std::move(framer), limits,
        receive_chunk_size);
  }

  async_framed_stream(async_socket &socket, Framer framer,
                      ntl::net::framing::frame_limits limits = {},
                      std::size_t receive_chunk_size = 4096)
      : async_framed_stream(socket.share(), std::move(framer), limits,
                            receive_chunk_size) {}

  async_framed_stream(const async_framed_stream &) = delete;
  async_framed_stream &operator=(const async_framed_stream &) = delete;
  async_framed_stream(async_framed_stream &&other) noexcept
      : state_(other.state_.exchange({}, std::memory_order_acq_rel)) {}
  async_framed_stream &operator=(async_framed_stream &&other) noexcept {
    if (this != &other) {
      close();
      state_.store(
          other.state_.exchange({}, std::memory_order_acq_rel),
          std::memory_order_release);
    }
    return *this;
  }

  ~async_framed_stream() { close(); }

  void close() noexcept {
    auto state = state_.exchange({}, std::memory_order_acq_rel);
    if (state)
      state->socket.close();
  }

  std::size_t buffered_size() const noexcept {
    auto state = state_.load(std::memory_order_acquire);
    return state ? state->buffered_size.load(std::memory_order_acquire) : 0;
  }
  std::size_t maximum_frame_size() const noexcept {
    auto state = state_.load(std::memory_order_acquire);
    return state ? state->limits.maximum_frame_size : 0;
  }

  ntl::net::user::task<framed_message> read_frame() {
    return read_frame_impl(state_.load(std::memory_order_acquire));
  }

private:
  struct shared_state {
    shared_state(async_socket socket_value, Framer framer_value,
                 ntl::net::framing::frame_limits limits_value,
                 std::size_t receive_chunk_size_value)
        : socket(std::move(socket_value)), framer(std::move(framer_value)),
          limits(limits_value),
          receive_chunk_size(receive_chunk_size_value) {}

    void reset_framer() noexcept {
      if constexpr (requires(Framer &value) { value.reset(); })
        framer.reset();
    }

    async_socket socket;
    Framer framer;
    ntl::net::framing::frame_limits limits{};
    std::size_t receive_chunk_size = 4096;
    std::vector<std::byte> buffer;
    std::atomic<std::size_t> buffered_size{0};
    std::atomic<bool> reading{false};
  };

  static DWORD map_status(NTSTATUS status) noexcept {
    switch (status) {
    case STATUS_BUFFER_OVERFLOW:
    case STATUS_BUFFER_TOO_SMALL:
      return ERROR_BUFFER_OVERFLOW;
    case STATUS_INSUFFICIENT_RESOURCES:
      return ERROR_NOT_ENOUGH_MEMORY;
    case STATUS_IO_TIMEOUT:
      return ERROR_TIMEOUT;
    case STATUS_CANCELLED:
      return ERROR_OPERATION_ABORTED;
    case STATUS_END_OF_FILE:
      return ERROR_HANDLE_EOF;
    default:
      return ERROR_INVALID_DATA;
    }
  }

  static ntl::net::user::task<framed_message>
  read_frame_impl(std::shared_ptr<shared_state> state) {
    if (!state || !state->socket)
      throw std::system_error(WSAENOTSOCK, std::system_category(),
                              "async_framed_stream::read_frame");
    if (state->reading.exchange(true, std::memory_order_acq_rel))
      throw std::system_error(ERROR_BUSY, std::system_category(),
                              "async_framed_stream::read_frame");
    struct reader_release {
      std::shared_ptr<shared_state> state;
      ~reader_release() {
        if (state)
          state->reading.store(false, std::memory_order_release);
      }
    } release{state};

    for (;;) {
      const auto bytes = ntl::net::scatter_view::from_contiguous(
          std::span<const std::byte>(state->buffer.data(),
                                     state->buffer.size()));
      const auto probe = ntl::net::framing::probe(
          state->framer, bytes, state->limits);
      if (probe.state() == ntl::net::framing::probe_state::complete) {
        std::vector<std::byte> frame(probe.frame_size());
        if (!frame.empty())
          std::memcpy(frame.data(), state->buffer.data(), frame.size());
        state->buffer.erase(
            state->buffer.begin(),
            state->buffer.begin() +
                static_cast<std::ptrdiff_t>(frame.size()));
        state->buffered_size.store(state->buffer.size(),
                                   std::memory_order_release);
        state->reset_framer();
        co_return framed_message(std::move(frame), probe.content_offset(),
                                 probe.content_size());
      }
      if (probe.state() == ntl::net::framing::probe_state::malformed)
        throw std::system_error(
            static_cast<int>(map_status(probe.error())),
            std::system_category(), "async_framed_stream::read_frame");

      const std::size_t current = state->buffer.size();
      if (current >= state->limits.maximum_frame_size)
        throw std::system_error(ERROR_BUFFER_OVERFLOW,
                                std::system_category(),
                                "async_framed_stream::read_frame");
      const std::size_t room = state->limits.maximum_frame_size - current;
      const std::size_t growth =
          (std::min)(state->receive_chunk_size, room);
      const std::size_t target =
          (std::max)(probe.required_total(), current + growth);
      if (target <= current || target > state->limits.maximum_frame_size)
        throw std::system_error(ERROR_BUFFER_OVERFLOW,
                                std::system_category(),
                                "async_framed_stream::read_frame");

      state->buffer.resize(target);
      state->buffered_size.store(state->buffer.size(),
                                 std::memory_order_release);
      const std::size_t received = co_await detail_socket_operation(
          state->socket.state_,
          std::span<std::byte>(state->buffer.data() + current,
                               target - current),
          detail_socket_operation::transfer_kind::read_some);
      state->buffer.resize(current + received);
      state->buffered_size.store(state->buffer.size(),
                                 std::memory_order_release);
      if (received != 0)
        continue;

      const auto final_bytes = ntl::net::scatter_view::from_contiguous(
          std::span<const std::byte>(state->buffer.data(),
                                     state->buffer.size()));
      const auto final = ntl::net::framing::finish(
          state->framer, final_bytes, state->limits);
      if (final.state() != ntl::net::framing::probe_state::complete)
        throw std::system_error(
            static_cast<int>(map_status(final.error())),
            std::system_category(), "async_framed_stream::read_frame");
      std::vector<std::byte> frame(final.frame_size());
      if (!frame.empty())
        std::memcpy(frame.data(), state->buffer.data(), frame.size());
      state->buffer.erase(
          state->buffer.begin(),
          state->buffer.begin() + static_cast<std::ptrdiff_t>(frame.size()));
      state->buffered_size.store(state->buffer.size(),
                                 std::memory_order_release);
      state->reset_framer();
      co_return framed_message(std::move(frame), final.content_offset(),
                               final.content_size());
    }
  }

  std::atomic<std::shared_ptr<shared_state>> state_;
};
#if defined(_MSC_VER) && defined(_M_ARM64)
#pragma warning(pop)
#endif

} // namespace ntl::net
