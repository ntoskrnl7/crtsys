/**
 * @file codec_memory
 * @brief Per-stream bounded allocation budget for native content codecs.
 *
 * Codec callbacks may be used by user-mode and kernel-mode backends. Kernel
 * allocations use nonpaged pool and are restricted to PASSIVE_LEVEL because
 * the surrounding owning codec API uses STL containers and exceptions.
 *
 * @copyright Copyright (c) 2022 NT Template Library Authors.
 */
#pragma once

#include <atomic>
#include <cstddef>
#include <limits>
#include <new>
#include <span>

#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
#include <ntl/pool_allocator>
#endif

namespace ntl::net::inspection {

struct codec_memory_limits {
  std::size_t maximum_allocated_bytes = 32 * 1024 * 1024;
  std::size_t maximum_single_allocation = 16 * 1024 * 1024;
};

/**
 * @brief Accounts every allocation made by one codec stream.
 *
 * The object must outlive the native codec state that receives its callbacks.
 * Allocation and release are thread-safe, although an individual codec stream
 * must still obey its backend's single-caller rule.
 */
class codec_memory_budget {
public:
  explicit codec_memory_budget(codec_memory_limits limits = {}) noexcept
      : limits_(limits) {}

  codec_memory_budget(const codec_memory_budget &) = delete;
  codec_memory_budget &operator=(const codec_memory_budget &) = delete;

  void *allocate(std::size_t bytes) noexcept {
    if (bytes == 0)
      bytes = 1;
    if (limits_.maximum_allocated_bytes == 0 ||
        limits_.maximum_single_allocation == 0 ||
        bytes > limits_.maximum_single_allocation ||
        bytes > limits_.maximum_allocated_bytes ||
        bytes > (std::numeric_limits<std::size_t>::max)() -
                    sizeof(allocation_header))
      return nullptr;

#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    if (KeGetCurrentIrql() != PASSIVE_LEVEL)
      return nullptr;
#endif

    std::size_t current = allocated_.load(std::memory_order_relaxed);
    for (;;) {
      if (current > limits_.maximum_allocated_bytes - bytes)
        return nullptr;
      if (allocated_.compare_exchange_weak(
              current, current + bytes, std::memory_order_acq_rel,
              std::memory_order_relaxed))
        break;
    }

    const std::size_t total = sizeof(allocation_header) + bytes;
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    void *const raw = ntl::allocate_pool(
        total, ntl::pool_kind::nonpaged, ntl::pool_option::none,
        ntl::pool_tag("cNtN"));
#else
    void *const raw = ::operator new(total, std::nothrow);
#endif
    if (!raw) {
      allocated_.fetch_sub(bytes, std::memory_order_release);
      return nullptr;
    }

    auto *const header = static_cast<allocation_header *>(raw);
    header->bytes = bytes;
    update_peak(current + bytes);
    return header + 1;
  }

  void *allocate_array(std::size_t count, std::size_t size) noexcept {
    if (count != 0 &&
        size > (std::numeric_limits<std::size_t>::max)() / count)
      return nullptr;
    return allocate(count * size);
  }

  void release(void *pointer) noexcept {
    if (!pointer)
      return;
    auto *const header = static_cast<allocation_header *>(pointer) - 1;
    const std::size_t bytes = header->bytes;
    allocated_.fetch_sub(bytes, std::memory_order_release);
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    ntl::free_pool(header, ntl::pool_tag("cNtN"));
#else
    ::operator delete(header);
#endif
  }

  std::size_t allocated_bytes() const noexcept {
    return allocated_.load(std::memory_order_acquire);
  }

  std::size_t peak_allocated_bytes() const noexcept {
    return peak_.load(std::memory_order_acquire);
  }

  codec_memory_limits limits() const noexcept { return limits_; }

private:
  union allocation_header {
    std::max_align_t alignment;
    std::size_t bytes;
  };

  void update_peak(std::size_t value) noexcept {
    std::size_t peak = peak_.load(std::memory_order_relaxed);
    while (peak < value &&
           !peak_.compare_exchange_weak(
               peak, value, std::memory_order_release,
               std::memory_order_relaxed)) {
    }
  }

  codec_memory_limits limits_{};
  std::atomic<std::size_t> allocated_{0};
  std::atomic<std::size_t> peak_{0};
};

/**
 * @brief Explicitly borrowed bounded scratch storage for one codec stream.
 *
 * Kernel builds obtain nonpaged memory through codec_memory_budget instead of
 * placing large native-codec work buffers on the limited kernel stack. The
 * referenced budget must outlive this low-level helper; ordinary codec
 * adapters own both objects and do not expose that ordering requirement.
 */
class borrowed_codec_scratch_buffer {
public:
  explicit borrowed_codec_scratch_buffer(codec_memory_budget &memory) noexcept
      : memory_(&memory) {}
  borrowed_codec_scratch_buffer(const borrowed_codec_scratch_buffer &) = delete;
  borrowed_codec_scratch_buffer &operator=(const borrowed_codec_scratch_buffer &) = delete;
  ~borrowed_codec_scratch_buffer() { reset(); }

  bool ensure(std::size_t size) noexcept {
    if (storage_)
      return size <= size_;
    if (size == 0)
      return false;
    storage_ = static_cast<std::byte *>(memory_->allocate(size));
    if (!storage_)
      return false;
    size_ = size;
    return true;
  }

  void reset() noexcept {
    if (storage_)
      memory_->release(storage_);
    storage_ = nullptr;
    size_ = 0;
  }

  std::span<std::byte> bytes() const noexcept {
    return {storage_, size_};
  }

private:
  codec_memory_budget *memory_ = nullptr;
  std::byte *storage_ = nullptr;
  std::size_t size_ = 0;
};

} // namespace ntl::net::inspection
