inline constexpr std::uint64_t h3_internal_error = 0x102;
inline constexpr std::uint64_t qpack_encoder_stream_type = 0x02;
inline constexpr std::uint64_t qpack_decoder_stream_type = 0x03;
inline constexpr std::uint64_t webtransport_bidirectional_signal = 0x41;

struct connection_limits {
  std::size_t maximum_streams = 1024;
  std::size_t maximum_receive_indication = 1024 * 1024;
  std::size_t maximum_send_size = 4 * 1024 * 1024;
  std::size_t maximum_prefix_bytes = 8;
  std::chrono::milliseconds shutdown_timeout{
      std::chrono::seconds(15)};
};

struct peer_stream_statistics {
  std::uint64_t bidirectional_started = 0;
  std::uint64_t unidirectional_started = 0;
  std::uint64_t receive_events = 0;
  std::uint64_t receive_fin_events = 0;
  std::uint64_t peer_send_shutdown_events = 0;
  std::uint64_t request_streams_classified = 0;
  std::uint64_t request_sink_calls = 0;
  std::uint64_t request_sink_final_calls = 0;
  std::int32_t last_request_sink_status = STATUS_SUCCESS;
};

/**
 * Identifies the logical HTTP/3 peer independently from its routed endpoint.
 *
 * `server_name` is used for SNI and certificate validation. When
 * `remote_address` is present, MsQuic sends to that address instead of
 * resolving `server_name`; the address port may be zero and is then filled
 * from `port`. This is useful for transparent proxies and service discovery
 * without weakening peer identity validation.
 */
struct connection_target {
  std::string server_name;
  std::uint16_t port = 0;
  QUIC_ADDRESS_FAMILY family = QUIC_ADDRESS_FAMILY_UNSPEC;
  std::optional<QUIC_ADDR> remote_address;
};

/**
 * Native MsQuic handles plus the owning state which keeps them valid.
 * User and kernel configuration facades both produce this value; callers do
 * not manage provider/registration/configuration destruction order.
 */
class connection;

class connection_context {
public:
  connection_context() noexcept = default;

  /**
   * Retains the native owner while presenting explicitly borrowed handles to
   * MsQuic. Normal callers obtain this value from an owning configuration.
   */
  static connection_context retain_borrowed_native(
      const QUIC_API_TABLE *api, HQUIC registration, HQUIC configuration,
      std::shared_ptr<void> native_owner) noexcept {
    connection_context result;
    result.api_ = api;
    result.registration_ = registration;
    result.configuration_ = configuration;
    result.native_owner_ = std::move(native_owner);
    return result;
  }

  explicit operator bool() const noexcept {
    return api_ && registration_ && configuration_ && native_owner_;
  }

  const QUIC_API_TABLE *borrowed_native_api() const noexcept { return api_; }
  HQUIC borrowed_native_registration() const noexcept { return registration_; }
  HQUIC borrowed_native_configuration() const noexcept {
    return configuration_;
  }

private:
  friend class connection;
  const QUIC_API_TABLE *api_ = nullptr;
  HQUIC registration_ = nullptr;
  HQUIC configuration_ = nullptr;
  std::shared_ptr<void> native_owner_;
};

/** Callback-scoped metadata. String fields borrow the MsQuic indication. */
struct accepted_connection_info_view {
  std::string_view server_name;
  std::string_view negotiated_alpn;
  QUIC_ADDR local_address{};
  QUIC_ADDR remote_address{};
  bool has_local_address = false;
  bool has_remote_address = false;
};

/**
 * Move-only callback-scoped access to a newly indicated MsQuic connection.
 *
 * A listener sink either moves this value into `connection::try_accept*()`
 * before returning or rejects the indication. It owns no native handle and
 * must not be stored beyond the listener callback.
 */
class borrowed_accepted_connection {
public:
  borrowed_accepted_connection() noexcept = default;
  borrowed_accepted_connection(const borrowed_accepted_connection &) = delete;
  borrowed_accepted_connection &
  operator=(const borrowed_accepted_connection &) = delete;
  borrowed_accepted_connection(borrowed_accepted_connection &&other) noexcept
      : native_(std::exchange(other.native_, nullptr)),
        information_(other.information_) {}
  borrowed_accepted_connection &
  operator=(borrowed_accepted_connection &&other) noexcept {
    if (this != &other) {
      native_ = std::exchange(other.native_, nullptr);
      information_ = other.information_;
    }
    return *this;
  }

  static borrowed_accepted_connection from_native(
      HQUIC native,
      const QUIC_NEW_CONNECTION_INFO &source) noexcept {
    borrowed_accepted_connection result;
    result.native_ = native;
    result.information_.server_name =
        source.ServerName && source.ServerNameLength != 0
            ? std::string_view(source.ServerName, source.ServerNameLength)
            : std::string_view{};
    result.information_.negotiated_alpn =
        source.NegotiatedAlpn && source.NegotiatedAlpnLength != 0
            ? std::string_view(
                  reinterpret_cast<const char *>(source.NegotiatedAlpn),
                  source.NegotiatedAlpnLength)
            : std::string_view{};
    if (source.LocalAddress) {
      result.information_.local_address = *source.LocalAddress;
      result.information_.has_local_address = true;
    }
    if (source.RemoteAddress) {
      result.information_.remote_address = *source.RemoteAddress;
      result.information_.has_remote_address = true;
    }
    return result;
  }

  explicit operator bool() const noexcept { return native_ != nullptr; }
  accepted_connection_info_view information() const noexcept {
    return information_;
  }
  HQUIC borrowed_native_handle() const noexcept { return native_; }

private:
  friend class connection;
  HQUIC release_native_handle() noexcept {
    return std::exchange(native_, nullptr);
  }

  HQUIC native_ = nullptr;
  accepted_connection_info_view information_{};
};

enum class connection_role : std::uint8_t {
  client,
  server,
};

