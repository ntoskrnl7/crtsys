namespace detail {

inline ntl::status from_quic_status(
    QUIC_STATUS value) noexcept {
  return QUIC_SUCCEEDED(value)
             ? ntl::status::ok()
             : ntl::status{static_cast<NTSTATUS>(value)};
}

struct send_context {
  explicit send_context(
      ntl::net::scatter_view source,
      std::size_t maximum) {
    if (source.size() > maximum)
      throw std::length_error(
          "MsQuic send exceeds the configured bound");
    bytes.resize(source.size());
    if (!bytes.empty()) {
      const ntl::status copied = source.copy_to(bytes);
      if (!copied.is_ok())
        throw std::runtime_error(
            "MsQuic send source could not be copied");
    }
    buffer.Length = static_cast<std::uint32_t>(bytes.size());
    buffer.Buffer =
        reinterpret_cast<std::uint8_t *>(bytes.data());
  }

  QUIC_BUFFER buffer{};
  std::vector<std::byte> bytes;
};

} // namespace detail

/**
 * @brief Owns one already-configured or newly-started MsQuic connection.
 *
 * `try_connect()` is the client factory. `try_accept()` is called from a
 * QUIC_LISTENER_EVENT_NEW_CONNECTION callback before that callback returns.
 * Both install all callbacks before the handshake can deliver application
 * data. The ordinary factories retain a shared sink. The explicitly named
 * `*_borrowed` factories are the only variants that require an external sink
 * lifetime.
 */
class connection final : public ntl::net::quic::transport_backend {
public:
  peer_stream_statistics peer_streams() const noexcept {
    return {
        .bidirectional_started =
            peer_bidirectional_started_.load(std::memory_order_relaxed),
        .unidirectional_started =
            peer_unidirectional_started_.load(std::memory_order_relaxed),
        .receive_events =
            peer_receive_events_.load(std::memory_order_relaxed),
        .receive_fin_events =
            peer_receive_fin_events_.load(std::memory_order_relaxed),
        .peer_send_shutdown_events =
            peer_send_shutdown_events_.load(std::memory_order_relaxed),
        .request_streams_classified =
            request_streams_classified_.load(std::memory_order_relaxed),
        .request_sink_calls =
            request_sink_calls_.load(std::memory_order_relaxed),
        .request_sink_final_calls =
            request_sink_final_calls_.load(std::memory_order_relaxed),
        .last_request_sink_status =
            last_request_sink_status_.load(std::memory_order_relaxed),
    };
  }

  connection(const connection &) = delete;
  connection &operator=(const connection &) = delete;

  ~connection() override {
    if (handle_) {
      stop();
      // Destruction runs on the owning cleanup domain, never in an MsQuic
      // callback. Prefer the graceful shutdown barrier, but do not let a
      // missing SHUTDOWN_COMPLETE callback pin that domain (and therefore
      // RegistrationClose or driver unload) forever. ConnectionClose is the
      // documented abortive cleanup path when graceful shutdown did not
      // complete; it synchronously retires the native handle before this
      // object's callback state is released.
      (void)wait_for_shutdown(limits_.shutdown_timeout);
      close_handles();
    }
  }

  static ntl::result<std::shared_ptr<connection>>
  try_connect(
      connection_context configured,
      connection_target target,
      std::shared_ptr<ntl::net::quic::backend_sink> sink,
      connection_limits limits = {}) noexcept {
    if (!configured || !sink)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (!configured.api_ || !configured.registration_ ||
        !configured.configuration_ || !valid_target(target) ||
        !valid_limits(limits))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    try {
      auto result = adopt(new (std::nothrow) connection(
          configured.api_, std::move(sink), connection_role::client, limits,
          std::move(configured.native_owner_)));
      if (!result)
        return ntl::unexpected(result.status());
      const ntl::status started = (*result)->start_client(
          std::static_pointer_cast<ntl::net::quic::transport_backend>(*result),
          configured.registration_, configured.configuration_,
          std::move(target));
      if (!started.is_ok())
        return ntl::unexpected(started);
      return ntl::ok(std::move(*result));
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }

  static ntl::result<std::shared_ptr<connection>>
  try_connect(
      connection_context configured,
      std::string server_name,
      std::uint16_t port,
      std::shared_ptr<ntl::net::quic::backend_sink> sink,
      QUIC_ADDRESS_FAMILY family =
          QUIC_ADDRESS_FAMILY_UNSPEC,
      connection_limits limits = {}) noexcept {
    return try_connect(
        std::move(configured),
        {.server_name = std::move(server_name),
         .port = port,
         .family = family},
        std::move(sink), limits);
  }

  static ntl::result<std::shared_ptr<connection>>
  try_connect_borrowed(
      const QUIC_API_TABLE *api,
      HQUIC registration,
      HQUIC configuration,
      connection_target target,
      ntl::net::quic::backend_sink &sink,
      connection_limits limits = {}) noexcept {
    if (!api || !registration || !configuration ||
        !valid_target(target) ||
        !valid_limits(limits))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    try {
      auto result = adopt(new (std::nothrow) connection(
          api, sink, connection_role::client, limits, {}));
      if (!result)
        return ntl::unexpected(result.status());

      HQUIC handle = nullptr;
      const QUIC_STATUS opened = api->ConnectionOpen(
          registration, &connection_callback, result->get(),
          &handle);
      if (QUIC_FAILED(opened))
        return ntl::unexpected(detail::from_quic_status(opened));
      (*result)->handle_ = handle;

      const ntl::status remote =
          configure_remote_address(api, handle, target);
      if (!remote.is_ok()) {
        (*result)->release_unstarted_connection();
        return ntl::unexpected(remote);
      }

      const ntl::status attached = (*result)->invoke_sink(
          [&] {
            return sink.on_transport_ready(
                std::static_pointer_cast<
                    ntl::net::quic::transport_backend>(*result));
          });
      if (!attached.is_ok()) {
        (*result)->release_unstarted_connection();
        return ntl::unexpected(attached);
      }

      const QUIC_STATUS started = api->ConnectionStart(
          handle, configuration, target.family, target.server_name.c_str(),
          target.port);
      if (QUIC_FAILED(started)) {
        (*result)->release_unstarted_connection();
        return ntl::unexpected(detail::from_quic_status(started));
      }
      (*result)->started_.store(true, std::memory_order_release);
      return ntl::ok(std::move(*result));
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(
          STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }

  static ntl::result<std::shared_ptr<connection>>
  try_accept(
      connection_context configured,
      borrowed_accepted_connection accepted,
      std::shared_ptr<ntl::net::quic::backend_sink> sink,
      connection_limits limits = {}) noexcept {
    if (!configured || !sink)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (!configured.api_ || !accepted ||
        !configured.configuration_ || !valid_limits(limits))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    try {
      auto result = adopt(new (std::nothrow) connection(
          configured.api_, std::move(sink), connection_role::server, limits,
          std::move(configured.native_owner_)));
      if (!result)
        return ntl::unexpected(result.status());
      const ntl::status started = (*result)->start_server(
          std::static_pointer_cast<ntl::net::quic::transport_backend>(*result),
          accepted.release_native_handle(), configured.configuration_);
      if (!started.is_ok())
        return ntl::unexpected(started);
      return ntl::ok(std::move(*result));
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }

  static ntl::result<std::shared_ptr<connection>>
  try_connect_borrowed(
      const QUIC_API_TABLE *api,
      HQUIC registration,
      HQUIC configuration,
      std::string server_name,
      std::uint16_t port,
      ntl::net::quic::backend_sink &sink,
      QUIC_ADDRESS_FAMILY family =
          QUIC_ADDRESS_FAMILY_UNSPEC,
      connection_limits limits = {}) noexcept {
    return try_connect_borrowed(
        api, registration, configuration,
        {.server_name = std::move(server_name),
         .port = port,
         .family = family},
        sink, limits);
  }

  static ntl::result<std::shared_ptr<connection>>
  try_accept_borrowed(
      const QUIC_API_TABLE *api,
      borrowed_accepted_connection accepted,
      HQUIC configuration,
      ntl::net::quic::backend_sink &sink,
      connection_limits limits = {}) noexcept {
    if (!api || !accepted || !configuration ||
        !valid_limits(limits))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    try {
      auto result = adopt(new (std::nothrow) connection(
          api, sink, connection_role::server, limits, {}));
      if (!result)
        return ntl::unexpected(result.status());
      (*result)->handle_ = accepted.release_native_handle();
      api->SetCallbackHandler(
          (*result)->handle_,
          reinterpret_cast<void *>(&connection_callback),
          result->get());
      const ntl::status attached = (*result)->invoke_sink(
          [&] {
            return sink.on_transport_ready(
                std::static_pointer_cast<
                    ntl::net::quic::transport_backend>(*result));
          });
      if (!attached.is_ok()) {
        (*result)->release_rejected_connection();
        return ntl::unexpected(attached);
      }
      const QUIC_STATUS configured =
          api->ConnectionSetConfiguration(
              (*result)->handle_, configuration);
      if (QUIC_FAILED(configured)) {
        (*result)->release_rejected_connection();
        return ntl::unexpected(detail::from_quic_status(configured));
      }
      (*result)->started_.store(true, std::memory_order_release);
      return ntl::ok(std::move(*result));
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(
          STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }

  ntl::net::quic::backend_capabilities
  capabilities() const noexcept override {
    auto result = msquic_backend::capabilities;
    result.origin_client =
        role_ == connection_role::client;
    return result;
  }

  ntl::status run_borrowed(
      ntl::net::quic::backend_sink &sink) noexcept override {
    if (&sink != sink_)
      return STATUS_INVALID_PARAMETER;
    std::unique_lock lock(state_lock_);
    state_changed_.wait(lock, [this] { return drained_locked(); });
    return terminal_status_;
  }

  ntl::status write_stream(
      std::uint64_t stream_id,
      ntl::net::scatter_view plaintext,
      bool final) noexcept override {
    if ((!plaintext && !final) ||
        plaintext.size() > limits_.maximum_send_size)
      return STATUS_INVALID_PARAMETER;
    auto stream = find_stream(stream_id);
    if (!stream)
      return STATUS_NOT_FOUND;
    return send_on_stream(std::move(stream), plaintext, final);
  }

  /**
   * Opens the one mandatory QPACK decoder stream before encoder callbacks
   * begin.  Preparing it outside a peer-stream callback also avoids making
   * stream-credit acquisition part of QPACK unblock processing.
   */
  ntl::status prepare_qpack_decoder_stream() noexcept override {
    // Opening the mandatory decoder stream is a one-time operation. Keep the
    // check, stream creation, type prefix, and publication in one critical
    // section so concurrent QPACK acknowledgements cannot create two decoder
    // streams and strand one of them.
    std::lock_guard qpack_guard(qpack_stream_lock_);
    std::uint64_t stream_id = 0;
    {
      std::lock_guard guard(state_lock_);
      stream_id = qpack_decoder_stream_id_;
    }
    if (stream_id == invalid_stream_id) {
      const ntl::status opened =
          open_unidirectional_stream(stream_id);
      if (!opened.is_ok())
        return opened;
      std::vector<std::byte> prefix;
      const ntl::status encoded = append_quic_varint(
          prefix, qpack_decoder_stream_type);
      if (!encoded.is_ok())
        return encoded;
      const ntl::status sent = write_stream(
          stream_id,
          ntl::net::scatter_view::from_contiguous(
              std::span<const std::byte>(prefix)),
          false);
      if (!sent.is_ok())
        return sent;
      std::lock_guard guard(state_lock_);
      if (qpack_decoder_stream_id_ == invalid_stream_id)
        qpack_decoder_stream_id_ = stream_id;
      else
        stream_id = qpack_decoder_stream_id_;
    }
    return ntl::status::ok();
  }

  /**
   * Creates a sink after the transport object exists but before MsQuic can
   * deliver handshake/application callbacks. This removes the cyclic
   * lifetime problem for high-level connection sinks which require a backend
   * reference in their constructor. The returned connection owns the sink.
   */
  template <class SinkFactory>
  static ntl::result<std::shared_ptr<connection>>
  try_accept_with_sink(
      connection_context configured,
      borrowed_accepted_connection accepted,
      SinkFactory &&factory,
      connection_limits limits = {}) noexcept {
    if (!configured)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    return try_accept_with_sink_retaining_native(
        configured.api_, std::move(accepted),
        configured.configuration_, std::forward<SinkFactory>(factory),
        limits, std::move(configured.native_owner_));
  }

  template <class SinkFactory>
  static ntl::result<std::shared_ptr<connection>>
  try_accept_with_sink_borrowed(
      const QUIC_API_TABLE *api,
      borrowed_accepted_connection accepted,
      HQUIC configuration,
      SinkFactory &&factory,
      connection_limits limits = {}) noexcept {
    return try_accept_with_sink_retaining_native(
        api, std::move(accepted), configuration,
        std::forward<SinkFactory>(factory), limits, {});
  }

  ntl::status write_qpack_decoder_stream(
      ntl::net::scatter_view plaintext) noexcept override {
    if (!plaintext ||
        plaintext.size() > limits_.maximum_send_size)
      return STATUS_INVALID_PARAMETER;
    const ntl::status prepared = prepare_qpack_decoder_stream();
    if (!prepared.is_ok())
      return prepared;
    std::uint64_t stream_id = invalid_stream_id;
    {
      std::lock_guard guard(state_lock_);
      stream_id = qpack_decoder_stream_id_;
    }
    if (stream_id == invalid_stream_id)
      return STATUS_INVALID_DEVICE_STATE;
    return write_stream(stream_id, plaintext, false);
  }

  ntl::status open_bidirectional_stream(
      std::uint64_t &stream_id) noexcept override {
    return open_stream(false, stream_id,
                       stream_kind::extension_bidirectional);
  }

  ntl::status open_request_stream(
      std::uint64_t &stream_id) noexcept override {
    return open_stream(false, stream_id, stream_kind::request);
  }

  ntl::status open_unidirectional_stream(
      std::uint64_t &stream_id) noexcept override {
    return open_stream(true, stream_id,
                       stream_kind::extension_unidirectional);
  }

  ntl::status send_datagram(
      ntl::net::scatter_view plaintext) noexcept override {
    if (!plaintext ||
        plaintext.size() > limits_.maximum_send_size ||
        plaintext.size() >
            (std::numeric_limits<std::uint32_t>::max)())
      return STATUS_INVALID_PARAMETER;
    if (!handle_ ||
        stopping_.load(std::memory_order_acquire))
      return STATUS_INVALID_DEVICE_STATE;

    detail::send_context *context = nullptr;
    try {
      context = new detail::send_context(
          plaintext, limits_.maximum_send_size);
    } catch (const std::bad_alloc &) {
      return STATUS_INSUFFICIENT_RESOURCES;
    } catch (const std::length_error &) {
      return STATUS_BUFFER_OVERFLOW;
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
    const QUIC_STATUS sent = api_->DatagramSend(
        handle_, &context->buffer, 1,
        QUIC_SEND_FLAG_NONE, context);
    if (QUIC_FAILED(sent)) {
      delete context;
      return detail::from_quic_status(sent);
    }
    return ntl::status::ok();
  }

  ntl::status reset_stream_at(
      std::uint64_t stream_id, std::uint64_t error_code,
      std::uint64_t reliable_size) noexcept override {
#ifdef QUIC_API_ENABLE_PREVIEW_FEATURES
    if (error_code > maximum_quic_varint ||
        reliable_size > maximum_quic_varint)
      return STATUS_INVALID_PARAMETER;
    if (!reliable_reset_negotiated_.load(
            std::memory_order_acquire))
      return STATUS_NOT_SUPPORTED;
    auto stream = find_stream(stream_id);
    if (!stream)
      return STATUS_NOT_FOUND;
    stream_operation operation(*this, stream);
    if (!operation)
      return STATUS_INVALID_DEVICE_STATE;
    const QUIC_STATUS configured = api_->SetParam(
        operation.handle(), QUIC_PARAM_STREAM_RELIABLE_OFFSET,
        sizeof(reliable_size), &reliable_size);
    if (QUIC_FAILED(configured))
      return detail::from_quic_status(configured);
    return detail::from_quic_status(api_->StreamShutdown(
        operation.handle(), QUIC_STREAM_SHUTDOWN_FLAG_ABORT_SEND,
        error_code));
#else
    (void)stream_id;
    (void)error_code;
    (void)reliable_size;
    return STATUS_NOT_SUPPORTED;
#endif
  }

  ntl::status reset_stream(
      std::uint64_t stream_id,
      std::uint64_t error_code) noexcept override {
    if (error_code > maximum_quic_varint)
      return STATUS_INVALID_PARAMETER;
    auto stream = find_stream(stream_id);
    if (!stream)
      return STATUS_NOT_FOUND;
    stream_operation operation(*this, stream);
    if (!operation)
      return STATUS_INVALID_DEVICE_STATE;
    return detail::from_quic_status(api_->StreamShutdown(
        operation.handle(), QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
        error_code));
  }

  void stop() noexcept override {
    if (!handle_ ||
        stopping_.exchange(true, std::memory_order_acq_rel))
      return;
    api_->ConnectionShutdown(
        handle_, QUIC_CONNECTION_SHUTDOWN_FLAG_NONE,
        h3_internal_error);
  }

  ntl::status drain() noexcept override {
    return wait_for_shutdown(limits_.shutdown_timeout)
               ? ntl::status::ok()
               : ntl::status{STATUS_IO_TIMEOUT};
  }

  void drain_exact() noexcept {
    if (!handle_)
      return;
    stop();
    wait_for_shutdown_exact();
  }

  bool wait_for_shutdown(
      std::chrono::milliseconds timeout) noexcept {
    std::unique_lock lock(state_lock_);
    return state_changed_.wait_for(
        lock, timeout,
        [this] { return drained_locked(); });
  }

  connection_role role() const noexcept { return role_; }

  /** Non-owning view; valid until this connection is destroyed. */
  ntl::net::quic::backend_sink *borrowed_sink() noexcept { return sink_; }
  const ntl::net::quic::backend_sink *borrowed_sink() const noexcept {
    return sink_;
  }

private:
  template <class SinkFactory>
  static ntl::result<std::shared_ptr<connection>>
  try_accept_with_sink_retaining_native(
      const QUIC_API_TABLE *api,
      borrowed_accepted_connection accepted,
      HQUIC configuration,
      SinkFactory &&factory,
      connection_limits limits,
      std::shared_ptr<void> native_owner) noexcept {
    if (!api || !accepted || !configuration ||
        !valid_limits(limits))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    try {
      auto result = adopt(new (std::nothrow) connection(
          api, connection_role::server, limits,
          std::move(native_owner)));
      if (!result)
        return ntl::unexpected(result.status());
      std::shared_ptr<ntl::net::quic::backend_sink> owned =
          std::invoke(
              std::forward<SinkFactory>(factory),
              std::static_pointer_cast<ntl::net::quic::transport_backend>(
                  *result));
      if (!owned)
        return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
      (*result)->sink_ = owned.get();
      (*result)->retained_sink_ = std::move(owned);
      (*result)->handle_ = accepted.release_native_handle();
      api->SetCallbackHandler(
          (*result)->handle_,
          reinterpret_cast<void *>(&connection_callback), result->get());
      const ntl::status attached = (*result)->invoke_sink(
          [&] {
            return (*result)->sink_->on_transport_ready(
                std::static_pointer_cast<
                    ntl::net::quic::transport_backend>(*result));
          });
      if (!attached.is_ok()) {
        (*result)->release_rejected_connection();
        return ntl::unexpected(attached);
      }
      const QUIC_STATUS configured = api->ConnectionSetConfiguration(
          (*result)->handle_, configuration);
      if (QUIC_FAILED(configured)) {
        (*result)->release_rejected_connection();
        return ntl::unexpected(detail::from_quic_status(configured));
      }
      (*result)->started_.store(true, std::memory_order_release);
      return ntl::ok(std::move(*result));
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }

  enum class stream_kind : std::uint8_t {
    undecided_bidirectional,
    request,
    extension_bidirectional,
    undecided_unidirectional,
    qpack_encoder,
    extension_unidirectional,
    local,
  };

  struct stream_callback_context;

  struct stream_state {
    connection *owner = nullptr;
    HQUIC handle = nullptr;
    std::atomic<std::uint64_t> id{invalid_stream_id};
    stream_kind kind = stream_kind::local;
    std::vector<std::byte> prefix;
    bool final_delivered = false;
    std::mutex lifecycle_lock;
    std::size_t operations = 0;
    std::size_t callbacks = 0;
    bool published = false;
    bool shutdown_complete = false;
    bool finalizing = false;
    stream_callback_context *callback_context = nullptr;
  };

  struct stream_callback_context {
    explicit stream_callback_context(
        std::shared_ptr<stream_state> value) noexcept
        : state(std::move(value)) {}

    std::shared_ptr<stream_state> state;
  };

  class callback_guard {
  public:
    explicit callback_guard(connection &owner) noexcept : owner_(&owner) {
      std::lock_guard guard(owner_->state_lock_);
      ++owner_->active_callbacks_;
    }
    callback_guard(const callback_guard &) = delete;
    callback_guard &operator=(const callback_guard &) = delete;
    ~callback_guard() {
      {
        std::lock_guard guard(owner_->state_lock_);
        --owner_->active_callbacks_;
      }
      owner_->state_changed_.notify_all();
    }

  private:
    connection *owner_;
  };

  class stream_callback_guard {
  public:
    stream_callback_guard(
        connection &owner,
        std::shared_ptr<stream_state> state) noexcept
        : owner_(&owner), state_(std::move(state)) {
      std::lock_guard guard(state_->lifecycle_lock);
      ++state_->callbacks;
    }
    stream_callback_guard(const stream_callback_guard &) = delete;
    stream_callback_guard &operator=(const stream_callback_guard &) = delete;
    ~stream_callback_guard() {
      owner_->finish_stream_callback(state_);
    }

  private:
    connection *owner_;
    std::shared_ptr<stream_state> state_;
  };

  class stream_operation {
  public:
    stream_operation(
        connection &owner,
        std::shared_ptr<stream_state> state) noexcept
        : owner_(&owner), state_(std::move(state)) {
      std::lock_guard guard(state_->lifecycle_lock);
      if (!state_->shutdown_complete && state_->handle) {
        ++state_->operations;
        handle_ = state_->handle;
      }
    }
    stream_operation(const stream_operation &) = delete;
    stream_operation &operator=(const stream_operation &) = delete;
    ~stream_operation() {
      if (handle_)
        owner_->finish_stream_operation(state_);
    }

    explicit operator bool() const noexcept { return handle_ != nullptr; }
    HQUIC handle() const noexcept { return handle_; }

  private:
    connection *owner_;
    std::shared_ptr<stream_state> state_;
    HQUIC handle_ = nullptr;
  };

  static constexpr std::uint64_t invalid_stream_id =
      (std::numeric_limits<std::uint64_t>::max)();

  static ntl::result<std::shared_ptr<connection>>
  adopt(connection *value) noexcept {
    if (!value)
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    auto *domain =
        ntl::net::kernel::borrowed_runtime_passive_cleanup_domain();
    if (!domain) {
      delete value;
      return ntl::unexpected(STATUS_DEVICE_NOT_READY);
    }
    value->cleanup_domain_ = domain;
    const ntl::status registered = domain->register_item(value->cleanup_);
    if (!registered.is_ok()) {
      delete value;
      return ntl::unexpected(static_cast<NTSTATUS>(registered));
    }
    try {
      return ntl::ok(std::shared_ptr<connection>(
          value, [](connection *owned) noexcept {
            owned->cleanup_domain_->retire_deferred(owned->cleanup_);
          }));
    } catch (...) {
      domain->retire_deferred(value->cleanup_);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
#else
    auto *domain = ntl::net::user::borrowed_runtime_cleanup_domain();
    if (!domain) {
      delete value;
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    value->cleanup_domain_ = domain;
    try {
      return ntl::ok(std::shared_ptr<connection>(
          value, [](connection *owned) noexcept {
            if (!owned->cleanup_domain_->retire_deferred(owned->cleanup_)
                     .is_ok())
              std::terminate();
          }));
    } catch (...) {
      if (!domain->retire_deferred(value->cleanup_).is_ok())
        std::terminate();
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
#endif
  }

#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
  static void cleanup_at_passive(void *context) noexcept {
    delete static_cast<connection *>(context);
  }
#else
  static void cleanup_deferred(void *context) noexcept {
    delete static_cast<connection *>(context);
  }
#endif

  connection(
      const QUIC_API_TABLE *api,
      ntl::net::quic::backend_sink &sink,
      connection_role role,
      connection_limits limits,
      std::shared_ptr<void> native_owner) noexcept
      : api_(api), sink_(&sink), role_(role), limits_(limits),
        native_owner_(std::move(native_owner)),
        next_local_bidirectional_stream_id_(
            role == connection_role::server ? 1u : 0u),
        next_local_unidirectional_stream_id_(
            role == connection_role::server ? 3u : 2u) {}

  connection(
      const QUIC_API_TABLE *api,
      std::shared_ptr<ntl::net::quic::backend_sink> sink,
      connection_role role,
      connection_limits limits,
      std::shared_ptr<void> native_owner) noexcept
      : api_(api), native_owner_(std::move(native_owner)),
        retained_sink_(std::move(sink)), sink_(retained_sink_.get()),
        role_(role), limits_(limits),
        next_local_bidirectional_stream_id_(
            role == connection_role::server ? 1u : 0u),
        next_local_unidirectional_stream_id_(
            role == connection_role::server ? 3u : 2u) {}

  connection(
      const QUIC_API_TABLE *api,
      connection_role role,
      connection_limits limits,
      std::shared_ptr<void> native_owner) noexcept
      : api_(api), role_(role), limits_(limits),
        native_owner_(std::move(native_owner)),
        next_local_bidirectional_stream_id_(
            role == connection_role::server ? 1u : 0u),
        next_local_unidirectional_stream_id_(
            role == connection_role::server ? 3u : 2u) {}

  static bool valid_limits(
      const connection_limits &limits) noexcept {
    return limits.maximum_streams != 0 &&
           limits.maximum_receive_indication != 0 &&
           limits.maximum_send_size != 0 &&
           limits.maximum_prefix_bytes >= 8 &&
           limits.shutdown_timeout.count() > 0;
  }

  static bool valid_target(const connection_target &target) noexcept {
    if (target.server_name.empty() || target.port == 0)
      return false;
    if (!target.remote_address)
      return true;
    const QUIC_ADDRESS_FAMILY remote_family =
        QuicAddrGetFamily(&*target.remote_address);
    if (remote_family != QUIC_ADDRESS_FAMILY_INET &&
        remote_family != QUIC_ADDRESS_FAMILY_INET6)
      return false;
    if (target.family != QUIC_ADDRESS_FAMILY_UNSPEC &&
        target.family != remote_family)
      return false;
    const std::uint16_t remote_port =
        QuicAddrGetPort(&*target.remote_address);
    return remote_port == 0 || remote_port == target.port;
  }

  static ntl::status configure_remote_address(
      const QUIC_API_TABLE *api, HQUIC handle,
      connection_target &target) noexcept {
    if (!target.remote_address)
      return ntl::status::ok();
    if (QuicAddrGetPort(&*target.remote_address) == 0)
      QuicAddrSetPort(&*target.remote_address, target.port);
    target.family = QuicAddrGetFamily(&*target.remote_address);
    return detail::from_quic_status(api->SetParam(
        handle, QUIC_PARAM_CONN_REMOTE_ADDRESS,
        sizeof(*target.remote_address), &*target.remote_address));
  }

  ntl::status start_client(
      std::shared_ptr<ntl::net::quic::transport_backend> self,
      HQUIC registration, HQUIC configuration,
      connection_target target) noexcept {
    HQUIC handle = nullptr;
    const QUIC_STATUS opened = api_->ConnectionOpen(
        registration, &connection_callback, this, &handle);
    if (QUIC_FAILED(opened))
      return detail::from_quic_status(opened);
    handle_ = handle;
    const ntl::status remote =
        configure_remote_address(api_, handle, target);
    if (!remote.is_ok()) {
      release_unstarted_connection();
      return remote;
    }
    const ntl::status attached =
        invoke_sink([&] { return sink_->on_transport_ready(std::move(self)); });
    if (!attached.is_ok()) {
      release_unstarted_connection();
      return attached;
    }
    const QUIC_STATUS started = api_->ConnectionStart(
        handle, configuration, target.family, target.server_name.c_str(),
        target.port);
    if (QUIC_FAILED(started)) {
      release_unstarted_connection();
      return detail::from_quic_status(started);
    }
    started_.store(true, std::memory_order_release);
    return ntl::status::ok();
  }

  ntl::status start_server(
      std::shared_ptr<ntl::net::quic::transport_backend> self,
      HQUIC accepted_connection, HQUIC configuration) noexcept {
    handle_ = accepted_connection;
    api_->SetCallbackHandler(
        accepted_connection,
        reinterpret_cast<void *>(&connection_callback), this);
    const ntl::status attached =
        invoke_sink([&] { return sink_->on_transport_ready(std::move(self)); });
    if (!attached.is_ok()) {
      release_rejected_connection();
      return attached;
    }
    const QUIC_STATUS configured =
        api_->ConnectionSetConfiguration(accepted_connection, configuration);
    if (QUIC_FAILED(configured)) {
      release_rejected_connection();
      return detail::from_quic_status(configured);
    }
    started_.store(true, std::memory_order_release);
    return ntl::status::ok();
  }

  static QUIC_STATUS QUIC_API connection_callback(
      HQUIC,
      void *context,
      QUIC_CONNECTION_EVENT *event) noexcept {
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    NT_ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
#endif
    auto *self = static_cast<connection *>(context);
    if (!self || !event)
      return QUIC_STATUS_INVALID_PARAMETER;
    callback_guard guard(*self);
    return self->on_connection_event(*event);
  }

  static QUIC_STATUS QUIC_API discarded_connection_callback(
      HQUIC, void *, QUIC_CONNECTION_EVENT *) noexcept {
    return QUIC_STATUS_SUCCESS;
  }

  static QUIC_STATUS QUIC_API stream_callback(
      HQUIC,
      void *context,
      QUIC_STREAM_EVENT *event) noexcept {
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    NT_ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
#endif
    auto *callback = static_cast<stream_callback_context *>(context);
    if (!callback || !callback->state || !event)
      return QUIC_STATUS_INVALID_PARAMETER;
    auto state = callback->state;
    if (!state->owner)
      return QUIC_STATUS_INVALID_PARAMETER;
    callback_guard connection_guard(*state->owner);
    stream_callback_guard stream_guard(*state->owner, state);
    return state->owner->on_stream_event(*state, *event);
  }

  QUIC_STATUS
  on_connection_event(QUIC_CONNECTION_EVENT &event) noexcept {
    switch (event.Type) {
    case QUIC_CONNECTION_EVENT_CONNECTED: {
      const std::string_view alpn(
          reinterpret_cast<const char *>(
              event.CONNECTED.NegotiatedAlpn),
          event.CONNECTED.NegotiatedAlpnLength);
      const ntl::status result =
          invoke_sink([&] { return sink_->on_connected(alpn); });
      if (!result.is_ok()) {
        fail(result);
        return QUIC_STATUS_ABORTED;
      }
      connected_.store(true, std::memory_order_release);
      return QUIC_STATUS_SUCCESS;
    }
    case QUIC_CONNECTION_EVENT_PEER_CERTIFICATE_RECEIVED: {
      const ntl::net::quic::peer_certificate_view certificate{
          .native_certificate =
              event.PEER_CERTIFICATE_RECEIVED.Certificate,
          .native_chain = event.PEER_CERTIFICATE_RECEIVED.Chain,
          .deferred_error_flags =
              event.PEER_CERTIFICATE_RECEIVED.DeferredErrorFlags,
          .deferred_status = static_cast<NTSTATUS>(
              event.PEER_CERTIFICATE_RECEIVED.DeferredStatus)};
      const ntl::status result = invoke_sink(
          [&] { return sink_->on_peer_certificate(certificate); });
      if (!result.is_ok()) {
        fail(result);
        return QUIC_STATUS_ABORTED;
      }
      return QUIC_STATUS_SUCCESS;
    }
    case QUIC_CONNECTION_EVENT_PEER_STREAM_STARTED:
      return accept_stream(
          event.PEER_STREAM_STARTED.Stream,
          (event.PEER_STREAM_STARTED.Flags &
           QUIC_STREAM_OPEN_FLAG_UNIDIRECTIONAL) != 0);
    case QUIC_CONNECTION_EVENT_DATAGRAM_STATE_CHANGED:
      invoke_sink_void([&] {
        sink_->on_datagram_send_state(
            event.DATAGRAM_STATE_CHANGED.SendEnabled != FALSE,
            event.DATAGRAM_STATE_CHANGED.MaxSendLength);
      });
      return QUIC_STATUS_SUCCESS;
    case QUIC_CONNECTION_EVENT_DATAGRAM_RECEIVED: {
      const QUIC_BUFFER *buffer =
          event.DATAGRAM_RECEIVED.Buffer;
      if (!buffer ||
          buffer->Length >
              limits_.maximum_receive_indication) {
        fail(STATUS_BUFFER_OVERFLOW);
        return QUIC_STATUS_ABORTED;
      }
      const auto bytes =
          ntl::net::scatter_view::from_contiguous(
              std::span<const std::byte>(
                  reinterpret_cast<const std::byte *>(
                      buffer->Buffer),
                  buffer->Length));
      const ntl::status result = invoke_sink(
          [&] { return sink_->on_datagram(bytes); });
      if (!result.is_ok()) {
        fail(result);
        return QUIC_STATUS_ABORTED;
      }
      return QUIC_STATUS_SUCCESS;
    }
    case QUIC_CONNECTION_EVENT_DATAGRAM_SEND_STATE_CHANGED:
      if (QUIC_DATAGRAM_SEND_STATE_IS_FINAL(
              event.DATAGRAM_SEND_STATE_CHANGED.State)) {
        delete static_cast<detail::send_context *>(
            event.DATAGRAM_SEND_STATE_CHANGED.ClientContext);
        event.DATAGRAM_SEND_STATE_CHANGED.ClientContext = nullptr;
      }
      return QUIC_STATUS_SUCCESS;
#ifdef QUIC_API_ENABLE_PREVIEW_FEATURES
    case QUIC_CONNECTION_EVENT_RELIABLE_RESET_NEGOTIATED:
      reliable_reset_negotiated_.store(
          event.RELIABLE_RESET_NEGOTIATED.IsNegotiated != FALSE,
          std::memory_order_release);
      invoke_sink_void([&] {
        sink_->on_reliable_reset_negotiated(
            event.RELIABLE_RESET_NEGOTIATED.IsNegotiated != FALSE);
      });
      return QUIC_STATUS_SUCCESS;
#endif
    case QUIC_CONNECTION_EVENT_SHUTDOWN_INITIATED_BY_TRANSPORT:
      set_terminal(static_cast<NTSTATUS>(
          event.SHUTDOWN_INITIATED_BY_TRANSPORT.Status));
      return QUIC_STATUS_SUCCESS;
    case QUIC_CONNECTION_EVENT_SHUTDOWN_INITIATED_BY_PEER:
      set_terminal(STATUS_CONNECTION_DISCONNECTED);
      return QUIC_STATUS_SUCCESS;
    case QUIC_CONNECTION_EVENT_SHUTDOWN_COMPLETE: {
      NTSTATUS status = STATUS_SUCCESS;
      {
        std::lock_guard guard(state_lock_);
        shutdown_complete_ = true;
        status = static_cast<NTSTATUS>(terminal_status_);
      }
      invoke_sink_void(
          [&] { sink_->on_closed(status); });
      state_changed_.notify_all();
      return QUIC_STATUS_SUCCESS;
    }
    default:
      return QUIC_STATUS_SUCCESS;
    }
  }

  QUIC_STATUS accept_stream(
      HQUIC handle, bool unidirectional) noexcept {
    std::shared_ptr<stream_state> state;
    try {
      state = std::make_shared<stream_state>();
    } catch (...) {
      api_->StreamShutdown(
          handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
          h3_internal_error);
      return QUIC_STATUS_OUT_OF_MEMORY;
    }
    state->owner = this;
    state->handle = handle;
    state->kind =
        unidirectional
            ? stream_kind::undecided_unidirectional
            : stream_kind::undecided_bidirectional;
    (unidirectional ? peer_unidirectional_started_
                    : peer_bidirectional_started_)
        .fetch_add(1, std::memory_order_relaxed);
    std::uint64_t queried_id = invalid_stream_id;
    std::uint32_t size = sizeof(queried_id);
    const QUIC_STATUS queried = api_->GetParam(
        handle, QUIC_PARAM_STREAM_ID, &size, &queried_id);
    if (QUIC_FAILED(queried)) {
      api_->StreamShutdown(
          handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
          h3_internal_error);
      return queried;
    }
    state->id.store(queried_id, std::memory_order_release);
    auto callback = std::unique_ptr<stream_callback_context>(
        new (std::nothrow) stream_callback_context(state));
    if (!callback) {
      api_->StreamShutdown(
          handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
          h3_internal_error);
      return QUIC_STATUS_OUT_OF_MEMORY;
    }
    {
      std::lock_guard guard(state_lock_);
      if (streams_.size() >= limits_.maximum_streams ||
          streams_.contains(queried_id)) {
        api_->StreamShutdown(
            handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
            h3_internal_error);
        return QUIC_STATUS_OUT_OF_MEMORY;
      }
      try {
        streams_.emplace(queried_id, state);
      } catch (...) {
        api_->StreamShutdown(
            handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
            h3_internal_error);
        return QUIC_STATUS_OUT_OF_MEMORY;
      }
      state->published = true;
      state->callback_context = callback.get();
      ++live_stream_contexts_;
    }
    api_->SetCallbackHandler(
        handle, reinterpret_cast<void *>(&stream_callback),
        callback.release());
    return QUIC_STATUS_SUCCESS;
  }

  QUIC_STATUS on_stream_event(
      stream_state &state,
      QUIC_STREAM_EVENT &event) noexcept {
    switch (event.Type) {
    case QUIC_STREAM_EVENT_START_COMPLETE:
      if (QUIC_FAILED(event.START_COMPLETE.Status)) {
        set_terminal(
            static_cast<NTSTATUS>(event.START_COMPLETE.Status));
        mark_stream_shutdown(state);
      } else {
        const auto expected =
            state.id.load(std::memory_order_acquire);
        if (expected != invalid_stream_id &&
            expected != event.START_COMPLETE.ID) {
          set_terminal(STATUS_DATA_ERROR);
          api_->StreamShutdown(
              state.handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
              h3_internal_error);
          return QUIC_STATUS_ABORTED;
        }
        state.id.store(
            event.START_COMPLETE.ID, std::memory_order_release);
      }
      return QUIC_STATUS_SUCCESS;
    case QUIC_STREAM_EVENT_RECEIVE: {
      peer_receive_events_.fetch_add(1, std::memory_order_relaxed);
      if (event.RECEIVE.TotalBufferLength >
              limits_.maximum_receive_indication ||
          event.RECEIVE.TotalBufferLength >
              (std::numeric_limits<std::size_t>::max)())
        return abort_stream(state, STATUS_BUFFER_OVERFLOW);
      std::vector<std::byte> bytes;
      try {
        bytes.reserve(static_cast<std::size_t>(
            event.RECEIVE.TotalBufferLength));
        for (std::uint32_t index = 0;
             index != event.RECEIVE.BufferCount; ++index) {
          const auto &buffer = event.RECEIVE.Buffers[index];
          bytes.insert(
              bytes.end(),
              reinterpret_cast<const std::byte *>(buffer.Buffer),
              reinterpret_cast<const std::byte *>(
                  buffer.Buffer + buffer.Length));
        }
      } catch (...) {
        return abort_stream(
            state, STATUS_INSUFFICIENT_RESOURCES);
      }
      const bool final =
          (event.RECEIVE.Flags & QUIC_RECEIVE_FLAG_FIN) != 0;
      if (final)
        peer_receive_fin_events_.fetch_add(1, std::memory_order_relaxed);
      const ntl::status consumed =
          consume_stream(state, bytes, final);
      if (!consumed.is_ok())
        return abort_stream(state, consumed);
      return QUIC_STATUS_SUCCESS;
    }
    case QUIC_STREAM_EVENT_PEER_SEND_SHUTDOWN:
      peer_send_shutdown_events_.fetch_add(1, std::memory_order_relaxed);
      if (!state.final_delivered) {
        const ntl::status consumed =
            consume_stream(state, {}, true);
        if (!consumed.is_ok())
          return abort_stream(state, consumed);
      }
      return QUIC_STATUS_SUCCESS;
    case QUIC_STREAM_EVENT_PEER_SEND_ABORTED: {
      const ntl::status reported = invoke_sink([&] {
        return sink_->on_peer_send_aborted(
            state.id.load(std::memory_order_acquire),
            event.PEER_SEND_ABORTED.ErrorCode);
      });
      return reported.is_ok() ? QUIC_STATUS_SUCCESS
                              : abort_stream(state, reported);
    }
    case QUIC_STREAM_EVENT_PEER_RECEIVE_ABORTED: {
      const ntl::status reported = invoke_sink([&] {
        return sink_->on_peer_receive_aborted(
            state.id.load(std::memory_order_acquire),
            event.PEER_RECEIVE_ABORTED.ErrorCode);
      });
      return reported.is_ok() ? QUIC_STATUS_SUCCESS
                              : abort_stream(state, reported);
    }
    case QUIC_STREAM_EVENT_SEND_COMPLETE:
      delete static_cast<detail::send_context *>(
          event.SEND_COMPLETE.ClientContext);
      event.SEND_COMPLETE.ClientContext = nullptr;
      return QUIC_STATUS_SUCCESS;
    case QUIC_STREAM_EVENT_SHUTDOWN_COMPLETE:
      mark_stream_shutdown(state);
      return QUIC_STATUS_SUCCESS;
    default:
      return QUIC_STATUS_SUCCESS;
    }
  }

  ntl::status consume_stream(
      stream_state &state,
      std::span<const std::byte> incoming,
      bool final) noexcept {
    if (state.final_delivered)
      return STATUS_INVALID_DEVICE_STATE;

    std::vector<std::byte> combined;
    std::span<const std::byte> payload = incoming;
    if (state.kind ==
            stream_kind::undecided_bidirectional ||
        state.kind ==
            stream_kind::undecided_unidirectional) {
      try {
        if (state.prefix.size() + incoming.size() >
            limits_.maximum_receive_indication)
          return STATUS_BUFFER_OVERFLOW;
        state.prefix.insert(
            state.prefix.end(), incoming.begin(), incoming.end());
      } catch (...) {
        return STATUS_INSUFFICIENT_RESOURCES;
      }
      if (state.prefix.empty() && final)
        return STATUS_END_OF_FILE;
      const auto view =
          ntl::net::scatter_view::from_contiguous(
              std::span<const std::byte>(state.prefix));
      const auto prefix = read_quic_varint(view);
      if (!prefix) {
        if (prefix.status() == STATUS_BUFFER_TOO_SMALL &&
            !final &&
            state.prefix.size() <
                limits_.maximum_prefix_bytes)
          return ntl::status::ok();
        return prefix.status() == STATUS_BUFFER_TOO_SMALL
                   ? ntl::status{STATUS_END_OF_FILE}
                   : prefix.status();
      }

      if (state.kind ==
          stream_kind::undecided_bidirectional) {
        state.kind =
            prefix->value ==
                    webtransport_bidirectional_signal
                ? stream_kind::extension_bidirectional
                : stream_kind::request;
        if (state.kind == stream_kind::request)
          request_streams_classified_.fetch_add(
              1, std::memory_order_relaxed);
        combined = std::move(state.prefix);
        payload = combined;
      } else if (
          prefix->value == qpack_encoder_stream_type) {
        state.kind = stream_kind::qpack_encoder;
        combined.assign(
            state.prefix.begin() +
                static_cast<std::ptrdiff_t>(
                    prefix->encoded_size),
            state.prefix.end());
        payload = combined;
        state.prefix.clear();
      } else {
        state.kind =
            stream_kind::extension_unidirectional;
        combined = std::move(state.prefix);
        payload = combined;
      }
    }

    const auto bytes =
        payload.empty()
            ? ntl::net::scatter_view{}
            : ntl::net::scatter_view::from_contiguous(payload);
    ntl::status result = ntl::status::ok();
    switch (state.kind) {
    case stream_kind::request:
      request_sink_calls_.fetch_add(1, std::memory_order_relaxed);
      if (final)
        request_sink_final_calls_.fetch_add(1, std::memory_order_relaxed);
      result = invoke_sink([&] {
        return sink_->on_request_stream(
            state.id.load(std::memory_order_acquire), bytes, final);
      });
      last_request_sink_status_.store(
          static_cast<NTSTATUS>(result), std::memory_order_relaxed);
      break;
    case stream_kind::extension_bidirectional:
      result = invoke_sink([&] {
        return sink_->on_peer_bidirectional_stream(
            state.id.load(std::memory_order_acquire), bytes, final);
      });
      break;
    case stream_kind::qpack_encoder:
      if (!payload.empty()) {
        result = invoke_sink([&] {
          return sink_->on_qpack_encoder_stream(bytes);
        });
      } else if (!final) {
        result = ntl::status::ok();
      }
      break;
    case stream_kind::extension_unidirectional:
      result = invoke_sink([&] {
        return sink_->on_peer_unidirectional_stream(
            state.id.load(std::memory_order_acquire), bytes, final);
      });
      break;
    default:
      result = STATUS_INVALID_DEVICE_STATE;
      break;
    }
    if (result.is_ok() && final)
      state.final_delivered = true;
    return result;
  }

  QUIC_STATUS abort_stream(
      stream_state &state,
      ntl::status status) noexcept {
    set_terminal(static_cast<NTSTATUS>(status));
    api_->StreamShutdown(
        state.handle, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
        h3_internal_error);
    return QUIC_STATUS_ABORTED;
  }

  ntl::status open_stream(
      bool unidirectional,
      std::uint64_t &stream_id,
      stream_kind local_kind) noexcept {
    // MsQuic queues StreamStart asynchronously, including when this method is
    // called from CONNECTED.  QUIC_PARAM_STREAM_ID is consequently not valid
    // until START_COMPLETE and cannot be queried synchronously without either
    // racing or deadlocking the connection worker.  Local QUIC stream IDs are
    // deterministic, so serialize opens and reserve the next ID from the
    // role/direction sequence before queueing StreamStart.
    std::lock_guard open_guard(local_stream_open_lock_);
    stream_id = invalid_stream_id;
    if (!handle_ ||
        stopping_.load(std::memory_order_acquire))
      return STATUS_INVALID_DEVICE_STATE;
    auto &next_stream_id =
        unidirectional ? next_local_unidirectional_stream_id_
                       : next_local_bidirectional_stream_id_;
    if (next_stream_id > maximum_quic_varint - 4)
      return STATUS_INTEGER_OVERFLOW;
    const std::uint64_t reserved_stream_id = next_stream_id;

    std::shared_ptr<stream_state> state;
    try {
      state = std::make_shared<stream_state>();
    } catch (...) {
      return STATUS_INSUFFICIENT_RESOURCES;
    }
    state->owner = this;
    state->kind = local_kind;
    auto callback = std::unique_ptr<stream_callback_context>(
        new (std::nothrow) stream_callback_context(state));
    if (!callback)
      return STATUS_INSUFFICIENT_RESOURCES;
    HQUIC stream = nullptr;
    const QUIC_STATUS opened = api_->StreamOpen(
        handle_,
        unidirectional
            ? QUIC_STREAM_OPEN_FLAG_UNIDIRECTIONAL
            : QUIC_STREAM_OPEN_FLAG_NONE,
        &stream_callback, callback.get(), &stream);
    if (QUIC_FAILED(opened))
      return detail::from_quic_status(opened);
    {
      std::lock_guard guard(state->lifecycle_lock);
      state->handle = stream;
      state->callback_context = callback.get();
    }
    {
      std::lock_guard guard(state_lock_);
      ++live_stream_contexts_;
    }
    callback.release();
    stream_operation construction(*this, state);
    state->id.store(reserved_stream_id, std::memory_order_release);
    const QUIC_STATUS started = api_->StreamStart(
        stream,
        static_cast<QUIC_STREAM_START_FLAGS>(
            QUIC_STREAM_START_FLAG_IMMEDIATE |
            QUIC_STREAM_START_FLAG_SHUTDOWN_ON_FAIL));
    if (QUIC_FAILED(started)) {
      mark_stream_shutdown(*state);
      return detail::from_quic_status(started);
    }
    next_stream_id += 4;
    const ntl::status published = publish_stream(state);
    if (!published.is_ok()) {
      api_->StreamShutdown(
          stream, QUIC_STREAM_SHUTDOWN_FLAG_ABORT,
          h3_internal_error);
      return published;
    }
    stream_id = reserved_stream_id;
    return ntl::status::ok();
  }

  ntl::status send_on_stream(
      std::shared_ptr<stream_state> stream,
      ntl::net::scatter_view plaintext,
      bool final) noexcept {
    stream_operation operation(*this, stream);
    if (!operation)
      return STATUS_INVALID_DEVICE_STATE;
    detail::send_context *context = nullptr;
    try {
      context = new detail::send_context(
          plaintext, limits_.maximum_send_size);
    } catch (const std::bad_alloc &) {
      return STATUS_INSUFFICIENT_RESOURCES;
    } catch (const std::length_error &) {
      return STATUS_BUFFER_OVERFLOW;
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
    const QUIC_STATUS sent = api_->StreamSend(
        operation.handle(),
        context->buffer.Length == 0 ? nullptr : &context->buffer,
        context->buffer.Length == 0 ? 0u : 1u,
        final ? QUIC_SEND_FLAG_FIN : QUIC_SEND_FLAG_NONE,
        context);
    if (QUIC_FAILED(sent)) {
      delete context;
      return detail::from_quic_status(sent);
    }
    return ntl::status::ok();
  }

  std::shared_ptr<stream_state>
  find_stream(std::uint64_t id) noexcept {
    std::lock_guard guard(state_lock_);
    const auto found = streams_.find(id);
    return found == streams_.end()
               ? std::shared_ptr<stream_state>{}
               : found->second;
  }

  ntl::status publish_stream(
      const std::shared_ptr<stream_state> &state) noexcept {
    std::lock_guard lifecycle_guard(state->lifecycle_lock);
    if (state->shutdown_complete)
      return STATUS_CONNECTION_DISCONNECTED;
    std::lock_guard guard(state_lock_);
    if (streams_.size() >= limits_.maximum_streams)
      return STATUS_QUOTA_EXCEEDED;
    const std::uint64_t id =
        state->id.load(std::memory_order_acquire);
    if (streams_.contains(id))
      return STATUS_OBJECT_NAME_COLLISION;
    try {
      streams_.emplace(id, state);
    } catch (...) {
      return STATUS_INSUFFICIENT_RESOURCES;
    }
    state->published = true;
    return ntl::status::ok();
  }

  void mark_stream_shutdown(stream_state &state) noexcept {
    bool remove = false;
    std::uint64_t id = invalid_stream_id;
    {
      std::lock_guard guard(state.lifecycle_lock);
      state.shutdown_complete = true;
      remove = std::exchange(state.published, false);
      id = state.id.load(std::memory_order_acquire);
    }
    if (remove) {
      std::lock_guard guard(state_lock_);
      const auto found = streams_.find(id);
      if (found != streams_.end() && found->second.get() == &state)
        streams_.erase(found);
    }
    state_changed_.notify_all();
  }

  static bool prepare_stream_finalization_locked(
      stream_state &state) noexcept {
    if (!state.shutdown_complete || state.operations != 0 ||
        state.callbacks != 0 || state.finalizing)
      return false;
    state.finalizing = true;
    return true;
  }

  void finish_stream_operation(
      const std::shared_ptr<stream_state> &state) noexcept {
    bool finalize = false;
    {
      std::lock_guard guard(state->lifecycle_lock);
      if (state->operations != 0)
        --state->operations;
      finalize = prepare_stream_finalization_locked(*state);
    }
    if (finalize)
      finalize_stream(state);
  }

  void finish_stream_callback(
      const std::shared_ptr<stream_state> &state) noexcept {
    bool finalize = false;
    {
      std::lock_guard guard(state->lifecycle_lock);
      if (state->callbacks != 0)
        --state->callbacks;
      finalize = prepare_stream_finalization_locked(*state);
    }
    if (finalize)
      finalize_stream(state);
  }

  void finalize_stream(
      const std::shared_ptr<stream_state> &state) noexcept {
    HQUIC handle = nullptr;
    stream_callback_context *callback = nullptr;
    {
      std::lock_guard guard(state->lifecycle_lock);
      handle = std::exchange(state->handle, nullptr);
      callback = std::exchange(state->callback_context, nullptr);
      state->owner = nullptr;
    }
    if (handle)
      api_->StreamClose(handle);
    delete callback;
    {
      std::lock_guard guard(state_lock_);
      if (live_stream_contexts_ != 0)
        --live_stream_contexts_;
    }
    state_changed_.notify_all();
  }

  bool drained_locked() const noexcept {
    return shutdown_complete_ && live_stream_contexts_ == 0 &&
           active_callbacks_ == 0;
  }

  void wait_for_shutdown_exact() noexcept {
    std::unique_lock lock(state_lock_);
    state_changed_.wait(lock, [this] { return drained_locked(); });
  }

  void wait_for_callbacks_exact() noexcept {
    std::unique_lock lock(state_lock_);
    state_changed_.wait(
        lock, [this] { return active_callbacks_ == 0; });
  }

  void release_unstarted_connection() noexcept {
    HQUIC handle = handle_;
    if (!handle)
      return;
    api_->SetCallbackHandler(
        handle,
        reinterpret_cast<void *>(&discarded_connection_callback),
        nullptr);
    wait_for_callbacks_exact();
    api_->ConnectionClose(handle);
    handle_ = nullptr;
  }

  void release_rejected_connection() noexcept {
    HQUIC handle = handle_;
    if (!handle)
      return;
    // The listener still owns a rejected server connection.  Do not close it
    // here: returning failure from NEW_CONNECTION makes MsQuic release it.
    // Remove the object-backed callback before that ownership transition.
    api_->SetCallbackHandler(
        handle,
        reinterpret_cast<void *>(&discarded_connection_callback),
        nullptr);
    wait_for_callbacks_exact();
    handle_ = nullptr;
  }

  template <class Invoke>
  ntl::status invoke_sink(Invoke &&invoke) noexcept {
    std::lock_guard guard(sink_lock_);
    try {
      return invoke();
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
  }

  template <class Invoke>
  void invoke_sink_void(Invoke &&invoke) noexcept {
    std::lock_guard guard(sink_lock_);
    try {
      invoke();
    } catch (...) {
    }
  }

  void fail(ntl::status status) noexcept {
    set_terminal(static_cast<NTSTATUS>(status));
    stop();
  }

  void set_terminal(NTSTATUS status) noexcept {
    std::lock_guard guard(state_lock_);
    if (terminal_status_.is_ok())
      terminal_status_ = status;
  }

  void close_handles() noexcept {
    HQUIC handle = std::exchange(handle_, nullptr);
    if (handle)
      api_->ConnectionClose(handle);
  }

  const QUIC_API_TABLE *api_ = nullptr;
  std::shared_ptr<void> native_owner_;
  std::shared_ptr<ntl::net::quic::backend_sink> retained_sink_;
  ntl::net::quic::backend_sink *sink_ = nullptr;
  connection_role role_ = connection_role::client;
  connection_limits limits_{};
  HQUIC handle_ = nullptr;
  std::atomic<bool> started_{false};
  std::atomic<bool> connected_{false};
  std::atomic<bool> stopping_{false};
  std::atomic<bool> reliable_reset_negotiated_{false};
  std::atomic<std::uint64_t> peer_bidirectional_started_{0};
  std::atomic<std::uint64_t> peer_unidirectional_started_{0};
  std::atomic<std::uint64_t> peer_receive_events_{0};
  std::atomic<std::uint64_t> peer_receive_fin_events_{0};
  std::atomic<std::uint64_t> peer_send_shutdown_events_{0};
  std::atomic<std::uint64_t> request_streams_classified_{0};
  std::atomic<std::uint64_t> request_sink_calls_{0};
  std::atomic<std::uint64_t> request_sink_final_calls_{0};
  std::atomic<std::int32_t> last_request_sink_status_{STATUS_SUCCESS};
  std::mutex sink_lock_;
  std::mutex qpack_stream_lock_;
  std::mutex local_stream_open_lock_;
  std::mutex state_lock_;
  std::condition_variable state_changed_;
  std::unordered_map<
      std::uint64_t, std::shared_ptr<stream_state>>
      streams_;
  std::size_t live_stream_contexts_ = 0;
  std::size_t active_callbacks_ = 0;
  std::uint64_t qpack_decoder_stream_id_ =
      invalid_stream_id;
  std::uint64_t next_local_bidirectional_stream_id_ = 0;
  std::uint64_t next_local_unidirectional_stream_id_ = 2;
  ntl::status terminal_status_ = ntl::status::ok();
  bool shutdown_complete_ = false;
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
  ntl::net::kernel::passive_cleanup_item cleanup_{
      &connection::cleanup_at_passive, this};
  ntl::net::kernel::passive_cleanup_domain *cleanup_domain_ = nullptr;
#else
  ntl::net::user::cleanup_item cleanup_{
      &connection::cleanup_deferred, this};
  ntl::net::user::cleanup_domain *cleanup_domain_ = nullptr;
#endif
};

