  mutable std::recursive_mutex state_lock_;
  std::shared_ptr<const ntl::net::http::inspection_policy> policy_;
  std::shared_ptr<const ntl::net::inspection::content_decoder_registry>
      decoders_;
  std::shared_ptr<const ntl::net::inspection::content_encoder_registry>
      encoders_;
  ntl::net::http::inspection_session_metadata session_{};
  std::shared_ptr<proxy_connection_observer> observer_;
  std::shared_ptr<webtransport::transform_session> webtransport_policy_;
  std::shared_ptr<webtransport_payload_handler> webtransport_handler_;
  proxy_connection_limits limits_{};
  webtransport::session_limits webtransport_limits_{};
  std::shared_ptr<proxy_terminal_response_provider> terminal_responses_;
  std::shared_ptr<std::pmr::memory_resource> message_memory_owner_;
  ntl::net::http::message_memory_ref message_memory_{};
  qpack_decoder_adapter<bounded_dynamic_qpack_decoder> qpack_;
  borrowed_connection_inspector inspector_;
  std::unordered_map<
      std::uint64_t, webtransport_session_state>
      webtransport_sessions_;
  std::unordered_map<std::uint64_t, request_state> requests_;
  std::unordered_set<std::uint64_t> blocked_streams_;
  std::unordered_map<std::uint64_t, std::vector<std::byte>>
      unidirectional_streams_;
  std::unordered_map<std::uint64_t, std::vector<std::byte>>
      bidirectional_streams_;
  webtransport::peer_settings peer_settings_{};
  std::size_t aggregate_body_bytes_ = 0;
  std::size_t aggregate_extension_stream_bytes_ = 0;
  std::uint64_t request_stream_calls_ = 0;
  std::uint64_t request_stream_final_calls_ = 0;
