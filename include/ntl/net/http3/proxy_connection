inline constexpr std::uint64_t h3_no_error = 0x100;
inline constexpr std::uint64_t h3_general_protocol_error = 0x101;
inline constexpr std::uint64_t h3_excessive_load = 0x107;

struct proxy_connection_limits {
  std::size_t maximum_concurrent_request_streams = 256;
  std::size_t maximum_buffered_bytes_per_stream = 2 * 1024 * 1024;
  std::size_t maximum_aggregate_body_bytes = 16 * 1024 * 1024;
  std::size_t maximum_frame_payload = 1024 * 1024;
  std::size_t maximum_decoded_header_bytes = 256 * 1024;
  std::size_t maximum_control_stream_bytes = 64 * 1024;
  std::size_t maximum_extension_stream_bytes = 1024 * 1024;
  std::size_t maximum_concurrent_extension_streams = 256;
  std::size_t maximum_aggregate_extension_stream_bytes = 16 * 1024 * 1024;
  std::size_t maximum_capsule_wire_bytes = 256 * 1024;
  std::size_t maximum_blocked_streams = 32;
  std::size_t maximum_concurrent_webtransport_sessions = 64;
  std::size_t qpack_table_capacity = 4096;
  bool require_http3_origin = true;
  bool require_server_name_authority_binding = true;
  bool enable_webtransport = true;

  constexpr bool valid() const noexcept {
    return maximum_concurrent_request_streams != 0 &&
           maximum_buffered_bytes_per_stream != 0 &&
           maximum_aggregate_body_bytes != 0 &&
           maximum_frame_payload != 0 &&
           maximum_decoded_header_bytes != 0 &&
           maximum_control_stream_bytes != 0 &&
           maximum_extension_stream_bytes != 0 &&
           maximum_concurrent_extension_streams != 0 &&
           maximum_aggregate_extension_stream_bytes != 0 &&
           maximum_capsule_wire_bytes != 0 &&
           maximum_blocked_streams != 0 &&
           maximum_concurrent_webtransport_sessions != 0;
  }
};

/** Optional telemetry. It is never allowed to replace a policy verdict. */
class proxy_connection_observer {
public:
  virtual ~proxy_connection_observer() = default;
  virtual void on_connected(std::string_view) noexcept {}
  virtual void on_inspection(
      const ntl::net::http::inspection_context_view &) noexcept {}
  virtual void on_webtransport_payload(
      const webtransport::payload &) noexcept {}
  virtual void on_qpack_stream_resumed(std::uint64_t) noexcept {}
  virtual void on_webtransport_session_opened(std::uint64_t) noexcept {}
  virtual void on_webtransport_session_closed(
      std::uint64_t, NTSTATUS) noexcept {}
  virtual void on_webtransport_reset(
      std::uint64_t, std::uint32_t) noexcept {}
  virtual void on_stream_rejected(
      std::uint64_t, NTSTATUS) noexcept {}
  virtual void on_stream_cancelled(std::uint64_t) noexcept {}
  virtual void on_exchange_complete(
      std::uint64_t, const ntl::net::http::request_message &,
      const ntl::net::http::response_message &, bool) noexcept {}
  virtual void on_closed(NTSTATUS) noexcept {}
};

/**
 * @brief Owning destination for an inspected WebTransport payload.
 *
 * The proxy retains the handler for the connection lifetime and invokes it
 * only after the per-session policy has permitted and transformed the
 * payload.  A handler can bridge to an upstream transport, persist data, or
 * deliberately echo a controlled fixture without coupling those product
 * choices to the protocol parser.
 */
class webtransport_payload_handler {
public:
  virtual ~webtransport_payload_handler() = default;
  virtual ntl::status handle(
      webtransport::backend_session &session,
      const webtransport::payload &payload) noexcept = 0;
};

/** A bounded terminal echo used by the controlled inspection examples. */
class webtransport_echo_handler final
    : public webtransport_payload_handler {
public:
  ntl::status handle(
      webtransport::backend_session &session,
      const webtransport::payload &payload) noexcept override {
    using webtransport::payload_kind;
    using webtransport::stream_direction;
    switch (payload.kind) {
    case payload_kind::stream:
      return payload.direction == stream_direction::bidirectional
                 ? session.send_bidirectional(payload.bytes)
                 : session.send_unidirectional(payload.bytes);
    case payload_kind::datagram:
      return session.send_datagram(payload.bytes);
    case payload_kind::capsule:
      return session.send_capsule(payload.capsule_type, payload.bytes);
    }
    return STATUS_INVALID_PARAMETER;
  }
};

struct proxy_connection_statistics {
  std::uint64_t request_stream_calls = 0;
  std::uint64_t request_stream_final_calls = 0;
  std::uint64_t request_inspector_retries = 0;
  std::uint64_t request_headers = 0;
  std::uint64_t request_stream_ends = 0;
  std::uint64_t origin_submit_calls = 0;
  std::int32_t last_stream_end_status = STATUS_SUCCESS;
  std::int32_t last_origin_submit_status = STATUS_SUCCESS;
  std::size_t blocked_request_streams = 0;
  std::size_t active_requests = 0;
};

enum class proxy_terminal_reason : std::uint8_t {
  policy_block = 1,
  origin_unavailable = 2,
};

struct proxy_terminal_context {
  proxy_terminal_reason reason = proxy_terminal_reason::policy_block;
  const ntl::net::http::request_message &request;
  NTSTATUS failure = STATUS_SUCCESS;
};

/** Optional application-specific terminal response body. */
class proxy_terminal_response_provider {
public:
  virtual ~proxy_terminal_response_provider() = default;
  virtual ntl::result<ntl::net::http::response_message>
  response_for(const proxy_terminal_context &context) noexcept = 0;
};

namespace proxy_connection_detail {

inline ntl::result<ntl::net::http::protocol>
origin_protocol(std::string_view negotiated) noexcept {
  using ntl::net::http::protocol;
  if (negotiated == "h3")
    return ntl::ok(protocol::http3);
  if (negotiated == "h2")
    return ntl::ok(protocol::http2);
  if (negotiated == "http/1.1" || negotiated == "http/1.0")
    return ntl::ok(protocol::http1);
  return ntl::unexpected(STATUS_PROTOCOL_NOT_SUPPORTED);
}

template <class ByteContainer>
inline ntl::net::scatter_view scatter(
    const ByteContainer &bytes) noexcept {
  return bytes.empty()
             ? ntl::net::scatter_view{}
             : ntl::net::scatter_view::from_contiguous(
                   std::span<const std::byte>(bytes.data(), bytes.size()));
}

template <class ByteContainer>
inline ntl::status append(
    ntl::net::scatter_view source, ByteContainer &destination,
    std::size_t maximum) noexcept {
  if (source.size() > maximum || destination.size() > maximum - source.size())
    return STATUS_BUFFER_OVERFLOW;
  try {
    const std::size_t offset = destination.size();
    destination.resize(offset + source.size());
    return source.size() == 0
               ? ntl::status::ok()
               : source.copy_to(
                     std::span<std::byte>(destination.data(),
                                          destination.size())
                         .subspan(offset, source.size()));
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

inline std::vector<proxy_header> proxy_headers(
    const ntl::net::http::header_collection &headers) {
  std::vector<proxy_header> result;
  result.reserve(headers.size());
  for (const auto &field : headers.fields())
    result.push_back(
        {std::string(field.name.begin(), field.name.end()),
         std::string(field.value.begin(), field.value.end())});
  return result;
}

inline std::vector<proxy_header> proxy_trailers(
    const ntl::net::http::header_list &trailers) {
  std::vector<proxy_header> result;
  result.reserve(trailers.size());
  for (const auto &field : trailers)
    result.push_back(
        {std::string(field.name.begin(), field.name.end()),
         std::string(field.value.begin(), field.value.end())});
  return result;
}

inline ntl::result<std::vector<header_field>> request_header_fields(
    const ntl::net::http::request_message &request,
    std::size_t maximum_header_bytes) noexcept {
  try {
    std::vector<header_field> result;
    result.reserve(request.headers.size() +
                   (request.extended_protocol ? 5u : 4u));
    std::size_t bytes = 0;
    const auto append = [&](std::string_view name,
                            std::string_view value,
                            bool never_index = false) -> ntl::status {
      if (name.size() > maximum_header_bytes ||
          value.size() > maximum_header_bytes - name.size() ||
          bytes > maximum_header_bytes - name.size() - value.size())
        return STATUS_BUFFER_OVERFLOW;
      result.push_back({std::string(name), std::string(value), never_index});
      bytes += name.size() + value.size();
      return ntl::status::ok();
    };
    auto status = append(":method", request.method);
    if (status.is_ok() && request.extended_protocol)
      status = append(":protocol", *request.extended_protocol);
    if (status.is_ok())
      status = append(":scheme", request.scheme);
    if (status.is_ok())
      status = append(":authority", request.authority);
    if (status.is_ok())
      status = append(":path", request.path);
    for (const auto &field : request.headers.fields()) {
      if (!status.is_ok())
        break;
      status = append(field.name, field.value, field.sensitive);
    }
    return status.is_ok()
               ? ntl::ok(std::move(result))
               : ntl::unexpected(static_cast<NTSTATUS>(status));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::status append_headers(
    ntl::net::http::header_collection &destination,
    const std::vector<proxy_header> &source) noexcept {
  try {
    for (const auto &field : source)
      destination.append(field.name, field.value);
    return ntl::status::ok();
  } catch (const std::invalid_argument &) {
    return STATUS_DATA_ERROR;
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

inline ntl::status append_trailers(
    ntl::net::http::header_list &destination,
    const std::vector<proxy_header> &source) noexcept {
  try {
    destination.reserve(source.size());
    for (const auto &field : source)
      destination.push_back({field.name, field.value, false});
    return ntl::status::ok();
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

inline ntl::net::http::response_message forbidden_response(
    ntl::net::http::message_memory_ref memory = {}) {
  ntl::net::http::response_message response(memory);
  response.wire_protocol = ntl::net::http::protocol::http3;
  response.status = 403;
  response.headers.append("content-type", "text/plain; charset=utf-8");
  constexpr std::string_view text = "Request blocked by policy.\n";
  response.body.assign(
      reinterpret_cast<const std::byte *>(text.data()),
      reinterpret_cast<const std::byte *>(text.data() + text.size()));
  return response;
}

inline ntl::net::http::response_message bad_gateway_response(
    ntl::net::http::message_memory_ref memory = {}) {
  ntl::net::http::response_message response(memory);
  response.wire_protocol = ntl::net::http::protocol::http3;
  response.status = 502;
  response.headers.append("content-type", "text/plain; charset=utf-8");
  constexpr std::string_view body = "Origin transport unavailable.\n";
  response.body.assign(
      reinterpret_cast<const std::byte *>(body.data()),
      reinterpret_cast<const std::byte *>(body.data() + body.size()));
  return response;
}

inline ntl::result<std::vector<std::byte>> encode_control_stream(
    bool webtransport_enabled,
    webtransport::session_limits webtransport_limits,
    std::size_t maximum) noexcept {
  if (webtransport_enabled)
    return webtransport::encode_control_stream(
        true, webtransport_limits, maximum);
  try {
    std::vector<std::byte> result;
    auto status = append_quic_varint(
        result, webtransport::control_stream_type);
    if (status.is_ok())
      status = webtransport::session_detail::append_frame(
          result, static_cast<std::uint64_t>(frame_type::settings), {});
    if (!status.is_ok())
      return ntl::unexpected(static_cast<NTSTATUS>(status));
    if (result.size() > maximum)
      return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline ntl::result<std::vector<std::byte>> encode_goaway(
    std::uint64_t stream_id, std::size_t maximum) noexcept {
  try {
    std::vector<std::byte> payload;
    auto status = append_quic_varint(payload, stream_id);
    std::vector<std::byte> result;
    if (status.is_ok())
      status = webtransport::session_detail::append_frame(
          result, static_cast<std::uint64_t>(frame_type::goaway), payload);
    if (!status.is_ok())
      return ntl::unexpected(static_cast<NTSTATUS>(status));
    if (result.size() > maximum)
      return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
    return ntl::ok(std::move(result));
  } catch (const std::bad_alloc &) {
    return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
  } catch (...) {
    return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
  }
}

inline async_origin_transport &required_origin(
    const std::unique_ptr<async_origin_transport> &origin) {
  if (!origin)
    throw std::invalid_argument("HTTP/3 proxy origin is null");
  return *origin;
}

