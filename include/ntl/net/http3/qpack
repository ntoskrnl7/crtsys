inline ntl::result<std::string>
read_literal(
    ntl::net::http2::hpack_detail::cursor &input,
    std::uint8_t prefix_bits, std::uint8_t huffman_mask,
    std::size_t maximum_decoded_size) {
  std::uint8_t first = 0;
  if (!input.at(0, first))
    return ntl::unexpected(STATUS_DATA_ERROR);
  const bool huffman = (first & huffman_mask) != 0;
  const auto length =
      ntl::net::http2::hpack_detail::read_integer(
          input, prefix_bits);
  if (!length)
    return ntl::unexpected(length.status());
  if (*length > input.remaining())
    return ntl::unexpected(STATUS_DATA_ERROR);
  if (huffman)
    return ntl::net::http2::hpack_detail::read_huffman_string(
        input, *length, maximum_decoded_size);
  if (*length > maximum_decoded_size)
    return ntl::unexpected(STATUS_BUFFER_OVERFLOW);

  std::string result;
  result.reserve(*length);
  for (std::size_t index = 0; index != *length; ++index) {
    std::uint8_t octet = 0;
    if (!input.read(octet))
      return ntl::unexpected(STATUS_DATA_ERROR);
    result.push_back(static_cast<char>(octet));
  }
  return ntl::ok(std::move(result));
}

inline ntl::status append(
    decoded_headers &output, std::string name,
    std::string value, bool never_index,
    std::size_t maximum_decoded_size) {
  if (name.size() >
          maximum_decoded_size - output.decoded_bytes ||
      value.size() >
          maximum_decoded_size - output.decoded_bytes -
              name.size())
    return STATUS_BUFFER_OVERFLOW;
  output.decoded_bytes += name.size() + value.size();
  output.fields.push_back(
      {std::move(name), std::move(value), never_index});
  return ntl::status::ok();
}

