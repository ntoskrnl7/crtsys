#pragma once

#include <ntl/net/http3/inspection_proxy>
#include <ntl/net/inspection/standard_content_decoders>
#include <ntl/net/inspection/standard_content_encoders>

#include <utility>

namespace ntl::net::http3 {

/**
 * @brief Owns the standard decoder registry used by inspection_proxy.
 */
class standard_inspection_proxy {
public:
  standard_inspection_proxy(
      std::shared_ptr<origin_transport> origin,
      std::shared_ptr<inspection_policy> policy,
      proxy_limits limits = {})
      : proxy_(std::move(origin), std::move(policy),
               standard_decoders(), limits) {}

  standard_inspection_proxy(
      std::shared_ptr<origin_transport> origin,
      std::shared_ptr<inspection_policy> policy,
      ntl::net::http::transform_pipeline transforms,
      proxy_limits limits = {})
      : proxy_(
            std::move(origin), std::move(policy), standard_decoders(),
            standard_encoders(), std::move(transforms), limits) {}

  standard_inspection_proxy(
      const standard_inspection_proxy &) = delete;
  standard_inspection_proxy &
  operator=(const standard_inspection_proxy &) = delete;

  ntl::result<origin_response>
  forward(incoming_request request) const noexcept {
    return proxy_.forward(std::move(request));
  }

private:
  static ntl::net::inspection::content_decoder_registry
  standard_decoders() {
    ntl::net::inspection::content_decoder_registry result;
    ntl::net::inspection::register_standard_content_decoders(result);
    return result;
  }

  static ntl::net::inspection::content_encoder_registry
  standard_encoders() {
    ntl::net::inspection::content_encoder_registry result;
    ntl::net::inspection::register_standard_content_encoders(result);
    return result;
  }

  inspection_proxy proxy_;
};

} // namespace ntl::net::http3
