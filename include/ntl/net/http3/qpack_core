namespace ntl::net::http3 {

struct qpack_field_view {
  std::string_view name;
  std::string_view value;
  bool never_index = false;
};

class qpack_field_sink {
public:
  virtual ~qpack_field_sink() = default;
  virtual ntl::status on_field(qpack_field_view field) noexcept = 0;
};

struct qpack_decode_result {
  std::size_t field_count = 0;
  std::size_t decoded_bytes = 0;
};

namespace qpack_core_detail {

