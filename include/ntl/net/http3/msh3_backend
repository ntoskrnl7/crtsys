namespace ntl::net::http3::msh3_backend {

inline constexpr std::uint64_t h3_internal_error = 0x102;
inline constexpr std::uint64_t h3_request_rejected = 0x10b;

struct header {
  std::string name;
  std::string value;
};

struct request {
  std::string server_name;
  std::vector<header> headers;
  std::vector<std::byte> body;

  std::string_view header_value(
      std::string_view name) const noexcept {
    for (const auto &field : headers) {
      if (field.name == name)
        return field.value;
    }
    return {};
  }
};

struct response {
  unsigned status = 500;
  std::vector<header> headers;
  std::vector<std::byte> body;
};

class request_handler {
public:
  virtual ~request_handler() = default;
  virtual ntl::result<response>
  handle(const request &message) noexcept = 0;
  virtual void on_transport_error(
      NTSTATUS) noexcept {}
};

/**
 * @brief Supplies an msh3 configuration selected from the ClientHello SNI.
 *
 * The provider retains ownership of every returned configuration until the
 * server has stopped and drained all connections.
 */
class server_identity_provider {
public:
  virtual ~server_identity_provider() = default;
  virtual ntl::result<MSH3_CONFIGURATION *>
  configuration_for(
      std::string_view server_name) noexcept = 0;
};

struct server_limits {
  std::size_t maximum_request_headers = 128;
  std::size_t maximum_request_header_bytes = 32 * 1024;
  std::size_t maximum_request_body_bytes = 2 * 1024 * 1024;
  std::size_t maximum_response_headers = 256;
  std::size_t maximum_response_header_bytes = 48 * 1024;
  std::size_t maximum_response_body_bytes = 4 * 1024 * 1024;
};

inline constexpr quic_backend_capabilities capabilities{
    .available = true,
    .tls13_termination = true,
    .destination_redirection = true,
    .qpack_dynamic_table = true,
    .bidirectional_streams = false,
    .unidirectional_streams = false,
    .quic_datagrams = false,
    .extended_connect = false,
    .webtransport = false,
    .origin_client = false,
    .encrypted_client_hello = false,
    .arbitrary_browser_server_identity = false};

namespace detail {

inline bool is_lowercase_header_name(
    std::string_view name) noexcept {
  if (name.empty())
    return false;
  for (const unsigned char value : name) {
    const bool valid =
        (value >= 'a' && value <= 'z') ||
        (value >= '0' && value <= '9') ||
        std::string_view("!#$%&'*+-.^_`|~").find(
            static_cast<char>(value)) !=
            std::string_view::npos;
    if (!valid)
      return false;
  }
  return true;
}

struct server_state;

struct request_state {
  server_state *server = nullptr;
  MSH3_REQUEST *handle = nullptr;
  request message;
  std::shared_ptr<std::mutex> connection_send_lock;
  std::mutex lock;
  std::atomic<unsigned> references{1};
  std::size_t header_bytes = 0;
  bool worker_started = false;
  bool shutdown = false;

  response outgoing;
  std::string status_text;
  std::string content_length;
  std::vector<header> response_storage;
  std::vector<MSH3_HEADER> response_headers;

  void add_reference() noexcept {
    references.fetch_add(1, std::memory_order_relaxed);
  }
  void release() noexcept;
};

struct connection_state {
  server_state *server = nullptr;
  MSH3_CONNECTION *handle = nullptr;
  std::string server_name;
  std::shared_ptr<std::mutex> send_lock =
      std::make_shared<std::mutex>();
};

struct server_state {
  MSH3_API *api = nullptr;
  server_identity_provider *identities = nullptr;
  request_handler *handler = nullptr;
  server_limits limits{};
  MSH3_LISTENER *listener = nullptr;
  std::mutex connections_lock;
  std::condition_variable connections_changed;
  std::unordered_set<MSH3_CONNECTION *> connections;
  std::atomic<std::size_t> active_requests{0};
  std::atomic<std::size_t> delivered_requests{0};
  std::atomic<bool> stopping{false};

  bool valid_limits() const noexcept {
    return api && identities && handler &&
           limits.maximum_request_headers != 0 &&
           limits.maximum_request_header_bytes != 0 &&
           limits.maximum_request_body_bytes != 0 &&
           limits.maximum_response_headers != 0 &&
           limits.maximum_response_header_bytes != 0 &&
           limits.maximum_response_body_bytes != 0;
  }

  void add_connection(MSH3_CONNECTION *connection) {
    std::lock_guard guard(connections_lock);
    connections.insert(connection);
  }

  void remove_connection(
      MSH3_CONNECTION *connection) noexcept {
    {
      std::lock_guard guard(connections_lock);
      connections.erase(connection);
    }
    connections_changed.notify_all();
  }

  void request_started() noexcept {
    active_requests.fetch_add(1, std::memory_order_relaxed);
  }

  void request_finished() noexcept {
    active_requests.fetch_sub(1, std::memory_order_relaxed);
    connections_changed.notify_all();
  }
};

inline void request_state::release() noexcept {
  if (references.fetch_sub(
          1, std::memory_order_acq_rel) != 1)
    return;
  if (server)
    server->request_finished();
  delete this;
}

inline ntl::status prepare_response(
    request_state &request) noexcept {
  try {
    auto &message = request.outgoing;
    const auto &limits = request.server->limits;
    if (message.status < 100 || message.status > 999 ||
        message.body.size() >
            limits.maximum_response_body_bytes ||
        message.headers.size() >
            limits.maximum_response_headers)
      return STATUS_INVALID_PARAMETER;

    request.status_text =
        std::to_string(message.status);
    request.content_length =
        std::to_string(message.body.size());
    request.response_storage.clear();
    request.response_storage.reserve(
        message.headers.size() + 2);
    request.response_storage.push_back(
        {":status", request.status_text});

    std::size_t bytes = 0;
    bool content_length_seen = false;
    for (const auto &field : message.headers) {
      if (!is_lowercase_header_name(field.name) ||
          field.name.front() == ':' ||
          field.value.find_first_of("\r\n") !=
              std::string::npos)
        return STATUS_DATA_ERROR;
      bytes += field.name.size() + field.value.size();
      if (bytes > limits.maximum_response_header_bytes)
        return STATUS_BUFFER_OVERFLOW;
      if (field.name == "content-length") {
        if (content_length_seen ||
            field.value != request.content_length)
          return STATUS_DATA_ERROR;
        content_length_seen = true;
      }
      request.response_storage.push_back(field);
    }
    if (!content_length_seen)
      request.response_storage.push_back(
          {"content-length", request.content_length});
    if (request.response_storage.size() >
        limits.maximum_response_headers)
      return STATUS_BUFFER_OVERFLOW;

    request.response_headers.clear();
    request.response_headers.reserve(
        request.response_storage.size());
    for (const auto &field : request.response_storage) {
      request.response_headers.push_back(
          {field.name.data(), field.name.size(),
           field.value.data(), field.value.size()});
    }
    return ntl::status::ok();
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

inline void send_error(
    request_state &request,
    unsigned status,
    std::string_view text) noexcept {
  try {
    request.outgoing = {};
    request.outgoing.status = status;
    request.outgoing.headers.push_back(
        {"content-type", "text/plain; charset=utf-8"});
    request.outgoing.body.assign(
        reinterpret_cast<const std::byte *>(text.data()),
        reinterpret_cast<const std::byte *>(
            text.data() + text.size()));
  } catch (...) {
    request.outgoing = {};
  }
}

inline void process_request(
    request_state *request) noexcept {
  try {
    auto handled =
        request->server->handler->handle(request->message);
    if (handled)
      request->outgoing = std::move(*handled);
    else {
      request->server->handler->on_transport_error(
          static_cast<NTSTATUS>(handled.status()));
      send_error(
          *request, 502,
          "The bounded HTTP/3 request handler failed.\n");
    }
    ntl::status prepared = prepare_response(*request);
    if (!prepared.is_ok()) {
      request->server->handler->on_transport_error(
          static_cast<NTSTATUS>(prepared));
      send_error(
          *request, 502,
          "The bounded HTTP/3 response was invalid.\n");
      prepared = prepare_response(*request);
    }

    std::lock_guard send_guard(
        *request->connection_send_lock);
    std::lock_guard guard(request->lock);
    if (!request->shutdown) {
      const bool sent =
          prepared.is_ok() &&
          ::MsH3RequestSend(
              request->handle, MSH3_REQUEST_SEND_FLAG_FIN,
              request->response_headers.data(),
              request->response_headers.size(),
              request->outgoing.body.empty()
                  ? nullptr
                  : request->outgoing.body.data(),
              static_cast<std::uint32_t>(
                  request->outgoing.body.size()),
              nullptr);
      if (!sent)
        ::MsH3RequestShutdown(
            request->handle,
            MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
            h3_internal_error);
      else
        request->server->delivered_requests.fetch_add(
            1, std::memory_order_relaxed);
    }
  } catch (...) {
    request->server->handler->on_transport_error(
        STATUS_UNHANDLED_EXCEPTION);
    std::lock_guard send_guard(
        *request->connection_send_lock);
    std::lock_guard guard(request->lock);
    if (!request->shutdown)
      ::MsH3RequestShutdown(
          request->handle,
          MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
          h3_internal_error);
  }
  request->release();
}

inline MSH3_STATUS MSH3_CALL request_callback(
    MSH3_REQUEST *handle,
    void *context,
    MSH3_REQUEST_EVENT *event) {
  auto &request =
      *static_cast<request_state *>(context);
  try {
    switch (event->Type) {
    case MSH3_REQUEST_EVENT_HEADER_RECEIVED: {
      const auto &field =
          *event->HEADER_RECEIVED.Header;
      const auto &limits = request.server->limits;
      if (request.message.headers.size() >=
              limits.maximum_request_headers ||
          field.NameLength >
              limits.maximum_request_header_bytes -
                  request.header_bytes ||
          field.ValueLength >
              limits.maximum_request_header_bytes -
                  request.header_bytes -
                  field.NameLength) {
        ::MsH3RequestShutdown(
            handle, MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
            h3_request_rejected);
        return MSH3_STATUS_SUCCESS;
      }
      request.header_bytes +=
          field.NameLength + field.ValueLength;
      request.message.headers.push_back(
          {std::string(field.Name, field.NameLength),
           std::string(field.Value, field.ValueLength)});
      break;
    }
    case MSH3_REQUEST_EVENT_DATA_RECEIVED: {
      const std::size_t length =
          event->DATA_RECEIVED.Length;
      if (request.message.body.size() >
              request.server->limits.maximum_request_body_bytes ||
          length >
          request.server->limits.maximum_request_body_bytes -
              request.message.body.size()) {
        ::MsH3RequestShutdown(
            handle, MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
            h3_request_rejected);
        return MSH3_STATUS_SUCCESS;
      }
      const auto *first =
          reinterpret_cast<const std::byte *>(
              event->DATA_RECEIVED.Data);
      request.message.body.insert(
          request.message.body.end(), first, first + length);
      // Returning MSH3_STATUS_SUCCESS consumes the complete indication
      // synchronously. MsH3RequestCompleteReceive is only paired with a
      // callback that returned MSH3_STATUS_PENDING.
      break;
    }
    case MSH3_REQUEST_EVENT_PEER_SEND_SHUTDOWN: {
      {
        std::lock_guard guard(request.lock);
        if (request.worker_started || request.shutdown)
          break;
        request.worker_started = true;
        request.add_reference();
      }
      try {
        std::thread(&process_request, &request).detach();
      } catch (...) {
        request.release();
        ::MsH3RequestShutdown(
            handle, MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
            h3_internal_error);
      }
      break;
    }
    case MSH3_REQUEST_EVENT_PEER_SEND_ABORTED:
    case MSH3_REQUEST_EVENT_PEER_RECEIVE_ABORTED:
      ::MsH3RequestShutdown(
          handle, MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
          h3_request_rejected);
      break;
    case MSH3_REQUEST_EVENT_SHUTDOWN_COMPLETE: {
      {
        std::lock_guard guard(request.lock);
        request.shutdown = true;
        request.handle = nullptr;
        ::MsH3RequestClose(handle);
      }
      request.release();
      break;
    }
    case MSH3_REQUEST_EVENT_IDEAL_SEND_SIZE:
    case MSH3_REQUEST_EVENT_SEND_COMPLETE:
    case MSH3_REQUEST_EVENT_SEND_SHUTDOWN_COMPLETE:
      break;
    default:
      return E_NOTIMPL;
    }
  } catch (...) {
    request.server->handler->on_transport_error(
        STATUS_INSUFFICIENT_RESOURCES);
    ::MsH3RequestShutdown(
        handle, MSH3_REQUEST_SHUTDOWN_FLAG_ABORT,
        h3_internal_error);
  }
  return MSH3_STATUS_SUCCESS;
}

inline MSH3_STATUS MSH3_CALL connection_callback(
    MSH3_CONNECTION *handle,
    void *context,
    MSH3_CONNECTION_EVENT *event) {
  auto *connection =
      static_cast<connection_state *>(context);
  try {
    switch (event->Type) {
    case MSH3_CONNECTION_EVENT_NEW_REQUEST: {
      auto *request = new (std::nothrow) request_state;
      if (!request) {
        ::MsH3RequestClose(event->NEW_REQUEST.Request);
        return E_OUTOFMEMORY;
      }
      request->server = connection->server;
      request->handle = event->NEW_REQUEST.Request;
      request->message.server_name =
          connection->server_name;
      request->connection_send_lock =
          connection->send_lock;
      connection->server->request_started();
      ::MsH3RequestSetCallbackHandler(
          request->handle, &request_callback, request);
      ::MsH3RequestSetReceiveEnabled(
          request->handle, true);
      break;
    }
    case MSH3_CONNECTION_EVENT_SHUTDOWN_INITIATED_BY_TRANSPORT:
      connection->server->handler->on_transport_error(
          static_cast<NTSTATUS>(
              event->SHUTDOWN_INITIATED_BY_TRANSPORT.Status));
      break;
    case MSH3_CONNECTION_EVENT_SHUTDOWN_INITIATED_BY_PEER:
    case MSH3_CONNECTION_EVENT_CONNECTED:
      break;
    case MSH3_CONNECTION_EVENT_SHUTDOWN_COMPLETE:
      connection->server->remove_connection(handle);
      ::MsH3ConnectionClose(handle);
      delete connection;
      break;
    default:
      return E_NOTIMPL;
    }
  } catch (...) {
    connection->server->handler->on_transport_error(
        STATUS_UNHANDLED_EXCEPTION);
    ::MsH3ConnectionShutdown(handle, h3_internal_error);
  }
  return MSH3_STATUS_SUCCESS;
}

inline MSH3_STATUS MSH3_CALL listener_callback(
    MSH3_LISTENER *,
    void *context,
    MSH3_LISTENER_EVENT *event) {
  auto &server = *static_cast<server_state *>(context);
  if (event->Type == MSH3_LISTENER_EVENT_SHUTDOWN_COMPLETE)
    return MSH3_STATUS_SUCCESS;
  if (event->Type != MSH3_LISTENER_EVENT_NEW_CONNECTION)
    return E_NOTIMPL;
  if (server.stopping.load(std::memory_order_acquire) ||
      !event->NEW_CONNECTION.ServerName ||
      event->NEW_CONNECTION.ServerNameLength == 0)
    return E_ACCESSDENIED;
  try {
    const std::string server_name(
        event->NEW_CONNECTION.ServerName,
        event->NEW_CONNECTION.ServerNameLength);
    auto configuration =
        server.identities->configuration_for(server_name);
    if (!configuration || !*configuration) {
      server.handler->on_transport_error(
          configuration
              ? STATUS_INVALID_DEVICE_STATE
              : static_cast<NTSTATUS>(
                    configuration.status()));
      return E_ACCESSDENIED;
    }
    auto *connection =
        new (std::nothrow) connection_state{
            &server, event->NEW_CONNECTION.Connection,
            server_name};
    if (!connection)
      return E_OUTOFMEMORY;
    ::MsH3ConnectionSetCallbackHandler(
        connection->handle,
        &connection_callback, connection);
    const MSH3_STATUS configured =
        ::MsH3ConnectionSetConfiguration(
            connection->handle, *configuration);
    if (MSH3_FAILED(configured)) {
      server.handler->on_transport_error(
          static_cast<NTSTATUS>(configured));
      delete connection;
      return configured;
    }
    server.add_connection(connection->handle);
    return MSH3_STATUS_SUCCESS;
  } catch (...) {
    server.handler->on_transport_error(
        STATUS_UNHANDLED_EXCEPTION);
    return E_ACCESSDENIED;
  }
}

} // namespace detail

class server {
public:
  server(
      MSH3_API *api,
      server_identity_provider &identities,
      request_handler &handler,
      server_limits limits = {})
      : state_(std::make_unique<detail::server_state>()) {
    state_->api = api;
    state_->identities = &identities;
    state_->handler = &handler;
    state_->limits = limits;
    if (!state_->valid_limits())
      throw std::invalid_argument(
          "invalid msh3 HTTP/3 server configuration");
  }

  server(const server &) = delete;
  server &operator=(const server &) = delete;
  server(server &&) = delete;
  server &operator=(server &&) = delete;

  ~server() {
    stop();
    (void)wait_for_drain(std::chrono::seconds(15));
  }

  ntl::status start(
      const MSH3_ADDR &address) noexcept {
    if (state_->listener)
      return STATUS_INVALID_DEVICE_STATE;
    state_->stopping.store(false, std::memory_order_release);
    state_->listener = ::MsH3ListenerOpen(
        state_->api, &address,
        &detail::listener_callback, state_.get());
    return state_->listener ? ntl::status::ok()
                            : ntl::status(
                                  STATUS_UNSUCCESSFUL);
  }

  void stop() noexcept {
    if (!state_ ||
        state_->stopping.exchange(
            true, std::memory_order_acq_rel))
      return;
    if (state_->listener) {
      ::MsH3ListenerClose(state_->listener);
      state_->listener = nullptr;
    }
    std::vector<MSH3_CONNECTION *> connections;
    try {
      std::lock_guard guard(state_->connections_lock);
      connections.assign(
          state_->connections.begin(),
          state_->connections.end());
    } catch (...) {
      return;
    }
    for (MSH3_CONNECTION *connection : connections)
      ::MsH3ConnectionShutdown(
          connection, h3_internal_error);
  }

  template <class Rep, class Period>
  bool wait_for_drain(
      std::chrono::duration<Rep, Period> timeout) noexcept {
    try {
      std::unique_lock lock(state_->connections_lock);
      return state_->connections_changed.wait_for(
          lock, timeout,
          [this] {
            return state_->connections.empty() &&
                   state_->active_requests.load(
                       std::memory_order_acquire) == 0;
          });
    } catch (...) {
      return false;
    }
  }

  std::size_t delivered_requests() const noexcept {
    return state_->delivered_requests.load(
        std::memory_order_acquire);
  }

  std::size_t active_requests() const noexcept {
    return state_->active_requests.load(
        std::memory_order_acquire);
  }

private:
  std::unique_ptr<detail::server_state> state_;
};

