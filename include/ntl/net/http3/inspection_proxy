/**
 * @file http3_inspection_proxy
 * @brief Transport-neutral, bounded HTTP/3 inspection proxy policy.
 *
 * The QUIC backend terminates TLS 1.3 and decodes HTTP/3. This layer owns
 * pseudo-header validation, SNI/authority binding, body/header quotas,
 * Content-Encoding decoding, typed inspection verdicts, and the requirement
 * for an actual HTTP/3 origin leg. The origin adapter never receives an
 * unvalidated raw request.
 *
 * @copyright Copyright (c) 2022 NT Template Library Authors.
 */
#pragma once

#include <ntl/net/inspection/content_decoder>
#include <ntl/net/inspection/content_encoder>
#include <ntl/net/inspection/core>
#include <ntl/net/http/transform>
#include <ntl/result>
#include <ntl/net/buffer/scatter_view>
#include <ntl/status>

#include <charconv>
#include <cstddef>
#include <cstdint>
#include <functional>
#include <limits>
#include <memory>
#include <new>
#include <optional>
#include <span>
#include <string>
