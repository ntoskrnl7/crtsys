#pragma once

#include <ntl/net/http3/framing>
#include <ntl/result>
#include <ntl/net/buffer/scatter_view>
#include <ntl/status>

#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
#include <ntl/net/kernel/dispatcher_executor>
#endif

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <span>
#include <string_view>
#include <unordered_map>
#include <vector>

namespace ntl::net::http3 {

struct connection_limits {
  std::size_t maximum_concurrent_request_streams = 256;
  std::size_t maximum_buffered_bytes_per_stream =
      2 * 1024 * 1024;
  frame_limits frames{};
};

/**
 * @brief Reassembles HTTP/3 frames from arbitrarily split QUIC stream data.
 */
class borrowed_connection_inspector {
public:
  borrowed_connection_inspector(
      qpack_decoder &decoder, connection_limits limits = {},
      std::size_t maximum_decoded_header_size =
          256 * 1024) noexcept
      : frame_inspector_(decoder, maximum_decoded_header_size),
        decoder_(&decoder),
        limits_(limits) {}

  void reset() noexcept {
    streams_.clear();
    frame_inspector_.reset();
  }

  ntl::status consume_qpack_encoder_stream(
      ntl::net::scatter_view plaintext) noexcept {
    if (!plaintext)
      return STATUS_INVALID_PARAMETER;
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    try {
      return ntl::net::kernel::dispatcher_executor::invoke(
          [this, plaintext]() noexcept {
            return decoder_->consume_encoder_stream(plaintext);
          });
    } catch (const ntl::exception &error) {
      return error.get_status();
    } catch (const std::bad_alloc &) {
      return STATUS_INSUFFICIENT_RESOURCES;
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
#else
    return decoder_->consume_encoder_stream(plaintext);
#endif
  }

  ntl::result<std::vector<std::byte>>
  take_qpack_decoder_stream() noexcept {
    return decoder_->take_decoder_stream();
  }

  ntl::status consume_request_stream(
      std::uint64_t stream_id, ntl::net::scatter_view plaintext,
      bool final, inspection_sink &sink) noexcept {
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    try {
      return ntl::net::kernel::dispatcher_executor::invoke(
          [this, stream_id, plaintext, final, &sink]() noexcept {
            return consume_request_stream_on_current_stack(
                stream_id, plaintext, final, sink);
          });
    } catch (const ntl::exception &error) {
      return error.get_status();
    } catch (const std::bad_alloc &) {
      return STATUS_INSUFFICIENT_RESOURCES;
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
#else
    return consume_request_stream_on_current_stack(
        stream_id, plaintext, final, sink);
#endif
  }

  /**
   * @brief Retries a request stream after encoder instructions unblocked it.
   */
  ntl::status resume_request_stream(
      std::uint64_t stream_id,
      inspection_sink &sink) noexcept {
#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
    try {
      return ntl::net::kernel::dispatcher_executor::invoke(
          [this, stream_id, &sink]() noexcept {
            return resume_request_stream_on_current_stack(stream_id, sink);
          });
    } catch (const ntl::exception &error) {
      return error.get_status();
    } catch (const std::bad_alloc &) {
      return STATUS_INSUFFICIENT_RESOURCES;
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
#else
    return resume_request_stream_on_current_stack(stream_id, sink);
#endif
  }

  ntl::status cancel_request_stream(
      std::uint64_t stream_id) noexcept {
    try {
      const auto found = streams_.find(stream_id);
      if (found == streams_.end())
        return STATUS_NOT_FOUND;
      const ntl::status canceled =
          decoder_->cancel_stream(stream_id);
      streams_.erase(found);
      return canceled;
    } catch (...) {
      return STATUS_INSUFFICIENT_RESOURCES;
    }
  }

private:
  ntl::status consume_request_stream_on_current_stack(
      std::uint64_t stream_id, ntl::net::scatter_view plaintext,
      bool final, inspection_sink &sink) noexcept {
    if ((!plaintext && !final) ||
        limits_.maximum_concurrent_request_streams == 0 ||
        limits_.maximum_buffered_bytes_per_stream == 0 ||
        limits_.frames.maximum_payload_size == 0)
      return STATUS_INVALID_PARAMETER;
    try {
      auto found = streams_.find(stream_id);
      if (found == streams_.end()) {
        if (streams_.size() >=
            limits_.maximum_concurrent_request_streams)
          return STATUS_QUOTA_EXCEEDED;
        found = streams_.try_emplace(stream_id).first;
      }
      auto &state = found->second;
      if (state.final)
        return STATUS_INVALID_DEVICE_STATE;
      auto &buffer = state.buffer;
      if (plaintext) {
        std::size_t consumed = 0;
        while (consumed != plaintext.size()) {
          if (buffer.size() >=
              limits_.maximum_buffered_bytes_per_stream)
            return STATUS_BUFFER_OVERFLOW;
          const std::size_t available =
              limits_.maximum_buffered_bytes_per_stream -
              buffer.size();
          const std::size_t count = (std::min)(
              available, plaintext.size() - consumed);
          const std::size_t offset = buffer.size();
          try {
            buffer.resize(offset + count);
          } catch (...) {
            return STATUS_INSUFFICIENT_RESOURCES;
          }
          const ntl::status copied = plaintext.copy_to(
              std::span<std::byte>(buffer).subspan(offset, count),
              consumed);
          if (!copied.is_ok()) {
            buffer.resize(offset);
            return copied;
          }
          consumed += count;

          // A transport receive indication may coalesce several complete
          // frames and be larger than the bounded assembly workspace. Drain
          // each complete frame before copying more of the indication.
          const ntl::status drained =
              drain(stream_id, found, sink);
          if (drained == STATUS_RETRY) {
            const std::size_t remaining =
                plaintext.size() - consumed;
            if (remaining >
                limits_.maximum_buffered_bytes_per_stream -
                    buffer.size())
              return STATUS_BUFFER_OVERFLOW;
            const std::size_t tail = buffer.size();
            try {
              buffer.resize(tail + remaining);
            } catch (...) {
              return STATUS_INSUFFICIENT_RESOURCES;
            }
            const ntl::status tail_copied = plaintext.copy_to(
                std::span<std::byte>(buffer).subspan(tail, remaining),
                consumed);
            if (!tail_copied.is_ok()) {
              buffer.resize(tail);
              return tail_copied;
            }
            state.final = final;
            return drained;
          }
          if (!drained.is_ok())
            return drained;
        }
      }

      state.final = final;
      return drain(stream_id, found, sink);
    } catch (...) {
      return STATUS_INSUFFICIENT_RESOURCES;
    }
  }

  ntl::status resume_request_stream_on_current_stack(
      std::uint64_t stream_id,
      inspection_sink &sink) noexcept {
    try {
      const auto found = streams_.find(stream_id);
      if (found == streams_.end())
        return STATUS_NOT_FOUND;
      return drain(stream_id, found, sink);
    } catch (...) {
      return STATUS_INSUFFICIENT_RESOURCES;
    }
  }

  struct request_stream_state {
    std::vector<std::byte> buffer;
    bool final = false;
  };

  using stream_map = std::unordered_map<
      std::uint64_t, request_stream_state>;

  ntl::status drain(
      std::uint64_t stream_id,
      stream_map::iterator found,
      inspection_sink &sink) noexcept {
    auto &state = found->second;
    auto &buffer = state.buffer;
    frame_framer framer(limits_.frames);
    for (;;) {
      if (buffer.empty())
        break;
      const auto bytes =
          ntl::net::scatter_view::from_contiguous(
              std::span<const std::byte>(buffer));
      const auto probe = framer.probe(bytes);
      if (probe.state() ==
          ntl::net::framing::probe_state::need_more)
        break;
      if (probe.state() ==
          ntl::net::framing::probe_state::malformed)
        return probe.error();
      auto wire = bytes.subview(0, probe.frame_size());
      if (!wire)
        return wire.status();
      const auto frame =
          frame_view::parse(*wire, limits_.frames);
      if (!frame)
        return frame.status();
      const ntl::status inspected =
          frame_inspector_.consume(stream_id, *frame, sink);
      if (!inspected.is_ok())
        return inspected;
      buffer.erase(
          buffer.begin(),
          buffer.begin() +
              static_cast<std::ptrdiff_t>(
                  probe.frame_size()));
    }
    if (!state.final)
      return ntl::status::ok();
    if (!buffer.empty())
      return STATUS_END_OF_FILE;
    const ntl::status ended =
        sink.on_stream_end(stream_id);
    streams_.erase(found);
    return ended;
  }

  borrowed_stream_inspector frame_inspector_;
  qpack_decoder *decoder_ = nullptr;
  connection_limits limits_{};
  stream_map streams_;
};

} // namespace ntl::net::http3
