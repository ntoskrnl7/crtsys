[[noreturn]] inline void
throw_tls_windows(const char *operation) {
  throw std::system_error(
      static_cast<int>(::GetLastError()),
      std::system_category(), operation);
}

[[noreturn]] inline void
throw_tls_ncrypt(SECURITY_STATUS status,
                 const char *operation) {
  throw std::system_error(
      static_cast<int>(status),
      std::system_category(), operation);
}

inline std::wstring
normalize_certificate_dns_name(std::wstring_view name) {
  if (name.empty() || name.size() > 253)
    throw std::invalid_argument(
        "TLS certificate DNS name is empty or too long");
  std::wstring normalized;
  normalized.reserve(name.size());
  std::size_t label_size = 0;
  for (wchar_t character : name) {
    if (character >= L'A' && character <= L'Z')
      character = static_cast<wchar_t>(
          character - L'A' + L'a');
    if (character == L'.') {
      if (label_size == 0 || label_size > 63)
        throw std::invalid_argument(
            "TLS certificate DNS label is invalid");
      label_size = 0;
    } else {
      const bool accepted =
          (character >= L'a' && character <= L'z') ||
          (character >= L'0' && character <= L'9') ||
          character == L'-' || character == L'_';
      if (!accepted)
        throw std::invalid_argument(
            "TLS certificate DNS name is not an ASCII A-label");
      ++label_size;
    }
    normalized.push_back(character);
  }
  if (label_size == 0 || label_size > 63)
    throw std::invalid_argument(
        "TLS certificate DNS label is invalid");
  return normalized;
}

inline std::vector<BYTE>
encode_tls_object(LPCSTR type, const void *value) {
  DWORD size = 0;
  if (!::CryptEncodeObjectEx(
          X509_ASN_ENCODING, type, value, 0, nullptr,
          nullptr, &size))
    throw_tls_windows("CryptEncodeObjectEx(size)");
  std::vector<BYTE> encoded(size);
  if (!::CryptEncodeObjectEx(
          X509_ASN_ENCODING, type, value, 0, nullptr,
          encoded.data(), &size))
    throw_tls_windows("CryptEncodeObjectEx");
  encoded.resize(size);
  return encoded;
}

inline std::vector<BYTE>
encode_tls_name(std::wstring_view distinguished_name) {
  const std::wstring owned(distinguished_name);
  DWORD size = 0;
  if (!::CertStrToNameW(
          X509_ASN_ENCODING, owned.c_str(),
          CERT_X500_NAME_STR, nullptr, nullptr, &size,
          nullptr))
    throw_tls_windows("CertStrToNameW(size)");
  std::vector<BYTE> encoded(size);
  if (!::CertStrToNameW(
          X509_ASN_ENCODING, owned.c_str(),
          CERT_X500_NAME_STR, nullptr, encoded.data(), &size,
          nullptr))
    throw_tls_windows("CertStrToNameW");
  encoded.resize(size);
  return encoded;
}

class ncrypt_provider {
public:
  ncrypt_provider() {
    const SECURITY_STATUS status =
        ::NCryptOpenStorageProvider(
            &handle_, MS_KEY_STORAGE_PROVIDER, 0);
    if (status != ERROR_SUCCESS)
      throw_tls_ncrypt(
          status, "NCryptOpenStorageProvider");
  }
  ncrypt_provider(const ncrypt_provider &) = delete;
  ncrypt_provider &operator=(const ncrypt_provider &) = delete;
  ~ncrypt_provider() {
    if (handle_)
      (void)::NCryptFreeObject(handle_);
  }
  NCRYPT_PROV_HANDLE get() const noexcept { return handle_; }

private:
  NCRYPT_PROV_HANDLE handle_ = 0;
};

class acquired_certificate_key {
public:
  explicit acquired_certificate_key(PCCERT_CONTEXT certificate) {
    if (!::CryptAcquireCertificatePrivateKey(
            certificate,
            CRYPT_ACQUIRE_PREFER_NCRYPT_KEY_FLAG |
                CRYPT_ACQUIRE_SILENT_FLAG,
            nullptr, &handle_, &key_spec_, &caller_frees_))
      throw_tls_windows(
          "CryptAcquireCertificatePrivateKey");
  }
  acquired_certificate_key(
      const acquired_certificate_key &) = delete;
  acquired_certificate_key &
  operator=(const acquired_certificate_key &) = delete;
  ~acquired_certificate_key() {
    if (!caller_frees_ || !handle_)
      return;
    if (key_spec_ == CERT_NCRYPT_KEY_SPEC)
      (void)::NCryptFreeObject(
          static_cast<NCRYPT_HANDLE>(handle_));
    else
      (void)::CryptReleaseContext(
          static_cast<HCRYPTPROV>(handle_), 0);
  }

  HCRYPTPROV_OR_NCRYPT_KEY_HANDLE get() const noexcept {
    return handle_;
  }
  DWORD key_spec() const noexcept { return key_spec_; }

private:
  HCRYPTPROV_OR_NCRYPT_KEY_HANDLE handle_ = 0;
  DWORD key_spec_ = 0;
  BOOL caller_frees_ = FALSE;
};

inline const char *
certificate_signature_oid(PCCERT_CONTEXT issuer) {
  if (!issuer || !issuer->pCertInfo ||
      !issuer->pCertInfo->SubjectPublicKeyInfo.Algorithm.pszObjId)
    throw std::invalid_argument(
        "TLS issuer certificate has no public-key algorithm");
  const char *const oid =
      issuer->pCertInfo->SubjectPublicKeyInfo.Algorithm.pszObjId;
  if (std::strcmp(oid, szOID_RSA_RSA) == 0)
    return szOID_RSA_SHA256RSA;
#ifdef szOID_ECDSA_SHA256
  if (std::strcmp(oid, szOID_ECC_PUBLIC_KEY) == 0)
    return szOID_ECDSA_SHA256;
#endif
  throw std::invalid_argument(
      "TLS issuer must use an RSA or ECDSA key");
}

inline void require_ca_certificate(PCCERT_CONTEXT issuer) {
  if (!issuer || !issuer->pCertInfo)
    throw std::invalid_argument(
        "TLS certificate issuer requires a certificate");
  const PCERT_EXTENSION extension = ::CertFindExtension(
      szOID_BASIC_CONSTRAINTS2,
      issuer->pCertInfo->cExtension,
      issuer->pCertInfo->rgExtension);
  if (!extension)
    throw std::invalid_argument(
        "TLS issuer certificate is missing CA constraints");

  CERT_BASIC_CONSTRAINTS2_INFO *constraints = nullptr;
  DWORD size = 0;
  if (!::CryptDecodeObjectEx(
          X509_ASN_ENCODING, X509_BASIC_CONSTRAINTS2,
          extension->Value.pbData, extension->Value.cbData,
          CRYPT_DECODE_ALLOC_FLAG, nullptr, &constraints, &size))
    throw_tls_windows(
        "CryptDecodeObjectEx(CA constraints)");
  const bool is_ca = constraints && constraints->fCA != FALSE;
  if (constraints)
    (void)::LocalFree(constraints);
  if (!is_ca)
    throw std::invalid_argument(
        "TLS issuer certificate is not a CA");

  BYTE usage = 0;
  if (::CertGetIntendedKeyUsage(
          X509_ASN_ENCODING, issuer->pCertInfo,
          &usage, sizeof(usage)) &&
      (usage & CERT_KEY_CERT_SIGN_KEY_USAGE) == 0)
    throw std::invalid_argument(
        "TLS issuer certificate cannot sign certificates");
}

