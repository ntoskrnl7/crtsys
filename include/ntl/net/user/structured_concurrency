struct detached_observer {
  struct promise_type {
    detached_observer get_return_object() const noexcept { return {}; }
    std::suspend_never initial_suspend() const noexcept { return {}; }
    std::suspend_never final_suspend() const noexcept { return {}; }
    void return_void() const noexcept {}
    [[noreturn]] void unhandled_exception() const noexcept {
      std::terminate();
    }
  };
};

template <class T> class background_state final {
public:
  explicit background_state(std::function<void()> stop)
      : stop_(std::move(stop)) {}

  template <class U> void complete(U &&value) noexcept {
    {
      std::lock_guard lock(lock_);
      try {
        value_.emplace(std::forward<U>(value));
      } catch (...) {
        exception_ = std::current_exception();
      }
      completed_ = true;
      stop_ = {};
    }
    completed_event_.notify_all();
  }

  void fail(std::exception_ptr exception) noexcept {
    {
      std::lock_guard lock(lock_);
      exception_ = std::move(exception);
      completed_ = true;
      stop_ = {};
    }
    completed_event_.notify_all();
  }

  void close() noexcept {
    std::function<void()> stop;
    {
      std::lock_guard lock(lock_);
      if (completed_ || stop_requested_)
        return;
      stop_requested_ = true;
      stop = std::move(stop_);
    }
    if (stop)
      stop();
  }

  bool ready() const noexcept {
    std::lock_guard lock(lock_);
    return completed_;
  }

  T get() {
    std::unique_lock lock(lock_);
    completed_event_.wait(lock, [this] { return completed_; });
    if (exception_)
      std::rethrow_exception(exception_);
    if (!value_)
      throw std::logic_error("background task produced no result");
    if (consumed_)
      throw std::logic_error("background task result was already consumed");
    consumed_ = true;
    return std::move(*value_);
  }

private:
  mutable std::mutex lock_;
  std::condition_variable completed_event_;
  std::function<void()> stop_;
  std::optional<T> value_;
  std::exception_ptr exception_;
  bool completed_ = false;
  bool stop_requested_ = false;
  bool consumed_ = false;
};

template <> class background_state<void> final {
public:
  explicit background_state(std::function<void()> stop)
      : stop_(std::move(stop)) {}

  void complete() noexcept {
    {
      std::lock_guard lock(lock_);
      completed_ = true;
      stop_ = {};
    }
    completed_event_.notify_all();
  }

  void fail(std::exception_ptr exception) noexcept {
    {
      std::lock_guard lock(lock_);
      exception_ = std::move(exception);
      completed_ = true;
      stop_ = {};
    }
    completed_event_.notify_all();
  }

  void close() noexcept {
    std::function<void()> stop;
    {
      std::lock_guard lock(lock_);
      if (completed_ || stop_requested_)
        return;
      stop_requested_ = true;
      stop = std::move(stop_);
    }
    if (stop)
      stop();
  }

  bool ready() const noexcept {
    std::lock_guard lock(lock_);
    return completed_;
  }

  void get() {
    std::unique_lock lock(lock_);
    completed_event_.wait(lock, [this] { return completed_; });
    if (exception_)
      std::rethrow_exception(exception_);
  }

private:
  mutable std::mutex lock_;
  std::condition_variable completed_event_;
  std::function<void()> stop_;
  std::exception_ptr exception_;
  bool completed_ = false;
  bool stop_requested_ = false;
};

template <class T>
detached_observer observe_background(
    std::shared_ptr<background_state<T>> state,
    task<T> operation) noexcept {
  try {
    if constexpr (std::is_void_v<T>) {
      co_await std::move(operation);
      state->complete();
    } else {
      state->complete(co_await std::move(operation));
    }
  } catch (...) {
    state->fail(std::current_exception());
  }
}

template <class T> struct completion_slot {
  template <class U> void store(U &&value) {
    result.emplace(std::forward<U>(value));
  }

  T take() {
    if (!result)
      throw std::logic_error("concurrent task produced no result");
    return std::move(*result);
  }

  std::optional<T> result;
};

template <> struct completion_slot<void> {
  void store() noexcept { completed = true; }

  std::monostate take() const {
    if (!completed)
      throw std::logic_error("concurrent task did not complete");
    return {};
  }

  bool completed = false;
};

template <class T>
using completion_value_t =
    std::conditional_t<std::is_void_v<T>, std::monostate, T>;

#if defined(_MSC_VER) && defined(_M_ARM64)
#pragma warning(push)
// The private coordination state contains over-aligned ARM64 synchronization
// storage; its intentional padding is not observable by callers.
#pragma warning(disable : 4324)
#endif
template <class First, class Second, class Stop>
class concurrent_pair_state final {
public:
  concurrent_pair_state(Stop stop, bool stop_on_first) noexcept(
      std::is_nothrow_move_constructible_v<Stop>)
      : stop_(std::move(stop)), stop_on_first_(stop_on_first) {}

  concurrent_pair_state(const concurrent_pair_state &) = delete;
  concurrent_pair_state &operator=(const concurrent_pair_state &) = delete;

  template <class Value>
    requires(!std::is_void_v<First>)
  void first_succeeded(Value &&value) noexcept {
    complete_with_value(first_, std::forward<Value>(value));
  }

  void first_succeeded() noexcept
    requires std::is_void_v<First>
  {
    complete_without_value(first_);
  }

  template <class Value>
    requires(!std::is_void_v<Second>)
  void second_succeeded(Value &&value) noexcept {
    complete_with_value(second_, std::forward<Value>(value));
  }

  void second_succeeded() noexcept
    requires std::is_void_v<Second>
  {
    complete_without_value(second_);
  }

  void failed(std::exception_ptr exception) noexcept {
    completion_action action;
    {
      std::lock_guard lock(lock_);
      action = record_completion_locked(std::move(exception));
    }
    finish_action(action);
  }

  bool ready() const noexcept {
    std::lock_guard lock(lock_);
    return completed_ == 2;
  }

  bool suspend(std::coroutine_handle<> continuation) noexcept {
    std::lock_guard lock(lock_);
    if (completed_ == 2)
      return false;
    continuation_ = continuation;
    return true;
  }

  void abandon() noexcept {
    bool stop = false;
    {
      std::lock_guard lock(lock_);
      abandoned_ = true;
      continuation_ = {};
      if (completed_ != 2 && !stop_requested_) {
        stop_requested_ = true;
        stop = true;
      }
    }
    if (stop)
      stop_();
  }

  std::tuple<completion_value_t<First>, completion_value_t<Second>>
  take_results() {
    std::lock_guard lock(lock_);
    if (completed_ != 2)
      throw std::logic_error("concurrent tasks have not completed");
    if (primary_failure_)
      std::rethrow_exception(primary_failure_);
    return {first_.take(), second_.take()};
  }

  void finish_without_results() {
    std::lock_guard lock(lock_);
    if (completed_ != 2)
      throw std::logic_error("concurrent tasks have not completed");
    if (primary_failure_)
      std::rethrow_exception(primary_failure_);
  }

private:
  struct completion_action {
    bool stop = false;
    std::coroutine_handle<> continuation{};
  };

  template <class Slot, class Value>
  void complete_with_value(Slot &slot, Value &&value) noexcept {
    completion_action action;
    try {
      std::lock_guard lock(lock_);
      slot.store(std::forward<Value>(value));
      action = record_completion_locked({});
    } catch (...) {
      failed(std::current_exception());
      return;
    }
    finish_action(action);
  }

  template <class Slot> void complete_without_value(Slot &slot) noexcept {
    completion_action action;
    {
      std::lock_guard lock(lock_);
      slot.store();
      action = record_completion_locked({});
    }
    finish_action(action);
  }

  completion_action
  record_completion_locked(std::exception_ptr exception) noexcept {
    completion_action action;
    const bool first_completion = completed_ == 0;
    if (exception && (!stop_on_first_ || first_completion) &&
        !primary_failure_)
      primary_failure_ = std::move(exception);

    const bool should_stop =
        stop_on_first_ ? first_completion
                       : static_cast<bool>(primary_failure_);
    if (should_stop && !stop_requested_) {
      stop_requested_ = true;
      action.stop = true;
    }

    ++completed_;
    if (completed_ == 2 && !abandoned_)
      action.continuation = std::exchange(continuation_, {});
    return action;
  }

  void finish_action(const completion_action &action) noexcept {
    // Stop can synchronously complete the peer operation. Invoke it before
    // resuming the parent so the parent always observes a fully drained pair.
    if (action.stop)
      stop_();
    if (action.continuation)
      action.continuation.resume();
  }

  mutable std::mutex lock_;
  completion_slot<First> first_;
  completion_slot<Second> second_;
  Stop stop_;
  std::exception_ptr primary_failure_;
  std::coroutine_handle<> continuation_{};
  unsigned completed_ = 0;
  bool stop_on_first_ = false;
  bool stop_requested_ = false;
  bool abandoned_ = false;
};
#if defined(_MSC_VER) && defined(_M_ARM64)
#pragma warning(pop)
#endif

template <class First, class Second, class Stop>
detached_observer observe_first(
    std::shared_ptr<concurrent_pair_state<First, Second, Stop>> state,
    task<First> operation) noexcept {
  try {
    if constexpr (std::is_void_v<First>) {
      co_await std::move(operation);
      state->first_succeeded();
    } else {
      state->first_succeeded(co_await std::move(operation));
    }
  } catch (...) {
    state->failed(std::current_exception());
  }
}

template <class First, class Second, class Stop>
detached_observer observe_second(
    std::shared_ptr<concurrent_pair_state<First, Second, Stop>> state,
    task<Second> operation) noexcept {
  try {
    if constexpr (std::is_void_v<Second>) {
      co_await std::move(operation);
      state->second_succeeded();
    } else {
      state->second_succeeded(co_await std::move(operation));
    }
  } catch (...) {
    state->failed(std::current_exception());
  }
}

template <class First, class Second, class Stop, bool ReturnResults>
class concurrent_pair_awaiter {
public:
  using state_type = concurrent_pair_state<First, Second, Stop>;

  concurrent_pair_awaiter(task<First> first, task<Second> second, Stop stop,
                          bool stop_on_first)
      : state_(std::make_shared<state_type>(std::move(stop),
                                            stop_on_first)) {
    observe_first(state_, std::move(first));
    observe_second(state_, std::move(second));
  }

  concurrent_pair_awaiter(const concurrent_pair_awaiter &) = delete;
  concurrent_pair_awaiter &operator=(const concurrent_pair_awaiter &) = delete;
  concurrent_pair_awaiter(concurrent_pair_awaiter &&) = delete;
  concurrent_pair_awaiter &operator=(concurrent_pair_awaiter &&) = delete;

  ~concurrent_pair_awaiter() {
    if (state_)
      state_->abandon();
  }

  bool await_ready() const noexcept { return state_->ready(); }

  bool await_suspend(std::coroutine_handle<> continuation) noexcept {
    return state_->suspend(continuation);
  }

  auto await_resume() {
    auto state = std::exchange(state_, {});
    if constexpr (ReturnResults)
      return state->take_results();
    else
      state->finish_without_results();
  }

private:
  std::shared_ptr<state_type> state_;
};

