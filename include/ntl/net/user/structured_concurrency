/**
 * @brief Move-only owning handle for a started task.
 *
 * close() and destruction invoke the supplied stop operation at most once.
 * They never block an IOCP callback: the coroutine frame and its awaited
 * native operations retain shared state until completion. get() is the
 * explicit top-level drain point when a caller needs the result.
 */
template <class T> class background_operation {
public:
  background_operation() noexcept = default;
  background_operation(const background_operation &) = delete;
  background_operation &operator=(const background_operation &) = delete;
  background_operation(background_operation &&) noexcept = default;
  background_operation &operator=(background_operation &&other) noexcept {
    if (this != &other) {
      close();
      state_ = std::move(other.state_);
    }
    return *this;
  }
  ~background_operation() { close(); }

  void close() noexcept {
    auto state = state_;
    if (state)
      state->close();
  }

  bool ready() const noexcept {
    auto state = state_;
    return state && state->ready();
  }

  explicit operator bool() const noexcept { return static_cast<bool>(state_); }

  T get() {
    if (!state_)
      throw std::logic_error("background operation has no state");
    return state_->get();
  }

private:
  template <class U, class Stop>
  friend background_operation<U> start_background(task<U>, Stop);

  explicit background_operation(
      std::shared_ptr<structured_concurrency_detail::background_state<T>>
          state) noexcept
      : state_(std::move(state)) {}

  std::shared_ptr<structured_concurrency_detail::background_state<T>> state_;
};

template <> inline void background_operation<void>::get() {
  if (!state_)
    throw std::logic_error("background operation has no state");
  state_->get();
}

/** Starts a lazy task under an owning, idempotently closeable handle. */
template <class T, class Stop>
background_operation<T> start_background(task<T> operation, Stop stop) {
  static_assert(std::is_nothrow_invocable_v<Stop &>,
                "the background stop callback must be noexcept");
  auto state = std::make_shared<
      structured_concurrency_detail::background_state<T>>(
      [stop = std::move(stop)]() mutable noexcept { stop(); });
  structured_concurrency_detail::observe_background(
      state, std::move(operation));
  return background_operation<T>(std::move(state));
}

/**
 * @brief Runs two tasks concurrently and cancels/drains both on an error.
 *
 * The stop callback is invoked at most once and must be noexcept. Destroying
 * the awaiting parent also invokes it and detaches the parent's continuation;
 * the two observer frames retain their shared state until both operations
 * finish. Successful completion returns both results as a tuple.
 */
template <class First, class Second, class Stop>
auto when_all_cancel_on_error(task<First> first, task<Second> second,
                              Stop stop) {
  static_assert(std::is_nothrow_invocable_v<Stop &>,
                "the structured stop callback must be noexcept");
  return structured_concurrency_detail::concurrent_pair_awaiter<
      First, Second, std::decay_t<Stop>, true>(
      std::move(first), std::move(second), std::move(stop), false);
}

/**
 * @brief Runs two tasks concurrently, stops the peer on first completion, and
 * drains both before resuming the parent.
 *
 * This is the natural policy for tunnels: EOF, a close frame, or an error in
 * either direction closes the transport pair. A follower cancellation error
 * is ignored; an error from the leading completion is rethrown.
 */
template <class First, class Second, class Stop>
auto when_all_stop_on_first(task<First> first, task<Second> second,
                            Stop stop) {
  static_assert(std::is_nothrow_invocable_v<Stop &>,
                "the structured stop callback must be noexcept");
  return structured_concurrency_detail::concurrent_pair_awaiter<
      First, Second, std::decay_t<Stop>, false>(
      std::move(first), std::move(second), std::move(stop), true);
}

