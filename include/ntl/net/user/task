namespace detail {

/** Self-destroying root coroutine used only while sync_wait owns its state. */
struct sync_wait_root {
  struct promise_type {
    sync_wait_root get_return_object() const noexcept { return {}; }
    std::suspend_never initial_suspend() const noexcept { return {}; }
    std::suspend_never final_suspend() const noexcept { return {}; }
    void return_void() const noexcept {}
    [[noreturn]] void unhandled_exception() const noexcept {
      std::terminate();
    }
  };
};

template <class T> class sync_wait_state {
public:
  template <class U> void complete(U &&value) noexcept {
    {
      std::lock_guard lock(lock_);
      try {
        value_.emplace(std::forward<U>(value));
      } catch (...) {
        exception_ = std::current_exception();
      }
      completed_ = true;
    }
    completed_event_.notify_one();
  }

  void fail(std::exception_ptr exception) noexcept {
    {
      std::lock_guard lock(lock_);
      exception_ = std::move(exception);
      completed_ = true;
    }
    completed_event_.notify_one();
  }

  T wait() {
    std::unique_lock lock(lock_);
    completed_event_.wait(lock, [this] { return completed_; });
    if (exception_)
      std::rethrow_exception(exception_);
    if (!value_)
      throw std::logic_error("user task produced no result");
    return std::move(*value_);
  }

private:
  std::mutex lock_;
  std::condition_variable completed_event_;
  bool completed_ = false;
  std::optional<T> value_;
  std::exception_ptr exception_;
};

template <> class sync_wait_state<void> {
public:
  void complete() noexcept {
    {
      std::lock_guard lock(lock_);
      completed_ = true;
    }
    completed_event_.notify_one();
  }

  void fail(std::exception_ptr exception) noexcept {
    {
      std::lock_guard lock(lock_);
      exception_ = std::move(exception);
      completed_ = true;
    }
    completed_event_.notify_one();
  }

  void wait() {
    std::unique_lock lock(lock_);
    completed_event_.wait(lock, [this] { return completed_; });
    if (exception_)
      std::rethrow_exception(exception_);
  }

private:
  std::mutex lock_;
  std::condition_variable completed_event_;
  bool completed_ = false;
  std::exception_ptr exception_;
};

template <class T>
sync_wait_root run_sync_wait(task<T> operation,
                             sync_wait_state<T> &state) noexcept {
  try {
    state.complete(co_await std::move(operation));
  } catch (...) {
    state.fail(std::current_exception());
  }
}

inline sync_wait_root run_sync_wait(task<void> operation,
                                    sync_wait_state<void> &state) noexcept {
  try {
    co_await std::move(operation);
    state.complete();
  } catch (...) {
    state.fail(std::current_exception());
  }
}

} // namespace detail

/**
 * @brief Starts one lazy task and blocks the calling thread until completion.
 *
 * This is a top-level bridge for console/service entry points. It must not be
 * called from an IOCP completion callback that the operation itself needs.
 * Child operations remain owned by the root coroutine until they complete or
 * abandon their lifetime-safe awaiter during exception unwinding.
 */
template <class T> T sync_wait(task<T> operation) {
  detail::sync_wait_state<T> state;
  detail::run_sync_wait(std::move(operation), state);
  return state.wait();
}

inline void sync_wait(task<void> operation) {
  detail::sync_wait_state<void> state;
  detail::run_sync_wait(std::move(operation), state);
  state.wait();
}

} // namespace ntl::net::user
