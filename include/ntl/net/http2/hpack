/**
 * @brief Complete bounded HPACK decoding context for one direction.
 *
 * Keep one instance per HTTP/2 connection direction. The configured dynamic
 * table limit is both an allocation bound and the greatest table-size update
 * accepted from the peer. Header-list output is separately bounded by the
 * maximum passed to decode().
 */
class bounded_hpack_decoder {
public:
  explicit bounded_hpack_decoder(
      hpack_limits limits = {}) noexcept
      : maximum_dynamic_table_size_(
            limits.maximum_dynamic_table_size),
        dynamic_table_limit_(
            limits.maximum_dynamic_table_size) {}

  void reset() noexcept {
    dynamic_table_.clear();
    dynamic_table_size_ = 0;
    dynamic_table_limit_ = maximum_dynamic_table_size_;
  }

  std::size_t dynamic_table_size() const noexcept {
    return dynamic_table_size_;
  }

  std::size_t dynamic_table_entries() const noexcept {
    return dynamic_table_.size();
  }

  ntl::result<decoded_headers>
  decode(ntl::net::scatter_view encoded,
         std::size_t maximum_decoded_size) noexcept {
    if (!encoded || maximum_decoded_size == 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    try {
      return decode_impl(encoded, maximum_decoded_size);
    } catch (const std::bad_alloc &) {
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return ntl::unexpected(STATUS_UNHANDLED_EXCEPTION);
    }
  }

private:
  struct dynamic_entry {
    std::string name;
    std::string value;
    std::size_t size = 0;
  };

  struct indexed_value {
    std::string_view name;
    std::string_view value;
  };

  std::optional<indexed_value>
  lookup(std::size_t index) const noexcept {
    if (index == 0)
      return std::nullopt;
    if (index <= hpack_detail::static_table.size()) {
      const auto &entry =
          hpack_detail::static_table[index - 1];
      return indexed_value{entry.name, entry.value};
    }
    const std::size_t dynamic_index =
        index - hpack_detail::static_table.size() - 1;
    if (dynamic_index >= dynamic_table_.size())
      return std::nullopt;
    const auto &entry = dynamic_table_[dynamic_index];
    return indexed_value{entry.name, entry.value};
  }

  void evict_to_limit() noexcept {
    while (dynamic_table_size_ > dynamic_table_limit_ &&
           !dynamic_table_.empty()) {
      dynamic_table_size_ -= dynamic_table_.back().size;
      dynamic_table_.pop_back();
    }
  }

  void insert(std::string name, std::string value) {
    if (name.size() >
        (std::numeric_limits<std::size_t>::max)() -
            value.size() - 32) {
      dynamic_table_.clear();
      dynamic_table_size_ = 0;
      return;
    }
    const std::size_t size =
        name.size() + value.size() + 32;
    if (size > dynamic_table_limit_) {
      dynamic_table_.clear();
      dynamic_table_size_ = 0;
      return;
    }
    while (!dynamic_table_.empty() &&
           dynamic_table_size_ >
               dynamic_table_limit_ - size) {
      dynamic_table_size_ -= dynamic_table_.back().size;
      dynamic_table_.pop_back();
    }
    dynamic_table_.insert(
        dynamic_table_.begin(),
        dynamic_entry{
            std::move(name), std::move(value), size});
    dynamic_table_size_ += size;
  }

  static ntl::status append_header(
      decoded_headers &output, std::string name,
      std::string value, bool never_index,
      std::size_t maximum_decoded_size) {
    if (name.size() > maximum_decoded_size -
                          output.decoded_bytes ||
        value.size() >
            maximum_decoded_size -
                output.decoded_bytes - name.size())
      return ntl::status(STATUS_BUFFER_OVERFLOW);
    output.decoded_bytes += name.size() + value.size();
    output.fields.push_back(
        {std::move(name), std::move(value), never_index});
    return ntl::status::ok();
  }

  ntl::result<decoded_headers>
  decode_impl(ntl::net::scatter_view encoded,
              std::size_t maximum_decoded_size) {
    hpack_detail::cursor input(encoded);
    decoded_headers output;
    bool header_field_seen = false;

    while (input.remaining() != 0) {
      std::uint8_t first = 0;
      if (!input.at(0, first))
        return ntl::unexpected(STATUS_DATA_ERROR);

      if ((first & 0x80u) != 0) {
        auto index = hpack_detail::read_integer(input, 7);
        if (!index)
          return ntl::unexpected(index.status());
        const auto found = lookup(*index);
        if (!found)
          return ntl::unexpected(STATUS_DATA_ERROR);
        const auto appended = append_header(
            output, std::string(found->name),
            std::string(found->value), false,
            maximum_decoded_size);
        if (!appended.is_ok())
          return ntl::unexpected(
              static_cast<NTSTATUS>(appended));
        header_field_seen = true;
        continue;
      }

      if ((first & 0xe0u) == 0x20u) {
        if (header_field_seen)
          return ntl::unexpected(STATUS_DATA_ERROR);
        auto size = hpack_detail::read_integer(input, 5);
        if (!size)
          return ntl::unexpected(size.status());
        if (*size > maximum_dynamic_table_size_)
          return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
        dynamic_table_limit_ = *size;
        evict_to_limit();
        continue;
      }

      const bool incremental = (first & 0xc0u) == 0x40u;
      const bool never_index =
          !incremental && (first & 0xf0u) == 0x10u;
      const std::uint8_t prefix_bits =
          incremental ? 6 : 4;
      auto name_index =
          hpack_detail::read_integer(input, prefix_bits);
      if (!name_index)
        return ntl::unexpected(name_index.status());

      std::string name;
      if (*name_index == 0) {
        auto literal_name = hpack_detail::read_string(
            input, maximum_decoded_size -
                       output.decoded_bytes);
        if (!literal_name)
          return ntl::unexpected(literal_name.status());
        name = std::move(*literal_name);
      } else {
        const auto found = lookup(*name_index);
        if (!found)
          return ntl::unexpected(STATUS_DATA_ERROR);
        name.assign(found->name);
      }
      if (name.size() >
          maximum_decoded_size - output.decoded_bytes)
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);

      auto value = hpack_detail::read_string(
          input, maximum_decoded_size -
                     output.decoded_bytes - name.size());
      if (!value)
        return ntl::unexpected(value.status());
      std::string dynamic_name;
      std::string dynamic_value;
      if (incremental) {
        dynamic_name = name;
        dynamic_value = *value;
      }
      const auto appended = append_header(
          output, std::move(name), std::move(*value),
          never_index, maximum_decoded_size);
      if (!appended.is_ok())
        return ntl::unexpected(
            static_cast<NTSTATUS>(appended));
      if (incremental)
        insert(std::move(dynamic_name),
               std::move(dynamic_value));
      header_field_seen = true;
    }
    return ntl::ok(std::move(output));
  }

  std::size_t maximum_dynamic_table_size_ = 0;
  std::size_t dynamic_table_limit_ = 0;
  std::size_t dynamic_table_size_ = 0;
  std::vector<dynamic_entry> dynamic_table_;
};

static_assert(noexcept(std::declval<bounded_hpack_decoder &>().reset()));
static_assert(noexcept(
    std::declval<bounded_hpack_decoder &>().decode(
        std::declval<ntl::net::scatter_view>(), 1)));

} // namespace ntl::net::http2
