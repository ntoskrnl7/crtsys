struct huffman_node {
  std::array<std::int16_t, 2> child{{-1, -1}};
  std::int16_t symbol = -1;
};

struct huffman_tree_storage {
  std::array<huffman_node, 1024> nodes{};
  std::size_t used = 1;
};

consteval huffman_tree_storage make_huffman_tree() {
  huffman_tree_storage result;
  for (std::size_t symbol = 0;
       symbol != huffman_codes.size(); ++symbol) {
    std::int16_t node = 0;
    const auto length = huffman_lengths[symbol];
    const auto code = huffman_codes[symbol];
    for (std::uint8_t consumed = 0; consumed != length;
         ++consumed) {
      const auto shift =
          static_cast<std::uint8_t>(length - consumed - 1);
      const std::size_t bit = (code >> shift) & 1u;
      auto &child = result.nodes[
          static_cast<std::size_t>(node)].child[bit];
      if (child < 0) {
        child = static_cast<std::int16_t>(result.used);
        ++result.used;
      }
      node = child;
    }
    result.nodes[static_cast<std::size_t>(node)].symbol =
        static_cast<std::int16_t>(symbol);
  }
  return result;
}

inline constexpr auto huffman_tree = make_huffman_tree();
static_assert(huffman_tree.used <= huffman_tree.nodes.size());

class cursor {
public:
  explicit cursor(ntl::net::scatter_view bytes) noexcept
      : bytes_(bytes) {}

  std::size_t remaining() const noexcept {
    return bytes_.size() - offset_;
  }

  std::size_t position() const noexcept { return offset_; }

  bool at(std::size_t relative,
          std::uint8_t &value) const noexcept {
    if (relative >= remaining())
      return false;
    const auto read =
        bytes_.read<std::uint8_t>(offset_ + relative);
    if (!read)
      return false;
    value = *read;
    return true;
  }

  bool read(std::uint8_t &value) noexcept {
    if (!at(0, value))
      return false;
    ++offset_;
    return true;
  }

  bool advance(std::size_t count) noexcept {
    if (count > remaining())
      return false;
    offset_ += count;
    return true;
  }

private:
  ntl::net::scatter_view bytes_;
  std::size_t offset_ = 0;
};

inline ntl::result<std::size_t>
read_integer(cursor &input, std::uint8_t prefix_bits) noexcept {
  if (prefix_bits == 0 || prefix_bits > 8)
    return ntl::unexpected(STATUS_INVALID_PARAMETER);
  std::uint8_t first = 0;
  if (!input.read(first))
    return ntl::unexpected(STATUS_DATA_ERROR);

  const std::size_t prefix_max =
      (std::size_t{1} << prefix_bits) - 1;
  std::size_t value = first & prefix_max;
  if (value != prefix_max)
    return ntl::ok(value);

  unsigned shift = 0;
  for (;;) {
    std::uint8_t octet = 0;
    if (!input.read(octet))
      return ntl::unexpected(STATUS_DATA_ERROR);
    const std::size_t part = octet & 0x7fu;
    if (shift >=
            std::numeric_limits<std::size_t>::digits ||
        part > ((std::numeric_limits<std::size_t>::max)() -
                value) >> shift)
      return ntl::unexpected(STATUS_INTEGER_OVERFLOW);
    value += part << shift;
    if ((octet & 0x80u) == 0)
      return ntl::ok(value);
    shift += 7;
  }
}

inline ntl::result<std::string>
read_huffman_string(cursor &input, std::size_t encoded_size,
                    std::size_t maximum_decoded_size) {
  if (encoded_size > input.remaining())
    return ntl::unexpected(STATUS_DATA_ERROR);

  std::string decoded;
  decoded.reserve((std::min)(
      encoded_size, maximum_decoded_size));
  std::int16_t node = 0;
  unsigned trailing_count = 0;
  unsigned trailing_value = 0;

  for (std::size_t offset = 0; offset != encoded_size;
       ++offset) {
    std::uint8_t octet = 0;
    if (!input.at(offset, octet))
      return ntl::unexpected(STATUS_DATA_ERROR);
    for (unsigned index = 0; index != 8; ++index) {
      const unsigned bit = (octet >> (7 - index)) & 1u;
      trailing_value =
          ((trailing_value << 1) | bit) & 0xffu;
      ++trailing_count;
      const auto child = huffman_tree.nodes[
          static_cast<std::size_t>(node)].child[bit];
      if (child < 0)
        return ntl::unexpected(STATUS_DATA_ERROR);
      node = child;
      const auto symbol = huffman_tree.nodes[
          static_cast<std::size_t>(node)].symbol;
      if (symbol < 0)
        continue;
      if (symbol == 256)
        return ntl::unexpected(STATUS_DATA_ERROR);
      if (decoded.size() >= maximum_decoded_size)
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
      decoded.push_back(static_cast<char>(symbol));
      node = 0;
      trailing_count = 0;
      trailing_value = 0;
    }
  }
  if (!input.advance(encoded_size))
    return ntl::unexpected(STATUS_DATA_ERROR);
  if (node != 0 &&
      (trailing_count > 7 ||
       trailing_value !=
           ((1u << trailing_count) - 1u)))
    return ntl::unexpected(STATUS_DATA_ERROR);
  return ntl::ok(std::move(decoded));
}

/** Allocation-free HPACK/QPACK Huffman decode into caller-owned storage. */
inline ntl::result<std::size_t>
read_huffman_to(cursor &input, std::size_t encoded_size,
                std::span<std::byte> output) noexcept {
  if (encoded_size > input.remaining())
    return ntl::unexpected(STATUS_DATA_ERROR);

  std::size_t decoded_size = 0;
  std::int16_t node = 0;
  unsigned trailing_count = 0;
  unsigned trailing_value = 0;
  for (std::size_t offset = 0; offset != encoded_size; ++offset) {
    std::uint8_t octet = 0;
    if (!input.at(offset, octet))
      return ntl::unexpected(STATUS_DATA_ERROR);
    for (unsigned index = 0; index != 8; ++index) {
      const unsigned bit = (octet >> (7 - index)) & 1u;
      trailing_value = ((trailing_value << 1) | bit) & 0xffu;
      ++trailing_count;
      const auto child = huffman_tree.nodes[
          static_cast<std::size_t>(node)].child[bit];
      if (child < 0)
        return ntl::unexpected(STATUS_DATA_ERROR);
      node = child;
      const auto symbol = huffman_tree.nodes[
          static_cast<std::size_t>(node)].symbol;
      if (symbol < 0)
        continue;
      if (symbol == 256)
        return ntl::unexpected(STATUS_DATA_ERROR);
      if (decoded_size == output.size())
        return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
      output[decoded_size++] = static_cast<std::byte>(symbol);
      node = 0;
      trailing_count = 0;
      trailing_value = 0;
    }
  }
  if (!input.advance(encoded_size))
    return ntl::unexpected(STATUS_DATA_ERROR);
  if (node != 0 &&
      (trailing_count > 7 ||
       trailing_value != ((1u << trailing_count) - 1u)))
    return ntl::unexpected(STATUS_DATA_ERROR);
  return ntl::ok(decoded_size);
}

inline ntl::result<std::string>
read_string(cursor &input,
            std::size_t maximum_decoded_size) {
  std::uint8_t first = 0;
  if (!input.at(0, first))
    return ntl::unexpected(STATUS_DATA_ERROR);
  const bool huffman = (first & 0x80u) != 0;
  auto length = read_integer(input, 7);
  if (!length)
    return ntl::unexpected(length.status());
  if (*length > input.remaining())
    return ntl::unexpected(STATUS_DATA_ERROR);
  if (huffman)
    return read_huffman_string(
        input, *length, maximum_decoded_size);
  if (*length > maximum_decoded_size)
    return ntl::unexpected(STATUS_BUFFER_OVERFLOW);

  std::string decoded;
  decoded.reserve(*length);
  for (std::size_t index = 0; index != *length; ++index) {
    std::uint8_t octet = 0;
    if (!input.read(octet))
      return ntl::unexpected(STATUS_DATA_ERROR);
    decoded.push_back(static_cast<char>(octet));
  }
  return ntl::ok(std::move(decoded));
}

