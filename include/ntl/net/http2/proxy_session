/**
 * @brief Runs both HTTP/2 directions and drains them before returning.
 *
 * Stream reads and writes are coroutine operations. `stop_transport` must
 * wake both outstanding reads (for sockets this is normally shutdown on both
 * native handles). The first EOF, policy drop, or failure invokes it exactly
 * once; both already-started children are then awaited. No thread or child
 * coroutine is detached from this scope.
 */
template <class DownstreamStream, class UpstreamStream,
          class StopTransport, class TunnelHandler>
ntl::net::user::task<proxy_session_result> run_proxy_session_borrowed(
    DownstreamStream &downstream, UpstreamStream &upstream,
    proxy_connection &connection, StopTransport stop_transport,
    TunnelHandler &tunnels,
    std::size_t maximum_frame_payload = 1024 * 1024) {
  if (maximum_frame_payload == 0 ||
      maximum_frame_payload > absolute_maximum_frame_size)
    throw std::invalid_argument("invalid HTTP/2 proxy session frame limit");

  proxy_session_detail::serialized_writer<DownstreamStream>
      downstream_writer(downstream);
  proxy_session_detail::serialized_writer<UpstreamStream>
      upstream_writer(upstream);
  proxy_session_detail::async_barrier server_settings;
  proxy_session_detail::shared_result result;

  auto stop = [&]() noexcept {
    connection.close();
    downstream_writer.cancel();
    upstream_writer.cancel();
    server_settings.cancel();
    try {
      stop_transport();
    } catch (...) {
    }
  };

  co_await ntl::net::user::when_all_stop_on_first(
      proxy_session_detail::relay_direction(
          downstream, upstream_writer, downstream_writer, connection,
          connection_direction::requests, server_settings, tunnels, result,
          maximum_frame_payload),
      proxy_session_detail::relay_direction(
          upstream, downstream_writer, upstream_writer, connection,
          connection_direction::responses, server_settings, tunnels, result,
          maximum_frame_payload),
      stop);
  co_return result.snapshot();
}

template <class DownstreamStream, class UpstreamStream,
          class StopTransport>
ntl::net::user::task<proxy_session_result> run_proxy_session_borrowed(
    DownstreamStream &downstream, UpstreamStream &upstream,
    proxy_connection &connection, StopTransport stop_transport,
    std::size_t maximum_frame_payload = 1024 * 1024) {
  reject_tunnel_handler tunnels;
  co_return co_await run_proxy_session_borrowed(
      downstream, upstream, connection, std::move(stop_transport), tunnels,
      maximum_frame_payload);
}

namespace proxy_session_detail {

template <class DownstreamStream, class UpstreamStream,
          class StopTransport, class TunnelHandler>
ntl::net::user::task<proxy_session_result> run_proxy_session_owned(
    std::shared_ptr<DownstreamStream> downstream,
    std::shared_ptr<UpstreamStream> upstream,
    std::shared_ptr<proxy_connection> connection,
    StopTransport stop_transport,
    std::shared_ptr<TunnelHandler> tunnels,
    std::size_t maximum_frame_payload) {
  co_return co_await run_proxy_session_borrowed(
      *downstream, *upstream, *connection, std::move(stop_transport),
      *tunnels, maximum_frame_payload);
}

} // namespace proxy_session_detail

/**
 * @brief Owning HTTP/2 session composition.
 *
 * All streams, semantic connection state, and tunnel callbacks are retained
 * by the lazy task at call time. Their declaration order and the lifetime of
 * the facade that created them are therefore not part of the contract.
 */
template <class DownstreamStream, class UpstreamStream,
          class StopTransport, class TunnelHandler>
ntl::net::user::task<proxy_session_result> run_proxy_session_with_stop(
    std::shared_ptr<DownstreamStream> downstream,
    std::shared_ptr<UpstreamStream> upstream,
    std::shared_ptr<proxy_connection> connection,
    StopTransport stop_transport,
    std::shared_ptr<TunnelHandler> tunnels,
    std::size_t maximum_frame_payload = 1024 * 1024) {
  if (!downstream || !upstream || !connection || !tunnels)
    throw std::invalid_argument(
        "HTTP/2 owning proxy session requires all dependencies");
  return proxy_session_detail::run_proxy_session_owned(
      std::move(downstream), std::move(upstream), std::move(connection),
      std::move(stop_transport), std::move(tunnels), maximum_frame_payload);
}

template <class DownstreamStream, class UpstreamStream,
          class StopTransport>
ntl::net::user::task<proxy_session_result> run_proxy_session_with_stop(
    std::shared_ptr<DownstreamStream> downstream,
    std::shared_ptr<UpstreamStream> upstream,
    std::shared_ptr<proxy_connection> connection,
    StopTransport stop_transport,
    std::size_t maximum_frame_payload = 1024 * 1024) {
  return run_proxy_session_with_stop(
      std::move(downstream), std::move(upstream), std::move(connection),
      std::move(stop_transport), std::make_shared<reject_tunnel_handler>(),
      maximum_frame_payload);
}

