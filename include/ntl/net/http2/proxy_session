template <class Stream>
void close_owned_stream(Stream &stream) noexcept {
  try {
    if constexpr (requires { stream.cancel(); }) {
      (void)stream.cancel();
    } else if constexpr (requires { stream.close(); }) {
      stream.close();
    }
  } catch (...) {
  }
}

template <class Stream>
ntl::net::user::task<void> shutdown_owned_stream(Stream &stream) {
  if constexpr (requires { stream.shutdown(); })
    co_await stream.shutdown();
  co_return;
}

template <class DownstreamStream, class UpstreamStream,
          class TunnelHandler>
ntl::net::user::task<proxy_session_result> run_proxy_session_auto_owned(
    std::shared_ptr<DownstreamStream> downstream,
    std::shared_ptr<UpstreamStream> upstream,
    std::shared_ptr<proxy_connection> connection,
    std::shared_ptr<TunnelHandler> tunnels,
    std::size_t maximum_frame_payload) {
  auto stop = [downstream, upstream]() noexcept {
    close_owned_stream(*downstream);
    close_owned_stream(*upstream);
  };
  auto result = co_await run_proxy_session_borrowed(
      *downstream, *upstream, *connection, std::move(stop), *tunnels,
      maximum_frame_payload);
  co_await shutdown_owned_stream(*downstream);
  co_await shutdown_owned_stream(*upstream);
  co_return result;
}

} // namespace proxy_session_detail

/**
 * @brief Owning HTTP/2 session with automatic peer cancellation and join.
 *
 * The session retains both streams, protocol state, and tunnel policy. The
 * first terminal direction closes both stream facades, cancels the peer, and
 * joins both child coroutines before returning. Callers do not supply a drain
 * callback or preserve declaration order.
 */
template <class DownstreamStream, class UpstreamStream, class TunnelHandler>
ntl::net::user::task<proxy_session_result> run_proxy_session(
    std::shared_ptr<DownstreamStream> downstream,
    std::shared_ptr<UpstreamStream> upstream,
    std::shared_ptr<proxy_connection> connection,
    std::shared_ptr<TunnelHandler> tunnels,
    std::size_t maximum_frame_payload = 1024 * 1024) {
  if (!downstream || !upstream)
    throw std::invalid_argument(
        "HTTP/2 owning proxy session requires both streams");
  return proxy_session_detail::run_proxy_session_auto_owned(
      std::move(downstream), std::move(upstream), std::move(connection),
      std::move(tunnels), maximum_frame_payload);
}

template <class DownstreamStream, class UpstreamStream>
ntl::net::user::task<proxy_session_result> run_proxy_session(
    std::shared_ptr<DownstreamStream> downstream,
    std::shared_ptr<UpstreamStream> upstream,
    std::shared_ptr<proxy_connection> connection,
    std::size_t maximum_frame_payload = 1024 * 1024) {
  return run_proxy_session(
      std::move(downstream), std::move(upstream), std::move(connection),
      std::make_shared<reject_tunnel_handler>(), maximum_frame_payload);
}

} // namespace ntl::net::http2
