struct wsk_provider_options {
  ULONG capture_timeout_milliseconds = 15'000;
};

struct wsk_transport_limits {
  std::size_t maximum_write_bytes = 1024 * 1024;
  std::size_t receive_buffer_bytes = 64 * 1024;
  std::chrono::milliseconds connect_timeout{15'000};
};

/**
 * A synchronous borrowed control view applied after WskSocket and before
 * connect. The input span only needs to remain valid for the factory call.
 */
struct wsk_socket_control_view {
  WSK_CONTROL_SOCKET_TYPE request_type = WskIoctl;
  ULONG control_code = 0;
  ULONG level = 0;
  std::span<const std::byte> input{};
};

/** A value-owned native IP endpoint with host-order port input. */
class ip_endpoint {
public:
  ip_endpoint() noexcept = default;

  static ip_endpoint ipv4(std::array<std::uint8_t, 4> address,
                          std::uint16_t port) noexcept {
    ip_endpoint result;
    SOCKADDR_IN native{};
    native.sin_family = AF_INET;
    native.sin_port = RtlUshortByteSwap(port);
    std::memcpy(&native.sin_addr, address.data(), address.size());
    std::memcpy(&result.storage_, &native, sizeof(native));
    result.length_ = sizeof(native);
    return result;
  }

  static ip_endpoint any_ipv4(std::uint16_t port = 0) noexcept {
    return ipv4({0, 0, 0, 0}, port);
  }

  static ip_endpoint ipv6(std::array<std::uint8_t, 16> address,
                          std::uint16_t port,
                          std::uint32_t scope_id = 0) noexcept {
    ip_endpoint result;
    SOCKADDR_IN6 native{};
    native.sin6_family = AF_INET6;
    native.sin6_port = RtlUshortByteSwap(port);
    native.sin6_scope_id = scope_id;
    std::memcpy(&native.sin6_addr, address.data(), address.size());
    std::memcpy(&result.storage_, &native, sizeof(native));
    result.length_ = sizeof(native);
    return result;
  }

  static ip_endpoint any_ipv6(std::uint16_t port = 0) noexcept {
    return ipv6({}, port);
  }

  static ip_endpoint from_native(const SOCKADDR *address,
                                 ULONG length) noexcept {
    ip_endpoint result;
    if (!address ||
        (address->sa_family == AF_INET && length < sizeof(SOCKADDR_IN)) ||
        (address->sa_family == AF_INET6 && length < sizeof(SOCKADDR_IN6)) ||
        (address->sa_family != AF_INET && address->sa_family != AF_INET6))
      return result;
    result.length_ = address->sa_family == AF_INET
                         ? sizeof(SOCKADDR_IN)
                         : sizeof(SOCKADDR_IN6);
    std::memcpy(&result.storage_, address, result.length_);
    return result;
  }

  explicit operator bool() const noexcept {
    return length_ != 0 &&
           (family() == AF_INET || family() == AF_INET6);
  }
  ADDRESS_FAMILY family() const noexcept {
    return length_ == 0 ? AF_UNSPEC : storage_.ss_family;
  }
  std::uint16_t port() const noexcept {
    if (family() == AF_INET) {
      const auto *address = reinterpret_cast<const SOCKADDR_IN *>(&storage_);
      return RtlUshortByteSwap(address->sin_port);
    }
    if (family() == AF_INET6) {
      const auto *address = reinterpret_cast<const SOCKADDR_IN6 *>(&storage_);
      return RtlUshortByteSwap(address->sin6_port);
    }
    return 0;
  }
  SOCKADDR *borrowed_native_address() noexcept {
    return reinterpret_cast<SOCKADDR *>(&storage_);
  }
  const SOCKADDR *borrowed_native_address() const noexcept {
    return reinterpret_cast<const SOCKADDR *>(&storage_);
  }
  ULONG length() const noexcept { return length_; }

  friend bool operator==(const ip_endpoint &left,
                         const ip_endpoint &right) noexcept {
    return left.length_ == right.length_ &&
           (left.length_ == 0 ||
            std::memcmp(&left.storage_, &right.storage_, left.length_) == 0);
  }

  friend bool operator!=(const ip_endpoint &left,
                         const ip_endpoint &right) noexcept {
    return !(left == right);
  }

private:
  SOCKADDR_STORAGE storage_{};
  ULONG length_ = 0;
};

namespace detail {

struct wsk_sync_wait {
  KEVENT event{};
};

inline NTSTATUS wsk_sync_completion(PDEVICE_OBJECT, PIRP,
                                    void *context) noexcept {
  auto *const wait = static_cast<wsk_sync_wait *>(context);
  KeSetEvent(&wait->event, IO_NO_INCREMENT, FALSE);
  return STATUS_MORE_PROCESSING_REQUIRED;
}

inline ntl::status wait_for_wsk_irp(
    PIRP irp, wsk_sync_wait &wait,
    std::chrono::milliseconds timeout =
        (std::chrono::milliseconds::max)()) noexcept {
  LARGE_INTEGER due_time{};
  LARGE_INTEGER *due_time_pointer = nullptr;
  if (timeout != (std::chrono::milliseconds::max)()) {
    if (timeout <= std::chrono::milliseconds::zero()) {
      (void)IoCancelIrp(irp);
      (void)KeWaitForSingleObject(&wait.event, Executive, KernelMode,
                                  FALSE, nullptr);
      return STATUS_IO_TIMEOUT;
    }
    constexpr auto maximum_milliseconds =
        (std::numeric_limits<LONGLONG>::max)() / 10'000;
    const auto count = timeout.count();
    const LONGLONG milliseconds =
        count > maximum_milliseconds
            ? maximum_milliseconds
            : static_cast<LONGLONG>(count);
    due_time.QuadPart = -milliseconds * 10'000;
    due_time_pointer = &due_time;
  }

  const NTSTATUS waited = KeWaitForSingleObject(
      &wait.event, Executive, KernelMode, FALSE, due_time_pointer);
  if (waited == STATUS_TIMEOUT) {
    (void)IoCancelIrp(irp);
    (void)KeWaitForSingleObject(&wait.event, Executive, KernelMode,
                                FALSE, nullptr);
    return STATUS_IO_TIMEOUT;
  }
  if (!NT_SUCCESS(waited))
    return waited;
  return irp->IoStatus.Status;
}

/**
 * Consumes the immediate WSK submission result before waiting. WSK completes
 * the supplied IRP before returning a status other than STATUS_PENDING, so a
 * synchronous success must not depend on a later event notification.
 */
inline ntl::status finish_wsk_irp(
    PIRP irp, wsk_sync_wait &wait, NTSTATUS submitted,
    std::chrono::milliseconds timeout =
        (std::chrono::milliseconds::max)()) noexcept {
  if (submitted == STATUS_PENDING)
    return wait_for_wsk_irp(irp, wait, timeout);
  if (!NT_SUCCESS(submitted))
    return submitted;
  return irp->IoStatus.Status;
}

inline ntl::status close_wsk_socket(PWSK_SOCKET socket,
                                    PIRP irp) noexcept {
  if (!socket || !irp || KeGetCurrentIrql() != PASSIVE_LEVEL)
    return STATUS_INVALID_DEVICE_STATE;
  wsk_sync_wait wait{};
  KeInitializeEvent(&wait.event, NotificationEvent, FALSE);
  IoReuseIrp(irp, STATUS_UNSUCCESSFUL);
  IoSetCompletionRoutine(irp, &wsk_sync_completion, &wait, TRUE, TRUE,
                         TRUE);
  const auto *dispatch =
      static_cast<const WSK_PROVIDER_BASIC_DISPATCH *>(socket->Dispatch);
  const NTSTATUS submitted = dispatch->WskCloseSocket(socket, irp);
  return finish_wsk_irp(irp, wait, submitted);
}

inline ntl::status control_wsk_socket(
    PWSK_SOCKET socket, WSK_CONTROL_SOCKET_TYPE request_type,
    ULONG control_code, ULONG level, std::span<const std::byte> input,
    std::span<std::byte> output, SIZE_T *output_size, PIRP irp,
    std::chrono::milliseconds timeout) noexcept {
  if (!socket || !irp || KeGetCurrentIrql() != PASSIVE_LEVEL ||
      (input.size() != 0 && !input.data()) ||
      (output.size() != 0 && !output.data()))
    return STATUS_INVALID_PARAMETER;

  if (output_size)
    *output_size = 0;
  wsk_sync_wait wait{};
  KeInitializeEvent(&wait.event, NotificationEvent, FALSE);
  IoReuseIrp(irp, STATUS_UNSUCCESSFUL);
  IoSetCompletionRoutine(irp, &wsk_sync_completion, &wait, TRUE, TRUE,
                         TRUE);
  const auto *dispatch =
      static_cast<const WSK_PROVIDER_BASIC_DISPATCH *>(socket->Dispatch);
  const NTSTATUS submitted = dispatch->WskControlSocket(
      socket, request_type, control_code, level, input.size(),
      input.empty() ? nullptr : const_cast<std::byte *>(input.data()),
      output.size(), output.empty() ? nullptr : output.data(), nullptr,
      irp);
  const ntl::status status = finish_wsk_irp(irp, wait, submitted, timeout);
  if (output_size)
    *output_size = static_cast<SIZE_T>(irp->IoStatus.Information);
  return status;
}

inline void initialize_work_item(WORK_QUEUE_ITEM &work,
                                 PWORKER_THREAD_ROUTINE routine,
                                 void *context) noexcept {
#ifdef _MSC_VER
#pragma warning(push)
#pragma warning(disable : 4996)
#endif
  ExInitializeWorkItem(&work, routine, context);
#ifdef _MSC_VER
#pragma warning(pop)
#endif
}

