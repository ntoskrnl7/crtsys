/** Shared native WSK registration retained by every listener and socket. */
class wsk_provider_state {
public:
  explicit wsk_provider_state(passive_cleanup_domain *domain) noexcept
      : cleanup_(&wsk_provider_state::cleanup_at_passive, this),
        domain_(domain) {}

  wsk_provider_state(const wsk_provider_state &) = delete;
  wsk_provider_state &operator=(const wsk_provider_state &) = delete;

  ~wsk_provider_state() {
    NT_ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
    close_native();
  }

  ntl::status open(wsk_provider_options options) noexcept {
    if (KeGetCurrentIrql() != PASSIVE_LEVEL)
      return STATUS_INVALID_DEVICE_STATE;
    WSK_CLIENT_NPI client{};
    client.ClientContext = this;
    client.Dispatch = &client_dispatch_;
    const NTSTATUS registered = WskRegister(&client, &registration_);
    if (!NT_SUCCESS(registered))
      return registered;
    registered_ = true;
    const NTSTATUS captured = WskCaptureProviderNPI(
        &registration_, options.capture_timeout_milliseconds, &provider_);
    if (!NT_SUCCESS(captured)) {
      close_native();
      return captured;
    }
    captured_ = true;
    WSK_EVENT_CALLBACK_CONTROL callbacks{};
    callbacks.NpiId = const_cast<PNPIID>(&NPI_WSK_INTERFACE_ID);
    callbacks.EventMask = WSK_EVENT_ACCEPT | WSK_EVENT_RECEIVE_FROM;
    const NTSTATUS configured = provider_.Dispatch->WskControlClient(
        provider_.Client, WSK_SET_STATIC_EVENT_CALLBACKS,
        sizeof(callbacks), &callbacks, 0, nullptr, nullptr, nullptr);
    if (!NT_SUCCESS(configured)) {
      close_native();
      return configured;
    }
    accepting_.store(true, std::memory_order_release);
    return ntl::status::ok();
  }

  void begin_close() noexcept {
    accepting_.store(false, std::memory_order_release);
  }

  bool accepting() const noexcept {
    return accepting_.load(std::memory_order_acquire) && captured_ &&
           provider_.Client && provider_.Dispatch;
  }

  const WSK_PROVIDER_NPI *borrowed_native_npi() const noexcept {
    return captured_ ? &provider_ : nullptr;
  }

  passive_cleanup_item &cleanup_item() noexcept { return cleanup_; }
  passive_cleanup_domain *domain() const noexcept { return domain_; }

private:
  static void cleanup_at_passive(void *context) noexcept {
    delete static_cast<wsk_provider_state *>(context);
  }

  void close_native() noexcept {
    if (captured_) {
      WskReleaseProviderNPI(&registration_);
      captured_ = false;
      provider_ = {};
    }
    if (registered_) {
      WskDeregister(&registration_);
      registered_ = false;
    }
  }

  inline static const WSK_CLIENT_DISPATCH client_dispatch_{
      MAKE_WSK_VERSION(1, 0), 0, nullptr};

  passive_cleanup_item cleanup_;
  passive_cleanup_domain *domain_ = nullptr;
  WSK_REGISTRATION registration_{};
  WSK_PROVIDER_NPI provider_{};
  std::atomic<bool> accepting_{false};
  bool registered_ = false;
  bool captured_ = false;
};

