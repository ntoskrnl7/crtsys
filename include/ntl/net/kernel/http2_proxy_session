/**
 * Move-only result of inspecting the first downstream HTTP/2 request.
 *
 * The buffered origin-facing frames are intentionally private.  They can only
 * be consumed by the continuation overload of run_kernel_proxy_session, which
 * prevents callers from forwarding a request that was blocked or from
 * replaying the preflight output twice.
 */
template <class WorkspaceLease> class kernel_proxy_session_preflight {
public:
  kernel_proxy_session_preflight(
      const kernel_proxy_session_preflight &) = delete;
  kernel_proxy_session_preflight &operator=(
      const kernel_proxy_session_preflight &) = delete;
  kernel_proxy_session_preflight(
      kernel_proxy_session_preflight &&) noexcept = default;
  kernel_proxy_session_preflight &operator=(
      kernel_proxy_session_preflight &&) noexcept = default;

  bool requires_upstream() const noexcept { return requires_upstream_; }
  const kernel_proxy_session_result &summary() const noexcept {
    return summary_;
  }

private:
  explicit kernel_proxy_session_preflight(WorkspaceLease workspace) noexcept
      : workspace_(std::move(workspace)) {}

  bool requires_upstream_ = false;
  std::size_t buffered_bytes_ = 0;
  kernel_proxy_session_result summary_{};
  std::vector<outbound_frame> upstream_frames_;
  WorkspaceLease workspace_;

  friend struct kernel_proxy_session_detail::preflight_access;
};

/** Default CONNECT behavior: reject before origin-facing HEADERS. */
struct reject_tunnel_handler {
  ntl::result<connect_disposition> admit(
      std::uint32_t,
      const ntl::net::http::request_message &) noexcept {
    return ntl::ok(connect_disposition::reject);
  }

  ntl::result<std::optional<std::vector<outbound_frame>>> transform(
      connection_direction, const frame_view &) noexcept {
    return ntl::unexpected(STATUS_INVALID_DEVICE_STATE);
  }

  void reset(std::uint32_t) noexcept {}
};

/** Caller-owned fixed buffers, normally leased from kernel::workspace_pool. */
struct kernel_proxy_session_buffer_views {
  std::span<std::byte> requests;
  std::span<std::byte> responses;

  bool valid(std::size_t maximum_frame_payload) const noexcept {
    if (maximum_frame_payload == 0 ||
        maximum_frame_payload > absolute_maximum_frame_size)
      return false;
    const std::size_t required =
        maximum_frame_payload + frame_header_size;
    if (requests.size() < required || responses.size() < required)
      return false;
    const auto request_begin =
        reinterpret_cast<std::uintptr_t>(requests.data());
    const auto request_end = request_begin + requests.size();
    const auto response_begin =
        reinterpret_cast<std::uintptr_t>(responses.data());
    const auto response_end = response_begin + responses.size();
    return request_end <= response_begin || response_end <= request_begin;
  }
};

struct kernel_proxy_session_workspace {
  explicit kernel_proxy_session_workspace(
      std::size_t maximum_frame_payload,
      std::size_t maximum_message_storage_size = 96 * 1024 * 1024,
      std::size_t maximum_single_allocation = 16 * 1024 * 1024)
      : message_memory_(
            *ntl::pmr::nonpaged_pool_resource(),
            {.maximum_allocated_bytes = maximum_message_storage_size,
             .maximum_single_allocation = maximum_single_allocation}),
        requests(maximum_frame_payload + frame_header_size),
        responses(maximum_frame_payload + frame_header_size) {
    if (maximum_frame_payload == 0 ||
        maximum_frame_payload > absolute_maximum_frame_size ||
        maximum_message_storage_size == 0 ||
        maximum_single_allocation == 0 ||
        maximum_single_allocation > maximum_message_storage_size)
      throw std::invalid_argument("invalid kernel HTTP/2 workspace limits");
  }

  kernel_proxy_session_workspace(const kernel_proxy_session_workspace &) =
      delete;
  kernel_proxy_session_workspace &
  operator=(const kernel_proxy_session_workspace &) = delete;

  std::vector<std::byte> requests;
  std::vector<std::byte> responses;

  kernel_proxy_session_buffer_views borrowed_buffers() noexcept {
    return {requests, responses};
  }

  ntl::net::http::message_memory_ref borrowed_memory() noexcept {
    return {&message_memory_};
  }

  std::size_t peak_message_storage() const noexcept {
    return message_memory_.peak_allocated_bytes();
  }

private:
  ntl::net::borrowed_bounded_memory_resource message_memory_;
};

