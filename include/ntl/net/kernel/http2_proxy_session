namespace ntl::net::http2 {

enum class kernel_proxy_session_termination : std::uint8_t {
  downstream_eof = 1,
  upstream_eof = 2,
  policy_drop = 3,
  graceful_goaway = 4,
};

/** How the owner must interrupt the sibling relay after the first terminal. */
enum class kernel_proxy_session_stop_mode : std::uint8_t {
  /** Wake pending reads but preserve the transports for TLS close-notify. */
  graceful,
  /** Abort both transports for policy drop or protocol/I/O failure. */
  abortive,
};

enum class kernel_proxy_session_failure_point : std::uint8_t {
  none = 0,
  source_read = 1,
  destination_write = 2,
  source_write = 3,
  protocol = 4,
};

struct kernel_proxy_session_stop_context {
  kernel_proxy_session_stop_mode mode =
      kernel_proxy_session_stop_mode::abortive;
  connection_direction direction = connection_direction::requests;
  ntl::status status{STATUS_UNHANDLED_EXCEPTION};
  kernel_proxy_session_failure_point failure_point =
      kernel_proxy_session_failure_point::none;
};

struct kernel_proxy_session_result {
  kernel_proxy_session_termination termination =
      kernel_proxy_session_termination::downstream_eof;
  std::size_t downstream_to_upstream_bytes = 0;
  std::size_t upstream_to_downstream_bytes = 0;
  std::size_t completed_requests = 0;
  std::size_t completed_responses = 0;
  unsigned last_response_status = 0;
  unsigned last_terminal_status = 0;
  kernel_proxy_session_failure_point failure_point =
      kernel_proxy_session_failure_point::none;
};

struct kernel_proxy_preflight_options {
  std::size_t maximum_frame_payload = 1024 * 1024;
  std::size_t maximum_buffered_origin_bytes = 4 * 1024 * 1024;
  /** Advertise RFC 8441 support while the origin connection is deferred. */
  bool advertise_extended_connect = false;

  constexpr bool valid() const noexcept {
    return maximum_frame_payload != 0 &&
           maximum_frame_payload <= absolute_maximum_frame_size &&
           maximum_buffered_origin_bytes != 0;
  }
};

