struct http3_origin_result {
  ntl::net::http::response_message message;
  std::string negotiated_protocol;
  bool peer_validated = false;
  bool peer_settings_received = false;
  bool dynamic_qpack = false;
  bool qpack_decoder_acknowledgement_queued = false;
};

/**
 * Why a strict HTTP/3 attempt failed.
 *
 * Fallback code must use this stage instead of guessing from NTSTATUS.  A
 * certificate rejection and a disconnected UDP path can otherwise surface
 * through the same provider shutdown status.
 */
enum class http3_origin_failure_kind : std::uint8_t {
  none,
  invalid_state,
  request_validation,
  resource_exhaustion,
  cancellation,
  transport_connection,
  transport_timeout,
  peer_authentication,
  application_protocol,
  http_protocol,
  internal,
};

inline constexpr bool http3_origin_quic_status_equals(
    NTSTATUS value, QUIC_STATUS expected) noexcept {
  return static_cast<std::uint32_t>(value) ==
         static_cast<std::uint32_t>(expected);
}

inline constexpr bool http3_origin_is_quic_tls_alert(
    NTSTATUS value) noexcept {
  constexpr std::uint32_t alert_mask = 0xffffff00u;
  const std::uint32_t prefix =
      static_cast<std::uint32_t>(QUIC_STATUS_TLS_ALERT(0)) & alert_mask;
  return (static_cast<std::uint32_t>(value) & alert_mask) == prefix;
}

/**
 * Classifies only exact MsQuic/NT transport evidence as retryable. Unknown
 * aborts remain `internal`, which is deliberately not a fallback authority.
 */
inline constexpr http3_origin_failure_kind
classify_http3_origin_connection_status(NTSTATUS value) noexcept {
  if (value == STATUS_IO_TIMEOUT ||
      http3_origin_quic_status_equals(
          value, QUIC_STATUS_CONNECTION_TIMEOUT) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_CONNECTION_IDLE))
    return http3_origin_failure_kind::transport_timeout;
  if (http3_origin_quic_status_equals(value, QUIC_STATUS_UNREACHABLE) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_CONNECTION_REFUSED))
    return http3_origin_failure_kind::transport_connection;
  if (http3_origin_quic_status_equals(value, QUIC_STATUS_HANDSHAKE_FAILURE) ||
      http3_origin_is_quic_tls_alert(value) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_CERT_EXPIRED) ||
      http3_origin_quic_status_equals(
          value, QUIC_STATUS_CERT_UNTRUSTED_ROOT) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_CERT_NO_CERT))
    return http3_origin_failure_kind::peer_authentication;
  if (http3_origin_quic_status_equals(value, QUIC_STATUS_ALPN_NEG_FAILURE) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_ALPN_IN_USE) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_VER_NEG_ERROR))
    return http3_origin_failure_kind::application_protocol;
  if (value == STATUS_INSUFFICIENT_RESOURCES || value == STATUS_NO_MEMORY ||
      value == STATUS_QUOTA_EXCEEDED ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_OUT_OF_MEMORY))
    return http3_origin_failure_kind::resource_exhaustion;
  if (value == STATUS_CANCELLED ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_ABORTED) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_USER_CANCELED))
    return http3_origin_failure_kind::cancellation;
  if (value == STATUS_INVALID_PARAMETER ||
      value == STATUS_INVALID_DEVICE_STATE || value == STATUS_NOT_SUPPORTED ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_INVALID_PARAMETER) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_INVALID_STATE) ||
      http3_origin_quic_status_equals(value, QUIC_STATUS_NOT_SUPPORTED))
    return http3_origin_failure_kind::invalid_state;
  return http3_origin_failure_kind::internal;
}

struct http3_origin_failure {
  http3_origin_failure_kind kind = http3_origin_failure_kind::none;
  ntl::status status = ntl::status::ok();
  bool request_committed = false;
  bool request_method_safe = false;

  constexpr bool route_retry_permitted() const noexcept {
    return !request_committed &&
           (kind == http3_origin_failure_kind::transport_connection ||
            kind == http3_origin_failure_kind::transport_timeout);
  }

  /**
   * Protocol fallback is more restrictive than trying the next resolved
   * address. Retrying another route is safe before commit for every method;
   * changing from HTTP/3 to TLS/TCP remains limited to idempotent requests.
   */
  constexpr bool transport_fallback_permitted() const noexcept {
    return request_method_safe && route_retry_permitted();
  }
};

class kernel_http3_origin_exchange;
class kernel_http_origin_fallback_exchange;

/** Opaque proof produced only by a completed strict HTTP/3 exchange. */
class http3_origin_attempt {
public:
  http3_origin_attempt(const http3_origin_attempt &) = delete;
  http3_origin_attempt &operator=(const http3_origin_attempt &) = delete;
  http3_origin_attempt(http3_origin_attempt &&) noexcept = default;
  http3_origin_attempt &operator=(http3_origin_attempt &&) noexcept = default;

  const ntl::result<http3_origin_result> &outcome() const noexcept {
    return outcome_;
  }
  ntl::result<http3_origin_result> &&take_outcome() noexcept {
    return std::move(outcome_);
  }
  const http3_origin_failure &failure() const noexcept { return failure_; }
  bool transport_fallback_permitted() const noexcept {
    return failure_.transport_fallback_permitted() && retry_request_.has_value();
  }
  bool route_retry_permitted() const noexcept {
    return failure_.route_retry_permitted() && retry_request_.has_value();
  }
  std::optional<ntl::net::http::request_message>
  take_uncommitted_request_for_route_retry() noexcept {
    if (!route_retry_permitted())
      return std::nullopt;
    return std::move(retry_request_);
  }

private:
  friend class kernel_http3_origin_exchange;
  friend class kernel_http_origin_fallback_exchange;

  http3_origin_attempt(
      ntl::result<http3_origin_result> &&outcome,
      http3_origin_failure failure,
      std::optional<ntl::net::http::request_message> &&retry) noexcept
      : outcome_(std::move(outcome)), failure_(failure),
        retry_request_(std::move(retry)) {}

  std::optional<ntl::net::http::request_message>
  take_retry_request() noexcept {
    return std::move(retry_request_);
  }

  ntl::result<http3_origin_result> outcome_;
  http3_origin_failure failure_{};
  // Present only when transport_fallback_permitted() is true.  Moving the
  // original request avoids a second multi-megabyte body copy.
  std::optional<ntl::net::http::request_message> retry_request_;
};

struct http3_origin_exchange_limits {
  std::size_t maximum_request_wire = 4 * 1024 * 1024;
  std::size_t maximum_response_wire = 4 * 1024 * 1024;
  std::size_t maximum_qpack_wire = 256 * 1024;
  std::size_t maximum_control_wire = 64 * 1024;
  std::size_t maximum_header_wire = 64 * 1024;
  std::size_t maximum_reserved_bytes = 32 * 1024 * 1024;
  unsigned maximum_qpack_resume_attempts = 32;
  std::chrono::milliseconds connect_timeout = std::chrono::seconds(10);
  std::chrono::milliseconds response_timeout = std::chrono::seconds(15);
  std::chrono::milliseconds qpack_progress_timeout = std::chrono::seconds(2);
  std::chrono::milliseconds qpack_ack_flush_delay =
      std::chrono::milliseconds(10);

  ntl::result<std::size_t> allocation_reservation() const noexcept {
    constexpr auto maximum_timeout_milliseconds =
        (std::numeric_limits<LONGLONG>::max)() / 10'000;
    if (maximum_request_wire == 0 || maximum_response_wire == 0 ||
        maximum_qpack_wire == 0 || maximum_control_wire == 0 ||
        maximum_header_wire == 0 || maximum_reserved_bytes == 0 ||
        maximum_qpack_resume_attempts == 0 || connect_timeout.count() <= 0 ||
        response_timeout.count() <= 0 ||
        qpack_progress_timeout.count() <= 0 ||
        qpack_ack_flush_delay.count() < 0 ||
        connect_timeout.count() > maximum_timeout_milliseconds ||
        response_timeout.count() > maximum_timeout_milliseconds ||
        qpack_progress_timeout.count() > maximum_timeout_milliseconds ||
        qpack_ack_flush_delay.count() > maximum_timeout_milliseconds)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    std::size_t total = 0;
    const auto add = [&total](std::size_t value,
                              std::size_t multiplier) noexcept {
      if (value > (std::numeric_limits<std::size_t>::max)() / multiplier)
        return false;
      const std::size_t product = value * multiplier;
      if (product > (std::numeric_limits<std::size_t>::max)() - total)
        return false;
      total += product;
      return true;
    };
    // Charge a conservative peak rather than only vector.size(): request
    // encode/copy, response wire/snapshot/inspector/body, QPACK snapshots and
    // control/header staging can coexist while a blocked field section is
    // resumed. A service-wide budget can reserve this amount before any
    // connection or large vector is created.
    if (!add(maximum_request_wire, 2) ||
        !add(maximum_response_wire, 4) ||
        !add(maximum_qpack_wire, 3) ||
        !add(maximum_control_wire, 2) ||
        !add(maximum_header_wire, 4) || total > maximum_reserved_bytes)
      return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
    return ntl::ok(total);
  }
};

class http3_origin_allocation_budget {
public:
  explicit http3_origin_allocation_budget(std::size_t maximum) noexcept
      : maximum_(maximum) {}

  bool try_acquire(std::size_t bytes) noexcept {
    if (bytes == 0 || bytes > maximum_)
      return false;
    std::size_t current = current_.load(std::memory_order_acquire);
    while (current <= maximum_ - bytes) {
      if (current_.compare_exchange_weak(
              current, current + bytes, std::memory_order_acq_rel,
              std::memory_order_acquire)) {
        std::size_t peak = peak_.load(std::memory_order_relaxed);
        while (peak < current + bytes &&
               !peak_.compare_exchange_weak(
                   peak, current + bytes, std::memory_order_relaxed)) {
        }
        return true;
      }
    }
    return false;
  }

  void release(std::size_t bytes) noexcept {
    std::size_t current = current_.load(std::memory_order_acquire);
    for (;;) {
      if (bytes == 0 || current < bytes) {
        NT_ASSERT(false);
        return;
      }
      if (current_.compare_exchange_weak(
              current, current - bytes, std::memory_order_acq_rel,
              std::memory_order_acquire))
        return;
    }
  }

  std::size_t current() const noexcept {
    return current_.load(std::memory_order_acquire);
  }
  std::size_t peak() const noexcept {
    return peak_.load(std::memory_order_acquire);
  }
  std::size_t maximum() const noexcept { return maximum_; }

private:
  const std::size_t maximum_ = 0;
  std::atomic<std::size_t> current_{0};
  std::atomic<std::size_t> peak_{0};
};

struct http3_origin_exchange_options {
  http3_origin_exchange_limits limits{};
  // An owning route value. The logical server_name remains the SNI and
  // certificate identity even when name resolution is performed by WSK.
  std::optional<QUIC_ADDR> resolved_remote_address;
  http3_origin_allocation_budget *borrowed_allocation_budget = nullptr;
  // The owner keeps both notification events alive until run() returns.
  // Request cancellation and service shutdown remain distinct authorities,
  // and every blocking wait observes both without polling.
  PKEVENT borrowed_request_cancellation_event = nullptr;
  PKEVENT borrowed_service_cancellation_event = nullptr;
};

