class passive_fast_mutex_guard {
public:
  explicit passive_fast_mutex_guard(FAST_MUTEX &value) noexcept
      : value_(&value) {
    NT_ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
    KeEnterCriticalRegion();
    ExAcquireFastMutexUnsafe(value_);
  }
  passive_fast_mutex_guard(const passive_fast_mutex_guard &) = delete;
  passive_fast_mutex_guard &
  operator=(const passive_fast_mutex_guard &) = delete;
  ~passive_fast_mutex_guard() {
    ExReleaseFastMutexUnsafe(value_);
    KeLeaveCriticalRegion();
  }

private:
  FAST_MUTEX *value_ = nullptr;
};

inline LARGE_INTEGER relative_timeout(
    std::chrono::milliseconds value) noexcept {
  LARGE_INTEGER result{};
  result.QuadPart = -static_cast<LONGLONG>(value.count()) * 10'000;
  return result;
}

template <class ByteContainer>
inline ntl::status append_scatter(
    ntl::net::scatter_view source, ByteContainer &destination,
    std::size_t maximum) noexcept {
  if (source.size() == 0)
    return ntl::status::ok();
  if (!source || destination.size() > maximum ||
      source.size() > maximum - destination.size())
    return source ? ntl::status{STATUS_BUFFER_OVERFLOW}
                  : ntl::status{STATUS_INVALID_PARAMETER};
  const std::size_t offset = destination.size();
  try {
    destination.resize(offset + source.size());
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
  const ntl::status copied = source.copy_to(
      std::span<std::byte>(destination.data(), destination.size())
          .subspan(offset));
  if (!copied.is_ok())
    destination.resize(offset);
  return copied;
}

inline ntl::status append_http3_frame(
    std::vector<std::byte> &wire, ntl::net::http3::frame_type type,
    std::span<const std::byte> payload,
    std::size_t maximum) noexcept {
  try {
    if (wire.size() > maximum || payload.size() > maximum - wire.size())
      return STATUS_BUFFER_OVERFLOW;
    std::vector<std::byte> header;
    header.reserve(16);
    ntl::status status = ntl::net::http3::append_quic_varint(
        header, static_cast<std::uint64_t>(type));
    if (status.is_ok())
      status = ntl::net::http3::append_quic_varint(header, payload.size());
    if (!status.is_ok())
      return status;
    if (header.size() > maximum - wire.size() ||
        payload.size() > maximum - wire.size() - header.size())
      return STATUS_BUFFER_OVERFLOW;
    wire.insert(wire.end(), header.begin(), header.end());
    wire.insert(wire.end(), payload.begin(), payload.end());
    return ntl::status::ok();
  } catch (const std::bad_alloc &) {
    return STATUS_INSUFFICIENT_RESOURCES;
  } catch (...) {
    return STATUS_UNHANDLED_EXCEPTION;
  }
}

class allocation_budget_lease {
public:
  allocation_budget_lease(http3_origin_allocation_budget *budget,
                          std::size_t bytes) noexcept
      : budget_(budget), bytes_(bytes), acquired_(!budget) {
    if (budget_)
      acquired_ = budget_->try_acquire(bytes_);
  }
  allocation_budget_lease(const allocation_budget_lease &) = delete;
  allocation_budget_lease &
  operator=(const allocation_budget_lease &) = delete;
  ~allocation_budget_lease() {
    if (budget_ && acquired_)
      budget_->release(bytes_);
  }

  explicit operator bool() const noexcept { return acquired_; }

private:
  http3_origin_allocation_budget *budget_ = nullptr;
  std::size_t bytes_ = 0;
  bool acquired_ = false;
};

class response_sink final : public ntl::net::http3::inspection_sink {
public:
  response_sink(std::size_t maximum_body_size,
                std::size_t maximum_header_size) noexcept
      : maximum_body_size_(maximum_body_size),
        maximum_header_size_(maximum_header_size) {}

  ntl::status on_headers(
      std::uint64_t,
      std::span<const ntl::net::http3::header_field> fields) noexcept override {
    try {
      if (headers_seen_)
        return STATUS_NOT_SUPPORTED;
      headers_seen_ = true;
      bool status_seen = false;
      for (const auto &field : fields) {
        if (field.name == ":status") {
          if (status_seen || field.value.size() != 3)
            return STATUS_DATA_ERROR;
          unsigned value = 0;
          for (const char digit : field.value) {
            if (digit < '0' || digit > '9')
              return STATUS_DATA_ERROR;
            value = value * 10 + static_cast<unsigned>(digit - '0');
          }
          message_.status = value;
          status_seen = true;
          continue;
        }
        if (field.name.empty() || field.name.front() == ':')
          return STATUS_DATA_ERROR;
        for (const unsigned char character : field.name) {
          if (character >= 'A' && character <= 'Z')
            return STATUS_DATA_ERROR;
        }
        message_.headers.append(field.name, field.value, field.never_index);
      }
      if (message_.status < 100 || message_.status > 599)
        return STATUS_DATA_ERROR;
      return status_seen ? ntl::status::ok()
                         : ntl::status{STATUS_DATA_ERROR};
    } catch (const std::invalid_argument &) {
      return STATUS_DATA_ERROR;
    } catch (const std::bad_alloc &) {
      return STATUS_INSUFFICIENT_RESOURCES;
    } catch (...) {
      return STATUS_UNHANDLED_EXCEPTION;
    }
  }

  ntl::status on_data(std::uint64_t,
                      ntl::net::scatter_view data) noexcept override {
    return append_scatter(data, message_.body, maximum_body_size_);
  }

  ntl::status on_stream_end(std::uint64_t) noexcept override {
    complete_ = true;
    return headers_seen_ ? ntl::status::ok()
                         : ntl::status{STATUS_DATA_ERROR};
  }

  bool complete() const noexcept { return complete_; }
  ntl::status validate(
      const ntl::net::http::request_message &request) const noexcept {
    if (message_.status < 200)
      return STATUS_DATA_ERROR;
    ntl::net::http::transform_limits limits{};
    limits.maximum_header_bytes = maximum_header_size_;
    limits.maximum_encoded_body_bytes = maximum_body_size_;
    limits.maximum_decoded_body_bytes = maximum_body_size_;
    const ntl::status headers = message_.headers.validate(
        ntl::net::http::protocol::http3, limits);
    if (!headers.is_ok())
      return headers;
    if (ntl::net::http::response_body_forbidden(request, message_))
      return message_.body.empty() ? ntl::status::ok()
                                   : ntl::status{STATUS_DATA_ERROR};
    const auto declared = message_.headers.first("content-length");
    if (!declared)
      return ntl::status::ok();
    std::size_t length = 0;
    const auto parsed = std::from_chars(
        declared->data(), declared->data() + declared->size(), length);
    return parsed.ec == std::errc{} &&
                   parsed.ptr == declared->data() + declared->size() &&
                   length == message_.body.size()
               ? ntl::status::ok()
               : ntl::status{STATUS_DATA_ERROR};
  }
  ntl::net::http::response_message take() noexcept {
    message_.wire_protocol = ntl::net::http::protocol::http3;
    return std::move(message_);
  }

private:
  std::size_t maximum_body_size_ = 0;
  std::size_t maximum_header_size_ = 0;
  ntl::net::http::response_message message_{};
  bool headers_seen_ = false;
  bool complete_ = false;
};

