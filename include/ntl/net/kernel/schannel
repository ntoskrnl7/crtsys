/**
 * @brief Reference to a LocalMachine certificate and private key.
 *
 * Kernel Schannel consumes a SHA-1 certificate thumbprint from a machine
 * certificate store. The certificate and its private key must be provisioned
 * before the driver acquires server credentials.
 */
struct schannel_certificate_store_ref {
  static constexpr std::size_t thumbprint_size = 20;
  static constexpr std::size_t maximum_store_name = 128;

  std::array<std::byte, thumbprint_size> sha1_thumbprint{};
  std::array<wchar_t, maximum_store_name> store_name{};
  bool machine_store = true;

  static ntl::result<schannel_certificate_store_ref>
  make(std::span<const std::byte> thumbprint,
       std::wstring_view store = L"MY") noexcept {
    if (thumbprint.size() != thumbprint_size || store.empty() ||
        store.size() >= maximum_store_name)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    schannel_certificate_store_ref result;
    std::copy(thumbprint.begin(), thumbprint.end(),
              result.sha1_thumbprint.begin());
    std::copy(store.begin(), store.end(), result.store_name.begin());
    result.store_name[store.size()] = L'\0';
    return ntl::ok(std::move(result));
  }
};

/**
 * @brief Selects peer validation and an optional client identity.
 *
 * An explicit certificate and the system's default client certificate are
 * mutually exclusive.  The referenced store identity is consumed while
 * acquiring the reusable credential handle and need not outlive it.
 */
struct schannel_client_credential_options {
  bool manual_peer_validation = false;
  bool use_default_client_certificate = false;
  const schannel_certificate_store_ref *borrowed_certificate = nullptr;
};

namespace detail {

// Public Schannel ABI structures are declared in the user-mode header with
// certificate-context pointer types. Kernel callers use the documented hash
// credential formats, so these private mirrors keep the ABI without importing
// CryptoAPI user-mode declarations into a driver translation unit.
inline constexpr ULONG sch_credentials_version = 5;
inline constexpr ULONG sch_cred_format_cert_hash_store = 2;
inline constexpr ULONG sch_machine_cert_hash = 1;
inline constexpr ULONG sch_cred_no_system_mapper = 0x00000002;
inline constexpr ULONG sch_cred_manual_validation = 0x00000008;
inline constexpr ULONG sch_cred_no_default_creds = 0x00000010;
inline constexpr ULONG sch_cred_use_default_creds = 0x00000040;
inline constexpr ULONG sch_use_strong_crypto = 0x00400000;
inline constexpr ULONG schannel_shutdown = 1;
inline constexpr ULONG secpkg_attr_remote_certificates = 0x5f;

inline constexpr SECURITY_STATUS security_ok = 0x00000000L;
inline constexpr SECURITY_STATUS security_internal_error =
    static_cast<SECURITY_STATUS>(0x80090304UL);
inline constexpr SECURITY_STATUS security_continue_needed = 0x00090312L;
inline constexpr SECURITY_STATUS security_complete_needed = 0x00090313L;
inline constexpr SECURITY_STATUS security_complete_and_continue = 0x00090314L;
inline constexpr SECURITY_STATUS security_context_expired = 0x00090317L;
inline constexpr SECURITY_STATUS security_context_expired_error =
    static_cast<SECURITY_STATUS>(0x80090317u);
inline constexpr SECURITY_STATUS security_incomplete_message =
    static_cast<SECURITY_STATUS>(0x80090318UL);
inline constexpr SECURITY_STATUS security_no_credentials =
    static_cast<SECURITY_STATUS>(0x8009030EUL);
inline constexpr SECURITY_STATUS security_renegotiate = 0x00090321L;

struct native_schannel_hash_store {
  ULONG length = sizeof(native_schannel_hash_store);
  ULONG flags = 0;
  ULONG_PTR provider = 0;
  std::array<std::byte, schannel_certificate_store_ref::thumbprint_size>
      sha_hash{};
  std::array<wchar_t, schannel_certificate_store_ref::maximum_store_name>
      store_name{};
};

struct native_sch_credentials {
  ULONG version = sch_credentials_version;
  ULONG credential_format = 0;
  ULONG credential_count = 0;
  void **credentials = nullptr;
  void *root_store = nullptr;
  ULONG mapper_count = 0;
  void **mappers = nullptr;
  ULONG session_lifespan = 0;
  ULONG flags = 0;
  ULONG tls_parameter_count = 0;
  void *tls_parameters = nullptr;
};

// Kernel Schannel exposes raw DER chains instead of CryptoAPI contexts.  The
// returned buffer is allocated by SSPI and must be released with
// FreeContextBuffer after it has been copied out of the callback boundary.
struct native_secpkg_context_certificates {
  ULONG certificate_count = 0;
  ULONG certificate_chain_size = 0;
  UCHAR *certificate_chain = nullptr;
};

class process_buffer {
public:
  process_buffer() noexcept = default;
  process_buffer(const process_buffer &) = delete;
  process_buffer &operator=(const process_buffer &) = delete;

  process_buffer(process_buffer &&other) noexcept
      : base_(std::exchange(other.base_, nullptr)),
        region_size_(std::exchange(other.region_size_, 0)),
        requested_size_(std::exchange(other.requested_size_, 0)) {}

  process_buffer &operator=(process_buffer &&other) noexcept {
    if (this != &other) {
      reset();
      base_ = std::exchange(other.base_, nullptr);
      region_size_ = std::exchange(other.region_size_, 0);
      requested_size_ = std::exchange(other.requested_size_, 0);
    }
    return *this;
  }

  ~process_buffer() { reset(); }

  static ntl::result<process_buffer>
  try_allocate(std::size_t size) noexcept {
    if (KeGetCurrentIrql() != PASSIVE_LEVEL)
      return ntl::unexpected(STATUS_INVALID_DEVICE_STATE);
    if (size == 0)
      return ntl::ok(process_buffer{});
    void *base = nullptr;
    SIZE_T region_size = size;
    const NTSTATUS status = ZwAllocateVirtualMemory(
        ZwCurrentProcess(), &base, 0, &region_size,
        MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
    if (!NT_SUCCESS(status))
      return ntl::unexpected(status);
    return ntl::ok(process_buffer(base, region_size, size));
  }

  static ntl::result<process_buffer>
  try_copy(std::span<const std::byte> bytes) noexcept {
    auto result = try_allocate(bytes.size());
    if (!result)
      return result;
    if (!bytes.empty())
      std::memcpy(result->data(), bytes.data(), bytes.size());
    return result;
  }

  void reset() noexcept {
    if (base_) {
      void *base = base_;
      SIZE_T size = 0;
      (void)ZwFreeVirtualMemory(ZwCurrentProcess(), &base, &size,
                                MEM_RELEASE);
    }
    base_ = nullptr;
    region_size_ = 0;
    requested_size_ = 0;
  }

  std::byte *data() noexcept { return static_cast<std::byte *>(base_); }
  const std::byte *data() const noexcept {
    return static_cast<const std::byte *>(base_);
  }
  std::size_t size() const noexcept { return requested_size_; }
  std::span<std::byte> span() noexcept { return {data(), requested_size_}; }
  explicit operator bool() const noexcept {
    return base_ != nullptr || requested_size_ == 0;
  }

private:
  process_buffer(void *base, SIZE_T region_size,
                 std::size_t requested_size) noexcept
      : base_(base), region_size_(region_size),
        requested_size_(requested_size) {}

  void *base_ = nullptr;
  SIZE_T region_size_ = 0;
  std::size_t requested_size_ = 0;
};

inline ntl::result<owned_bytes>
copy_security_buffer(const SecBuffer &source, std::size_t maximum,
                     ULONG tag) noexcept {
  if (source.cbBuffer > maximum ||
      (source.cbBuffer != 0 && !source.pvBuffer))
    return ntl::unexpected(source.cbBuffer > maximum
                               ? STATUS_BUFFER_OVERFLOW
                               : STATUS_INVALID_BUFFER_SIZE);
  return owned_bytes::try_copy(
      {static_cast<const std::byte *>(source.pvBuffer), source.cbBuffer},
      buffer_limits{maximum}, tag);
}

inline const SecBuffer *find_buffer(const SecBuffer *buffers,
                                    std::size_t count,
                                    ULONG type) noexcept {
  for (std::size_t index = 0; index != count; ++index) {
    if (buffers[index].BufferType == type)
      return &buffers[index];
  }
  return nullptr;
}

inline SECURITY_STATUS complete_auth_if_needed(SECURITY_STATUS status,
                                                CtxtHandle &context,
                                                SecBufferDesc &output) noexcept {
  if (status != security_complete_needed &&
      status != security_complete_and_continue)
    return status;
  const SECURITY_STATUS completed = CompleteAuthToken(&context, &output);
  if (completed != security_ok)
    return completed;
  return status == security_complete_needed ? security_ok
                                             : security_continue_needed;
}

inline bool context_may_exist(SECURITY_STATUS status) noexcept {
  return status == security_ok || status == security_continue_needed ||
         status == security_complete_needed ||
         status == security_complete_and_continue;
}

