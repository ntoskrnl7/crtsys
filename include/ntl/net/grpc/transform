/**
 * @file grpc_transform
 * @brief Bounded streaming gRPC message inspection and rewriting.
 */
#pragma once

#if defined(_KERNEL_MODE) || defined(_KERNEL32_)
#error "ntl/net/grpc/transform is a user-mode header"
#endif

#include <ntl/net/grpc/framing>
#include <ntl/net/inspection/content_decoder>
#include <ntl/net/inspection/content_encoder>
#include <ntl/net/inspection/core>

#include <cstddef>
#include <cstdint>
#include <functional>
#include <new>
#include <span>
#include <string>
#include <string_view>
#include <type_traits>
#include <utility>
#include <vector>

namespace ntl::net::grpc {

enum class direction : std::uint8_t { request = 1, response = 2 };

struct semantic_message {
  direction flow = direction::request;
  std::uint64_t sequence = 0;
  bool compressed = false;
  std::string encoding = "identity";
  std::vector<std::byte> payload;
};

enum class transform_action : std::uint8_t {
  forward = 1,
  block = 2,
  drop = 3,
};

class transform_result {
public:
  static transform_result unchanged() noexcept { return {}; }
  static transform_result replace(std::vector<std::byte> payload) {
    transform_result result;
    result.modified_ = true;
    result.payload_ = std::move(payload);
    return result;
  }
  static transform_result block() noexcept {
    transform_result result;
    result.action_ = transform_action::block;
    return result;
  }
  static transform_result drop() noexcept {
    transform_result result;
    result.action_ = transform_action::drop;
    return result;
  }
  transform_action action() const noexcept { return action_; }
  bool modified() const noexcept { return modified_; }
  std::vector<std::byte> release_payload() noexcept {
    return std::move(payload_);
  }

private:
  transform_action action_ = transform_action::forward;
  bool modified_ = false;
  std::vector<std::byte> payload_;
};

struct transform_limits {
  std::size_t maximum_buffered_bytes = 8 * 1024 * 1024;
  std::size_t maximum_encoded_message_bytes = 4 * 1024 * 1024;
  std::size_t maximum_decoded_message_bytes = 16 * 1024 * 1024;
};

class message_transform_pipeline {
public:
  explicit message_transform_pipeline(transform_limits limits = {})
      : limits_(limits) {
    if (limits_.maximum_buffered_bytes == 0 ||
        limits_.maximum_encoded_message_bytes == 0 ||
        limits_.maximum_decoded_message_bytes == 0)
      throw std::invalid_argument("gRPC transform limits are invalid");
  }

  template <class Function>
  message_transform_pipeline &transform(Function &&function) {
    using callback_type = std::decay_t<Function>;
    rules_.push_back(
        [callback = callback_type(std::forward<Function>(function))](
            semantic_message &message) {
          return static_cast<transform_result>(callback(message));
        });
    return *this;
  }

  template <class Function>
  message_transform_pipeline &inspect(Function &&function) {
    using callback_type = std::decay_t<Function>;
    return transform([callback = callback_type(
                          std::forward<Function>(function))](
                         semantic_message &message) {
      switch (static_cast<ntl::net::inspection::verdict>(
          callback(static_cast<const semantic_message &>(message)))) {
      case ntl::net::inspection::verdict::permit:
        return transform_result::unchanged();
      case ntl::net::inspection::verdict::block:
        return transform_result::block();
      case ntl::net::inspection::verdict::drop_flow:
        return transform_result::drop();
      }
      return transform_result::block();
    });
  }

  transform_action apply(semantic_message &message,
                         bool &modified) const noexcept {
    modified = false;
    try {
      for (const auto &rule : rules_) {
        auto result = rule(message);
        if (result.action() != transform_action::forward)
          return result.action();
        if (result.modified()) {
          message.payload = result.release_payload();
          modified = true;
          if (message.payload.size() >
              limits_.maximum_decoded_message_bytes)
            return transform_action::block;
        }
      }
      return transform_action::forward;
    } catch (...) {
      return transform_action::block;
    }
  }

  transform_limits limits() const noexcept { return limits_; }

private:
  std::vector<std::function<transform_result(semantic_message &)>> rules_;
  transform_limits limits_{};
};

struct feed_outcome {
  transform_action action = transform_action::forward;
  std::vector<std::byte> wire;
  std::size_t messages = 0;
  std::size_t modified_messages = 0;
  NTSTATUS failure = STATUS_SUCCESS;
};

/**
 * @brief Incremental gRPC stream adapter for HTTP/2 or HTTP/3 DATA chunks.
 */
class stream_transformer {
public:
  stream_transformer(
      direction flow, std::string grpc_encoding,
      const message_transform_pipeline &pipeline,
      const ntl::net::inspection::content_decoder_registry &decoders,
      const ntl::net::inspection::content_encoder_registry &encoders)
      : flow_(flow), encoding_(normalize(std::move(grpc_encoding))),
        pipeline_(&pipeline), decoders_(&decoders), encoders_(&encoders) {
    if (encoding_.empty())
      encoding_ = "identity";
  }

  feed_outcome feed(std::span<const std::byte> bytes,
                    bool final = false) noexcept {
    feed_outcome outcome;
    try {
      if (finished_ || bytes.size() >
                           pipeline_->limits().maximum_buffered_bytes -
                               buffer_.size())
        return fail(finished_ ? STATUS_INVALID_DEVICE_STATE
                              : STATUS_BUFFER_OVERFLOW);
      buffer_.insert(buffer_.end(), bytes.begin(), bytes.end());

      std::size_t consumed = 0;
      while (buffer_.size() - consumed >= 5) {
        const auto remaining = std::span<const std::byte>(buffer_).subspan(consumed);
        const auto view = ntl::net::scatter_view::from_contiguous(remaining);
        const auto probe = message_framer(
            pipeline_->limits().maximum_encoded_message_bytes).probe(view);
        if (probe.state() == ntl::net::framing::probe_state::need_more)
          break;
        if (probe.state() != ntl::net::framing::probe_state::complete)
          return fail(probe.error());

        const auto header = inspect_header(
            view, pipeline_->limits().maximum_encoded_message_bytes);
        if (!header)
          return fail(header.status());
        std::vector<std::byte> payload(
            remaining.begin() + 5,
            remaining.begin() +
                static_cast<std::ptrdiff_t>(5 + header->payload_size));
        if (header->compressed) {
          if (encoding_ == "identity")
            return fail(STATUS_DATA_ERROR);
          auto decoder = decoders_->create(encoding_);
          if (!decoder)
            return fail(STATUS_NOT_SUPPORTED);
          auto decoded = ntl::net::inspection::decode_complete(
              *decoder, ntl::net::scatter_view::from_contiguous(
                            std::span<const std::byte>(payload)),
              pipeline_->limits().maximum_decoded_message_bytes);
          if (!decoded)
            return fail(decoded.status());
          payload = std::move(*decoded);
        }

        semantic_message message{
            flow_, sequence_++, header->compressed, encoding_,
            std::move(payload)};
        bool modified = false;
        outcome.action = pipeline_->apply(message, modified);
        if (outcome.action != transform_action::forward)
          return outcome;
        if (modified)
          ++outcome.modified_messages;

        std::vector<std::byte> encoded_payload = std::move(message.payload);
        if (header->compressed) {
          auto encoder = encoders_->create(encoding_);
          if (!encoder)
            return fail(STATUS_NOT_SUPPORTED);
          auto encoded = ntl::net::inspection::encode_complete(
              *encoder, encoded_payload,
              pipeline_->limits().maximum_encoded_message_bytes);
          if (!encoded)
            return fail(encoded.status());
          encoded_payload = std::move(*encoded);
        }
        auto wire = encode_message(
            encoded_payload, header->compressed,
            pipeline_->limits().maximum_encoded_message_bytes);
        if (!wire)
          return fail(wire.status());
        if (wire->size() >
            pipeline_->limits().maximum_buffered_bytes - outcome.wire.size())
          return fail(STATUS_BUFFER_OVERFLOW);
        outcome.wire.insert(outcome.wire.end(), wire->begin(), wire->end());
        ++outcome.messages;
        consumed += probe.frame_size();
      }
      if (consumed != 0)
        buffer_.erase(buffer_.begin(),
                      buffer_.begin() + static_cast<std::ptrdiff_t>(consumed));
      if (final) {
        finished_ = true;
        if (!buffer_.empty())
          return fail(STATUS_END_OF_FILE);
      }
      return outcome;
    } catch (const std::bad_alloc &) {
      return fail(STATUS_INSUFFICIENT_RESOURCES);
    } catch (...) {
      return fail(STATUS_UNHANDLED_EXCEPTION);
    }
  }

private:
  static std::string normalize(std::string value) {
    for (char &character : value) {
      if (character >= 'A' && character <= 'Z')
        character = static_cast<char>(character + ('a' - 'A'));
    }
    return value;
  }
  feed_outcome fail(ntl::status status) noexcept {
    finished_ = true;
    return {transform_action::block, {}, 0, 0,
            static_cast<NTSTATUS>(status)};
  }

  direction flow_ = direction::request;
  std::string encoding_ = "identity";
  const message_transform_pipeline *pipeline_ = nullptr;
  const ntl::net::inspection::content_decoder_registry *decoders_ = nullptr;
  const ntl::net::inspection::content_encoder_registry *encoders_ = nullptr;
  std::vector<std::byte> buffer_;
  std::uint64_t sequence_ = 0;
  bool finished_ = false;
};

} // namespace ntl::net::grpc
