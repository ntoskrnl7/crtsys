 */
#pragma once

#if !defined(_KERNEL_MODE) && !defined(_KERNEL32_)
#error "ntl/net/buffer/owned_bytes is a kernel-mode header"
#endif

#include <ntl/pool_allocator>
#include <ntl/net/buffer/scatter_view>

#include <cstddef>
#include <span>
#include <utility>

namespace ntl::net {

/**
 * @brief Explicit bound applied before allocating a copied network buffer.
 */
struct buffer_limits {
  std::size_t maximum = 64 * 1024;

  constexpr bool accepts(std::size_t length) const noexcept {
    return length <= maximum;
  }
};

/**
 * @brief Independent move-only bytes safe beyond a native callback lifetime.
 */
class owned_bytes {
public:
  owned_bytes() noexcept = default;
  owned_bytes(const owned_bytes &) = delete;
  owned_bytes &operator=(const owned_bytes &) = delete;

  owned_bytes(owned_bytes &&other) noexcept
      : data_(std::exchange(other.data_, nullptr)),
        size_(std::exchange(other.size_, 0)),
        tag_(std::exchange(other.tag_, ntl::default_pool_tag)) {}

  owned_bytes &operator=(owned_bytes &&other) noexcept {
    if (this != &other) {
      reset();
      data_ = std::exchange(other.data_, nullptr);
      size_ = std::exchange(other.size_, 0);
      tag_ = std::exchange(other.tag_, ntl::default_pool_tag);
    }
    return *this;
  }

  ~owned_bytes() { reset(); }

  static ntl::result<owned_bytes>
  try_allocate(std::size_t length, buffer_limits limits,
               ULONG tag = ntl::pool_tag("bLtN")) noexcept {
    if (!limits.accepts(length))
      return ntl::unexpected(STATUS_BUFFER_OVERFLOW);
    if (length == 0)
      return ntl::ok(owned_bytes{});

    const ntl::status irql =
        ntl::require_pool_irql(ntl::pool_kind::nonpaged);
    if (!irql.is_ok())
      return ntl::unexpected(irql);

    void *const storage = ntl::detail::allocate_pool_bytes(
        length, alignof(std::max_align_t), ntl::pool_kind::nonpaged,
        ntl::pool_option::none, tag);
    if (!storage)
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);

    return ntl::ok(
        owned_bytes(static_cast<std::byte *>(storage), length, tag));
  }

  static ntl::result<owned_bytes>
  try_copy(scatter_view source, buffer_limits limits,
           ULONG tag = ntl::pool_tag("bLtN")) noexcept {
    if (!source)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    auto result = try_allocate(source.size(), limits, tag);
    if (!result)
      return result;
    if (source.empty())
      return result;

    const ntl::status copied = source.copy_to(result->span());
    if (!copied.is_ok())
      return ntl::unexpected(copied);
    return result;
  }

  static ntl::result<owned_bytes>
  try_copy(std::span<const std::byte> source, buffer_limits limits,
           ULONG tag = ntl::pool_tag("bLtN")) noexcept {
    return try_copy(scatter_view::from_contiguous(source), limits, tag);
  }

  void reset() noexcept {
    std::byte *const data = std::exchange(data_, nullptr);
    if (data) {
      ntl::detail::free_pool_bytes(
          data, ntl::pool_kind::nonpaged, tag_);
    }
    size_ = 0;
    tag_ = ntl::default_pool_tag;
  }

  explicit operator bool() const noexcept {
    return data_ != nullptr || size_ == 0;
  }
  bool empty() const noexcept { return size_ == 0; }
  std::size_t size() const noexcept { return size_; }
  std::byte *data() noexcept { return data_; }
  const std::byte *data() const noexcept { return data_; }

  std::span<std::byte> span() noexcept {
    return {data_, size_};
  }
  std::span<const std::byte> span() const noexcept {
    return {data_, size_};
  }
  scatter_view view() const noexcept {
    return scatter_view::from_contiguous(span());
  }
  mutable_scatter_view mutable_view() noexcept {
    return mutable_scatter_view::from_contiguous(span());
  }

private:
  owned_bytes(std::byte *data, std::size_t length, ULONG tag) noexcept
      : data_(data), size_(length), tag_(tag) {}

  std::byte *data_ = nullptr;
  std::size_t size_ = 0;
  ULONG tag_ = ntl::default_pool_tag;
};

} // namespace ntl::net
