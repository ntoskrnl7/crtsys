template <class> inline constexpr bool known_layer = false;
template <>
inline constexpr bool known_layer<layers::ale_connect_redirect_v4> = true;
template <>
inline constexpr bool known_layer<layers::ale_connect_redirect_v6> = true;
template <>
inline constexpr bool known_layer<layers::ale_bind_redirect_v4> = true;
template <>
inline constexpr bool known_layer<layers::ale_bind_redirect_v6> = true;
template <>
inline constexpr bool known_layer<layers::ale_auth_connect_v4> = true;
template <>
inline constexpr bool known_layer<layers::ale_auth_connect_v6> = true;
template <>
inline constexpr bool known_layer<layers::ale_auth_recv_accept_v4> = true;
template <>
inline constexpr bool known_layer<layers::ale_auth_recv_accept_v6> = true;
template <>
inline constexpr bool known_layer<layers::ale_flow_established_v4> = true;
template <>
inline constexpr bool known_layer<layers::ale_flow_established_v6> = true;
