inline constexpr bool known_layer<layers::datagram_data_v4> = true;
template <>
inline constexpr bool known_layer<layers::datagram_data_v6> = true;
template <>
inline constexpr bool known_layer<layers::inbound_transport_v4> = true;
template <>
inline constexpr bool known_layer<layers::inbound_transport_v6> = true;
template <>
inline constexpr bool known_layer<layers::outbound_transport_v4> = true;
template <>
inline constexpr bool known_layer<layers::outbound_transport_v6> = true;
template <>
inline constexpr bool known_layer<layers::ale_endpoint_closure_v4> = true;
template <>
inline constexpr bool known_layer<layers::ale_endpoint_closure_v6> = true;
template <>
inline constexpr bool known_layer<layers::name_resolution_cache_v4> = true;
template <>
inline constexpr bool known_layer<layers::name_resolution_cache_v6> = true;
template <>
inline constexpr bool known_layer<layers::inbound_mac_frame_ethernet> = true;
template <>
inline constexpr bool known_layer<layers::outbound_mac_frame_ethernet> = true;
template <>
inline constexpr bool known_layer<layers::ingress_vswitch_ethernet> = true;
template <>
inline constexpr bool known_layer<layers::egress_vswitch_ethernet> = true;
#ifdef NTL_WFP_HAS_FAST_LAYERS
template <>
inline constexpr bool known_layer<layers::inbound_transport_fast> = true;
template <>
inline constexpr bool known_layer<layers::outbound_transport_fast> = true;
#endif
template <>
inline constexpr bool known_layer<layers::ipsec_v4> = true;
template <>
inline constexpr bool known_layer<layers::ipsec_v6> = true;

template <class Layer>
inline constexpr bool stream_layer =
    std::is_same_v<Layer, layers::stream_v4> ||
    std::is_same_v<Layer, layers::stream_v6>;

template <class Layer>
inline constexpr bool connect_redirect_layer =
    std::is_same_v<Layer, layers::ale_connect_redirect_v4> ||
    std::is_same_v<Layer, layers::ale_connect_redirect_v6>;

template <class Layer>
inline constexpr bool bind_redirect_layer =
    std::is_same_v<Layer, layers::ale_bind_redirect_v4> ||
    std::is_same_v<Layer, layers::ale_bind_redirect_v6>;

template <class Layer>
inline constexpr bool flow_context_layer =
    stream_layer<Layer> ||
    std::is_same_v<Layer, layers::datagram_data_v4> ||
    std::is_same_v<Layer, layers::datagram_data_v6>;

template <class Layer>
inline constexpr bool decision_layer =
    known_layer<Layer> && !stream_layer<Layer>;

template <class Layer>
inline constexpr bool packet_decision_layer =
    std::is_same_v<Layer, layers::datagram_data_v4> ||
    std::is_same_v<Layer, layers::datagram_data_v6> ||
    std::is_same_v<Layer, layers::inbound_transport_v4> ||
    std::is_same_v<Layer, layers::inbound_transport_v6> ||
    std::is_same_v<Layer, layers::outbound_transport_v4> ||
    std::is_same_v<Layer, layers::outbound_transport_v6> ||
    std::is_same_v<Layer, layers::inbound_mac_frame_ethernet> ||
    std::is_same_v<Layer, layers::outbound_mac_frame_ethernet> ||
    std::is_same_v<Layer, layers::ingress_vswitch_ethernet> ||
    std::is_same_v<Layer, layers::egress_vswitch_ethernet>
#ifdef NTL_WFP_HAS_FAST_LAYERS
    ||
    std::is_same_v<Layer, layers::inbound_transport_fast> ||
    std::is_same_v<Layer, layers::outbound_transport_fast>
#endif
    ;

template <class Layer>
inline constexpr bool ale_authorization_layer =
    std::is_same_v<Layer, layers::ale_auth_connect_v4> ||
    std::is_same_v<Layer, layers::ale_auth_connect_v6> ||
    std::is_same_v<Layer, layers::ale_auth_recv_accept_v4> ||
    std::is_same_v<Layer, layers::ale_auth_recv_accept_v6>;
