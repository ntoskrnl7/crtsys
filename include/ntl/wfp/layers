#ifdef NTL_WFP_KERNEL_MODE
#define NTL_WFP_PACKET_FIELDS(prefix)                                           \
  enum class field : std::uint16_t {                                            \
    protocol = prefix##_IP_PROTOCOL,                                             \
    local_address = prefix##_IP_LOCAL_ADDRESS,                                   \
    remote_address = prefix##_IP_REMOTE_ADDRESS,                                 \
    local_port = prefix##_IP_LOCAL_PORT,                                         \
    remote_port = prefix##_IP_REMOTE_PORT,                                       \
    interface_index = prefix##_INTERFACE_INDEX,                                  \
    subinterface_index = prefix##_SUB_INTERFACE_INDEX,                           \
    flags = prefix##_FLAGS,                                                      \
  }
#define NTL_WFP_PACKET_RUNTIME(value) static constexpr UINT16 runtime_id = value
#else
#define NTL_WFP_PACKET_FIELDS(prefix)
#define NTL_WFP_PACKET_RUNTIME(value)
#endif

