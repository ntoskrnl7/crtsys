  /**
   * @brief Registers an owning stream callback and typed flow context.
   *
   * The callback signature is
   * `stream_result(State &, const stream_event<Layer, Context> &) noexcept`.
   */
  template <class Context, class Layer, class State, class Callback>
    requires detail::exact_nothrow_callback<
        stream_result, std::decay_t<Callback>, State &,
        const stream_event<Layer, Context> &>
  ntl::result<flow_target<Layer, Context>>
  add_stream(stream_callout_key<Layer> key,
             std::shared_ptr<State> owned_state,
             Callback callback, UINT32 flags = 0) noexcept {
    return add_stream_callback<callout_kind::stream, Context>(
        key, std::move(owned_state), std::move(callback), flags);
  }

  /**
   * @brief Registers an observation-only stream callback.
   *
   * The callback returns void because an inspection callout is not allowed to
   * return permit or block. WFP classification always continues afterward.
   */
