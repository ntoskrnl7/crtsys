private:
  template <class Result, class Layer, class State, class Callback>
  ntl::status add_classify(
      basic_callout_key<
          Layer, detail::callout_kind_for_result_v<Result>> key,
      std::shared_ptr<State> owned_state,
      Callback callback, UINT32 flags) noexcept {
    using callback_type = std::decay_t<Callback>;
    using binding_type =
        detail::owning_classify_binding<Result, Layer, State, callback_type>;
    using slots_type = detail::owning_classify_slots<binding_type, Capacity>;

    static_assert(detail::classification_callback_result<Result>);
    static_assert(detail::decision_layer<Layer>,
                  "classification callback requires an ntl::wfp decision layer");
    static_assert(
        detail::exact_nothrow_callback<
            Result, callback_type, State &,
            const classify_event<Layer> &>,
        "a typed WFP callback must be noexcept and return the exact result");
    static_assert(std::is_nothrow_destructible_v<callback_type>,
                  "a WFP callback must be nothrow destructible");

    if (!state_ || !owned_state)
      return STATUS_INVALID_PARAMETER;
    state_->lock_state();
    if (state_->shutdown->closing() ||
        !state_->device || !state_->device->native_handle()) {
      state_->unlock_state();
      return STATUS_INVALID_DEVICE_STATE;
    }
    if (state_->count == state_->registrations.size()) {
      state_->unlock_state();
      return STATUS_INSUFFICIENT_RESOURCES;
    }

    std::shared_ptr<binding_type> binding;
    try {
      binding = std::make_shared<binding_type>(
          state_->shutdown, &state_->activity,
          std::move(owned_state), std::move(callback));
    } catch (...) {
      state_->unlock_state();
      return STATUS_INSUFFICIENT_RESOURCES;
    }

    const auto claimed = slots_type::claim(*binding);
    if (!claimed) {
      state_->unlock_state();
      return STATUS_INSUFFICIENT_RESOURCES;
    }
    binding->publish(
        claimed->slot,
        [](detail::owning_callback_binding_base &base,
           std::size_t slot) noexcept { slots_type::release(base, slot); });

    FWPS_CALLOUT2 callout{};
    callout.calloutKey = key.native();
    callout.flags = flags;
    callout.classifyFn = claimed->callback;
    callout.notifyFn = &detail::accept_filter_notification;

    UINT32 id = 0;
    const NTSTATUS result = FwpsCalloutRegister2(
        state_->device->native_handle(), &callout, &id);
    if (!NT_SUCCESS(result)) {
      binding->unpublish();
      state_->unlock_state();
      return result;
    }

    state_->registrations[state_->count++] =
        registration{id, {}, std::move(binding)};
    state_->unlock_state();
    return ntl::status::ok();
  }

