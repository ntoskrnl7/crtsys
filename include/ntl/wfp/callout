  add_stream_inspection(inspection_callout_key<Layer> key,
                        std::shared_ptr<State> owned_state,
                        Callback callback, UINT32 flags = 0) noexcept {
    return add_stream_callback<callout_kind::inspection, Context>(
        key, std::move(owned_state), std::move(callback), flags);
  }

private:
  template <callout_kind Kind, class Context, class Layer, class State,
            class Callback>
  ntl::result<flow_target<Layer, Context>>
  add_stream_callback(basic_callout_key<Layer, Kind> key,
                      std::shared_ptr<State> owned_state,
                      Callback callback, UINT32 flags) noexcept {
    static_assert(Kind == callout_kind::inspection ||
                  Kind == callout_kind::stream);
    using callback_type = std::decay_t<Callback>;
    using binding_type = std::conditional_t<
        Kind == callout_kind::inspection,
        detail::owning_stream_inspection_binding<
            Layer, Context, State, callback_type>,
        detail::owning_stream_binding<
            Layer, Context, State, callback_type>>;
    using slots_type =
        detail::owning_stream_slots<binding_type, Capacity, Kind>;

    static_assert(detail::stream_layer<Layer>,
                  "a stream callback requires an ntl::wfp stream layer");
    static_assert(std::is_nothrow_destructible_v<Context>,
                  "a WFP flow context destructor must be noexcept");
    static_assert(std::is_nothrow_destructible_v<callback_type>,
                  "a WFP callback must be nothrow destructible");

    if (!state_ || !owned_state)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    state_->lock_state();
    if (state_->shutdown->closing() ||
        !state_->device || !state_->device->native_handle()) {
      state_->unlock_state();
      return ntl::unexpected(STATUS_INVALID_DEVICE_STATE);
    }
    if (state_->count == state_->registrations.size()) {
      state_->unlock_state();
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }

    std::shared_ptr<detail::flow_registration_state<Layer, Context>>
        flow_state;
    std::shared_ptr<binding_type> binding;
    try {
      flow_state = std::make_shared<
          detail::flow_registration_state<Layer, Context>>(state_->shutdown);
      binding = std::make_shared<binding_type>(
          state_->shutdown, &state_->activity,
          std::move(owned_state), std::move(callback));
    } catch (...) {
      state_->unlock_state();
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }

    const auto claimed = slots_type::claim(*binding);
    if (!claimed) {
      state_->unlock_state();
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    binding->publish(
        claimed->slot,
        [](detail::owning_callback_binding_base &base,
           std::size_t slot) noexcept { slots_type::release(base, slot); });

    FWPS_CALLOUT2 callout{};
    callout.calloutKey = key.native();
    callout.flags = flags;
    callout.classifyFn = claimed->callback;
    callout.notifyFn = &detail::accept_filter_notification;
    callout.flowDeleteFn =
        &detail::flow_delete_adapter<Layer, Context>::invoke;

    UINT32 id = 0;
    const NTSTATUS result = FwpsCalloutRegister2(
        state_->device->native_handle(), &callout, &id);
    if (!NT_SUCCESS(result)) {
      binding->unpublish();
      state_->unlock_state();
      return ntl::unexpected(result);
    }

    flow_state->activate(id);
    state_->registrations[state_->count++] =
        registration{id, flow_state, std::move(binding)};
    state_->unlock_state();
    return ntl::ok(
        flow_target<Layer, Context>(std::move(flow_state)));
  }

