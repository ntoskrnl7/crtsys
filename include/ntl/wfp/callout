template <class Binding, std::size_t SlotCount, callout_kind Kind>
struct owning_stream_slots {
  static_assert(SlotCount != 0);
  using layer_type = typename Binding::layer_type;
  using context_type = typename Binding::context_type;

  struct claim_result {
    std::size_t slot = 0;
    FWPS_CALLOUT_CLASSIFY_FN2 callback = nullptr;
  };

  template <std::size_t Slot>
  static void NTAPI invoke(
      const FWPS_INCOMING_VALUES0 *values,
      const FWPS_INCOMING_METADATA_VALUES0 *metadata, void *layer_data,
      const void *, const FWPS_FILTER2 *filter, UINT64 flow_context,
      FWPS_CLASSIFY_OUT0 *output) noexcept {
    if (!layer_data || !output)
      return;

    auto *io_packet =
        static_cast<FWPS_STREAM_CALLOUT_IO_PACKET0 *>(layer_data);
    Binding *binding = acquire(Slot);
    if (!binding) {
      if constexpr (Kind == callout_kind::inspection) {
        apply_decision(classification_action::continue_classification,
                       filter, *output);
      } else {
        detail_apply_stream_result(
            stream_result::block(io_packet->streamData
                                     ? io_packet->streamData->dataLength
                                     : 0),
            filter, io_packet, *output);
      }
      return;
    }

    auto *holder = reinterpret_cast<
        flow_context_holder<layer_type, context_type> *>(flow_context);
    context_type *context = holder ? holder->context.get() : nullptr;
    stream_event<layer_type, context_type> event(
        values, metadata, io_packet, filter, context, output);
    const auto activity = binding->enter_activity();
    if constexpr (Kind == callout_kind::inspection) {
      binding->invoke(event);
      binding->leave(activity);
      apply_decision(classification_action::continue_classification,
                     filter, *output);
    } else {
      const stream_result result = binding->invoke(event);
      binding->leave(activity);
      detail_apply_stream_result(result, filter, io_packet, *output);
    }
  }

  static std::optional<claim_result> claim(Binding &binding) noexcept {
    KIRQL old_irql;
    KeAcquireSpinLock(&lock_, &old_irql);
    for (std::size_t index = 0; index != SlotCount; ++index) {
      if (!slots_[index]) {
        slots_[index] = &binding;
        const claim_result result{index, callbacks_[index]};
        KeReleaseSpinLock(&lock_, old_irql);
        return result;
      }
    }
    KeReleaseSpinLock(&lock_, old_irql);
    return std::nullopt;
  }

  static void release(owning_callback_binding_base &base,
                      std::size_t slot) noexcept {
    KIRQL old_irql;
    KeAcquireSpinLock(&lock_, &old_irql);
    if (slot < SlotCount && slots_[slot] == &base)
      slots_[slot] = nullptr;
    KeReleaseSpinLock(&lock_, old_irql);
  }

private:
  static Binding *acquire(std::size_t slot) noexcept {
    KIRQL old_irql;
    KeAcquireSpinLock(&lock_, &old_irql);
    auto *binding = static_cast<Binding *>(slots_[slot]);
    if (binding && !binding->try_enter())
      binding = nullptr;
    KeReleaseSpinLock(&lock_, old_irql);
    return binding;
  }

  template <std::size_t... Slots>
  static constexpr auto make_callbacks(
      std::index_sequence<Slots...>) noexcept {
    return std::array<FWPS_CALLOUT_CLASSIFY_FN2, sizeof...(Slots)>{
        &invoke<Slots>...};
  }

  inline static KSPIN_LOCK lock_{};
  inline static void *slots_[SlotCount]{};
  inline static constexpr auto callbacks_ =
      make_callbacks(std::make_index_sequence<SlotCount>{});
};
