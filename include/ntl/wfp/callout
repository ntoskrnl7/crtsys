/**
 * @brief Shared owning facade for one callout driver's device and run-time
 * registrations.
 *
 * Copies retain one shared state, so member declaration order and facade
 * destruction order are irrelevant. close() is idempotent across all copies.
 * It first stops flow association, drains tracked flow contexts, unregisters
 * every callout in reverse order, and finally releases the backing device.
 * If the last facade is released above PASSIVE_LEVEL, destruction is handed to
 * the runtime passive-cleanup domain; applications do not queue a work item or
 * manage rundown themselves. close() may be called through DISPATCH_LEVEL. It
 * completes synchronously for an ordinary PASSIVE_LEVEL caller; when invoked
 * by one of its own callbacks or above PASSIVE_LEVEL, it queues the same drain
 * to the joined runtime worker and returns STATUS_PENDING.
 */
template <std::size_t Capacity = 16> class callout_driver {
  struct registration {
    UINT32 id = 0;
    std::shared_ptr<detail::flow_registration_base> flow;
    std::shared_ptr<detail::owning_callback_binding_base> callback;
  };

  struct shared_state {
    explicit shared_state(ntl::driver &driver)
        : cleanup(&shared_state::cleanup_at_passive, this),
          deferred_close(&shared_state::close_at_passive, this) {
      KeInitializeMutex(&lock, 0);
      KeInitializeEvent(&closed, NotificationEvent, FALSE);
      shutdown = std::make_shared<detail::callout_shutdown_gate>();
      auto options =
          ntl::device_options().type(FILE_DEVICE_NETWORK).exclusive(false);
      device = driver.create_device<void>(options);
    }

    ~shared_state() {
      NT_ASSERT(ntl::current_irql() == ntl::irql::passive);
      if (InterlockedCompareExchange(&close_started, 0, 0) == 0) {
        shutdown->close();
        const ntl::status result = close_now();
        NT_ASSERT(result.is_ok());
      } else {
        NT_ASSERT(KeReadStateEvent(&closed) != 0);
        NT_ASSERT(NT_SUCCESS(static_cast<NTSTATUS>(
            InterlockedCompareExchange(&close_status, 0, 0))));
      }
    }

    static void cleanup_at_passive(void *context) noexcept {
      delete static_cast<shared_state *>(context);
    }

    static void close_at_passive(void *context) noexcept {
      static_cast<shared_state *>(context)->complete_close();
    }

    void lock_state() const noexcept {
      const NTSTATUS result = KeWaitForSingleObject(
          &lock, Executive, KernelMode, FALSE, nullptr);
      NT_ASSERT(NT_SUCCESS(result));
      (void)result;
    }

    void unlock_state() const noexcept {
      (void)KeReleaseMutex(&lock, FALSE);
    }

    ntl::status request_close(
        std::shared_ptr<shared_state> owner) noexcept {
      if (ntl::current_irql() > ntl::irql::dispatch)
        return STATUS_INVALID_DEVICE_STATE;
      const bool reentrant_close =
          InterlockedCompareExchangePointer(
              &closing_thread, nullptr, nullptr) == KeGetCurrentThread();
      const bool may_wait =
          ntl::current_irql() == ntl::irql::passive &&
          !activity.current_thread_active() && !reentrant_close;
      if (InterlockedCompareExchange(&close_started, 1, 0) == 0) {
        shutdown->close();
        if (may_wait) {
          complete_close();
        } else {
          deferred_owner = std::move(owner);
          const ntl::status registered =
              ntl::net::kernel::detail::register_runtime_passive_cleanup(
                  deferred_close);
          if (!registered.is_ok()) {
            deferred_owner.reset();
            InterlockedExchange(&close_started, 0);
            return registered;
          }
          ntl::net::kernel::detail::
              retire_runtime_passive_cleanup_deferred(deferred_close);
        }
      }

      if (!may_wait)
        return STATUS_PENDING;

      const NTSTATUS waited = KeWaitForSingleObject(
          &closed, Executive, KernelMode, FALSE, nullptr);
      if (!NT_SUCCESS(waited))
        return waited;
      return ntl::status{static_cast<NTSTATUS>(
          InterlockedCompareExchange(&close_status, 0, 0))};
    }

    void complete_close() noexcept {
      InterlockedExchangePointer(&closing_thread, KeGetCurrentThread());
      const ntl::status result = close_now();
      InterlockedExchangePointer(&closing_thread, nullptr);
      InterlockedExchange(&close_status,
                          static_cast<NTSTATUS>(result));
      KeSetEvent(&closed, IO_NO_INCREMENT, FALSE);
      deferred_owner.reset();
    }

    ntl::status close_now() noexcept {
      NT_ASSERT(ntl::current_irql() == ntl::irql::passive);
      lock_state();

      if (bfe_subscription) {
        const NTSTATUS unsubscribed =
            FwpmBfeStateUnsubscribeChanges0(bfe_subscription);
        if (!NT_SUCCESS(unsubscribed)) {
          unlock_state();
          return unsubscribed;
        }
        bfe_subscription = nullptr;
        if (bfe_callback)
          bfe_callback->stop_and_drain();
        bfe_callback.reset();
      }

      for (std::size_t index = 0; index != count; ++index) {
        if (registrations[index].callback)
          registrations[index].callback->stop_and_drain();
      }

      while (count != 0) {
        registration &entry = registrations[count - 1];
        if (entry.flow) {
          const ntl::status drained = entry.flow->drain();
          if (!drained.is_ok()) {
            unlock_state();
            return drained;
          }
        }

        const NTSTATUS result = FwpsCalloutUnregisterById0(entry.id);
        if (!NT_SUCCESS(result) &&
            result != STATUS_FWP_CALLOUT_NOT_FOUND) {
          unlock_state();
          return result;
        }

        if (entry.callback)
          entry.callback->unpublish();
        entry = {};
        --count;
      }

      device.reset();
      unlock_state();
      return ntl::status::ok();
    }

    ntl::net::kernel::passive_cleanup_item cleanup;
    ntl::net::kernel::passive_cleanup_item deferred_close;
    mutable KMUTEX lock{};
    KEVENT closed{};
    volatile LONG close_started = 0;
    volatile LONG close_status = STATUS_PENDING;
    PVOID volatile closing_thread = nullptr;
    std::shared_ptr<detail::callout_shutdown_gate> shutdown;
    ntl::detail::callback_activity activity;
    std::shared_ptr<shared_state> deferred_owner;
    std::shared_ptr<ntl::device<void>> device;
    std::array<registration, Capacity> registrations{};
    std::size_t count = 0;
    HANDLE bfe_subscription = nullptr;
    std::shared_ptr<detail::owning_callback_binding_base> bfe_callback;
  };

public:
  explicit callout_driver(ntl::driver &driver) : state_(make_state(driver)) {}

  callout_driver(const callout_driver &) noexcept = default;
  callout_driver &operator=(const callout_driver &) noexcept = default;
  callout_driver(callout_driver &&) noexcept = default;
  callout_driver &operator=(callout_driver &&) noexcept = default;
  ~callout_driver() = default;

  FWPM_SERVICE_STATE bfe_state() const noexcept {
    return FwpmBfeStateGet0();
  }

  /** Registers an observation callback; WFP classification then continues. */
  template <class Layer, class State, class Callback>
    requires detail::exact_nothrow_callback<
        void, std::decay_t<Callback>, State &,
        const classify_event<Layer> &>
  ntl::status add_inspection(
      inspection_callout_key<Layer> key, std::shared_ptr<State> owned_state,
      Callback callback, UINT32 flags = 0) noexcept {
    return add_classify<void>(
        key, std::move(owned_state), std::move(callback), flags);
  }

