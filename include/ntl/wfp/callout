public:

  /**
   * @brief Drains flow contexts, then unregisters every callout before
   * deleting the backing device.
   *
   * The operation is idempotent, making entry failure and normal unload share
   * the same cleanup path. STATUS_PENDING is a successful close request: NTL
   * retains the state and completes native teardown on its joined PASSIVE
   * worker without requiring a caller-owned work item or rundown object.
   */
  [[nodiscard]] ntl::status close() const noexcept {
    return state_ ? state_->request_close(state_) : ntl::status::ok();
  }

  std::size_t size() const noexcept {
    if (!state_)
      return 0;
    state_->lock_state();
    const std::size_t result = state_->count;
    state_->unlock_state();
    return result;
  }

  /**
   * @brief Subscribes to BFE state changes while owning callback state.
   *
   * The callback signature is
   * `void(State &, FWPM_SERVICE_STATE) noexcept`.
   */
  template <class State, class Callback>
  ntl::status watch_bfe(std::shared_ptr<State> owned_state,
                        Callback callback) noexcept {
    using callback_type = std::decay_t<Callback>;
    using binding_type =
        detail::owning_bfe_binding<State, callback_type>;
    static_assert(
        std::is_nothrow_invocable_r_v<void, callback_type &, State &,
                                      FWPM_SERVICE_STATE>,
        "an owning BFE callback must be noexcept and accept State and state");
    static_assert(std::is_nothrow_destructible_v<callback_type>,
                  "a BFE callback must be nothrow destructible");

    if (!state_ || !owned_state)
      return STATUS_INVALID_PARAMETER;
    state_->lock_state();
    if (state_->shutdown->closing() ||
        !state_->device || !state_->device->native_handle()) {
      state_->unlock_state();
      return STATUS_INVALID_DEVICE_STATE;
    }
    if (state_->bfe_subscription) {
      state_->unlock_state();
      return STATUS_ALREADY_REGISTERED;
    }

    std::shared_ptr<binding_type> binding;
    try {
      binding = std::make_shared<binding_type>(
          state_->shutdown, &state_->activity,
          std::move(owned_state), std::move(callback));
    } catch (...) {
      state_->unlock_state();
      return STATUS_INSUFFICIENT_RESOURCES;
    }

    const NTSTATUS result = FwpmBfeStateSubscribeChanges0(
        state_->device->native_handle(), &binding_type::invoke,
        binding.get(), &state_->bfe_subscription);
    if (NT_SUCCESS(result))
      state_->bfe_callback = std::move(binding);
    state_->unlock_state();
    return result;
  }

private:
  static std::shared_ptr<shared_state> make_state(ntl::driver &driver) {
    auto *const raw = new shared_state(driver);
    const ntl::status registered =
        ntl::net::kernel::detail::register_runtime_passive_cleanup(
            raw->cleanup);
    if (!registered.is_ok()) {
      delete raw;
      throw ntl::exception(registered,
                           "WFP callout cleanup registration failed");
    }

    try {
      return std::shared_ptr<shared_state>(
          raw, [](shared_state *value) noexcept {
            ntl::net::kernel::detail::
                retire_runtime_passive_cleanup_deferred(value->cleanup);
          });
    } catch (...) {
      ntl::net::kernel::detail::
          retire_runtime_passive_cleanup_deferred(raw->cleanup);
      throw;
    }
  }

  std::shared_ptr<shared_state> state_;
