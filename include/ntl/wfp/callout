template <class Result, class Callback, class... Arguments>
concept exact_nothrow_callback =
    requires(Callback &callback, Arguments... arguments) {
      { std::invoke(callback, arguments...) } noexcept
          -> std::same_as<Result>;
    };

inline NTSTATUS NTAPI accept_filter_notification(
    FWPS_CALLOUT_NOTIFY_TYPE, const GUID *, FWPS_FILTER2 *) noexcept {
  return STATUS_SUCCESS;
}

class owning_callback_binding_base {
public:
  using release_slot_fn =
      void (*)(owning_callback_binding_base &, std::size_t) noexcept;

  explicit owning_callback_binding_base(
      std::shared_ptr<callout_shutdown_gate> shutdown,
      ntl::detail::callback_activity *activity) noexcept
      : shutdown_(std::move(shutdown)), activity_(activity) {
    ExInitializeRundownProtection(&rundown_);
  }

  owning_callback_binding_base(const owning_callback_binding_base &) = delete;
  owning_callback_binding_base &
  operator=(const owning_callback_binding_base &) = delete;

  virtual ~owning_callback_binding_base() = default;

  bool try_enter() noexcept {
    if (!shutdown_ || shutdown_->closing())
      return false;
    if (ExAcquireRundownProtection(&rundown_) == FALSE)
      return false;
    if (shutdown_->closing()) {
      ExReleaseRundownProtection(&rundown_);
      return false;
    }
    return true;
  }

  ntl::detail::callback_activity::token enter_activity() noexcept {
    return activity_ ? activity_->enter()
                     : ntl::detail::callback_activity::token{};
  }

  void leave(ntl::detail::callback_activity::token entered) noexcept {
    if (activity_)
      activity_->leave(entered);
    ExReleaseRundownProtection(&rundown_);
  }

  void stop_and_drain() noexcept {
    if (InterlockedCompareExchange(&stopping_, 1, 0) == 0)
      ExWaitForRundownProtectionRelease(&rundown_);
  }

  void publish(std::size_t slot, release_slot_fn release) noexcept {
    slot_ = slot;
    release_ = release;
    InterlockedExchange(&published_, 1);
  }

  void unpublish() noexcept {
    if (InterlockedCompareExchange(&published_, 0, 1) == 1)
      release_(*this, slot_);
  }

private:
  EX_RUNDOWN_REF rundown_{};
  volatile LONG stopping_ = 0;
  volatile LONG published_ = 0;
  std::size_t slot_ = 0;
  release_slot_fn release_ = nullptr;
  std::shared_ptr<callout_shutdown_gate> shutdown_;
  ntl::detail::callback_activity *activity_ = nullptr;
};

template <class State, class Callback>
class owning_bfe_binding final : public owning_callback_binding_base {
public:
  owning_bfe_binding(std::shared_ptr<callout_shutdown_gate> shutdown,
                     ntl::detail::callback_activity *activity,
                     std::shared_ptr<State> state,
                     Callback callback) noexcept(
      std::is_nothrow_move_constructible_v<Callback>)
      : owning_callback_binding_base(std::move(shutdown), activity),
        state_(std::move(state)),
        callback_(std::move(callback)) {}

  static void CALLBACK invoke(void *context,
                              FWPM_SERVICE_STATE state) noexcept {
    auto *binding = static_cast<owning_bfe_binding *>(context);
    if (!binding || !binding->try_enter())
      return;
    const auto activity = binding->enter_activity();
    std::invoke(binding->callback_, *binding->state_, state);
    binding->leave(activity);
  }

private:
  std::shared_ptr<State> state_;
  Callback callback_;
};

template <class Result, class Layer, class State, class Callback>
class owning_classify_binding final : public owning_callback_binding_base {
public:
  using layer_type = Layer;

  owning_classify_binding(std::shared_ptr<callout_shutdown_gate> shutdown,
                          ntl::detail::callback_activity *activity,
                          std::shared_ptr<State> state,
                          Callback callback) noexcept(
      std::is_nothrow_move_constructible_v<Callback>)
      : owning_callback_binding_base(std::move(shutdown), activity),
        state_(std::move(state)),
        callback_(std::move(callback)) {}

  classification_action invoke(const classify_event<Layer> &event) noexcept {
    if constexpr (std::is_void_v<Result>) {
      std::invoke(callback_, *state_, event);
      return classification_action::continue_classification;
    } else {
      return to_classification_action(
          std::invoke(callback_, *state_, event));
    }
  }

private:
  std::shared_ptr<State> state_;
  Callback callback_;
};

