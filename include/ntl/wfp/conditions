  Derived &derived() noexcept { return static_cast<Derived &>(*this); }

  condition_list &native_conditions() noexcept { return conditions_; }

  const condition_list &native_conditions() const noexcept {
    return conditions_;
  }

  condition_list conditions_;
  bool vlan_selected_ = false;
  bool tenant_network_selected_ = false;
