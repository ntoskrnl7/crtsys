class sid_value {
public:
  static sid_value from_string(std::wstring_view value) {
    if (value.empty())
      throw std::invalid_argument("WFP SID string cannot be empty");
    const std::wstring owned(value);
    PSID native = nullptr;
    if (!::ConvertStringSidToSidW(owned.c_str(), &native))
      throw std::system_error(static_cast<int>(::GetLastError()),
                              std::system_category(), "ConvertStringSidToSidW");
    struct local_release {
      PSID value = nullptr;
      ~local_release() {
        if (value)
          ::LocalFree(value);
      }
    } release{native};
    return from_native(native);
  }

  static sid_value from_native(PSID value) {
    if (!value || !::IsValidSid(value))
      throw std::invalid_argument("WFP SID is invalid");
    const DWORD size = ::GetLengthSid(value);
    if (size == 0)
      throw std::invalid_argument("WFP SID is empty");
    std::vector<std::uint8_t> bytes(size);
    if (!::CopySid(size, bytes.data(), value))
      throw std::system_error(static_cast<int>(::GetLastError()),
                              std::system_category(), "CopySid");
    return sid_value(std::move(bytes));
  }

  std::span<const std::uint8_t> bytes() const noexcept { return bytes_; }

private:
  explicit sid_value(std::vector<std::uint8_t> bytes)
      : bytes_(std::move(bytes)) {}

  std::vector<std::uint8_t> bytes_;
};

class security_descriptor_value {
public:
  static security_descriptor_value for_identity(
      std::span<const std::uint8_t> sid_bytes) {
    if (sid_bytes.empty() ||
        !::IsValidSid(
            reinterpret_cast<PSID>(
                const_cast<std::uint8_t *>(sid_bytes.data()))))
      throw std::invalid_argument("WFP identity SID is invalid");

    const auto sid = reinterpret_cast<PSID>(
        const_cast<std::uint8_t *>(sid_bytes.data()));
    const DWORD acl_size =
        sizeof(ACL) + sizeof(ACCESS_ALLOWED_ACE) -
        sizeof(DWORD) + ::GetLengthSid(sid);
    std::vector<std::uint8_t> acl_bytes(acl_size);
    auto *const acl =
        reinterpret_cast<PACL>(acl_bytes.data());
    if (!::InitializeAcl(acl, acl_size, ACL_REVISION) ||
        !::AddAccessAllowedAce(
            acl, ACL_REVISION, FWP_ACTRL_MATCH_FILTER, sid))
      throw std::system_error(
          static_cast<int>(::GetLastError()),
          std::system_category(),
          "create WFP identity ACL");

    SECURITY_DESCRIPTOR absolute{};
    if (!::InitializeSecurityDescriptor(
            &absolute, SECURITY_DESCRIPTOR_REVISION) ||
        !::SetSecurityDescriptorDacl(
            &absolute, TRUE, acl, FALSE))
      throw std::system_error(
          static_cast<int>(::GetLastError()),
          std::system_category(),
          "create WFP identity security descriptor");

    DWORD required = 0;
    (void)::MakeSelfRelativeSD(
        &absolute, nullptr, &required);
    if (::GetLastError() != ERROR_INSUFFICIENT_BUFFER ||
        required == 0)
      throw std::system_error(
          static_cast<int>(::GetLastError()),
          std::system_category(),
          "size WFP identity security descriptor");
    std::vector<std::uint8_t> descriptor(required);
    if (!::MakeSelfRelativeSD(
            &absolute,
            reinterpret_cast<PSECURITY_DESCRIPTOR>(
                descriptor.data()),
            &required))
      throw std::system_error(
          static_cast<int>(::GetLastError()),
          std::system_category(),
          "serialize WFP identity security descriptor");
    descriptor.resize(required);
    return security_descriptor_value(
        std::move(descriptor));
  }

  std::span<const std::uint8_t> bytes() const noexcept {
    return bytes_;
  }

private:
  explicit security_descriptor_value(
      std::vector<std::uint8_t> bytes)
      : bytes_(std::move(bytes)) {}

  std::vector<std::uint8_t> bytes_;
};

