  template <class L = Layer,
            std::enable_if_t<vswitch_condition_layer<L>, int> = 0>
  Derived &network_type_equal(virtual_switch_network value) {
    conditions_.add_u8(
        FWPM_CONDITION_VSWITCH_NETWORK_TYPE,
        static_cast<std::uint8_t>(value));
    return derived();
  }

  template <class L = Layer,
            std::enable_if_t<vswitch_condition_layer<L>, int> = 0>
  Derived &source_interface_equal(
      const virtual_switch_interface_id &value) {
    conditions_.add_blob(
        FWPM_CONDITION_VSWITCH_SOURCE_INTERFACE_ID,
        value.bytes());
    return derived();
  }

  template <class L = Layer,
            std::enable_if_t<vswitch_condition_layer<L>, int> = 0>
  Derived &destination_interface_equal(
      const virtual_switch_interface_id &value) {
    conditions_.add_blob(
        FWPM_CONDITION_VSWITCH_DESTINATION_INTERFACE_ID,
        value.bytes());
