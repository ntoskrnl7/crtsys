/** @brief Host-order IPv4 address used by typed policy conditions. */
struct ipv4_address {
public:
  static constexpr ipv4_address from_octets(std::uint8_t first,
                                            std::uint8_t second,
                                            std::uint8_t third,
                                            std::uint8_t fourth) noexcept {
    return ipv4_address((static_cast<std::uint32_t>(first) << 24) |
                        (static_cast<std::uint32_t>(second) << 16) |
                        (static_cast<std::uint32_t>(third) << 8) |
                        static_cast<std::uint32_t>(fourth));
  }

  static constexpr ipv4_address from_host_order(std::uint32_t value) noexcept {
    return ipv4_address(value);
  }

  constexpr std::uint32_t host_order() const noexcept { return value_; }

private:
  friend class ipv4_network;
  template <class, class> friend class detail::typed_condition_builder;
  constexpr explicit ipv4_address(std::uint32_t value) noexcept
      : value_(value) {}
  std::uint32_t value_ = 0;
};

/** @brief IPv4 network prefix used by typed policy conditions. */
class ipv4_network {
public:
  constexpr ipv4_network(ipv4_address address, std::uint8_t prefix_length)
      : address_(address.host_order()), prefix_length_(prefix_length) {
    if (prefix_length > 32)
      throw std::invalid_argument("WFP IPv4 prefix length exceeds 32");
  }

  constexpr std::uint32_t address() const noexcept { return address_; }
  constexpr std::uint8_t prefix_length() const noexcept {
    return prefix_length_;
  }

private:
  std::uint32_t address_ = 0;
  std::uint8_t prefix_length_ = 0;
};

/** @brief Network-order IPv6 address bytes used by typed policy conditions. */
struct ipv6_address {
  std::array<std::uint8_t, 16> bytes{};

  constexpr explicit ipv6_address(
      std::array<std::uint8_t, 16> network_order) noexcept
      : bytes(network_order) {}
};

/** @brief IPv6 network prefix used by typed policy conditions. */
class ipv6_network {
public:
  constexpr ipv6_network(ipv6_address address, std::uint8_t prefix_length)
      : address_(address), prefix_length_(prefix_length) {
    if (prefix_length > 128)
      throw std::invalid_argument("WFP IPv6 prefix length exceeds 128");
  }

  constexpr const ipv6_address &address() const noexcept { return address_; }
  constexpr std::uint8_t prefix_length() const noexcept {
    return prefix_length_;
  }

private:
  ipv6_address address_;
  std::uint8_t prefix_length_ = 0;
};

