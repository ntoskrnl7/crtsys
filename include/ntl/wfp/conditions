class condition_list {
public:
  condition_list() = default;
  condition_list(const condition_list &) = delete;
  condition_list &operator=(const condition_list &) = delete;
  condition_list(condition_list &&) noexcept = default;
  condition_list &operator=(condition_list &&) noexcept = default;

  std::size_t size() const noexcept { return values_.size(); }
  FWPM_FILTER_CONDITION0 *data() noexcept {
    return values_.empty() ? nullptr : values_.data();
  }
  const FWPM_FILTER_CONDITION0 *data() const noexcept {
    return values_.empty() ? nullptr : values_.data();
  }

  void add_u8(const GUID &field, std::uint8_t value,
              FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type = FWP_UINT8;
    condition.conditionValue.uint8 = value;
    append(condition);
  }

  void add_u16(const GUID &field, std::uint16_t value,
               FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type = FWP_UINT16;
    condition.conditionValue.uint16 = value;
    append(condition);
  }

  void add_u32(const GUID &field, std::uint32_t value,
               FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type = FWP_UINT32;
    condition.conditionValue.uint32 = value;
    append(condition);
  }

  void add_blob(const GUID &field, std::span<const std::uint8_t> bytes,
                FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    prepare_append(field);
    auto storage = std::make_unique<owned_blob>(bytes);
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type = FWP_BYTE_BLOB_TYPE;
    condition.conditionValue.byteBlob = &storage->native;
    blobs_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_sid(const GUID &field, std::span<const std::uint8_t> bytes,
               FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    prepare_append(field);
    auto storage = std::make_unique<owned_sid>(bytes);
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type = FWP_SID;
    condition.conditionValue.sid =
        reinterpret_cast<SID *>(storage->bytes.data());
    sids_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_security_descriptor(
      const GUID &field,
      std::span<const std::uint8_t> bytes,
      FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    prepare_append(field);
    auto storage = std::make_unique<owned_blob>(bytes);
    if (!::IsValidSecurityDescriptor(
            reinterpret_cast<PSECURITY_DESCRIPTOR>(
                storage->bytes.data())) ||
        !::GetSecurityDescriptorControl(
            reinterpret_cast<PSECURITY_DESCRIPTOR>(
                storage->bytes.data()),
            &storage->control, &storage->revision) ||
        (storage->control & SE_SELF_RELATIVE) == 0)
      throw std::invalid_argument(
          "WFP identity security descriptor is invalid");
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type =
        FWP_SECURITY_DESCRIPTOR_TYPE;
    condition.conditionValue.sd = &storage->native;
    blobs_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_u16_range(
      const GUID &field,
      std::uint16_t low,
      std::uint16_t high) {
    if (low > high)
      throw std::invalid_argument(
          "WFP UINT16 range low exceeds high");
    prepare_append(field);
    auto storage = std::make_unique<FWP_RANGE0>();
    storage->valueLow.type = FWP_UINT16;
    storage->valueLow.uint16 = low;
    storage->valueHigh.type = FWP_UINT16;
    storage->valueHigh.uint16 = high;
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_RANGE;
    condition.conditionValue.type = FWP_RANGE_TYPE;
    condition.conditionValue.rangeValue = storage.get();
    ranges_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_u32_range(
      const GUID &field,
      std::uint32_t low,
      std::uint32_t high) {
    if (low > high)
      throw std::invalid_argument(
          "WFP UINT32 range low exceeds high");
    prepare_append(field);
    auto storage = std::make_unique<FWP_RANGE0>();
    storage->valueLow.type = FWP_UINT32;
    storage->valueLow.uint32 = low;
    storage->valueHigh.type = FWP_UINT32;
    storage->valueHigh.uint32 = high;
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_RANGE;
    condition.conditionValue.type = FWP_RANGE_TYPE;
    condition.conditionValue.rangeValue = storage.get();
    ranges_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_v4_network(const GUID &field, ipv4_network network) {
    prepare_append(field);
    auto storage = std::make_unique<FWP_V4_ADDR_AND_MASK>();
    const auto prefix = network.prefix_length();
    const std::uint32_t mask = prefix == 0 ? 0u : 0xffffffffu << (32u - prefix);
    storage->addr = network.address() & mask;
    storage->mask = mask;
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_V4_ADDR_MASK;
    condition.conditionValue.v4AddrMask = storage.get();
    v4_networks_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_v6_address(
      const GUID &field,
      ipv6_address address,
      FWP_MATCH_TYPE match = FWP_MATCH_EQUAL) {
    prepare_append(field);
    auto storage = std::make_unique<FWP_BYTE_ARRAY16>();
    std::copy(address.bytes.begin(), address.bytes.end(), storage->byteArray16);
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = match;
    condition.conditionValue.type = FWP_BYTE_ARRAY16_TYPE;
    condition.conditionValue.byteArray16 = storage.get();
    v6_addresses_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_v6_network(const GUID &field, ipv6_network network) {
    prepare_append(field);
    auto storage = std::make_unique<FWP_V6_ADDR_AND_MASK>();
    const auto &bytes = network.address().bytes;
    std::copy(bytes.begin(), bytes.end(), storage->addr);
    storage->prefixLength = network.prefix_length();
    const auto whole = static_cast<std::size_t>(storage->prefixLength / 8);
    const auto partial = static_cast<unsigned>(storage->prefixLength % 8);
    if (whole < bytes.size()) {
      if (partial != 0)
        storage->addr[whole] &=
            static_cast<std::uint8_t>(0xffu << (8u - partial));
      const auto first_zero = whole + (partial == 0 ? 0u : 1u);
      std::fill(storage->addr + first_zero, storage->addr + bytes.size(),
                static_cast<std::uint8_t>(0));
    }
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_V6_ADDR_MASK;
    condition.conditionValue.v6AddrMask = storage.get();
    v6_networks_.push_back(std::move(storage));
    append_prepared(condition);
  }

  void add_mac(const GUID &field, mac_address address) {
    prepare_append(field);
    auto storage = std::make_unique<FWP_BYTE_ARRAY6>();
    std::copy(address.bytes.begin(), address.bytes.end(), storage->byteArray6);
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_BYTE_ARRAY6_TYPE;
    condition.conditionValue.byteArray6 = storage.get();
    mac_addresses_.push_back(std::move(storage));
    append_prepared(condition);
  }

private:
  void prepare_append(const GUID &field) {
    const auto duplicate =
        std::find_if(values_.begin(), values_.end(),
                     [&](const FWPM_FILTER_CONDITION0 &existing) {
                       return ::IsEqualGUID(existing.fieldKey, field);
                     });
    if (duplicate != values_.end())
      throw std::logic_error(
          "WFP filter contains the same condition field twice");
    values_.reserve(values_.size() + 1);
  }

  void append_prepared(const FWPM_FILTER_CONDITION0 &condition) {
    values_.push_back(condition);
  }

  void append(const FWPM_FILTER_CONDITION0 &condition) {
    prepare_append(condition.fieldKey);
    append_prepared(condition);
  }

  struct owned_blob {
    explicit owned_blob(std::span<const std::uint8_t> source)
        : bytes(source.begin(), source.end()) {
      if (bytes.empty() || bytes.size() > (std::numeric_limits<UINT32>::max)())
        throw std::invalid_argument(
            "WFP byte-blob condition has an invalid size");
      native.size = static_cast<UINT32>(bytes.size());
      native.data = bytes.data();
    }
    std::vector<std::uint8_t> bytes;
    FWP_BYTE_BLOB native{};
    SECURITY_DESCRIPTOR_CONTROL control = 0;
    DWORD revision = 0;
  };

  struct owned_sid {
    explicit owned_sid(std::span<const std::uint8_t> source)
        : bytes(source.begin(), source.end()) {
      if (bytes.empty() || !::IsValidSid(reinterpret_cast<PSID>(bytes.data())))
        throw std::invalid_argument("WFP SID condition is invalid");
    }
    std::vector<std::uint8_t> bytes;
  };

  std::vector<FWPM_FILTER_CONDITION0> values_;
  std::vector<std::unique_ptr<owned_blob>> blobs_;
  std::vector<std::unique_ptr<owned_sid>> sids_;
  std::vector<std::unique_ptr<FWP_V4_ADDR_AND_MASK>> v4_networks_;
  std::vector<std::unique_ptr<FWP_BYTE_ARRAY16>> v6_addresses_;
  std::vector<std::unique_ptr<FWP_V6_ADDR_AND_MASK>> v6_networks_;
  std::vector<std::unique_ptr<FWP_BYTE_ARRAY6>> mac_addresses_;
  std::vector<std::unique_ptr<FWP_RANGE0>> ranges_;
};

