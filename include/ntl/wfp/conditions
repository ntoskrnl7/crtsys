  }

  template <class L = Layer,
            std::enable_if_t<vswitch_condition_layer<L>, int> = 0>
  Derived &tenant_network_equal(std::uint16_t value) {
    if (vlan_selected_)
      throw std::logic_error(
          "WFP vSwitch tenant-network and VLAN conditions are mutually exclusive");
    conditions_.add_u16(
        FWPM_CONDITION_VSWITCH_TENANT_NETWORK_ID,
        value);
    tenant_network_selected_ = true;
    return derived();
  }

