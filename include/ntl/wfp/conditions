/** @brief Validated user or service SID for ALE user conditions. */
class user_identity {
public:
  static user_identity from_string(std::wstring_view value) {
    const auto sid = detail::sid_value::from_string(value);
    return user_identity(
        detail::security_descriptor_value::for_identity(
            sid.bytes()));
  }
  static user_identity from_native(PSID value) {
    const auto sid = detail::sid_value::from_native(value);
    return user_identity(
        detail::security_descriptor_value::for_identity(
            sid.bytes()));
  }

private:
  template <class, class> friend class detail::typed_condition_builder;
  explicit user_identity(
      detail::security_descriptor_value value)
      : value_(std::move(value)) {}
  std::span<const std::uint8_t> bytes() const noexcept {
    return value_.bytes();
  }
  detail::security_descriptor_value value_;
};

