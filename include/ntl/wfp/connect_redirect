/**
 * @brief Captured WFP handoff for one accepted redirected connection.
 *
 * The redirect records remain opaque. connect_original() applies them before
 * connect(), which both preserves WFP attribution and prevents redirect
 * loops.
 */
class redirected_connection {
public:
  redirected_connection(const redirected_connection &) = delete;
  redirected_connection &
  operator=(const redirected_connection &) = delete;
  redirected_connection(redirected_connection &&) noexcept = default;
  redirected_connection &
  operator=(redirected_connection &&) noexcept = default;

  static redirected_connection capture(SOCKET accepted) {
    if (accepted == INVALID_SOCKET)
      throw std::system_error(WSAENOTSOCK, std::system_category(),
                              "redirected_connection::capture");

    const auto records = query_blob(
        accepted, SIO_QUERY_WFP_CONNECTION_REDIRECT_RECORDS);

    detail::connect_redirect_context context{};
    DWORD returned = 0;
    if (::WSAIoctl(
            accepted, SIO_QUERY_WFP_CONNECTION_REDIRECT_CONTEXT,
            nullptr, 0, &context, static_cast<DWORD>(sizeof(context)),
            &returned, nullptr, nullptr) == SOCKET_ERROR)
      throw_last_socket_error(
          "SIO_QUERY_WFP_CONNECTION_REDIRECT_CONTEXT");
    if (returned != sizeof(context) ||
        !detail::valid_connect_redirect_context(context))
      throw std::runtime_error("unsupported WFP redirect context");

    return redirected_connection(
        context.original_remote, context.original_local, context.process_id,
        context.flow_id,
        std::vector<std::byte>(
            reinterpret_cast<const std::byte *>(
                context.application_id.data()),
            reinterpret_cast<const std::byte *>(
                context.application_id.data() + context.application_id_size)),
        records);
  }

  const SOCKADDR_STORAGE &original_destination_ref() const noexcept {
    return original_remote_;
  }

  const SOCKADDR_STORAGE &original_source_ref() const noexcept {
    return original_local_;
  }

  std::uint64_t process_id() const noexcept { return process_id_; }

  std::uint64_t flow_id() const noexcept { return flow_id_; }

  std::span<const std::byte> application_id() const noexcept {
    return application_id_;
  }

  /**
   * @brief Creates and binds an overlapped socket with redirect records set.
   *
   * ConnectEx requires a bound socket. The returned socket is ready for an
   * asynchronous connect to original_destination_ref(); the caller owns it.
   */
  SOCKET prepare_original_socket(
      DWORD socket_flags = WSA_FLAG_OVERLAPPED) const {
    const ADDRESS_FAMILY family = original_remote_.ss_family;
    if (family != AF_INET && family != AF_INET6)
      throw std::system_error(WSAEAFNOSUPPORT, std::system_category(),
                              "WFP original destination family");

    SOCKET outbound = ::WSASocketW(
        family, SOCK_STREAM, IPPROTO_TCP, nullptr, 0, socket_flags);
    if (outbound == INVALID_SOCKET)
      throw_last_socket_error("WSASocketW(proxy outbound)");

    try {
      DWORD returned = 0;
      if (records_.size() >
          (std::numeric_limits<DWORD>::max)())
        throw std::overflow_error("WFP redirect records are too large");
      if (::WSAIoctl(
              outbound, SIO_SET_WFP_CONNECTION_REDIRECT_RECORDS,
              const_cast<std::byte *>(records_.data()),
              static_cast<DWORD>(records_.size()), nullptr, 0,
              &returned, nullptr, nullptr) == SOCKET_ERROR)
        throw_last_socket_error(
            "SIO_SET_WFP_CONNECTION_REDIRECT_RECORDS");

      if (family == AF_INET) {
        SOCKADDR_IN local{};
        local.sin_family = AF_INET;
        local.sin_addr.s_addr = htonl(INADDR_ANY);
        if (::bind(outbound, reinterpret_cast<const sockaddr *>(&local),
                   sizeof(local)) == SOCKET_ERROR)
          throw_last_socket_error("bind(proxy outbound IPv4)");
      } else {
        SOCKADDR_IN6 local{};
        local.sin6_family = AF_INET6;
        local.sin6_addr = in6addr_any;
        if (::bind(outbound, reinterpret_cast<const sockaddr *>(&local),
                   sizeof(local)) == SOCKET_ERROR)
          throw_last_socket_error("bind(proxy outbound IPv6)");
      }
      return outbound;
    } catch (...) {
      (void)::closesocket(outbound);
      throw;
    }
  }

  /**
   * @brief Synchronously connects a prepared socket to the original peer.
   *
   * Coroutine services should prefer prepare_original_socket() followed by
   * async_socket::connect so a slow origin cannot block their IOCP worker.
   */
  SOCKET connect_original(
      DWORD socket_flags = WSA_FLAG_OVERLAPPED) const {
    SOCKET outbound = prepare_original_socket(socket_flags);
    try {
      const ADDRESS_FAMILY family = original_remote_.ss_family;
      const int address_size =
          family == AF_INET ? sizeof(SOCKADDR_IN)
                            : sizeof(SOCKADDR_IN6);
      if (::connect(outbound,
                    reinterpret_cast<const sockaddr *>(
                        &original_remote_),
                    address_size) == SOCKET_ERROR)
        throw_last_socket_error("connect(original destination)");
      return outbound;
    } catch (...) {
      (void)::closesocket(outbound);
      throw;
    }
  }

private:
  redirected_connection(
      const SOCKADDR_STORAGE &remote, const SOCKADDR_STORAGE &local,
      std::uint64_t process_id, std::uint64_t flow_id,
      std::vector<std::byte> application_id,
      std::vector<std::byte> records) noexcept
      : original_remote_(remote), original_local_(local),
        process_id_(process_id), flow_id_(flow_id),
        application_id_(std::move(application_id)),
        records_(std::move(records)) {}

  [[noreturn]] static void
  throw_last_socket_error(const char *operation) {
    throw std::system_error(WSAGetLastError(),
                            std::system_category(), operation);
  }

  static std::vector<std::byte>
  query_blob(SOCKET socket, DWORD operation) {
    constexpr DWORD initial_blob_size = 8 * 1024;
    constexpr DWORD maximum_blob_size = 1024 * 1024;
    std::vector<std::byte> result(initial_blob_size);
    for (unsigned attempt = 0; attempt != 2; ++attempt) {
      DWORD returned = 0;
      if (::WSAIoctl(
              socket, operation, nullptr, 0, result.data(),
              static_cast<DWORD>(result.size()), &returned,
              nullptr, nullptr) != SOCKET_ERROR) {
        if (returned == 0 || returned > result.size())
          throw std::runtime_error("WFP returned invalid redirect records");
        result.resize(returned);
        return result;
      }

      const int error = ::WSAGetLastError();
      const bool size_failure =
          error == ERROR_INSUFFICIENT_BUFFER || error == WSAEFAULT;
      if (!size_failure || returned <= result.size() ||
          returned > maximum_blob_size)
        throw std::system_error(
            error, std::system_category(),
            "SIO_QUERY_WFP_CONNECTION_REDIRECT_RECORDS");
      result.resize(returned);
    }
    throw std::runtime_error("WFP redirect records changed size repeatedly");
  }

  SOCKADDR_STORAGE original_remote_{};
  SOCKADDR_STORAGE original_local_{};
  std::uint64_t process_id_ = 0;
  std::uint64_t flow_id_ = 0;
  std::vector<std::byte> application_id_;
  std::vector<std::byte> records_;
};

