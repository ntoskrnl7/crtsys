/**
 * @brief Move-only owner of a WFP redirect handle.
 *
 * redirect() performs loop detection, writable-layer acquisition, context
 * ownership transfer, and fail-closed action selection as one operation.
 */
class connect_redirector {
public:
  connect_redirector(const connect_redirector &) = delete;
  connect_redirector &operator=(const connect_redirector &) = delete;

  connect_redirector(connect_redirector &&other) noexcept
      : handle_(std::exchange(other.handle_, nullptr)) {}

  connect_redirector &operator=(connect_redirector &&other) noexcept {
    if (this != &other) {
      reset();
      handle_ = std::exchange(other.handle_, nullptr);
    }
    return *this;
  }

  ~connect_redirector() { reset(); }

  static ntl::result<connect_redirector>
  try_create(provider_key provider) noexcept {
    HANDLE handle = nullptr;
    const NTSTATUS status =
        FwpsRedirectHandleCreate0(&provider.native(), 0, &handle);
    if (!NT_SUCCESS(status))
      return ntl::unexpected(status);
    return ntl::ok(connect_redirector(handle));
  }

  /**
   * @brief Redirects this TCP or connected-UDP flow to a localhost proxy.
   *
   * A connection already seen through this redirect handle is permitted
   * without another redirect. Every native failure returns block.
   */
  template <class Layer>
  terminating_decision redirect(const classify_event<Layer> &event,
                    local_proxy_target target) const noexcept {
    static_assert(detail::connect_redirect_layer<Layer>,
                  "redirect() requires an ALE_CONNECT_REDIRECT layer");

    if (!handle_ || !target.valid() || !event.metadata_ ||
        !event.classify_context_ || !event.filter_ || !event.output_)
      return terminating_decision::block;

    if ((event.metadata_->currentMetadataValues &
         FWPS_METADATA_FIELD_REDIRECT_RECORD_HANDLE) != 0 &&
        event.metadata_->redirectRecords) {
      const auto state = FwpsQueryConnectionRedirectState0(
          event.metadata_->redirectRecords, handle_, nullptr);
      if (state == FWPS_CONNECTION_REDIRECTED_BY_SELF ||
          state == FWPS_CONNECTION_PREVIOUSLY_REDIRECTED_BY_SELF)
        return terminating_decision::permit;
    }

    UINT64 classify_handle = 0;
    NTSTATUS status = FwpsAcquireClassifyHandle0(
        const_cast<void *>(event.classify_context_), 0, &classify_handle);
    if (!NT_SUCCESS(status))
      return terminating_decision::block;

    void *writable = nullptr;
    status = FwpsAcquireWritableLayerDataPointer0(
        classify_handle, event.filter_->filterId, 0, &writable,
        event.output_);
    if (!NT_SUCCESS(status)) {
      FwpsReleaseClassifyHandle0(classify_handle);
      return terminating_decision::block;
    }

    auto *request = static_cast<FWPS_CONNECT_REQUEST0 *>(writable);
    if (request->previousVersion &&
        request->previousVersion->modifierFilterId ==
            event.filter_->filterId) {
      event.output_->actionType = FWP_ACTION_PERMIT;
      event.output_->rights |= FWPS_RIGHT_ACTION_WRITE;
      FwpsApplyModifiedLayerData0(classify_handle, request, 0);
      FwpsReleaseClassifyHandle0(classify_handle);
      return terminating_decision::permit;
    }

    detail::connect_redirect_context *context = nullptr;
    if (target.context ==
        original_destination_context::preserve) {
      context = static_cast<detail::connect_redirect_context *>(
          ntl::allocate_pool(
              sizeof(detail::connect_redirect_context),
              ntl::pool_kind::nonpaged, ntl::pool_option::none,
              ntl::pool_tag("rClN")));
      if (!context) {
        FwpsApplyModifiedLayerData0(classify_handle, request, 0);
        FwpsReleaseClassifyHandle0(classify_handle);
        return terminating_decision::block;
      }

      RtlZeroMemory(context, sizeof(*context));
      context->magic = detail::redirect_context_magic;
      context->version = detail::redirect_context_version;
      context->size = sizeof(*context);
      RtlCopyMemory(&context->original_remote,
                    &request->remoteAddressAndPort,
                    sizeof(SOCKADDR_STORAGE));
      RtlCopyMemory(&context->original_local,
                    &request->localAddressAndPort,
                    sizeof(SOCKADDR_STORAGE));
      context->process_id = event.metadata().process_id().value_or(0);
      context->flow_id = event.metadata().flow_handle().value_or(0);
      const auto *application =
          event.value(Layer::field::app_id).byte_blob();
      if (context->process_id == 0 || !application ||
          application->size == 0 || !application->data ||
          application->size > context->application_id.size()) {
        ntl::free_pool(context, ntl::pool_tag("rClN"));
        FwpsApplyModifiedLayerData0(classify_handle, request, 0);
        FwpsReleaseClassifyHandle0(classify_handle);
        return terminating_decision::block;
      }
      context->application_id_size =
          static_cast<std::uint16_t>(application->size);
      RtlCopyMemory(context->application_id.data(), application->data,
                    application->size);
    }

    RtlZeroMemory(&request->remoteAddressAndPort,
                  sizeof(request->remoteAddressAndPort));
    if constexpr (std::is_same_v<Layer,
                                 layers::ale_connect_redirect_v4>) {
      auto *address = reinterpret_cast<SOCKADDR_IN *>(
          &request->remoteAddressAndPort);
      address->sin_family = AF_INET;
      address->sin_port = RtlUshortByteSwap(target.port);
      address->sin_addr.S_un.S_addr =
          RtlUlongByteSwap(INADDR_LOOPBACK);
    } else {
      auto *address = reinterpret_cast<SOCKADDR_IN6 *>(
          &request->remoteAddressAndPort);
      IN6ADDR_SETLOOPBACK(address);
      address->sin6_port = RtlUshortByteSwap(target.port);
    }

    request->localRedirectTargetPID = target.process_id;
    request->localRedirectHandle = handle_;
    request->localRedirectContext = context;
    request->localRedirectContextSize =
        context ? sizeof(*context) : 0;

    event.output_->actionType = FWP_ACTION_PERMIT;
    event.output_->rights |= FWPS_RIGHT_ACTION_WRITE;
    FwpsApplyModifiedLayerData0(classify_handle, request, 0);
    FwpsReleaseClassifyHandle0(classify_handle);
    return terminating_decision::permit;
  }

  explicit operator bool() const noexcept { return handle_ != nullptr; }

  void reset() noexcept {
    HANDLE handle = std::exchange(handle_, nullptr);
    if (handle)
      FwpsRedirectHandleDestroy0(handle);
  }

private:
  explicit connect_redirector(HANDLE handle) noexcept : handle_(handle) {}
  HANDLE handle_ = nullptr;
};

/**
 * @brief Applies one typed ALE bind redirect and always pairs writable-data
 * acquisition with apply/release.
 */
class bind_redirector {
public:
  template <class Layer>
  static terminating_decision redirect(
      const classify_event<Layer> &event,
      const local_bind_target_v4 &target) noexcept {
    static_assert(
        std::is_same_v<Layer, layers::ale_bind_redirect_v4>,
        "an IPv4 bind target requires ALE_BIND_REDIRECT_V4");
    return redirect_impl(event, target);
  }

  template <class Layer>
  static terminating_decision redirect(
      const classify_event<Layer> &event,
      const local_bind_target_v6 &target) noexcept {
    static_assert(
        std::is_same_v<Layer, layers::ale_bind_redirect_v6>,
        "an IPv6 bind target requires ALE_BIND_REDIRECT_V6");
    return redirect_impl(event, target);
  }

private:
  template <class Layer, class Target>
  static terminating_decision redirect_impl(
      const classify_event<Layer> &event,
      const Target &target) noexcept {
    static_assert(detail::bind_redirect_layer<Layer>,
                  "bind redirect requires an ALE_BIND_REDIRECT layer");
    if (!event.classify_context_ || !event.filter_ || !event.output_)
        return terminating_decision::block;

    UINT64 classify_handle = 0;
    NTSTATUS status = FwpsAcquireClassifyHandle0(
        const_cast<void *>(event.classify_context_), 0, &classify_handle);
    if (!NT_SUCCESS(status))
      return terminating_decision::block;

    void *writable = nullptr;
    status = FwpsAcquireWritableLayerDataPointer0(
        classify_handle, event.filter_->filterId, 0, &writable,
        event.output_);
    if (!NT_SUCCESS(status)) {
      FwpsReleaseClassifyHandle0(classify_handle);
      return terminating_decision::block;
    }

    auto *request = static_cast<FWPS_BIND_REQUEST0 *>(writable);
    if (request->previousVersion &&
        request->previousVersion->modifierFilterId ==
            event.filter_->filterId) {
      event.output_->actionType = FWP_ACTION_PERMIT;
      event.output_->rights |= FWPS_RIGHT_ACTION_WRITE;
      FwpsApplyModifiedLayerData0(classify_handle, request, 0);
      FwpsReleaseClassifyHandle0(classify_handle);
      return terminating_decision::permit;
    }

    RtlZeroMemory(
        &request->localAddressAndPort,
        sizeof(request->localAddressAndPort));
    if constexpr (std::is_same_v<Target, local_bind_target_v4>) {
      auto *address = reinterpret_cast<SOCKADDR_IN *>(
          &request->localAddressAndPort);
      address->sin_family = AF_INET;
      address->sin_port = RtlUshortByteSwap(target.port);
      address->sin_addr.S_un.S_addr =
          RtlUlongByteSwap(target.address);
    } else {
      auto *address = reinterpret_cast<SOCKADDR_IN6 *>(
          &request->localAddressAndPort);
      address->sin6_family = AF_INET6;
      address->sin6_port = RtlUshortByteSwap(target.port);
      address->sin6_scope_id = target.scope_id;
      RtlCopyMemory(
          &address->sin6_addr, target.address.data(),
          target.address.size());
    }
    request->portReservationToken = target.port_reservation_token;

    event.output_->actionType = FWP_ACTION_PERMIT;
    event.output_->rights |= FWPS_RIGHT_ACTION_WRITE;
    FwpsApplyModifiedLayerData0(classify_handle, request, 0);
    FwpsReleaseClassifyHandle0(classify_handle);
    return terminating_decision::permit;
  }
};

