namespace ntl::wfp {

/**
 * @brief Whether WFP should retain a proxy's original-destination blob.
 */
enum class original_destination_context : std::uint8_t {
  preserve,
  omit,
};

/**
 * @brief A localhost proxy selected by a redirect filter.
 *
 * The port is in host byte order. Both values must be nonzero.
 */
struct local_proxy_target {
  std::uint32_t process_id = 0;
  std::uint16_t port = 0;
  /**
   * Keep this enabled when the proxy will query the original destination
   * through SIO_QUERY_WFP_CONNECTION_REDIRECT_CONTEXT. An explicit managed
   * endpoint that already owns the authority may disable it, avoiding a
   * flow-lifetime allocation that WFP would otherwise own until teardown.
   */
  original_destination_context context =
      original_destination_context::preserve;

  constexpr bool valid() const noexcept {
    return process_id != 0 && port != 0;
  }

  constexpr std::uint64_t filter_context() const noexcept {
    constexpr std::uint64_t no_redirect_context = 1ull << 63;
    const std::uint64_t target =
        (static_cast<std::uint64_t>(process_id) << 16) |
        static_cast<std::uint64_t>(port);
    return context == original_destination_context::preserve
               ? target
               : target | no_redirect_context;
  }

  static constexpr local_proxy_target
  from_filter_context(std::uint64_t value) noexcept {
    constexpr std::uint64_t no_redirect_context = 1ull << 63;
    return {
        static_cast<std::uint32_t>((value >> 16) & 0xffffffffu),
        static_cast<std::uint16_t>(value & 0xffffu),
        (value & no_redirect_context) == 0
            ? original_destination_context::preserve
            : original_destination_context::omit,
    };
  }
};

/**
 * @brief New IPv4 bind identity for ALE bind redirection.
 *
 * Address and port are in host byte order. A zero address selects INADDR_ANY;
 * a zero port requests an ephemeral port. The reservation token is optional.
 */
struct local_bind_target_v4 {
  std::uint32_t address = 0;
  std::uint16_t port = 0;
  std::uint64_t port_reservation_token = 0;
};

/**
 * @brief New IPv6 bind identity for ALE bind redirection.
 *
 * Address bytes are in network order. A zero address selects in6addr_any; a
 * zero port requests an ephemeral port. The reservation token is optional.
 */
struct local_bind_target_v6 {
  std::array<std::uint8_t, 16> address{};
  std::uint32_t scope_id = 0;
  std::uint16_t port = 0;
  std::uint64_t port_reservation_token = 0;
};

/**
 * @brief Opaque nonzero selector carried from one bind filter to its callout.
 *
 * A selector identifies driver-owned bind policy; it is deliberately not a
 * serialized sockaddr. This keeps IPv6 addresses and port-reservation tokens
 * out of the 64-bit native filter context and prevents user mode from
 * manufacturing a partial bind target.
 */
struct bind_redirect_selector {
  std::uint64_t value = 0;

  constexpr bool valid() const noexcept { return value != 0; }
  constexpr std::uint64_t filter_context() const noexcept {
    return value;
  }

  static constexpr bind_redirect_selector
  from_filter_context(std::uint64_t value) noexcept {
    return {value};
  }
};

namespace detail {

inline constexpr std::uint32_t redirect_context_magic = 0x52544c4eu;
inline constexpr std::uint16_t redirect_context_version = 2;
inline constexpr std::size_t maximum_redirect_application_id_size = 2048;

struct connect_redirect_context {
  std::uint32_t magic = redirect_context_magic;
  std::uint16_t version = redirect_context_version;
  std::uint16_t size = sizeof(connect_redirect_context);
  SOCKADDR_STORAGE original_remote{};
  SOCKADDR_STORAGE original_local{};
  std::uint64_t process_id = 0;
  std::uint64_t flow_id = 0;
  std::uint16_t application_id_size = 0;
  std::uint16_t reserved = 0;
  std::array<std::uint8_t, maximum_redirect_application_id_size>
      application_id{};
};

static_assert(std::is_trivially_copyable_v<connect_redirect_context>);
static_assert(std::is_standard_layout_v<connect_redirect_context>);
static_assert(offsetof(connect_redirect_context, magic) == 0);
static_assert(offsetof(connect_redirect_context, original_remote) == 8);
static_assert(offsetof(connect_redirect_context, original_local) == 136);
static_assert(offsetof(connect_redirect_context, process_id) == 264);
static_assert(offsetof(connect_redirect_context, flow_id) == 272);
static_assert(offsetof(connect_redirect_context, application_id_size) == 280);
static_assert(offsetof(connect_redirect_context, application_id) == 284);
static_assert(sizeof(connect_redirect_context) == 2336);
static_assert(sizeof(connect_redirect_context) <=
              (std::numeric_limits<std::uint16_t>::max)());

inline bool valid_connect_redirect_context(
    const connect_redirect_context &context) noexcept {
  return context.magic == redirect_context_magic &&
         context.version == redirect_context_version &&
         context.size == sizeof(connect_redirect_context) &&
         context.process_id != 0 && context.application_id_size != 0 &&
         context.application_id_size <= context.application_id.size();
}

} // namespace detail

