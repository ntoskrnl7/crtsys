  copied_udp_ip_packet &operator=(copied_udp_ip_packet &&) noexcept = default;

  static ntl::result<copied_udp_ip_packet>
  try_create(owned_injection_packet &&packet,
             std::uint32_t ip_header_size) noexcept {
    if (!packet || ip_header_size == 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    return ntl::ok(copied_udp_ip_packet(
        std::move(packet), ip_header_size));
  }

  ntl::status rewrite_udp_source(
      std::uint16_t source_port, ADDRESS_FAMILY family,
      std::span<const std::byte> source_address,
      std::span<const std::byte> destination_address,
      IF_INDEX interface_index = 0,
      IF_INDEX subinterface_index = 0) noexcept {
    const std::size_t expected =
        family == AF_INET ? 4u : family == AF_INET6 ? 16u : 0u;
    if (!packet_ || source_port == 0 || expected == 0 ||
        source_address.size() != expected ||
        destination_address.size() != expected)
      return STATUS_INVALID_PARAMETER;
    const ntl::status port = packet_.rewrite_inbound_udp_source_port(
        source_port, ip_header_size_);
    if (!port.is_ok())
      return port;
    return FwpsConstructIpHeaderForTransportPacket0(
        packet_.borrowed_native_handle(), ip_header_size_, family,
        reinterpret_cast<const UCHAR *>(source_address.data()),
        reinterpret_cast<const UCHAR *>(destination_address.data()),
        IPPROTO_UDP, 0, nullptr, 0, 0, nullptr, interface_index,
        subinterface_index);
  }

  explicit operator bool() const noexcept {
    return static_cast<bool>(packet_);
  }
  owned_injection_packet release() noexcept { return std::move(packet_); }

private:
  copied_udp_ip_packet(owned_injection_packet &&packet,
                       std::uint32_t ip_header_size) noexcept
      : packet_(std::move(packet)), ip_header_size_(ip_header_size) {}

  owned_injection_packet packet_;
  std::uint32_t ip_header_size_ = 0;
};

namespace detail {

class injection_packet_storage {
public:
  explicit injection_packet_storage(cloned_packet &&packet) noexcept
      : packet_(std::in_place_type<cloned_packet>, std::move(packet)) {}
  explicit injection_packet_storage(owned_injection_packet &&packet) noexcept
      : packet_(std::in_place_type<owned_injection_packet>,
                std::move(packet)) {}

  injection_packet_storage(const injection_packet_storage &) = delete;
  injection_packet_storage &
  operator=(const injection_packet_storage &) = delete;
  injection_packet_storage(injection_packet_storage &&) noexcept = default;
  injection_packet_storage &
  operator=(injection_packet_storage &&) noexcept = default;

  explicit operator bool() const noexcept {
    return std::visit(
        [](const auto &packet) noexcept -> bool {
          using packet_type = std::remove_cvref_t<decltype(packet)>;
          if constexpr (std::is_same_v<packet_type, std::monostate>)
            return false;
          else
            return static_cast<bool>(packet);
        },
        packet_);
  }

  NET_BUFFER_LIST *borrowed_native_handle() const noexcept {
    return std::visit(
        [](const auto &packet) noexcept -> NET_BUFFER_LIST * {
          using packet_type = std::remove_cvref_t<decltype(packet)>;
          if constexpr (std::is_same_v<packet_type, std::monostate>)
            return nullptr;
          else
            return packet.borrowed_native_handle();
        },
        packet_);
  }

  void reset() noexcept {
    std::visit(
        [](auto &packet) noexcept {
          using packet_type = std::remove_cvref_t<decltype(packet)>;
          if constexpr (!std::is_same_v<packet_type, std::monostate>)
            packet.reset();
        },
        packet_);
    packet_.template emplace<std::monostate>();
  }

private:
  std::variant<std::monostate, cloned_packet, owned_injection_packet> packet_;
};

