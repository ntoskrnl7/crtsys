/** Move-only packet and request accepted only by transport send injection. */
class transport_send_packet {
public:
  transport_send_packet(cloned_packet &&packet,
                        transport_send_request &&request) noexcept
      : packet_(std::move(packet)), request_(std::move(request)) {}
  transport_send_packet(owned_injection_packet &&packet,
                        transport_send_request &&request) noexcept
      : packet_(std::move(packet)), request_(std::move(request)) {}
  transport_send_packet(const transport_send_packet &) = delete;
  transport_send_packet &operator=(const transport_send_packet &) = delete;
  transport_send_packet(transport_send_packet &&) noexcept = default;
  transport_send_packet &operator=(transport_send_packet &&) noexcept =
      default;
  explicit operator bool() const noexcept {
    return static_cast<bool>(packet_) && static_cast<bool>(request_);
  }
  NET_BUFFER_LIST *borrowed_native_handle() const noexcept {
    return packet_.borrowed_native_handle();
  }
  void reset() noexcept { packet_.reset(); }

private:
  friend class transport_injector;
  detail::injection_packet_storage packet_;
  transport_send_request request_;
};

namespace detail {

struct injection_state {
  using resource_cleanup =
      void (*)(PNDIS_GENERIC_OBJECT, NDIS_HANDLE) noexcept;

  injection_state(
      HANDLE value,
      ntl::net::kernel::passive_cleanup_domain &cleanup_domain,
      injection_limits limits_value,
      PNDIS_GENERIC_OBJECT generic = nullptr,
      NDIS_HANDLE packet_pool = nullptr,
      resource_cleanup cleanup_resources_value = nullptr) noexcept
      : handle(value), cleanup(&injection_state::cleanup_at_passive, this),
        domain(&cleanup_domain), limits(limits_value), generic_object(generic),
        nbl_pool(packet_pool), cleanup_resources(cleanup_resources_value) {
    ExInitializeRundownProtection(&rundown);
  }

  static void cleanup_at_passive(void *context) noexcept {
    auto *state = static_cast<injection_state *>(context);
    ExWaitForRundownProtectionRelease(&state->rundown);
    if (state->handle)
      (void)FwpsInjectionHandleDestroy0(
          std::exchange(state->handle, nullptr));
    if (state->cleanup_resources)
      state->cleanup_resources(state->generic_object, state->nbl_pool);
    state->nbl_pool = nullptr;
    state->generic_object = nullptr;
    delete state;
  }

  HANDLE handle = nullptr;
  EX_RUNDOWN_REF rundown{};
  std::atomic<bool> accepting{true};
  std::atomic<std::uint64_t> completion_failures{0};
  std::atomic<NTSTATUS> last_completion_status{STATUS_SUCCESS};
  std::atomic<std::size_t> active_injections{0};
  std::atomic<std::size_t> peak_injections{0};
  std::atomic<std::uint64_t> quota_rejections{0};
  ntl::net::kernel::passive_cleanup_item cleanup;
  ntl::net::kernel::passive_cleanup_domain *domain = nullptr;
  injection_limits limits{};
  PNDIS_GENERIC_OBJECT generic_object = nullptr;
  NDIS_HANDLE nbl_pool = nullptr;
  resource_cleanup cleanup_resources = nullptr;

  bool try_reserve_injection() noexcept {
    std::size_t active = active_injections.load(std::memory_order_relaxed);
    for (;;) {
      if (active >= limits.maximum_in_flight) {
        quota_rejections.fetch_add(1, std::memory_order_relaxed);
        return false;
      }
      if (active_injections.compare_exchange_weak(
              active, active + 1, std::memory_order_acq_rel,
              std::memory_order_relaxed)) {
        const std::size_t selected = active + 1;
        std::size_t peak = peak_injections.load(std::memory_order_relaxed);
        while (peak < selected &&
               !peak_injections.compare_exchange_weak(
                   peak, selected, std::memory_order_relaxed,
                   std::memory_order_relaxed)) {
        }
        return true;
      }
    }
  }

  void release_injection() noexcept {
    const std::size_t previous =
        active_injections.fetch_sub(1, std::memory_order_acq_rel);
    if (previous == 0)
      active_injections.store(0, std::memory_order_release);
    NT_ASSERT(previous != 0);
  }
};

struct owning_packet_context {
  template <class Packet>
  static owning_packet_context *create(injection_state &owner,
                                       Packet &&value) noexcept {
    using packet_type = std::remove_cvref_t<Packet>;
    auto *packet = new (std::nothrow) packet_type(std::move(value));
    if (!packet)
      return nullptr;
    auto *context = new (std::nothrow) owning_packet_context(
        owner, packet,
        [](void *stored) noexcept {
          static_cast<packet_type *>(stored)->reset();
          delete static_cast<packet_type *>(stored);
        },
        [](void *stored) noexcept -> NET_BUFFER_LIST * {
          if constexpr (requires(packet_type &value) {
                          value.borrowed_native_handle();
                        })
            return static_cast<packet_type *>(stored)
                ->borrowed_native_handle();
          else {
            (void)stored;
            return nullptr;
          }
        });
    if (!context) {
      static_cast<packet_type *>(packet)->reset();
      delete static_cast<packet_type *>(packet);
    }
    return context;
  }

  ~owning_packet_context() {
    // The owned NBL must be released while the injection owner's rundown
    // protection is still held.  In particular, injected_stream_data may
    // depend on an NBL pool that reset() frees immediately after rundown.
    destroy(packet);
    state->release_injection();
    ExReleaseRundownProtection(&state->rundown);
  }

  NET_BUFFER_LIST *borrowed_native_handle() const noexcept {
    return native(packet);
  }

  template <class Packet> Packet &as() noexcept {
    return *static_cast<Packet *>(packet);
  }

private:
  owning_packet_context(injection_state &owner, void *value,
                        void (*destroy_value)(void *) noexcept,
                        NET_BUFFER_LIST *(*native_value)(void *) noexcept)
      noexcept
      : state(&owner), packet(value), destroy(destroy_value),
        native(native_value) {}

public:

  injection_state *state;
  void *packet;
  void (*destroy)(void *) noexcept;
  NET_BUFFER_LIST *(*native)(void *) noexcept;
};

inline void NTAPI injection_complete(void *context, NET_BUFFER_LIST *packet,
                                     BOOLEAN) noexcept {
  auto *owned = static_cast<owning_packet_context *>(context);
  if (packet) {
    const NTSTATUS status =
        static_cast<NTSTATUS>(NET_BUFFER_LIST_STATUS(packet));
    if (!NT_SUCCESS(status)) {
      owned->state->last_completion_status.store(
          status, std::memory_order_relaxed);
      owned->state->completion_failures.fetch_add(
          1, std::memory_order_relaxed);
    }
  }
  delete owned;
}

struct async_stream_clone_context {
  async_stream_clone_context(
      injection_state &owner, LONG count) noexcept
      : state(&owner), remaining(count) {}

  ~async_stream_clone_context() {
    state->release_injection();
    ExReleaseRundownProtection(&state->rundown);
  }

  injection_state *state;
  volatile LONG remaining;
};

inline void NTAPI stream_clone_injection_complete(
    void *context, NET_BUFFER_LIST *packet, BOOLEAN) noexcept {
  auto *completion =
      static_cast<async_stream_clone_context *>(context);
  FwpsFreeCloneNetBufferList0(packet, 0);
  if (InterlockedDecrement(&completion->remaining) == 0)
    delete completion;
}

class injection_owner {
public:
  injection_owner() = default;
  injection_owner(const injection_owner &) = delete;
  injection_owner &operator=(const injection_owner &) = delete;
  injection_owner(injection_owner &&other) noexcept
      : state_(std::move(other.state_)) {}
  injection_owner &operator=(injection_owner &&other) noexcept {
    if (this != &other) {
      reset();
      state_ = std::move(other.state_);
    }
    return *this;
  }

  ~injection_owner() { reset(); }

  static ntl::result<injection_owner>
  try_create(ADDRESS_FAMILY family, UINT32 type,
             injection_limits limits = {}) noexcept {
    if (!limits.valid())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    HANDLE handle = nullptr;
    const NTSTATUS result =
        FwpsInjectionHandleCreate0(family, type, &handle);
    if (!NT_SUCCESS(result))
      return ntl::unexpected(result);

    return adopt(handle, limits, nullptr, nullptr, nullptr);
  }

  static ntl::result<injection_owner>
  try_create(ADDRESS_FAMILY family, UINT32 type,
             PDRIVER_OBJECT driver,
             injection_limits limits = {}) noexcept {
    if (!driver || !limits.valid())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    HANDLE handle = nullptr;
    const NTSTATUS result =
        FwpsInjectionHandleCreate0(family, type, &handle);
    if (!NT_SUCCESS(result))
      return ntl::unexpected(result);

    PNDIS_GENERIC_OBJECT generic =
        NdisAllocateGenericObject(driver, 'gIwN', 0);
    if (!generic) {
      (void)FwpsInjectionHandleDestroy0(handle);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    NET_BUFFER_LIST_POOL_PARAMETERS parameters{};
    parameters.Header.Type = NDIS_OBJECT_TYPE_DEFAULT;
    parameters.Header.Revision =
        NET_BUFFER_LIST_POOL_PARAMETERS_REVISION_1;
    parameters.Header.Size =
        NDIS_SIZEOF_NET_BUFFER_LIST_POOL_PARAMETERS_REVISION_1;
    parameters.fAllocateNetBuffer = TRUE;
    parameters.PoolTag = 'pIwN';
    NDIS_HANDLE packet_pool =
        NdisAllocateNetBufferListPool(generic, &parameters);
    if (!packet_pool) {
      NdisFreeGenericObject(generic);
      (void)FwpsInjectionHandleDestroy0(handle);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    return adopt(handle, limits, generic, packet_pool,
                 &release_ndis_resources);
  }

private:
  static void release_ndis_resources(
      PNDIS_GENERIC_OBJECT generic,
      NDIS_HANDLE packet_pool) noexcept {
    if (packet_pool)
      NdisFreeNetBufferListPool(packet_pool);
    if (generic)
      NdisFreeGenericObject(generic);
  }

  static ntl::result<injection_owner>
  adopt(HANDLE handle, injection_limits limits,
        PNDIS_GENERIC_OBJECT generic, NDIS_HANDLE packet_pool,
        injection_state::resource_cleanup cleanup_resources) noexcept {

    auto *domain =
        ntl::net::kernel::borrowed_runtime_passive_cleanup_domain();
    auto *raw = domain
                    ? new (std::nothrow) injection_state(
                          handle, *domain, limits, generic, packet_pool,
                          cleanup_resources)
                    : nullptr;
    if (!raw) {
      if (cleanup_resources)
        cleanup_resources(generic, packet_pool);
      (void)FwpsInjectionHandleDestroy0(handle);
      return ntl::unexpected(domain ? STATUS_INSUFFICIENT_RESOURCES
                                    : STATUS_DEVICE_NOT_READY);
    }
    const ntl::status registered = domain->register_item(raw->cleanup);
    if (!registered.is_ok()) {
      (void)FwpsInjectionHandleDestroy0(handle);
      if (cleanup_resources)
        cleanup_resources(generic, packet_pool);
      delete raw;
      return ntl::unexpected(static_cast<NTSTATUS>(registered));
    }
    try {
      std::shared_ptr<injection_state> state(
          raw, [](injection_state *value) noexcept {
            value->accepting.store(false, std::memory_order_release);
            value->domain->retire_deferred(value->cleanup);
          });
      return ntl::ok(injection_owner(std::move(state)));
    } catch (...) {
      raw->accepting.store(false, std::memory_order_release);
      domain->retire_deferred(raw->cleanup);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
  }

public:

  ntl::result<owned_injection_packet>
  try_copy_packet(ntl::net::scatter_view source,
                  ntl::net::buffer_limits limits,
                  ULONG tag = ntl::pool_tag("iPwN")) const noexcept {
    auto state = state_;
    if (!state || !state->accepting.load(std::memory_order_acquire) ||
        !state->nbl_pool)
      return ntl::unexpected(STATUS_INVALID_DEVICE_STATE);
    return owned_injection_packet::try_copy(state->nbl_pool, source,
                                             limits, tag);
  }

  void reset() noexcept {
    auto state = std::move(state_);
    if (state)
      state->accepting.store(false, std::memory_order_release);
  }

  FWPS_PACKET_INJECTION_STATE
  query(borrowed_packet packet) const noexcept {
    auto state = state_;
    if (!state || !state->accepting.load(std::memory_order_acquire) || !packet)
      return FWPS_PACKET_NOT_INJECTED;
    return FwpsQueryPacketInjectionState0(
        state->handle, packet.borrowed_native_handle(), nullptr);
  }

  template <class Packet>
  ntl::result<owning_packet_context *>
  prepare(Packet &&packet) noexcept {
    auto state = state_;
    if (!state || !state->accepting.load(std::memory_order_acquire) || !packet)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (!ExAcquireRundownProtection(&state->rundown))
      return ntl::unexpected(STATUS_DELETE_PENDING);
    if (!state->accepting.load(std::memory_order_acquire)) {
      ExReleaseRundownProtection(&state->rundown);
      return ntl::unexpected(STATUS_DELETE_PENDING);
    }
    if (!state->try_reserve_injection()) {
      ExReleaseRundownProtection(&state->rundown);
      return ntl::unexpected(STATUS_QUOTA_EXCEEDED);
    }

    auto *context = owning_packet_context::create(*state, std::move(packet));
    if (!context) {
      state->release_injection();
      ExReleaseRundownProtection(&state->rundown);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    return ntl::ok(context);
  }

  ntl::result<async_stream_clone_context *>
  prepare_stream_clone(LONG count) noexcept {
    auto state = state_;
    if (!state || !state->accepting.load(std::memory_order_acquire) ||
        count <= 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (!ExAcquireRundownProtection(&state->rundown))
      return ntl::unexpected(STATUS_DELETE_PENDING);
    if (!state->accepting.load(std::memory_order_acquire)) {
      ExReleaseRundownProtection(&state->rundown);
      return ntl::unexpected(STATUS_DELETE_PENDING);
    }
    if (!state->try_reserve_injection()) {
      ExReleaseRundownProtection(&state->rundown);
      return ntl::unexpected(STATUS_QUOTA_EXCEEDED);
    }

    auto *context = new (std::nothrow)
        async_stream_clone_context(*state, count);
    if (!context) {
      state->release_injection();
      ExReleaseRundownProtection(&state->rundown);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    return ntl::ok(context);
  }

  struct statistics_type {
    std::uint64_t completion_failures = 0;
    NTSTATUS last_completion_status = STATUS_SUCCESS;
    std::size_t active_injections = 0;
    std::size_t peak_injections = 0;
    std::uint64_t quota_rejections = 0;
  };

  statistics_type statistics() const noexcept {
    const auto state = state_;
    return state
               ? statistics_type{
                     state->completion_failures.load(
                         std::memory_order_relaxed),
                     state->last_completion_status.load(
                         std::memory_order_relaxed),
                     state->active_injections.load(
                         std::memory_order_relaxed),
                     state->peak_injections.load(
                         std::memory_order_relaxed),
                     state->quota_rejections.load(
                         std::memory_order_relaxed)}
               : statistics_type{};
  }

  /** Non-owning native handle; valid only while this owner remains open. */
  HANDLE borrowed_native_handle() const noexcept {
    auto state = state_;
    return state && state->accepting.load(std::memory_order_acquire)
               ? state->handle
               : nullptr;
  }

private:
  explicit injection_owner(
      std::shared_ptr<injection_state> state) noexcept
      : state_(std::move(state)) {}

  std::shared_ptr<injection_state> state_;
};

template <class Context>
inline ntl::status finish_injection(NTSTATUS result,
                                    Context *context) noexcept {
  if (!NT_SUCCESS(result))
    delete context;
  return result;
}

