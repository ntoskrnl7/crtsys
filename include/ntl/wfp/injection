/**
 * @file injection
 * @brief Unload-safe asynchronous WFP packet injection.
 */
#pragma once

#if !defined(_KERNEL_MODE) && !defined(_KERNEL32_)
#error "ntl/wfp/injection is a kernel-mode header"
#endif

#include "../result"
#include "../status"
#include "packet"
#include "stream"

#include <memory>
#include <new>
#include <utility>

namespace ntl::wfp {

namespace detail {

struct injection_state {
  explicit injection_state(HANDLE value) noexcept : handle(value) {
    ExInitializeRundownProtection(&rundown);
  }

  HANDLE handle = nullptr;
  EX_RUNDOWN_REF rundown{};
};

template <class Packet> struct async_packet_context {
  async_packet_context(injection_state &owner, Packet &&value) noexcept
      : state(&owner), packet(std::move(value)) {}

  ~async_packet_context() {
    // The owned NBL must be released while the injection owner's rundown
    // protection is still held.  In particular, injected_stream_data may
    // depend on an NBL pool that reset() frees immediately after rundown.
    packet.reset();
    ExReleaseRundownProtection(&state->rundown);
  }

  injection_state *state;
  Packet packet;
};

template <class Packet>
inline void NTAPI injection_complete(void *context, NET_BUFFER_LIST *,
                                     BOOLEAN) noexcept {
  delete static_cast<async_packet_context<Packet> *>(context);
}

struct async_stream_clone_context {
  async_stream_clone_context(
      injection_state &owner, LONG count) noexcept
      : state(&owner), remaining(count) {}

  ~async_stream_clone_context() {
    ExReleaseRundownProtection(&state->rundown);
  }

  injection_state *state;
  volatile LONG remaining;
};

inline void NTAPI stream_clone_injection_complete(
    void *context, NET_BUFFER_LIST *packet, BOOLEAN) noexcept {
  auto *completion =
      static_cast<async_stream_clone_context *>(context);
  FwpsFreeCloneNetBufferList0(packet, 0);
  if (InterlockedDecrement(&completion->remaining) == 0)
    delete completion;
}

class injection_owner {
public:
  injection_owner() = default;
  injection_owner(const injection_owner &) = delete;
  injection_owner &operator=(const injection_owner &) = delete;
  injection_owner(injection_owner &&other) noexcept
      : state_(std::move(other.state_)) {}
  injection_owner &operator=(injection_owner &&other) noexcept {
    if (this != &other) {
      reset();
      state_ = std::move(other.state_);
    }
    return *this;
  }

  ~injection_owner() { reset(); }

  static ntl::result<injection_owner>
  try_create(ADDRESS_FAMILY family, UINT32 type) noexcept {
    HANDLE handle = nullptr;
    const NTSTATUS result =
        FwpsInjectionHandleCreate0(family, type, &handle);
    if (!NT_SUCCESS(result))
      return ntl::unexpected(result);

    std::unique_ptr<injection_state> state(
        new (std::nothrow) injection_state(handle));
    if (!state) {
      (void)FwpsInjectionHandleDestroy0(handle);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    return ntl::ok(injection_owner(std::move(state)));
  }

  void reset() noexcept {
    if (!state_)
      return;
    NT_ASSERT(KeGetCurrentIrql() == PASSIVE_LEVEL);
    ExWaitForRundownProtectionRelease(&state_->rundown);
    (void)FwpsInjectionHandleDestroy0(state_->handle);
    state_.reset();
  }

  FWPS_PACKET_INJECTION_STATE
  query(borrowed_packet packet) const noexcept {
    if (!state_ || !packet)
      return FWPS_PACKET_NOT_INJECTED;
    return FwpsQueryPacketInjectionState0(
        state_->handle, packet.native_handle(), nullptr);
  }

  template <class Packet>
  ntl::result<async_packet_context<Packet> *>
  prepare(Packet &&packet) noexcept {
    if (!state_ || !packet)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (!ExAcquireRundownProtection(&state_->rundown))
      return ntl::unexpected(STATUS_DELETE_PENDING);

    auto *context = new (std::nothrow)
        async_packet_context<Packet>(*state_, std::move(packet));
    if (!context) {
      ExReleaseRundownProtection(&state_->rundown);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    return ntl::ok(context);
  }

  ntl::result<async_stream_clone_context *>
  prepare_stream_clone(LONG count) noexcept {
    if (!state_ || count <= 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    if (!ExAcquireRundownProtection(&state_->rundown))
      return ntl::unexpected(STATUS_DELETE_PENDING);

    auto *context = new (std::nothrow)
        async_stream_clone_context(*state_, count);
    if (!context) {
      ExReleaseRundownProtection(&state_->rundown);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }
    return ntl::ok(context);
  }

  HANDLE native_handle() const noexcept {
    return state_ ? state_->handle : nullptr;
  }

private:
  explicit injection_owner(
      std::unique_ptr<injection_state> &&state) noexcept
      : state_(std::move(state)) {}

  std::unique_ptr<injection_state> state_;
};

template <class Context>
inline ntl::status finish_injection(NTSTATUS result,
                                    Context *context) noexcept {
  if (!NT_SUCCESS(result))
    delete context;
  return result;
}

} // namespace detail

/**
 * @brief Network-layer injector whose handle waits for all completions.
 */
class network_injector {
public:
  network_injector(const network_injector &) = delete;
  network_injector &operator=(const network_injector &) = delete;
  network_injector(network_injector &&) noexcept = default;
  network_injector &operator=(network_injector &&) noexcept = default;

  static ntl::result<network_injector>
  try_create(ADDRESS_FAMILY family = AF_UNSPEC) noexcept {
    auto owner = detail::injection_owner::try_create(
        family, FWPS_INJECTION_TYPE_NETWORK);
    if (!owner)
      return ntl::unexpected(owner.status());
    return ntl::ok(network_injector(std::move(*owner)));
  }

  FWPS_PACKET_INJECTION_STATE
  query(borrowed_packet packet) const noexcept {
    return owner_.query(packet);
  }

  ntl::status inject_send(cloned_packet &&packet,
                          COMPARTMENT_ID compartment_id,
                          UINT32 flags = 0) noexcept {
    auto prepared = owner_.prepare(std::move(packet));
    if (!prepared)
      return prepared.status();
    auto *context = *prepared;
    return detail::finish_injection(
        FwpsInjectNetworkSendAsync0(
            owner_.native_handle(), nullptr, flags, compartment_id,
            context->packet.native_handle(),
            &detail::injection_complete<cloned_packet>,
            context),
        context);
  }

  ntl::status inject_receive(cloned_packet &&packet,
                             COMPARTMENT_ID compartment_id,
                             IF_INDEX interface_index,
                             IF_INDEX subinterface_index,
                             UINT32 flags = 0) noexcept {
    auto prepared = owner_.prepare(std::move(packet));
    if (!prepared)
      return prepared.status();
    auto *context = *prepared;
    return detail::finish_injection(
        FwpsInjectNetworkReceiveAsync0(
            owner_.native_handle(), nullptr, flags, compartment_id,
            interface_index, subinterface_index,
            context->packet.native_handle(),
            &detail::injection_complete<cloned_packet>,
            context),
        context);
  }

  void reset() noexcept { owner_.reset(); }

private:
  explicit network_injector(detail::injection_owner &&owner) noexcept
      : owner_(std::move(owner)) {}
  detail::injection_owner owner_;
};

