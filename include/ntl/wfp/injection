struct injection_limits {
  std::size_t maximum_in_flight = 1024;

  constexpr bool valid() const noexcept {
    return maximum_in_flight != 0 && maximum_in_flight <= 64 * 1024;
  }
};

/**
 * @brief Move-only, completion-safe arguments for an outbound transport send.
 *
 * WFP requires the buffers referenced by `FWPS_TRANSPORT_SEND_PARAMS0` to
 * remain valid until the asynchronous injection completion callback.  This
 * type owns those buffers and keeps the endpoint, address family, compartment,
 * scope, and ancillary control data together so callers cannot accidentally
 * pass stack-backed send parameters.
 */
class transport_send_request {
public:
  transport_send_request(const transport_send_request &) = delete;
  transport_send_request &operator=(const transport_send_request &) = delete;

  transport_send_request(transport_send_request &&other) noexcept
      : endpoint_handle_(std::exchange(other.endpoint_handle_, 0)),
        family_(std::exchange(
            other.family_, static_cast<ADDRESS_FAMILY>(AF_UNSPEC))),
        compartment_id_(std::exchange(other.compartment_id_,
                                      UNSPECIFIED_COMPARTMENT_ID)),
        remote_address_(other.remote_address_),
        remote_address_size_(std::exchange(other.remote_address_size_, 0)),
        remote_scope_(other.remote_scope_),
        control_data_(std::move(other.control_data_)),
        has_send_parameters_(
            std::exchange(other.has_send_parameters_, false)) {
    rebind_native_parameters();
    other.native_parameters_ = {};
  }

  transport_send_request &
  operator=(transport_send_request &&other) noexcept {
    if (this != &other) {
      endpoint_handle_ = std::exchange(other.endpoint_handle_, 0);
      family_ = std::exchange(
          other.family_, static_cast<ADDRESS_FAMILY>(AF_UNSPEC));
      compartment_id_ = std::exchange(other.compartment_id_,
                                      UNSPECIFIED_COMPARTMENT_ID);
      remote_address_ = other.remote_address_;
      remote_address_size_ = std::exchange(other.remote_address_size_, 0);
      remote_scope_ = other.remote_scope_;
      control_data_ = std::move(other.control_data_);
      has_send_parameters_ =
          std::exchange(other.has_send_parameters_, false);
      rebind_native_parameters();
      other.native_parameters_ = {};
    }
    return *this;
  }

  /**
   * @brief Adopts already-owned ancillary data without another allocation.
   */
  static ntl::result<transport_send_request>
  try_create(UINT64 endpoint_handle, ADDRESS_FAMILY family,
             COMPARTMENT_ID compartment_id,
             std::span<const std::byte> remote_address,
             SCOPE_ID remote_scope,
             ntl::net::owned_bytes &&control_data) noexcept {
    const std::size_t expected_address_size = address_size(family);
    if (endpoint_handle == 0 || expected_address_size == 0 ||
        remote_address.size() != expected_address_size ||
        control_data.size() >
            static_cast<std::size_t>(
                (std::numeric_limits<ULONG>::max)()))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    transport_send_request request(endpoint_handle, family, compartment_id);
    std::memcpy(request.remote_address_.data(), remote_address.data(),
                remote_address.size());
    request.remote_address_size_ = remote_address.size();
    request.remote_scope_ = remote_scope;
    request.control_data_ = std::move(control_data);
    request.has_send_parameters_ = true;
    request.rebind_native_parameters();
    return ntl::ok(std::move(request));
  }

  /**
   * @brief Deep-copies callback-scoped ancillary data into nonpaged storage.
   */
  static ntl::result<transport_send_request>
  try_copy(UINT64 endpoint_handle, ADDRESS_FAMILY family,
           COMPARTMENT_ID compartment_id,
           std::span<const std::byte> remote_address,
           SCOPE_ID remote_scope, std::span<const std::byte> control_data,
           ntl::net::buffer_limits control_data_limits,
           ULONG tag = ntl::pool_tag("sIwN")) noexcept {
    const std::size_t expected_address_size = address_size(family);
    if (endpoint_handle == 0 || expected_address_size == 0 ||
        remote_address.size() != expected_address_size ||
        !control_data_limits.accepts(control_data.size()))
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    auto owned_control_data = ntl::net::owned_bytes::try_copy(
        control_data, control_data_limits, tag);
    if (!owned_control_data)
      return ntl::unexpected(owned_control_data.status());
    return try_create(endpoint_handle, family, compartment_id, remote_address,
                      remote_scope, std::move(*owned_control_data));
  }

  /**
   * @brief Creates an explicit raw-socket request whose NBL contains the IP
   * header and therefore needs no transport send parameter block.
   */
  static ntl::result<transport_send_request>
  raw_packet(UINT64 endpoint_handle, ADDRESS_FAMILY family,
             COMPARTMENT_ID compartment_id) noexcept {
    if (endpoint_handle == 0 || address_size(family) == 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    return ntl::ok(
        transport_send_request(endpoint_handle, family, compartment_id));
  }

  explicit operator bool() const noexcept {
    return endpoint_handle_ != 0 && address_size(family_) != 0 &&
           (!has_send_parameters_ ||
            remote_address_size_ == address_size(family_));
  }

  UINT64 endpoint_handle() const noexcept { return endpoint_handle_; }
  ADDRESS_FAMILY family() const noexcept { return family_; }
  COMPARTMENT_ID compartment_id() const noexcept { return compartment_id_; }
  SCOPE_ID remote_scope() const noexcept { return remote_scope_; }
  bool has_send_parameters() const noexcept { return has_send_parameters_; }
  std::span<const std::byte> remote_address() const noexcept {
    return std::span<const std::byte>(remote_address_).first(
        remote_address_size_);
  }
  std::span<const std::byte> control_data() const noexcept {
    return control_data_.span();
  }

private:
  friend class transport_injector;

  transport_send_request(UINT64 endpoint_handle, ADDRESS_FAMILY family,
                         COMPARTMENT_ID compartment_id) noexcept
      : endpoint_handle_(endpoint_handle), family_(family),
        compartment_id_(compartment_id) {}

  static constexpr std::size_t address_size(ADDRESS_FAMILY family) noexcept {
    return family == AF_INET ? 4u : family == AF_INET6 ? 16u : 0u;
  }

  void rebind_native_parameters() noexcept {
    native_parameters_ = {};
    if (!has_send_parameters_)
      return;
    native_parameters_.remoteAddress =
        reinterpret_cast<UCHAR *>(remote_address_.data());
    native_parameters_.remoteScopeId = remote_scope_;
    if (!control_data_.empty()) {
      native_parameters_.controlData =
          reinterpret_cast<WSACMSGHDR *>(control_data_.data());
      native_parameters_.controlDataLength =
          static_cast<ULONG>(control_data_.size());
    }
  }

  FWPS_TRANSPORT_SEND_PARAMS0 *native_parameters() noexcept {
    return has_send_parameters_ ? &native_parameters_ : nullptr;
  }

  UINT64 endpoint_handle_ = 0;
  ADDRESS_FAMILY family_ = AF_UNSPEC;
  COMPARTMENT_ID compartment_id_ = UNSPECIFIED_COMPARTMENT_ID;
  std::array<std::byte, 16> remote_address_{};
  std::size_t remote_address_size_ = 0;
  SCOPE_ID remote_scope_{};
  ntl::net::owned_bytes control_data_;
  bool has_send_parameters_ = false;
  FWPS_TRANSPORT_SEND_PARAMS0 native_parameters_{};
};

/**
 * @brief Move-only NBL whose storage is independent from the classified NBL.
 *
 * Cross-direction injection must not retain send-path NBL metadata such as
 * checksum-offload and loopback state.  This owner copies only the bounded
 * packet bytes into nonpaged storage and builds a fresh WFP injection NBL.
 * The supplying injection runtime owns the NBL pool until every asynchronous
 * completion has drained.
 */
class owned_injection_packet {
public:
  owned_injection_packet() noexcept = default;
  owned_injection_packet(const owned_injection_packet &) = delete;
  owned_injection_packet &operator=(const owned_injection_packet &) = delete;

  owned_injection_packet(owned_injection_packet &&other) noexcept
      : packet_(std::exchange(other.packet_, nullptr)),
        mdl_(std::exchange(other.mdl_, nullptr)),
        storage_(std::move(other.storage_)) {}

  owned_injection_packet &
  operator=(owned_injection_packet &&other) noexcept {
    if (this != &other) {
      reset();
      packet_ = std::exchange(other.packet_, nullptr);
      mdl_ = std::exchange(other.mdl_, nullptr);
      storage_ = std::move(other.storage_);
    }
    return *this;
  }

  ~owned_injection_packet() { reset(); }

  static ntl::result<owned_injection_packet>
  try_copy(NDIS_HANDLE nbl_pool, ntl::net::scatter_view source,
           ntl::net::buffer_limits limits,
           ULONG tag = ntl::pool_tag("iPwN")) noexcept {
    if (!nbl_pool || !source || source.empty() ||
        source.size() > (std::numeric_limits<ULONG>::max)())
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    auto storage = ntl::net::owned_bytes::try_copy(source, limits, tag);
    if (!storage)
      return ntl::unexpected(storage.status());

    MDL *mdl = IoAllocateMdl(storage->data(),
                             static_cast<ULONG>(storage->size()), FALSE,
                             FALSE, nullptr);
    if (!mdl)
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    MmBuildMdlForNonPagedPool(mdl);

    NET_BUFFER_LIST *packet = nullptr;
    const NTSTATUS allocated = FwpsAllocateNetBufferAndNetBufferList0(
        nbl_pool, 0, 0, mdl, 0, storage->size(), &packet);
    if (!NT_SUCCESS(allocated)) {
      IoFreeMdl(mdl);
      return ntl::unexpected(allocated);
    }
    return ntl::ok(owned_injection_packet(
        packet, mdl, std::move(*storage)));
  }

  explicit operator bool() const noexcept { return packet_ != nullptr; }
  NET_BUFFER_LIST *borrowed_native_handle() const noexcept { return packet_; }
  ntl::net::scatter_view bytes() const noexcept {
    return detail::nbl_bytes(packet_);
  }
  ntl::net::mutable_scatter_view edit_bytes() noexcept {
    return detail::mutable_nbl_bytes(packet_);
  }

  ntl::status rewrite_inbound_udp_source_port(
      std::uint16_t host_order_port,
      std::size_t ip_header_size) noexcept {
    if (!packet_ || host_order_port == 0 ||
        ip_header_size > storage_.size() ||
        storage_.size() - ip_header_size < 8)
      return STATUS_INVALID_PARAMETER;
    auto bytes = edit_bytes();
    const ntl::status port = bytes.write_be16(ip_header_size,
                                               host_order_port);
    if (!port.is_ok())
      return port;
    return bytes.write_be16(ip_header_size + 6, 0);
  }

  void reset() noexcept {
    NET_BUFFER_LIST *packet = std::exchange(packet_, nullptr);
    if (packet)
      FwpsFreeNetBufferList0(packet);
    MDL *mdl = std::exchange(mdl_, nullptr);
    if (mdl)
      IoFreeMdl(mdl);
    storage_.reset();
  }

private:
  owned_injection_packet(NET_BUFFER_LIST *packet, MDL *mdl,
                         ntl::net::owned_bytes &&storage) noexcept
      : packet_(packet), mdl_(mdl), storage_(std::move(storage)) {}

  NET_BUFFER_LIST *packet_ = nullptr;
  MDL *mdl_ = nullptr;
  ntl::net::owned_bytes storage_;
};

/**
 * @brief An inbound transport clone positioned and shaped for reinjection.
 *
 * The factory performs the fragile NBL retreat/clone/restore sequence while
 * the classify callback still owns the original packet. The clone remains at
 * the IP header, records the validated header sizes, and exposes only the
 * source-tuple rewrite needed by a transparent UDP proxy.
 */
class transport_receive_packet {
public:
  transport_receive_packet(const transport_receive_packet &) = delete;
  transport_receive_packet &
  operator=(const transport_receive_packet &) = delete;
  transport_receive_packet(transport_receive_packet &&) noexcept = default;
  transport_receive_packet &
  operator=(transport_receive_packet &&) noexcept = default;

  /** Adopts a caller-prepared receive NBL without tuple rewriting. */
  explicit transport_receive_packet(cloned_packet &&packet) noexcept
      : packet_(std::move(packet)) {}

  static ntl::result<transport_receive_packet> try_clone(
      borrowed_packet packet, std::uint32_t ip_header_size,
      std::uint32_t transport_header_size) noexcept {
    if (!packet || ip_header_size == 0 || transport_header_size == 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    NET_BUFFER_LIST *const native = packet.borrowed_native_handle();
    NET_BUFFER *const first = NET_BUFFER_LIST_FIRST_NB(native);
    if (!first || NET_BUFFER_NEXT_NB(first) != nullptr)
      return ntl::unexpected(STATUS_NOT_SUPPORTED);
    if (ip_header_size >
            (std::numeric_limits<ULONG>::max)() - transport_header_size)
      return ntl::unexpected(STATUS_INTEGER_OVERFLOW);
    const ULONG retreat = ip_header_size + transport_header_size;
    const NDIS_STATUS positioned = NdisRetreatNetBufferDataStart(
        first, retreat, 0, nullptr);
    if (positioned != NDIS_STATUS_SUCCESS)
      return ntl::unexpected(STATUS_BUFFER_TOO_SMALL);
    auto clone = cloned_packet::try_create(packet);
    NdisAdvanceNetBufferDataStart(first, retreat, FALSE, nullptr);
    if (!clone)
      return ntl::unexpected(clone.status());
    return ntl::ok(transport_receive_packet(
        std::move(*clone), ip_header_size, transport_header_size));
  }

  /**
   * @brief Clones an outbound UDP transport NBL for receive-path injection.
   *
   * Outbound datagram data is positioned at the transport header and has no
   * IP header yet.  rewrite_udp_source() therefore constructs a fresh IP
   * header with a zero header-include length before the clone is injected into
   * the receive path.  This is the reverse half used by local transparent UDP
   * proxies for connected clients whose transport would reject the proxy's
   * unmodified source tuple before an inbound datagram callout can observe it.
   */
  static ntl::result<transport_receive_packet>
  try_clone_from_outbound(borrowed_packet packet) noexcept {
    if (!packet)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    auto clone = cloned_packet::try_create(packet);
    if (!clone)
      return ntl::unexpected(clone.status());
    constexpr std::uint32_t udp_header_size = 8;
    return ntl::ok(transport_receive_packet(
        std::move(*clone), 0, udp_header_size));
  }

  /**
   * @brief Clones an IP-positioned packet for receive-path tuple restoration.
   */
  static ntl::result<transport_receive_packet>
  try_clone_ip_packet(borrowed_packet packet,
                      std::uint32_t ip_header_size) noexcept {
    if (!packet || ip_header_size == 0)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);
    auto clone = cloned_packet::try_create(packet);
    if (!clone)
      return ntl::unexpected(clone.status());
    constexpr std::uint32_t udp_header_size = 8;
    return ntl::ok(transport_receive_packet(
        std::move(*clone), ip_header_size, udp_header_size));
  }

  ntl::status rewrite_udp_source(
      std::uint16_t source_port, ADDRESS_FAMILY family,
      std::span<const std::byte> source_address,
      std::span<const std::byte> destination_address,
      IF_INDEX interface_index = 0,
      IF_INDEX subinterface_index = 0) noexcept {
    const std::size_t expected =
        family == AF_INET ? 4u : family == AF_INET6 ? 16u : 0u;
    if (!packet_ || source_port == 0 || expected == 0 ||
        source_address.size() != expected ||
        destination_address.size() != expected)
      return STATUS_INVALID_PARAMETER;
    const ntl::status port = packet_.rewrite_inbound_udp_source_port(
        source_port, ip_header_size_);
    if (!port.is_ok())
      return port;
    return FwpsConstructIpHeaderForTransportPacket0(
        packet_.borrowed_native_handle(), ip_header_size_, family,
        reinterpret_cast<const UCHAR *>(source_address.data()),
        reinterpret_cast<const UCHAR *>(destination_address.data()),
        IPPROTO_UDP, 0, nullptr, 0,
        0,
        nullptr, interface_index,
        subinterface_index);
  }

  explicit operator bool() const noexcept {
    return static_cast<bool>(packet_);
  }

  void reset() noexcept { packet_.reset(); }
  NET_BUFFER_LIST *borrowed_native_handle() const noexcept {
    return packet_.borrowed_native_handle();
  }
  cloned_packet release() noexcept { return std::move(packet_); }
  std::uint32_t ip_header_size() const noexcept { return ip_header_size_; }
  std::uint32_t transport_header_size() const noexcept {
    return transport_header_size_;
  }

private:
  transport_receive_packet(cloned_packet &&packet,
                           std::uint32_t ip_header_size,
                           std::uint32_t transport_header_size) noexcept
      : packet_(std::move(packet)), ip_header_size_(ip_header_size),
        transport_header_size_(transport_header_size) {}

  cloned_packet packet_;
  std::uint32_t ip_header_size_ = 0;
  std::uint32_t transport_header_size_ = 0;
};

/** Fresh UDP/IP packet built without inheriting classified-NBL metadata. */
class copied_udp_ip_packet {
public:
  copied_udp_ip_packet(const copied_udp_ip_packet &) = delete;
