/**
 * @brief Stream injector paired with cloned_stream_data ownership.
 */
class stream_injector {
public:
  stream_injector(const stream_injector &) = delete;
  stream_injector &operator=(const stream_injector &) = delete;
  stream_injector(stream_injector &&other) noexcept
      : owner_(std::move(other.owner_)),
        generic_object_(std::exchange(other.generic_object_, nullptr)),
        nbl_pool_(std::exchange(other.nbl_pool_, nullptr)) {}

  stream_injector &operator=(stream_injector &&other) noexcept {
    if (this != &other) {
      reset();
      owner_ = std::move(other.owner_);
      generic_object_ =
          std::exchange(other.generic_object_, nullptr);
      nbl_pool_ = std::exchange(other.nbl_pool_, nullptr);
    }
    return *this;
  }

  ~stream_injector() { reset(); }

  static ntl::result<stream_injector>
  try_create(ADDRESS_FAMILY family = AF_UNSPEC,
             injection_limits limits = {}) noexcept {
    auto owner = detail::injection_owner::try_create(
        family, FWPS_INJECTION_TYPE_STREAM, limits);
    if (!owner)
      return ntl::unexpected(owner.status());
    return ntl::ok(stream_injector(std::move(*owner)));
  }

  /**
   * @brief Creates a stream injector that can also allocate replacement data.
   */
  static ntl::result<stream_injector>
  try_create(PDRIVER_OBJECT driver,
             ADDRESS_FAMILY family = AF_UNSPEC,
             injection_limits limits = {}) noexcept {
    if (!driver)
      return ntl::unexpected(STATUS_INVALID_PARAMETER);

    auto owner = detail::injection_owner::try_create(
        family, FWPS_INJECTION_TYPE_STREAM, limits);
    if (!owner)
      return ntl::unexpected(owner.status());

    PNDIS_GENERIC_OBJECT generic =
        NdisAllocateGenericObject(driver, 'gSwN', 0);
    if (!generic)
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);

    NET_BUFFER_LIST_POOL_PARAMETERS parameters{};
    parameters.Header.Type = NDIS_OBJECT_TYPE_DEFAULT;
    parameters.Header.Revision =
        NET_BUFFER_LIST_POOL_PARAMETERS_REVISION_1;
    parameters.Header.Size =
        NDIS_SIZEOF_NET_BUFFER_LIST_POOL_PARAMETERS_REVISION_1;
    parameters.fAllocateNetBuffer = TRUE;
    parameters.PoolTag = 'pSwN';

    NDIS_HANDLE pool =
        NdisAllocateNetBufferListPool(generic, &parameters);
    if (!pool) {
      NdisFreeGenericObject(generic);
      return ntl::unexpected(STATUS_INSUFFICIENT_RESOURCES);
    }

    return ntl::ok(
        stream_injector(std::move(*owner), generic, pool));
  }

  ntl::result<injected_stream_data>
  try_make_data(const void *data, std::size_t length,
                std::uint32_t stream_flags) const noexcept {
    return injected_stream_data::try_create(
        nbl_pool_, data, length, stream_flags);
  }

  template <class Layer>
  ntl::status inject(stream_injection_site<Layer> site,
                     cloned_stream_data &&data,
                     UINT32 flags = 0) noexcept {
    static_assert(detail::stream_layer<Layer>,
                  "stream injection requires a stream layer");
    if (!site || !data)
      return STATUS_INVALID_PARAMETER;

    LONG list_count = 0;
    for (NET_BUFFER_LIST *packet = data.chain_; packet;
         packet = NET_BUFFER_LIST_NEXT_NBL(packet)) {
      if (list_count == MAXLONG)
        return STATUS_INTEGER_OVERFLOW;
      ++list_count;
    }

    auto prepared = owner_.prepare_stream_clone(list_count);
    if (!prepared)
      return prepared.status();
    auto *context = *prepared;

    NET_BUFFER_LIST *const chain =
        std::exchange(data.chain_, nullptr);
    const std::size_t length =
        std::exchange(data.length_, 0);
    const std::uint32_t stream_flags =
        std::exchange(data.stream_flags_, 0);
    const ULONG clone_flags =
        std::exchange(data.clone_flags_, 0);
    const NTSTATUS result = FwpsStreamInjectAsync0(
        owner_.borrowed_native_handle(), nullptr, flags, site.flow_id_,
        site.callout_id_, Layer::runtime_id, stream_flags,
        chain, length, &detail::stream_clone_injection_complete,
        context);
    if (!NT_SUCCESS(result)) {
      const BOOLEAN dispatch_level =
          KeGetCurrentIrql() == DISPATCH_LEVEL ? TRUE : FALSE;
      FwpsDiscardClonedStreamData0(
          chain, clone_flags, dispatch_level);
      delete context;
    }
    return result;
  }

  template <class Layer>
  ntl::status inject(stream_injection_site<Layer> site,
                     injected_stream_data &&data,
                     UINT32 flags = 0) noexcept {
    static_assert(detail::stream_layer<Layer>,
                  "stream injection requires a stream layer");
    if (!site)
      return STATUS_INVALID_PARAMETER;

    auto prepared = owner_.prepare(std::move(data));
    if (!prepared)
      return prepared.status();
    auto *context = *prepared;
    return detail::finish_injection(
        FwpsStreamInjectAsync0(
            owner_.borrowed_native_handle(), nullptr, flags, site.flow_id_,
            site.callout_id_, Layer::runtime_id,
            context->as<injected_stream_data>().stream_flags_,
            context->as<injected_stream_data>().chain_,
            context->as<injected_stream_data>().length_,
            &detail::injection_complete, context),
        context);
  }

  void reset() noexcept {
    owner_.reset();
    if (nbl_pool_) {
      NdisFreeNetBufferListPool(nbl_pool_);
      nbl_pool_ = nullptr;
    }
    if (generic_object_) {
      NdisFreeGenericObject(generic_object_);
      generic_object_ = nullptr;
    }
  }

private:
  explicit stream_injector(detail::injection_owner &&owner) noexcept
      : owner_(std::move(owner)) {}

  stream_injector(detail::injection_owner &&owner,
                  PNDIS_GENERIC_OBJECT generic,
                  NDIS_HANDLE pool) noexcept
      : owner_(std::move(owner)), generic_object_(generic),
        nbl_pool_(pool) {}

  detail::injection_owner owner_;
  PNDIS_GENERIC_OBJECT generic_object_ = nullptr;
  NDIS_HANDLE nbl_pool_ = nullptr;
};

