  template <class Layer>
  void add_enforcement_filter(
      const sublayer_ref &sublayer,
      enforcement_filter_builder<Layer> &builder) {
    static_assert(
        detail::filterable_layer<Layer>,
        "add_enforcement_filter() requires a filterable WFP layer");
    require_current(sublayer.transaction_);

    GUID provider_key = sublayer.provider_.native();
    FWP_VALUE0 weight{};
    weight.type = FWP_UINT8;
    weight.uint8 = builder.weight_;

    FWPM_FILTER0 filter{};
    filter.filterKey = builder.key_.native();
    filter.providerKey = &provider_key;
    filter.displayData.name =
        const_cast<wchar_t *>(builder.name_.c_str());
    filter.displayData.description =
        const_cast<wchar_t *>(builder.description_.c_str());
    filter.layerKey = Layer::policy_key();
    filter.subLayerKey = sublayer.key_.native();
    filter.weight = weight;
    auto &conditions = builder.native_conditions();
    filter.numFilterConditions =
        static_cast<UINT32>(conditions.size());
    filter.filterCondition = conditions.data();
    filter.action.type =
        builder.action_ == enforcement_action::permit
            ? FWP_ACTION_PERMIT
            : FWP_ACTION_BLOCK;
    if (scope_ == policy_scope::persistent)
      filter.flags |= FWPM_FILTER_FLAG_PERSISTENT;
    check(FwpmFilterAdd0(
              engine_, &filter, nullptr, nullptr),
          "FwpmFilterAdd0(enforcement)");
    filters_.push_back(builder.key_.native());
  }

  template <class Layer>
  void add_boot_time_block_filter(
      const sublayer_ref &sublayer,
      boot_time_block_filter_builder<Layer> &builder) {
    static_assert(
        detail::callout_layer<Layer>,
        "add_boot_time_block_filter() requires a kernel WFP layer");
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "boot-time WFP filters require a persistent policy session");
    require_current(sublayer.transaction_);

    GUID provider_key = sublayer.provider_.native();
    FWP_VALUE0 weight{};
    weight.type = FWP_UINT8;
    weight.uint8 = builder.weight_;

    FWPM_FILTER0 filter{};
    filter.filterKey = builder.key_.native();
    filter.providerKey = &provider_key;
    filter.displayData.name =
        const_cast<wchar_t *>(builder.name_.c_str());
    filter.displayData.description =
        const_cast<wchar_t *>(
            builder.description_.c_str());
    filter.layerKey = Layer::policy_key();
    filter.subLayerKey = sublayer.key_.native();
    filter.weight = weight;
    auto &conditions = builder.native_conditions();
    filter.numFilterConditions =
        static_cast<UINT32>(conditions.size());
    filter.filterCondition = conditions.data();
    filter.action.type = FWP_ACTION_BLOCK;
    filter.flags = FWPM_FILTER_FLAG_BOOTTIME;
    check(FwpmFilterAdd0(
              engine_, &filter, nullptr, nullptr),
          "FwpmFilterAdd0(boot-time block)");
    filters_.push_back(builder.key_.native());
  }

private:
  template <class Layer, class Builder>
  void add_callout_filter(const sublayer_ref &sublayer,
                          const callout_ref<Layer> &callout,
                          Builder &builder, FWP_ACTION_TYPE action,
                          UINT32 flags,
                          std::optional<callout_unavailable>
                              unavailable) {
    require_current(sublayer.transaction_);
    require_current(callout.transaction_);
    if (!IsEqualGUID(sublayer.provider_.native(),
                     callout.provider_.native()))
      throw std::logic_error(
          "WFP sublayer and callout belong to different providers");

    GUID provider_key = sublayer.provider_.native();
    FWP_VALUE0 weight{};
    weight.type = FWP_UINT8;
    weight.uint8 = builder.weight_;

    FWPM_FILTER0 filter{};
    filter.filterKey = builder.key_.native();
    filter.providerKey = &provider_key;
    filter.displayData.name =
        const_cast<wchar_t *>(builder.name_.c_str());
    filter.displayData.description =
        const_cast<wchar_t *>(builder.description_.c_str());
    filter.layerKey = Layer::policy_key();
    filter.subLayerKey = sublayer.key_.native();
    filter.weight = weight;
    auto &conditions = builder.native_conditions();
    filter.numFilterConditions =
        static_cast<UINT32>(conditions.size());
    filter.filterCondition = conditions.data();
    filter.action.type = action;
    filter.action.calloutKey = callout.key_.native();
    filter.rawContext = builder.context_;
    filter.flags = flags;
    if (unavailable == callout_unavailable::permit)
      filter.flags |=
          FWPM_FILTER_FLAG_PERMIT_IF_CALLOUT_UNREGISTERED;
    if (scope_ == policy_scope::persistent)
      filter.flags |= FWPM_FILTER_FLAG_PERSISTENT;
    check(FwpmFilterAdd0(engine_, &filter, nullptr, nullptr),
          "FwpmFilterAdd0");
    filters_.push_back(builder.key_.native());
  }

  friend class policy_session;
  policy_transaction(HANDLE engine, std::uint64_t transaction,
                     policy_scope scope,
                     std::optional<std::uint64_t> revision) noexcept
      : engine_(engine), transaction_(transaction),
        scope_(scope), revision_(revision) {}

  static void check(DWORD result, const char *operation) {
    if (result != ERROR_SUCCESS)
      throw management_error(result, operation);
  }

  void require_current(std::uint64_t transaction) const {
    if (transaction != transaction_)
      throw std::logic_error(
          "WFP policy reference belongs to another transaction");
  }

  static bool same_keys(const std::vector<GUID> &left,
                        const std::vector<GUID> &right) noexcept {
    if (left.size() != right.size())
      return false;
    return std::all_of(left.begin(), left.end(), [&](const GUID &key) {
      return std::any_of(right.begin(), right.end(), [&](const GUID &value) {
        return ::IsEqualGUID(key, value);
      });
    });
  }

  bool matches(const policy_manifest &manifest) const noexcept {
    return same_keys(providers_, manifest.providers_) &&
           same_keys(sublayers_, manifest.sublayers_) &&
           same_keys(callouts_, manifest.callouts_) &&
           same_keys(filters_, manifest.filters_);
  }

  HANDLE engine_ = nullptr;
  std::uint64_t transaction_ = 0;
  policy_scope scope_ = policy_scope::ephemeral;
  std::optional<std::uint64_t> revision_;
  std::vector<GUID> providers_;
  std::vector<GUID> sublayers_;
  std::vector<GUID> callouts_;
  std::vector<GUID> filters_;
};

/**
 * @brief Move-only WFP engine session with explicit policy lifetime.
 *
 * Session-scoped objects disappear with the controller. Persistent objects
 * are replaced or removed through a typed `policy_manifest`; there is no raw
 * delete-by-GUID escape hatch in application code.
 */
class policy_session {
public:
  static policy_session ephemeral(
      std::wstring name = L"ntl::wfp session policy") {
    return policy_session(std::move(name), policy_scope::ephemeral);
  }

  static policy_session persistent(
      std::wstring name = L"ntl::wfp persistent policy") {
    return policy_session(std::move(name), policy_scope::persistent);
  }

  policy_session(const policy_session &) = delete;
  policy_session &operator=(const policy_session &) = delete;

  policy_session(policy_session &&other) noexcept
      : engine_(std::exchange(other.engine_, nullptr)),
        name_(std::move(other.name_)), scope_(other.scope_) {}

  policy_session &operator=(policy_session &&other) noexcept {
    if (this != &other) {
      close();
      engine_ = std::exchange(other.engine_, nullptr);
      name_ = std::move(other.name_);
      scope_ = other.scope_;
    }
    return *this;
  }

  ~policy_session() { close(); }

  policy_scope scope() const noexcept { return scope_; }

  /**
   * @brief Reopens the BFE engine after a service restart.
   *
   * Persistent callers should follow this with reconcile(). Session-scoped
   * callers should reinstall because BFE discarded the ephemeral graph.
   */
  void reconnect() {
    HANDLE replacement = open(name_, scope_);
    close();
    engine_ = replacement;
  }

  template <class Function> void install(Function &&function) {
    if (scope_ != policy_scope::ephemeral)
      throw std::logic_error(
          "persistent WFP policy requires reconcile(revision, writer)");
    transact(
        nullptr, nullptr, std::nullopt,
        std::forward<Function>(function));
  }

  /**
   * @brief Atomically removes a known graph and installs its replacement.
   */
  template <class Function>
  void reconcile(
      const policy_revision &revision, Function &&function) {
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "WFP reconcile is available only for persistent policy");
    transact(
        &revision.manifest_, nullptr, revision.version_,
        std::forward<Function>(function));
  }

  /**
   * @brief Atomically migrates a healthy persistent graph to a newer revision.
   */
  template <class Function>
  void migrate(
      const policy_revision &current,
      const policy_revision &next,
      Function &&function) {
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "WFP migration is available only for persistent policy");
    if (next.version_ <= current.version_)
      throw std::invalid_argument(
          "WFP migration revision must increase");
    if (!health(current).healthy())
      throw std::logic_error(
          "WFP migration source revision is not healthy");
    transact(
        &current.manifest_, &next.manifest_,
        next.version_, std::forward<Function>(function));
  }

  /**
   * @brief Atomically restores an older, explicitly supplied policy writer.
   */
  template <class Function>
  void rollback(
      const policy_revision &current,
      const policy_revision &previous,
      Function &&function) {
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "WFP rollback is available only for persistent policy");
    if (previous.version_ >= current.version_)
      throw std::invalid_argument(
          "WFP rollback revision must decrease");
    if (!health(current).healthy())
      throw std::logic_error(
          "WFP rollback source revision is not healthy");
    transact(
        &current.manifest_, &previous.manifest_,
        previous.version_,
        std::forward<Function>(function));
  }

  /**
   * @brief Reopens BFE and restores the expected graph only when unhealthy.
   *
   * Call this after BFE/service restart notification. Returns true when a
   * transaction was needed.
   */
  template <class Function>
  bool recover(
      const policy_revision &expected, Function &&function) {
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "WFP recovery is available only for persistent policy");
    reconnect();
    if (health(expected).healthy())
      return false;
    reconcile(expected, std::forward<Function>(function));
    return true;
  }

  /** @brief Atomically removes every object named by the manifest. */
  void uninstall(const policy_revision &revision) {
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "WFP manifest uninstall is available only for persistent policy");
    const auto &manifest = revision.manifest_;
    if (manifest.empty())
      return;
    check(FwpmTransactionBegin0(engine_, 0), "FwpmTransactionBegin0");
    try {
      remove_manifest(manifest);
      check(FwpmTransactionCommit0(engine_), "FwpmTransactionCommit0");
    } catch (...) {
      (void)FwpmTransactionAbort0(engine_);
      throw;
    }
  }

  /** @brief Checks that every object in a manifest is visible through BFE. */
  policy_health_report health(
      const policy_revision &revision) const {
    if (scope_ != policy_scope::persistent)
      throw std::logic_error(
          "WFP manifest health is available only for persistent policy");
    policy_health_report report;
    report.scope = scope_;
    report.expected_revision = revision.version_;
    const auto &manifest = revision.manifest_;
    report.expected_objects =
        manifest.providers_.size() + manifest.sublayers_.size() +
        manifest.callouts_.size() + manifest.filters_.size();

    for (const auto &key : manifest.providers_) {
      if (!provider_present(key)) {
        report.missing.push_back(
            {policy_object_kind::provider, key});
        continue;
      }
      const auto observed = provider_revision(key);
      if (!observed || *observed != revision.version_)
        report.revision_mismatches.push_back(key);
    }
    for (const auto &key : manifest.sublayers_)
      if (!sublayer_present(key))
        report.missing.push_back(
            {policy_object_kind::sublayer, key});
    for (const auto &key : manifest.callouts_)
      if (!callout_present(key))
        report.missing.push_back(
            {policy_object_kind::callout, key});
    for (const auto &key : manifest.filters_)
      if (!filter_present(key))
        report.missing.push_back(
            {policy_object_kind::filter, key});
    return report;
  }

private:
  policy_session(std::wstring name, policy_scope scope)
      : name_(std::move(name)), scope_(scope) {
    engine_ = open(name_, scope_);
  }

  static HANDLE open(const std::wstring &name, policy_scope scope) {
    FWPM_SESSION0 session{};
    session.displayData.name = const_cast<wchar_t *>(name.c_str());
    if (scope == policy_scope::ephemeral)
      session.flags = FWPM_SESSION_FLAG_DYNAMIC;
    HANDLE engine = nullptr;
    const DWORD result =
        FwpmEngineOpen0(nullptr, RPC_C_AUTHN_WINNT, nullptr, &session,
                        &engine);
    if (result != ERROR_SUCCESS)
      throw management_error(result, "FwpmEngineOpen0");
    return engine;
  }

  template <class Function>
  void transact(
      const policy_manifest *first_replacement,
      const policy_manifest *second_replacement,
      std::optional<std::uint64_t> revision,
      Function &&function) {
    static_assert(
        std::is_invocable_v<Function, policy_transaction &>,
        "policy callback must accept ntl::wfp::policy_transaction&");
    check(FwpmTransactionBegin0(engine_, 0), "FwpmTransactionBegin0");

    policy_transaction transaction(
        engine_, next_transaction(), scope_, revision);
    try {
      if (first_replacement)
        remove_manifest(*first_replacement);
      if (second_replacement)
        remove_manifest(*second_replacement);
      std::invoke(std::forward<Function>(function), transaction);
      const auto *const expected =
          second_replacement
              ? second_replacement
              : first_replacement;
      if (expected && !transaction.matches(*expected))
        throw std::logic_error(
            "persistent WFP writer output does not match its manifest");
      check(FwpmTransactionCommit0(engine_), "FwpmTransactionCommit0");
    } catch (...) {
      (void)FwpmTransactionAbort0(engine_);
      throw;
    }
  }

public:
  /**
   * @brief Returns the installed schema for a compile-time WFP layer.
   *
   * An empty result is a real capability result: the selected Windows build
   * does not expose that layer. It must not be reported as runtime coverage.
   */
  template <class Layer>
  std::optional<policy_layer_diagnostic> inspect_layer() const {
    static_assert(detail::known_layer<Layer>,
                  "inspect_layer() requires a known WFP layer");
    FWPM_LAYER0 *native = nullptr;
    const GUID key = Layer::policy_key();
    const DWORD result =
        FwpmLayerGetByKey0(engine_, &key, &native);
    native_owner<FWPM_LAYER0> owned(native);
    if (result == static_cast<DWORD>(FWP_E_LAYER_NOT_FOUND))
      return std::nullopt;
    check(result, "FwpmLayerGetByKey0");
    if (!native)
      return std::nullopt;
    return policy_layer_diagnostic{
        native->layerKey, native->defaultSubLayerKey,
        native->flags, native->numFields, native->layerId};
  }

  template <class Layer>
  bool layer_present() const {
    return inspect_layer<Layer>().has_value();
  }

  /**
   * @brief Tests whether this engine can resolve a provider by key.
   */
  bool provider_present(provider_key key) const {
    FWPM_PROVIDER0 *native = nullptr;
    const DWORD result =
        FwpmProviderGetByKey0(engine_, &key.native(), &native);
    native_owner<FWPM_PROVIDER0> owned(native);
    if (result == static_cast<DWORD>(FWP_E_PROVIDER_NOT_FOUND))
      return false;
    check(result, "FwpmProviderGetByKey0");
    return native != nullptr;
  }

  /**
   * @brief Tests whether this engine can resolve a sublayer by key.
   */
  bool sublayer_present(sublayer_key key) const {
    FWPM_SUBLAYER0 *native = nullptr;
    const DWORD result =
        FwpmSubLayerGetByKey0(engine_, &key.native(), &native);
    native_owner<FWPM_SUBLAYER0> owned(native);
    if (result == static_cast<DWORD>(FWP_E_SUBLAYER_NOT_FOUND))
      return false;
    check(result, "FwpmSubLayerGetByKey0");
    return native != nullptr;
  }

  /**
   * @brief Tests whether a typed callout exists on its declared layer.
   */
  template <class Layer>
  bool callout_present(callout_key<Layer> key) const {
    FWPM_CALLOUT0 *native = nullptr;
    const DWORD result =
        FwpmCalloutGetByKey0(engine_, &key.native(), &native);
    native_owner<FWPM_CALLOUT0> owned(native);
    if (result == static_cast<DWORD>(FWP_E_CALLOUT_NOT_FOUND))
      return false;
    check(result, "FwpmCalloutGetByKey0");
    return native &&
           ::IsEqualGUID(native->applicableLayer,
                         Layer::policy_key());
  }

  /**
   * @brief Returns a pointer-free snapshot of one typed filter.
   */
  template <class Layer>
  std::optional<policy_filter_diagnostic>
  inspect_filter(filter_key<Layer> key) const {
    FWPM_FILTER0 *native = nullptr;
    const DWORD result =
        FwpmFilterGetByKey0(engine_, &key.native(), &native);
    native_owner<FWPM_FILTER0> owned(native);
    if (result == static_cast<DWORD>(FWP_E_FILTER_NOT_FOUND))
      return std::nullopt;
    check(result, "FwpmFilterGetByKey0");
    if (!native ||
        !::IsEqualGUID(native->layerKey, Layer::policy_key()))
      return std::nullopt;
    return snapshot_filter(*native);
  }

  /**
   * @brief Enumerates a bounded, pointer-free inventory for one WFP layer.
   *
   * At most maximum_filters snapshots are returned. The method probes for
   * one additional result and sets truncated when the layer contains more.
   */
  template <class Layer>
  policy_filter_inventory
  enumerate_filters(std::size_t maximum_filters = 256) const {
    if (maximum_filters == 0 ||
        maximum_filters >
            (std::numeric_limits<UINT32>::max)())
      throw std::invalid_argument(
          "WFP filter inventory bound is invalid");

    FWPM_FILTER_ENUM_TEMPLATE0 query{};
    query.layerKey = Layer::policy_key();
    query.enumType = FWP_FILTER_ENUM_FULLY_CONTAINED;
    query.actionMask = 0xFFFFFFFFu;

    HANDLE enum_handle = nullptr;
    check(FwpmFilterCreateEnumHandle0(
              engine_, &query, &enum_handle),
          "FwpmFilterCreateEnumHandle0");
    struct enum_handle_guard {
      HANDLE engine;
      HANDLE value;
      ~enum_handle_guard() {
        if (value)
          (void)FwpmFilterDestroyEnumHandle0(engine, value);
      }
    } enum_guard{engine_, enum_handle};

    policy_filter_inventory inventory;
    inventory.filters.reserve(maximum_filters);
    while (inventory.filters.size() < maximum_filters) {
      const auto remaining =
          maximum_filters - inventory.filters.size();
      const UINT32 requested = static_cast<UINT32>(
          (std::min<std::size_t>)(remaining, 64));
      FWPM_FILTER0 **entries = nullptr;
      UINT32 returned = 0;
      check(FwpmFilterEnum0(
                engine_, enum_handle, requested, &entries, &returned),
            "FwpmFilterEnum0");
      native_owner<FWPM_FILTER0 *> owned(entries);
      if (returned == 0)
        return inventory;
      for (UINT32 index = 0; index != returned; ++index) {
        if (entries[index])
          inventory.filters.push_back(
              snapshot_filter(*entries[index]));
      }
    }

    FWPM_FILTER0 **probe = nullptr;
    UINT32 probe_count = 0;
    check(FwpmFilterEnum0(
              engine_, enum_handle, 1, &probe, &probe_count),
          "FwpmFilterEnum0");
    native_owner<FWPM_FILTER0 *> owned_probe(probe);
    inventory.truncated = probe_count != 0;
    return inventory;
  }

private:
  struct native_memory_deleter {
    template <class Value>
    void operator()(Value *value) const noexcept {
      if (!value)
        return;
      void *memory = value;
      ::FwpmFreeMemory0(&memory);
    }
  };

  template <class Value>
  using native_owner =
      std::unique_ptr<Value, native_memory_deleter>;

  static std::uint64_t hash_bytes(
      const std::uint8_t *data, std::size_t size) noexcept {
    std::uint64_t value = 14695981039346656037ull;
    for (std::size_t index = 0; index != size; ++index) {
      value ^= data[index];
      value *= 1099511628211ull;
    }
    return value;
  }

  static std::uint64_t scalar_value(
      const FWP_VALUE0 &value) noexcept {
    switch (value.type) {
    case FWP_UINT8:
      return value.uint8;
    case FWP_UINT16:
      return value.uint16;
    case FWP_UINT32:
      return value.uint32;
    case FWP_UINT64:
      return value.uint64 ? *value.uint64 : 0;
    case FWP_INT8:
      return static_cast<std::uint64_t>(value.int8);
    case FWP_INT16:
      return static_cast<std::uint64_t>(value.int16);
    case FWP_INT32:
      return static_cast<std::uint64_t>(value.int32);
    case FWP_INT64:
      return value.int64
                 ? static_cast<std::uint64_t>(*value.int64)
                 : 0;
    default:
      return 0;
    }
  }

  static std::uint64_t scalar_value(
      const FWP_CONDITION_VALUE0 &value) noexcept {
    switch (value.type) {
    case FWP_UINT8:
      return value.uint8;
    case FWP_UINT16:
      return value.uint16;
    case FWP_UINT32:
      return value.uint32;
    case FWP_UINT64:
      return value.uint64 ? *value.uint64 : 0;
    case FWP_INT8:
      return static_cast<std::uint64_t>(value.int8);
    case FWP_INT16:
      return static_cast<std::uint64_t>(value.int16);
    case FWP_INT32:
      return static_cast<std::uint64_t>(value.int32);
    case FWP_INT64:
      return value.int64
                 ? static_cast<std::uint64_t>(*value.int64)
                 : 0;
    default:
      return 0;
    }
  }

  static policy_condition_diagnostic snapshot_condition(
      const FWPM_FILTER_CONDITION0 &native) noexcept {
    policy_condition_diagnostic result{};
    result.field_key = native.fieldKey;
    result.match_type = native.matchType;
    result.value_type = native.conditionValue.type;
    result.scalar_value = scalar_value(native.conditionValue);
    if (native.conditionValue.type == FWP_BYTE_BLOB_TYPE &&
        native.conditionValue.byteBlob) {
      const auto &blob = *native.conditionValue.byteBlob;
      result.blob_size = blob.size;
      if (blob.data)
        result.blob_hash = hash_bytes(blob.data, blob.size);
    }
    return result;
  }

  policy_filter_diagnostic snapshot_filter(
      const FWPM_FILTER0 &native) const {
    policy_filter_diagnostic result{};
    result.filter_key = native.filterKey;
    if (native.providerKey) {
      result.provider_key = *native.providerKey;
      result.has_provider = true;
    }
    result.layer_key = native.layerKey;
    result.sublayer_key = native.subLayerKey;
    result.filter_id = native.filterId;
    result.flags = native.flags;
    result.action_type = native.action.type;
    if ((native.action.type & FWP_ACTION_FLAG_CALLOUT) != 0)
      result.action_callout_key = native.action.calloutKey;
    if ((native.flags & FWPM_FILTER_FLAG_HAS_PROVIDER_CONTEXT) == 0)
      result.raw_context = native.rawContext;
    result.weight_type = native.weight.type;
    result.weight_value = scalar_value(native.weight);
    result.effective_weight_type = native.effectiveWeight.type;
    result.effective_weight_value =
        scalar_value(native.effectiveWeight);

    FWPM_SUBLAYER0 *sublayer = nullptr;
    const DWORD sublayer_result = FwpmSubLayerGetByKey0(
        engine_, &native.subLayerKey, &sublayer);
    native_owner<FWPM_SUBLAYER0> owned_sublayer(sublayer);
    if (sublayer_result == ERROR_SUCCESS && sublayer)
      result.sublayer_weight = sublayer->weight;
    else if (sublayer_result !=
             static_cast<DWORD>(FWP_E_SUBLAYER_NOT_FOUND))
      check(sublayer_result, "FwpmSubLayerGetByKey0");

    constexpr std::size_t maximum_conditions = 64;
    const std::size_t condition_count =
        (std::min<std::size_t>)(
            native.numFilterConditions, maximum_conditions);
    result.conditions.reserve(condition_count);
    for (std::size_t index = 0;
         index != condition_count; ++index)
      result.conditions.push_back(
          snapshot_condition(native.filterCondition[index]));
    result.conditions_truncated =
        native.numFilterConditions > maximum_conditions;
    return result;
  }

  bool provider_present(const GUID &key) const {
    FWPM_PROVIDER0 *native = nullptr;
    const DWORD result =
        FwpmProviderGetByKey0(engine_, &key, &native);
    native_owner<FWPM_PROVIDER0> owned(native);
    if (result == static_cast<DWORD>(FWP_E_PROVIDER_NOT_FOUND))
      return false;
    check(result, "FwpmProviderGetByKey0");
    return native != nullptr;
  }

  std::optional<std::uint64_t>
  provider_revision(const GUID &key) const {
    FWPM_PROVIDER0 *native = nullptr;
    const DWORD result =
        FwpmProviderGetByKey0(engine_, &key, &native);
    native_owner<FWPM_PROVIDER0> owned(native);
    if (result ==
        static_cast<DWORD>(FWP_E_PROVIDER_NOT_FOUND))
      return std::nullopt;
    check(result, "FwpmProviderGetByKey0");
    if (!native)
      return std::nullopt;
    return detail::decode_policy_revision(
        native->providerData);
  }

