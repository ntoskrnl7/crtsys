class management_error : public std::system_error {
public:
  management_error(DWORD code, const char *operation)
      : std::system_error(static_cast<int>(code), std::system_category(),
                          operation) {}
};

/**
 * @brief Pointer-free snapshot of one native WFP filter condition.
 *
 * Scalar values are copied into scalar_value. Byte blobs are represented by
 * their size and FNV-1a hash so diagnostics can compare application
 * identities without retaining or logging executable paths.
 */
struct policy_condition_diagnostic {
  GUID field_key{};
  FWP_MATCH_TYPE match_type = FWP_MATCH_EQUAL;
  FWP_DATA_TYPE value_type = FWP_EMPTY;
  std::uint64_t scalar_value = 0;
  std::uint32_t blob_size = 0;
  std::uint64_t blob_hash = 0;
};

/**
 * @brief Pointer-free snapshot of a WFP filter and its effective placement.
 */
struct policy_filter_diagnostic {
  GUID filter_key{};
  GUID provider_key{};
  bool has_provider = false;
  GUID layer_key{};
  GUID sublayer_key{};
  GUID action_callout_key{};
  std::uint64_t filter_id = 0;
  std::uint64_t raw_context = 0;
  FWP_ACTION_TYPE action_type = FWP_ACTION_NONE;
  std::uint32_t flags = 0;
  FWP_DATA_TYPE weight_type = FWP_EMPTY;
  std::uint64_t weight_value = 0;
  FWP_DATA_TYPE effective_weight_type = FWP_EMPTY;
  std::uint64_t effective_weight_value = 0;
  std::uint16_t sublayer_weight = 0;
  std::vector<policy_condition_diagnostic> conditions;
  bool conditions_truncated = false;

  const policy_condition_diagnostic *
  find_condition(const GUID &field) const noexcept {
    for (const auto &condition : conditions)
      if (::IsEqualGUID(condition.field_key, field))
        return &condition;
    return nullptr;
  }
};

/**
 * @brief Bounded filter inventory for one WFP layer.
 */
struct policy_filter_inventory {
  std::vector<policy_filter_diagnostic> filters;
  bool truncated = false;
};

/**
 * @brief Owning WFP application identifier derived from an executable path.
 */
class application_id {
public:
  static application_id from_path(std::wstring_view path) {
    if (path.empty())
      throw std::invalid_argument(
          "WFP application path cannot be empty");
    const std::wstring owned(path);
    FWP_BYTE_BLOB *native = nullptr;
    const DWORD status =
        ::FwpmGetAppIdFromFileName0(owned.c_str(), &native);
    if (status != ERROR_SUCCESS)
      throw management_error(
          status, "FwpmGetAppIdFromFileName0");
    struct native_release {
      FWP_BYTE_BLOB *value;
      ~native_release() {
        if (value)
          ::FwpmFreeMemory0(
              reinterpret_cast<void **>(&value));
      }
    } release{native};
    if (!native || native->size == 0 || !native->data)
      throw std::runtime_error(
          "WFP returned an empty application identifier");
    return application_id(std::vector<std::uint8_t>(
        native->data, native->data + native->size));
  }

  static application_id current_process() {
    std::vector<wchar_t> path(32768);
    const DWORD length = ::GetModuleFileNameW(
        nullptr, path.data(), static_cast<DWORD>(path.size()));
    if (length == 0)
      throw management_error(
          ::GetLastError(), "GetModuleFileNameW");
    if (length >= path.size())
      throw std::system_error(
          ERROR_BUFFER_OVERFLOW, std::system_category(),
          "current executable path exceeds the Windows limit");
    return from_path(
        std::wstring_view(path.data(), length));
  }

  std::span<const std::uint8_t> bytes() const noexcept {
    return bytes_;
  }

private:
  explicit application_id(std::vector<std::uint8_t> bytes)
      : bytes_(std::move(bytes)) {}

  std::vector<std::uint8_t> bytes_;
};

