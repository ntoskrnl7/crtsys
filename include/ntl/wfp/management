      : key_(key), name_(std::move(name)),
        context_(target.filter_context()),
        unavailable_(unavailable) {
    static_assert(detail::connect_redirect_layer<Layer>,
                  "connect_redirect_filter_builder requires an "
                  "ALE_CONNECT_REDIRECT layer");
