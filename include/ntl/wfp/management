  void remove_manifest(const policy_manifest &manifest) {
    for (auto iterator = manifest.filters_.rbegin();
         iterator != manifest.filters_.rend(); ++iterator)
      ignore_missing(
          FwpmFilterDeleteByKey0(engine_, &*iterator),
          static_cast<DWORD>(FWP_E_FILTER_NOT_FOUND),
          "FwpmFilterDeleteByKey0");

    for (auto iterator = manifest.callouts_.rbegin();
         iterator != manifest.callouts_.rend(); ++iterator)
      ignore_missing(
          FwpmCalloutDeleteByKey0(engine_, &*iterator),
          static_cast<DWORD>(FWP_E_CALLOUT_NOT_FOUND),
          "FwpmCalloutDeleteByKey0");

    for (auto iterator = manifest.sublayers_.rbegin();
         iterator != manifest.sublayers_.rend(); ++iterator)
      ignore_missing(
          FwpmSubLayerDeleteByKey0(engine_, &*iterator),
          static_cast<DWORD>(FWP_E_SUBLAYER_NOT_FOUND),
          "FwpmSubLayerDeleteByKey0");

    for (auto iterator = manifest.providers_.rbegin();
         iterator != manifest.providers_.rend(); ++iterator)
      ignore_missing(
          FwpmProviderDeleteByKey0(engine_, &*iterator),
          static_cast<DWORD>(FWP_E_PROVIDER_NOT_FOUND),
          "FwpmProviderDeleteByKey0");
  }

  static void ignore_missing(DWORD result, DWORD missing,
                             const char *operation) {
    if (result != ERROR_SUCCESS && result != missing)
      throw management_error(result, operation);
  }

  static void check(DWORD result, const char *operation) {
    if (result != ERROR_SUCCESS)
      throw management_error(result, operation);
  }

  void close() noexcept {
    if (engine_) {
      (void)FwpmEngineClose0(engine_);
      engine_ = nullptr;
    }
  }

  static std::uint64_t next_transaction() noexcept {
    static std::atomic<std::uint64_t> value{1};
    return value.fetch_add(1, std::memory_order_relaxed);
  }

  HANDLE engine_ = nullptr;
  std::wstring name_;
  policy_scope scope_ = policy_scope::ephemeral;
};

