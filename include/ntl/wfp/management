/** @brief Controls whether installed WFP objects follow the process lifetime. */
enum class policy_scope {
  /**
   * Objects are attached to a dynamic engine session and disappear if the
   * controller exits or loses its BFE connection.
   */
  ephemeral,

  /**
   * Objects survive controller and BFE restarts until an explicit manifest
   * uninstall or reconcile removes them.
   */
  persistent,
};

/**
 * @brief Explicit behavior while a terminating callout is not registered.
 */
enum class callout_unavailable {
  /** Treat the matching callout filter as block (WFP default). */
  block,
  /** Treat the matching callout filter as permit. */
  permit,
};

enum class enforcement_action {
  permit,
  block,
};

/**
 * @brief Typed inventory of one policy graph, used for atomic replacement.
 *
 * The manifest stores only object keys. `policy_session::reconcile()` removes
 * the old graph in dependency order and installs its replacement in the same
 * WFP transaction.
 */
class policy_manifest {
public:
  policy_manifest &include(provider_key key) {
    append_unique(providers_, key.native());
    return *this;
  }

  policy_manifest &include(sublayer_key key) {
    append_unique(sublayers_, key.native());
    return *this;
  }

  template <class Layer>
  policy_manifest &include(callout_key<Layer> key) {
    append_unique(callouts_, key.native());
    return *this;
  }

  template <class Layer>
  policy_manifest &include(filter_key<Layer> key) {
    append_unique(filters_, key.native());
    return *this;
  }

  bool empty() const noexcept {
    return providers_.empty() && sublayers_.empty() &&
           callouts_.empty() && filters_.empty();
  }

private:
  friend class policy_session;
  friend class policy_transaction;

  static void append_unique(std::vector<GUID> &values,
                            const GUID &value) {
    const auto duplicate = std::find_if(
        values.begin(), values.end(), [&](const GUID &existing) {
          return ::IsEqualGUID(existing, value);
        });
    if (duplicate == values.end())
      values.push_back(value);
  }

  std::vector<GUID> providers_;
  std::vector<GUID> sublayers_;
  std::vector<GUID> callouts_;
  std::vector<GUID> filters_;
};

/**
 * @brief Versioned persistent policy graph used for migration and rollback.
 */
class policy_revision {
public:
  policy_revision(
      std::uint64_t version, policy_manifest manifest)
      : version_(version), manifest_(std::move(manifest)) {
    if (version_ == 0)
      throw std::invalid_argument(
          "WFP policy revision must be nonzero");
    if (manifest_.empty())
      throw std::invalid_argument(
          "WFP policy revision manifest cannot be empty");
  }

  std::uint64_t version() const noexcept {
    return version_;
  }

  const policy_manifest &manifest() const noexcept {
    return manifest_;
  }

private:
  friend class policy_session;
  std::uint64_t version_ = 0;
  policy_manifest manifest_;
};

enum class policy_object_kind {
  provider,
  sublayer,
  callout,
  filter,
};

struct missing_policy_object {
  policy_object_kind kind = policy_object_kind::provider;
  GUID key{};
};

/** @brief Pointer-free health snapshot for one expected policy graph. */
struct policy_health_report {
  policy_scope scope = policy_scope::ephemeral;
  std::size_t expected_objects = 0;
  std::uint64_t expected_revision = 0;
  std::vector<missing_policy_object> missing;
  std::vector<GUID> revision_mismatches;

  bool healthy() const noexcept {
    return expected_objects != 0 && missing.empty() &&
           revision_mismatches.empty();
  }
};

namespace detail {

inline constexpr std::array<std::uint8_t, 8>
    policy_revision_magic{
        'N', 'T', 'L', 'W', 'F', 'P', 'R', 1};

inline std::array<std::uint8_t, 16>
encode_policy_revision(std::uint64_t revision) noexcept {
  std::array<std::uint8_t, 16> result{};
  std::copy(
      policy_revision_magic.begin(),
      policy_revision_magic.end(), result.begin());
  for (std::size_t index = 0; index != 8; ++index)
    result[8 + index] = static_cast<std::uint8_t>(
        revision >> (index * 8));
  return result;
}

inline std::optional<std::uint64_t>
decode_policy_revision(const FWP_BYTE_BLOB &blob) noexcept {
  if (blob.size != 16 || !blob.data ||
      !std::equal(
          policy_revision_magic.begin(),
          policy_revision_magic.end(), blob.data))
    return std::nullopt;
  std::uint64_t result = 0;
  for (std::size_t index = 0; index != 8; ++index)
    result |= static_cast<std::uint64_t>(
                  blob.data[8 + index])
              << (index * 8);
  return result == 0
             ? std::nullopt
             : std::optional<std::uint64_t>(result);
}

} // namespace detail

/**
 * @brief A terminating local-proxy filter for ALE connect redirection.
