/**
 * @brief Owning WFP application identifier derived from an executable path.
 */
class application_id {
public:
  static application_id from_path(std::wstring_view path) {
    if (path.empty())
      throw std::invalid_argument(
          "WFP application path cannot be empty");
    const std::wstring owned(path);
    FWP_BYTE_BLOB *native = nullptr;
    const DWORD status =
        ::FwpmGetAppIdFromFileName0(owned.c_str(), &native);
    if (status != ERROR_SUCCESS)
      throw management_error(
          status, "FwpmGetAppIdFromFileName0");
    struct native_release {
      FWP_BYTE_BLOB *value;
      ~native_release() {
        if (value)
          ::FwpmFreeMemory0(
              reinterpret_cast<void **>(&value));
      }
    } release{native};
    if (!native || native->size == 0 || !native->data)
      throw std::runtime_error(
          "WFP returned an empty application identifier");
    return application_id(std::vector<std::uint8_t>(
        native->data, native->data + native->size));
  }

  static application_id current_process() {
    std::vector<wchar_t> path(32768);
    const DWORD length = ::GetModuleFileNameW(
        nullptr, path.data(), static_cast<DWORD>(path.size()));
    if (length == 0)
      throw management_error(
          ::GetLastError(), "GetModuleFileNameW");
    if (length >= path.size())
      throw std::system_error(
          ERROR_BUFFER_OVERFLOW, std::system_category(),
          "current executable path exceeds the Windows limit");
    return from_path(
        std::wstring_view(path.data(), length));
  }

  std::span<const std::uint8_t> bytes() const noexcept {
    return bytes_;
  }

private:
  explicit application_id(std::vector<std::uint8_t> bytes)
      : bytes_(std::move(bytes)) {}

  std::vector<std::uint8_t> bytes_;
};

template <class Derived, class Layer>
template <class L, std::enable_if_t<
                       detail::ale_identity_condition_layer<L>, int>>
Derived &detail::typed_condition_builder<Derived, Layer>::
    application_equal(const application_id &application) {
  conditions_.add_blob(
      FWPM_CONDITION_ALE_APP_ID, application.bytes());
  return derived();
}

