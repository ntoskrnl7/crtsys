/**
 * @brief A terminating local-proxy filter for ALE connect redirection.
 *
 * The proxy PID and host-order port are mandatory constructor data. The
 * native action, raw context encoding, and CLEAR_ACTION_RIGHT flag cannot be
 * changed by application code.
 */
template <class Layer> class connect_redirect_filter_builder {
public:
  connect_redirect_filter_builder(filter_key<Layer> key,
                                  std::wstring name,
                                  local_proxy_target target)
      : key_(key), name_(std::move(name)),
        context_(target.filter_context()) {
    static_assert(detail::connect_redirect_layer<Layer>,
                  "connect_redirect_filter_builder requires an "
                  "ALE_CONNECT_REDIRECT layer");
    if (!target.valid())
      throw std::invalid_argument(
          "a connect redirect target needs a nonzero PID and port");
  }

  connect_redirect_filter_builder &
  description(std::wstring value) {
    description_ = std::move(value);
    return *this;
  }

  connect_redirect_filter_builder &
  weight(std::uint8_t value) noexcept {
    weight_ = value;
    return *this;
  }

  connect_redirect_filter_builder &
  protocol_equal(std::uint8_t protocol) {
    conditions_.push_back(
        scalar_condition(FWPM_CONDITION_IP_PROTOCOL, protocol));
    return *this;
  }

  connect_redirect_filter_builder &
  local_port_equal(std::uint16_t port) {
    conditions_.push_back(
        scalar_condition(FWPM_CONDITION_IP_LOCAL_PORT, port));
    return *this;
  }

  connect_redirect_filter_builder &
  remote_port_equal(std::uint16_t port) {
    conditions_.push_back(
        scalar_condition(FWPM_CONDITION_IP_REMOTE_PORT, port));
    return *this;
  }

  /**
   * @brief Selects only connections created by one executable identity.
   *
   * The identifier bytes are copied into the builder, so a temporary
   * application_id cannot leave a dangling native condition pointer.
   */
  connect_redirect_filter_builder &
  application_equal(const application_id &application) {
    add_blob_condition(
        FWPM_CONDITION_ALE_APP_ID, application.bytes());
    return *this;
  }

  /**
   * @brief Selects one host-order IPv4 remote address.
   */
  connect_redirect_filter_builder &
  remote_address_v4_equal(std::uint32_t address) {
    static_assert(
        std::is_same_v<
            Layer, layers::ale_connect_redirect_v4>,
        "remote_address_v4_equal requires the IPv4 redirect layer");
    conditions_.push_back(
        scalar_condition(
            FWPM_CONDITION_IP_REMOTE_ADDRESS, address));
    return *this;
  }

private:
  friend class policy_transaction;

  struct owned_blob {
    explicit owned_blob(std::span<const std::uint8_t> source)
        : bytes(source.begin(), source.end()) {
      if (bytes.empty() ||
          bytes.size() >
              (std::numeric_limits<UINT32>::max)())
        throw std::invalid_argument(
            "WFP byte-blob condition has an invalid size");
      native.size = static_cast<UINT32>(bytes.size());
      native.data = bytes.data();
    }

    std::vector<std::uint8_t> bytes;
    FWP_BYTE_BLOB native{};
  };

  void add_blob_condition(
      const GUID &field,
      std::span<const std::uint8_t> bytes) {
    auto storage = std::make_unique<owned_blob>(bytes);
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_BYTE_BLOB_TYPE;
    condition.conditionValue.byteBlob = &storage->native;
    conditions_.push_back(condition);
    blobs_.push_back(std::move(storage));
  }

  static FWPM_FILTER_CONDITION0
  scalar_condition(const GUID &field, std::uint8_t value) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_UINT8;
    condition.conditionValue.uint8 = value;
    return condition;
  }

  static FWPM_FILTER_CONDITION0
  scalar_condition(const GUID &field, std::uint16_t value) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_UINT16;
    condition.conditionValue.uint16 = value;
    return condition;
  }

  static FWPM_FILTER_CONDITION0
  scalar_condition(const GUID &field, std::uint32_t value) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_UINT32;
    condition.conditionValue.uint32 = value;
    return condition;
  }

  filter_key<Layer> key_;
  std::wstring name_;
  std::wstring description_;
  std::uint8_t weight_ = 8;
  std::uint64_t context_ = 0;
  std::vector<FWPM_FILTER_CONDITION0> conditions_;
  std::vector<std::unique_ptr<owned_blob>> blobs_;
};

