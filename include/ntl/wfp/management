/**
 * @brief Transaction-scoped policy writer.
 *
 * Instances can only be created by dynamic_session::install and cannot be
 * copied, moved, committed, or aborted by application code.
 */
class policy_transaction {
public:
  policy_transaction(const policy_transaction &) = delete;
  policy_transaction &operator=(const policy_transaction &) = delete;
  policy_transaction(policy_transaction &&) = delete;
  policy_transaction &operator=(policy_transaction &&) = delete;

  provider_ref add_provider(const provider_spec &spec) {
    FWPM_PROVIDER0 provider{};
    provider.providerKey = spec.key.native();
    provider.displayData.name =
        const_cast<wchar_t *>(spec.name.c_str());
    provider.displayData.description =
        const_cast<wchar_t *>(spec.description.c_str());
    check(FwpmProviderAdd0(engine_, &provider, nullptr),
          "FwpmProviderAdd0");
    return provider_ref(spec.key, transaction_);
  }

  sublayer_ref add_sublayer(const provider_ref &owner,
                            const sublayer_spec &spec) {
    require_current(owner.transaction_);
    GUID provider_key = owner.key_.native();
    FWPM_SUBLAYER0 sublayer{};
    sublayer.subLayerKey = spec.key.native();
    sublayer.providerKey = &provider_key;
    sublayer.displayData.name =
        const_cast<wchar_t *>(spec.name.c_str());
    sublayer.displayData.description =
        const_cast<wchar_t *>(spec.description.c_str());
    sublayer.weight = spec.weight;
    check(FwpmSubLayerAdd0(engine_, &sublayer, nullptr),
          "FwpmSubLayerAdd0");
    return sublayer_ref(spec.key, owner.key_, transaction_);
  }

  template <class Layer>
  callout_ref<Layer> add_callout(const provider_ref &owner,
                                 const callout_spec<Layer> &spec) {
    static_assert(detail::known_layer<Layer>,
                  "unsupported ntl::wfp layer tag");
    require_current(owner.transaction_);
    GUID provider_key = owner.key_.native();
    FWPM_CALLOUT0 callout{};
    callout.calloutKey = spec.key.native();
    callout.providerKey = &provider_key;
    callout.displayData.name =
        const_cast<wchar_t *>(spec.name.c_str());
    callout.displayData.description =
        const_cast<wchar_t *>(spec.description.c_str());
    callout.applicableLayer = Layer::policy_key();
    check(FwpmCalloutAdd0(engine_, &callout, nullptr, nullptr),
          "FwpmCalloutAdd0");
    return callout_ref<Layer>(spec.key, owner.key_, transaction_);
  }

  template <class Layer>
  void add_filter(const sublayer_ref &sublayer,
                  const callout_ref<Layer> &callout,
                  filter_builder<Layer> &builder) {
    static_assert(detail::ale_authorization_layer<Layer>,
                  "add_filter() is limited to ALE authorization layers");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_TERMINATING,
                       FWPM_FILTER_FLAG_CLEAR_ACTION_RIGHT);
  }

  template <class Layer>
  void add_connect_redirect_filter(
      const sublayer_ref &sublayer,
      const callout_ref<Layer> &callout,
      connect_redirect_filter_builder<Layer> &builder) {
    static_assert(detail::connect_redirect_layer<Layer>,
                  "add_connect_redirect_filter() requires an "
                  "ALE_CONNECT_REDIRECT layer");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_TERMINATING,
                       FWPM_FILTER_FLAG_CLEAR_ACTION_RIGHT);
  }

  template <class Layer>
  void add_bind_redirect_filter(
      const sublayer_ref &sublayer,
      const callout_ref<Layer> &callout,
      bind_redirect_filter_builder<Layer> &builder) {
    static_assert(detail::bind_redirect_layer<Layer>,
                  "add_bind_redirect_filter() requires an "
                  "ALE_BIND_REDIRECT layer");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_TERMINATING,
                       FWPM_FILTER_FLAG_CLEAR_ACTION_RIGHT);
  }

  template <class Layer>
  void add_inspection_filter(
      const sublayer_ref &sublayer, const callout_ref<Layer> &callout,
      inspection_filter_builder<Layer> &builder) {
    static_assert(detail::known_layer<Layer>,
                  "unsupported ntl::wfp layer tag");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_INSPECTION, 0);
  }

  template <class Layer>
  void add_packet_filter(const sublayer_ref &sublayer,
                         const callout_ref<Layer> &callout,
                         packet_filter_builder<Layer> &builder) {
    static_assert(detail::packet_decision_layer<Layer>,
                  "add_packet_filter() requires a packet decision layer");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_TERMINATING,
                       FWPM_FILTER_FLAG_CLEAR_ACTION_RIGHT);
  }

  template <class Layer>
  void add_stream_filter(const sublayer_ref &sublayer,
                         const callout_ref<Layer> &callout,
                         stream_filter_builder<Layer> &builder) {
    static_assert(detail::stream_layer<Layer>,
                  "add_stream_filter() requires a stream layer");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_TERMINATING,
                       FWPM_FILTER_FLAG_CLEAR_ACTION_RIGHT);
  }

  template <class Layer>
  void add_stream_control_filter(
      const sublayer_ref &sublayer, const callout_ref<Layer> &callout,
      stream_control_filter_builder<Layer> &builder) {
    static_assert(detail::stream_layer<Layer>,
                  "add_stream_control_filter() requires a stream layer");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_UNKNOWN, 0);
  }

private:
  template <class Layer, class Builder>
  void add_callout_filter(const sublayer_ref &sublayer,
                          const callout_ref<Layer> &callout,
                          Builder &builder, FWP_ACTION_TYPE action,
                          UINT32 flags) {
    require_current(sublayer.transaction_);
    require_current(callout.transaction_);
    if (!IsEqualGUID(sublayer.provider_.native(),
                     callout.provider_.native()))
      throw std::logic_error(
          "WFP sublayer and callout belong to different providers");

    GUID provider_key = sublayer.provider_.native();
    FWP_VALUE0 weight{};
    weight.type = FWP_UINT8;
    weight.uint8 = builder.weight_;

    FWPM_FILTER0 filter{};
    filter.filterKey = builder.key_.native();
    filter.providerKey = &provider_key;
    filter.displayData.name =
        const_cast<wchar_t *>(builder.name_.c_str());
    filter.displayData.description =
        const_cast<wchar_t *>(builder.description_.c_str());
    filter.layerKey = Layer::policy_key();
    filter.subLayerKey = sublayer.key_.native();
    filter.weight = weight;
    filter.numFilterConditions =
        static_cast<UINT32>(builder.conditions_.size());
    filter.filterCondition = builder.conditions_.empty()
                                 ? nullptr
                                 : builder.conditions_.data();
    filter.action.type = action;
    filter.action.calloutKey = callout.key_.native();
    filter.rawContext = builder.context_;
    filter.flags = flags;
    check(FwpmFilterAdd0(engine_, &filter, nullptr, nullptr),
          "FwpmFilterAdd0");
  }

  friend class dynamic_session;
  policy_transaction(HANDLE engine, std::uint64_t transaction) noexcept
      : engine_(engine), transaction_(transaction) {}

  static void check(DWORD result, const char *operation) {
    if (result != ERROR_SUCCESS)
      throw management_error(result, operation);
  }

  void require_current(std::uint64_t transaction) const {
    if (transaction != transaction_)
      throw std::logic_error(
          "WFP policy reference belongs to another transaction");
  }

  HANDLE engine_ = nullptr;
  std::uint64_t transaction_ = 0;
};

/**
 * @brief Move-only dynamic WFP engine session.
 *
 * All objects created by this session disappear when it closes, including on
 * process failure. Policy changes can only be made through install(), which
 * commits on normal return and aborts on every exception.
 */
class dynamic_session {
public:
  explicit dynamic_session(std::wstring name = L"ntl::wfp dynamic session") {
    FWPM_SESSION0 session{};
    session.displayData.name = const_cast<wchar_t *>(name.c_str());
    session.flags = FWPM_SESSION_FLAG_DYNAMIC;
    const DWORD result =
        FwpmEngineOpen0(nullptr, RPC_C_AUTHN_WINNT, nullptr, &session,
                        &engine_);
    if (result != ERROR_SUCCESS)
      throw management_error(result, "FwpmEngineOpen0");
  }

  dynamic_session(const dynamic_session &) = delete;
  dynamic_session &operator=(const dynamic_session &) = delete;

  dynamic_session(dynamic_session &&other) noexcept
      : engine_(std::exchange(other.engine_, nullptr)) {}

  dynamic_session &operator=(dynamic_session &&other) noexcept {
    if (this != &other) {
      close();
      engine_ = std::exchange(other.engine_, nullptr);
    }
    return *this;
  }

  ~dynamic_session() { close(); }

  template <class Function> void install(Function &&function) {
    static_assert(
        std::is_invocable_v<Function, policy_transaction &>,
        "install callback must accept ntl::wfp::policy_transaction&");
    check(FwpmTransactionBegin0(engine_, 0), "FwpmTransactionBegin0");

    policy_transaction transaction(engine_, next_transaction());
    try {
      std::invoke(std::forward<Function>(function), transaction);
      check(FwpmTransactionCommit0(engine_), "FwpmTransactionCommit0");
    } catch (...) {
      (void)FwpmTransactionAbort0(engine_);
      throw;
    }
  }

private:
  static void check(DWORD result, const char *operation) {
    if (result != ERROR_SUCCESS)
      throw management_error(result, operation);
  }

  void close() noexcept {
    if (engine_) {
      (void)FwpmEngineClose0(engine_);
      engine_ = nullptr;
    }
  }

  static std::uint64_t next_transaction() noexcept {
    static std::atomic<std::uint64_t> value{1};
    return value.fetch_add(1, std::memory_order_relaxed);
  }

  HANDLE engine_ = nullptr;
};

