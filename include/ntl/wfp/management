/**
 * @brief Transaction-scoped policy writer.
 *
 * Instances can only be created by policy_session and cannot be
 * copied, moved, committed, or aborted by application code.
 */
class policy_transaction {
public:
  policy_transaction(const policy_transaction &) = delete;
  policy_transaction &operator=(const policy_transaction &) = delete;
  policy_transaction(policy_transaction &&) = delete;
  policy_transaction &operator=(policy_transaction &&) = delete;

  provider_ref add_provider(const provider_spec &spec) {
    FWPM_PROVIDER0 provider{};
    provider.providerKey = spec.key.native();
    provider.displayData.name =
        const_cast<wchar_t *>(spec.name.c_str());
    provider.displayData.description =
        const_cast<wchar_t *>(spec.description.c_str());
    provider.serviceName = spec.service_name.empty()
                               ? nullptr
                               : const_cast<wchar_t *>(
                                     spec.service_name.c_str());
    std::array<std::uint8_t, 16> revision_data{};
    if (scope_ == policy_scope::persistent) {
      provider.flags |= FWPM_PROVIDER_FLAG_PERSISTENT;
      if (!revision_)
        throw std::logic_error(
            "persistent WFP provider requires a policy revision");
      revision_data =
          detail::encode_policy_revision(*revision_);
      provider.providerData.size =
          static_cast<UINT32>(revision_data.size());
      provider.providerData.data =
          revision_data.data();
    }
    check(FwpmProviderAdd0(engine_, &provider, nullptr),
          "FwpmProviderAdd0");
    providers_.push_back(spec.key.native());
    return provider_ref(spec.key, transaction_);
  }

  sublayer_ref add_sublayer(const provider_ref &owner,
                            const sublayer_spec &spec) {
    require_current(owner.transaction_);
    GUID provider_key = owner.key_.native();
    FWPM_SUBLAYER0 sublayer{};
    sublayer.subLayerKey = spec.key.native();
    sublayer.providerKey = &provider_key;
    sublayer.displayData.name =
        const_cast<wchar_t *>(spec.name.c_str());
    sublayer.displayData.description =
        const_cast<wchar_t *>(spec.description.c_str());
    sublayer.weight = spec.weight;
    if (scope_ == policy_scope::persistent)
      sublayer.flags |= FWPM_SUBLAYER_FLAG_PERSISTENT;
    check(FwpmSubLayerAdd0(engine_, &sublayer, nullptr),
          "FwpmSubLayerAdd0");
    sublayers_.push_back(spec.key.native());
    return sublayer_ref(spec.key, owner.key_, transaction_);
  }

  template <class Layer>
  callout_ref<Layer> add_callout(const provider_ref &owner,
                                 const callout_spec<Layer> &spec) {
    static_assert(
        detail::callout_layer<Layer>,
        "add_callout() requires a third-party kernel callout layer");
    require_current(owner.transaction_);
    GUID provider_key = owner.key_.native();
    FWPM_CALLOUT0 callout{};
    callout.calloutKey = spec.key.native();
    callout.providerKey = &provider_key;
    callout.displayData.name =
        const_cast<wchar_t *>(spec.name.c_str());
    callout.displayData.description =
        const_cast<wchar_t *>(spec.description.c_str());
    callout.applicableLayer = Layer::policy_key();
    if (scope_ == policy_scope::persistent)
      callout.flags |= FWPM_CALLOUT_FLAG_PERSISTENT;
    check(FwpmCalloutAdd0(engine_, &callout, nullptr, nullptr),
          "FwpmCalloutAdd0");
    callouts_.push_back(spec.key.native());
    return callout_ref<Layer>(spec.key, owner.key_, transaction_);
  }

  template <class Layer>
  void add_filter(const sublayer_ref &sublayer,
                  const callout_ref<Layer> &callout,
                  filter_builder<Layer> &builder) {
    static_assert(detail::ale_authorization_layer<Layer>,
                  "add_filter() is limited to ALE authorization layers");
    add_callout_filter(sublayer, callout, builder,
                       FWP_ACTION_CALLOUT_TERMINATING,
                       FWPM_FILTER_FLAG_CLEAR_ACTION_RIGHT,
                       builder.unavailable_);
