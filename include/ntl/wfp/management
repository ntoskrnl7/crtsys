template <class Layer> class stream_control_filter_builder {
public:
  stream_control_filter_builder(filter_key<Layer> key, std::wstring name)
      : key_(key), name_(std::move(name)) {
    static_assert(detail::stream_layer<Layer>,
                  "stream_control_filter_builder requires a stream layer");
  }

  stream_control_filter_builder &description(std::wstring value) {
    description_ = std::move(value);
    return *this;
  }

  stream_control_filter_builder &weight(std::uint8_t value) noexcept {
    weight_ = value;
    return *this;
  }

  stream_control_filter_builder &local_port_equal(std::uint16_t port) {
    conditions_.push_back(
        scalar_condition(FWPM_CONDITION_IP_LOCAL_PORT, port));
    return *this;
  }

  stream_control_filter_builder &remote_port_equal(std::uint16_t port) {
    conditions_.push_back(
        scalar_condition(FWPM_CONDITION_IP_REMOTE_PORT, port));
    return *this;
  }

  stream_control_filter_builder &context(std::uint64_t value) noexcept {
    context_ = value;
    return *this;
  }

private:
  friend class policy_transaction;

  static FWPM_FILTER_CONDITION0 scalar_condition(const GUID &field,
                                                  std::uint16_t value) {
    FWPM_FILTER_CONDITION0 condition{};
    condition.fieldKey = field;
    condition.matchType = FWP_MATCH_EQUAL;
    condition.conditionValue.type = FWP_UINT16;
    condition.conditionValue.uint16 = value;
    return condition;
  }

  filter_key<Layer> key_;
  std::wstring name_;
  std::wstring description_;
  std::uint8_t weight_ = 8;
  std::uint64_t context_ = 0;
  std::vector<FWPM_FILTER_CONDITION0> conditions_;
};

