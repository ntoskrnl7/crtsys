[Version]
Signature   = "$WINDOWS NT$"
Class       = "ActivityMonitor"
ClassGuid   = {b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider    = %ProviderName%
DriverVer   = 07/24/2026,0.1.0.0
CatalogFile = crtsys_flt_name_changer_runtime_test.cat
PnpLockdown = 1

[DestinationDirs]
DriverCopyFiles.Downlevel = 12
DriverCopyFiles.24H2      = 13

[DefaultInstall.NTamd64]
OptionDesc = %ServiceDescription%
CopyFiles  = DriverCopyFiles.Downlevel

[DefaultInstall.NTamd64.10.0...26100]
OptionDesc = %ServiceDescription%
CopyFiles  = DriverCopyFiles.24H2

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,,ServiceInstall.Downlevel

[DefaultInstall.NTamd64.10.0...26100.Services]
AddService = %ServiceName%,,ServiceInstall.24H2

[ServiceInstall.Downlevel]
DisplayName    = %ServiceDescription%
Description    = %ServiceDescription%
ServiceBinary  = %12%\crtsys_flt_name_changer_runtime_test.sys
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Activity Monitor"
Dependencies   = FltMgr
AddReg         = Instances.AddRegistry.Downlevel,Mapping.AddRegistry

[ServiceInstall.24H2]
DisplayName    = %ServiceDescription%
Description    = %ServiceDescription%
ServiceBinary  = %13%\crtsys_flt_name_changer_runtime_test.sys
ServiceType    = 2
StartType      = 3
ErrorControl   = 1
LoadOrderGroup = "FSFilter Activity Monitor"
Dependencies   = FltMgr
AddReg         = Instances.AddRegistry.24H2,Mapping.AddRegistry

[Instances.AddRegistry.Downlevel]
HKR,"Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Instances\%DefaultInstance%","Altitude",0x00000000,%DefaultAltitude%
HKR,"Instances\%DefaultInstance%","Flags",0x00010001,0

[Instances.AddRegistry.24H2]
HKR,"Parameters\Instances","DefaultInstance",0x00000000,%DefaultInstance%
HKR,"Parameters\Instances\%DefaultInstance%","Altitude",0x00000000,%DefaultAltitude%
HKR,"Parameters\Instances\%DefaultInstance%","Flags",0x00010001,0

[Mapping.AddRegistry]
HKR,"Parameters","UserMapping",0x00000000,%UserMapping%
HKR,"Parameters","RealMapping",0x00000000,%RealMapping%
HKR,"Parameters","SupportedFeatures",0x00010001,0x3

[DriverCopyFiles.Downlevel]
crtsys_flt_name_changer_runtime_test.sys

[DriverCopyFiles.24H2]
crtsys_flt_name_changer_runtime_test.sys

[SourceDisksFiles]
crtsys_flt_name_changer_runtime_test.sys = 1,,

[SourceDisksNames]
1 = %DiskName%,,,

[Strings]
ProviderName       = "ntoskrnl7"
ServiceName        = "CrtSysFltNameChangerRuntimeTest"
ServiceDescription = "crtsys NTL NameChanger minifilter runtime test"
DefaultInstance    = "CrtSys FLT NameChanger runtime test instance"
DefaultAltitude    = "370030.230"
UserMapping        = "\crtsys-namechanger-visible\graft"
RealMapping        = "\crtsys-namechanger-store\real"
DiskName           = "crtsys NTL NameChanger minifilter runtime test media"
