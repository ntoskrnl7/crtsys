<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CrtSysIsDriverProject Condition="'$(CrtSysIsDriverProject)' == '' and ('$(ConfigurationType)' == 'Driver' or '$(DriverType)' != '')">true</CrtSysIsDriverProject>
    <CrtSysIsDriverProject Condition="'$(CrtSysIsDriverProject)' == ''">false</CrtSysIsDriverProject>
    <CrtSysUseDriverSupport Condition="'$(CrtSysUseDriverSupport)' == '' and '$(CrtSysIsDriverProject)' == 'true'">true</CrtSysUseDriverSupport>
    <CrtSysUseDriverSupport Condition="'$(CrtSysUseDriverSupport)' == ''">false</CrtSysUseDriverSupport>
    <CrtSysUseNtlContentCodecs Condition="'$(CrtSysUseNtlContentCodecs)' == '' and '$(CrtSysIsDriverProject)' != 'true'">true</CrtSysUseNtlContentCodecs>
    <CrtSysUseNtlContentCodecs Condition="'$(CrtSysUseNtlContentCodecs)' == ''">false</CrtSysUseNtlContentCodecs>
    <CrtSysUseNtlMsQuicHeaders Condition="'$(CrtSysUseNtlMsQuicHeaders)' == ''">true</CrtSysUseNtlMsQuicHeaders>
    <CrtSysUseNtlKernelMsQuic Condition="'$(CrtSysUseNtlKernelMsQuic)' == ''">false</CrtSysUseNtlKernelMsQuic>
    <CrtSysLibPlatform Condition="'$(CrtSysLibPlatform)' == '' and '$(Platform)' == 'Win32'">x86</CrtSysLibPlatform>
    <CrtSysLibPlatform Condition="'$(CrtSysLibPlatform)' == ''">$(Platform)</CrtSysLibPlatform>
    <CrtSysTargetArchitectureDefinition Condition="'$(CrtSysTargetArchitectureDefinition)' == '' and '$(CrtSysLibPlatform)' == 'x86'">_X86_</CrtSysTargetArchitectureDefinition>
    <CrtSysTargetArchitectureDefinition Condition="'$(CrtSysTargetArchitectureDefinition)' == '' and '$(CrtSysLibPlatform)' == 'x64'">_AMD64_</CrtSysTargetArchitectureDefinition>
    <CrtSysTargetArchitectureDefinition Condition="'$(CrtSysTargetArchitectureDefinition)' == '' and '$(CrtSysLibPlatform)' == 'ARM'">_ARM_</CrtSysTargetArchitectureDefinition>
    <CrtSysTargetArchitectureDefinition Condition="'$(CrtSysTargetArchitectureDefinition)' == '' and '$(CrtSysLibPlatform)' == 'ARM64'">_ARM64_</CrtSysTargetArchitectureDefinition>
    <CrtSysEntryPointSuffix Condition="'$(CrtSysEntryPointSuffix)' == '' and '$(CrtSysLibPlatform)' == 'x86'">@8</CrtSysEntryPointSuffix>
    <CrtSysEntryPointSuffix Condition="'$(CrtSysEntryPointSuffix)' == ''"></CrtSysEntryPointSuffix>
    <CrtSysLibraryConfiguration Condition="'$(CrtSysLibraryConfiguration)' == '' and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">$(Configuration)</CrtSysLibraryConfiguration>
    <CrtSysLibraryConfiguration Condition="'$(CrtSysLibraryConfiguration)' == ''">Release</CrtSysLibraryConfiguration>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$([System.String]::Copy(&quot;$(VCToolsVersion)&quot;).StartsWith(&quot;14.5&quot;))' == 'true'">v145</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$([System.String]::Copy(&quot;$(VCToolsVersion)&quot;).StartsWith(&quot;14.4&quot;))' == 'true'">v143</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$([System.String]::Copy(&quot;$(VCToolsVersion)&quot;).StartsWith(&quot;14.2&quot;))' == 'true'">v142</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$(PlatformToolsetVersion)' == '145'">v145</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$(PlatformToolsetVersion)' == '143'">v143</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$(PlatformToolsetVersion)' == '142'">v142</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$(PlatformToolset)' == 'v145'">v145</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$(PlatformToolset)' == 'v143'">v143</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == '' and '$(PlatformToolset)' == 'v142'">v142</CrtSysLibToolset>
    <CrtSysLibToolset Condition="'$(CrtSysLibToolset)' == ''">v143</CrtSysLibToolset>
    <CrtSysAllowToolsetFallback Condition="'$(CrtSysAllowToolsetFallback)' == ''">false</CrtSysAllowToolsetFallback>
    <CrtSysNativeLibRoot Condition="'$(CrtSysNativeLibRoot)' == '' and Exists('$(MSBuildThisFileDirectory)lib\native')">$(MSBuildThisFileDirectory)lib\native\</CrtSysNativeLibRoot>
    <CrtSysNativeLibRoot Condition="'$(CrtSysNativeLibRoot)' == ''">$(CrtSysRoot)lib\native\</CrtSysNativeLibRoot>
    <CrtSysContentCodecRoot Condition="'$(CrtSysContentCodecRoot)' == ''">$(CrtSysRoot)build\native\codecs\</CrtSysContentCodecRoot>
    <CrtSysContentCodecLibDir Condition="'$(CrtSysContentCodecLibDir)' == ''">$(CrtSysContentCodecRoot)lib\$(CrtSysLibToolset)\$(CrtSysLibPlatform)\$(CrtSysLibraryConfiguration)\</CrtSysContentCodecLibDir>
    <CrtSysKernelContentCodecRoot Condition="'$(CrtSysKernelContentCodecRoot)' == ''">$(CrtSysRoot)build\native\kernel-codecs\</CrtSysKernelContentCodecRoot>
    <CrtSysKernelContentCodecLibDir Condition="'$(CrtSysKernelContentCodecLibDir)' == ''">$(CrtSysKernelContentCodecRoot)lib\$(CrtSysLibToolset)\$(CrtSysLibPlatform)\$(CrtSysLibraryConfiguration)\</CrtSysKernelContentCodecLibDir>
    <CrtSysMsQuicRoot Condition="'$(CrtSysMsQuicRoot)' == ''">$(CrtSysRoot)build\native\msquic\</CrtSysMsQuicRoot>
    <CrtSysMsQuicIncludeDir Condition="'$(CrtSysMsQuicIncludeDir)' == ''">$(CrtSysMsQuicRoot)include\</CrtSysMsQuicIncludeDir>
    <CrtSysPropertyPageRoot Condition="'$(CrtSysPropertyPageRoot)' == ''">$(CrtSysRoot)build\native\</CrtSysPropertyPageRoot>
    <CrtSysMsQuicHeaderRevision Condition="'$(CrtSysMsQuicHeaderRevision)' == ''">b3945bb0c9e44463c93dac13e40975a7c3a526ca</CrtSysMsQuicHeaderRevision>
    <CrtSysHasToolsetLibLayout Condition="Exists('$(CrtSysNativeLibRoot)v142') or Exists('$(CrtSysNativeLibRoot)v143') or Exists('$(CrtSysNativeLibRoot)v145')">true</CrtSysHasToolsetLibLayout>
    <CrtSysExactLibDir>$(CrtSysNativeLibRoot)$(CrtSysLibToolset)\$(CrtSysLibPlatform)\$(CrtSysLibraryConfiguration)\</CrtSysExactLibDir>
    <CrtSysFallbackLibDir>$(CrtSysNativeLibRoot)v143\$(CrtSysLibPlatform)\$(CrtSysLibraryConfiguration)\</CrtSysFallbackLibDir>
    <CrtSysLegacyLibDir>$(CrtSysNativeLibRoot)$(CrtSysLibPlatform)\$(CrtSysLibraryConfiguration)\</CrtSysLegacyLibDir>
    <CrtSysLibDir Condition="'$(CrtSysLibDir)' == ''">$(CrtSysExactLibDir)</CrtSysLibDir>
    <CrtSysLibDir Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysAllowToolsetFallback)' == 'true' and '$(CrtSysLibToolset)' != 'v143' and !Exists('$(CrtSysLibDir)crtsys.lib')">$(CrtSysFallbackLibDir)</CrtSysLibDir>
    <CrtSysLibDir Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysHasToolsetLibLayout)' != 'true' and !Exists('$(CrtSysLibDir)crtsys.lib')">$(CrtSysLegacyLibDir)</CrtSysLibDir>
    <CrtSysUseNtlKmdfMain Condition="'$(CrtSysUseNtlKmdfMain)' == ''">false</CrtSysUseNtlKmdfMain>
    <CrtSysUseNtlFltMain Condition="'$(CrtSysUseNtlFltMain)' == ''">false</CrtSysUseNtlFltMain>
    <CrtSysIsKmdf Condition="'$(DriverType)' == 'KMDF'">true</CrtSysIsKmdf>
    <CrtSysIsKmdf Condition="'$(CrtSysIsKmdf)' == ''">false</CrtSysIsKmdf>
    <CrtSysIsExportDriver Condition="'$(DriverType)' == 'ExportDriver'">true</CrtSysIsExportDriver>
    <CrtSysIsExportDriver Condition="'$(CrtSysIsExportDriver)' == ''">false</CrtSysIsExportDriver>
    <CrtSysWdmEntryPoint
      Condition="'$(CrtSysWdmEntryPoint)' == '' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true' and '$(CrtSysUseNtlFltMain)' == 'true'">NtlMinifilter</CrtSysWdmEntryPoint>
    <CrtSysWdmEntryPoint
      Condition="'$(CrtSysWdmEntryPoint)' == '' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true' and '$(CrtSysIsWfp)' == 'true'">NtlWfp</CrtSysWdmEntryPoint>
    <CrtSysWdmEntryPoint
      Condition="'$(CrtSysWdmEntryPoint)' == '' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true' and '$(CrtSysIsNdis)' == 'true'">NtlNdis</CrtSysWdmEntryPoint>
    <CrtSysWdmEntryPoint
      Condition="'$(CrtSysWdmEntryPoint)' == '' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true' and '$(CrtSysUseNtlMain)' == 'false'">Default</CrtSysWdmEntryPoint>
    <CrtSysWdmEntryPoint
      Condition="'$(CrtSysWdmEntryPoint)' == '' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true' and '$(CrtSysUseNtlMain)' != 'false'">NtlWdm</CrtSysWdmEntryPoint>
    <CrtSysWdmEntryPoint
      Condition="'$(CrtSysWdmEntryPoint)' == '' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true'">Default</CrtSysWdmEntryPoint>

    <CrtSysKmdfEntryPoint
      Condition="'$(CrtSysKmdfEntryPoint)' == '' and '$(CrtSysIsKmdf)' == 'true' and '$(CrtSysUseNtlKmdfMain)' == 'true'">NtlKmdf</CrtSysKmdfEntryPoint>
    <CrtSysKmdfEntryPoint
      Condition="'$(CrtSysKmdfEntryPoint)' == '' and '$(CrtSysIsKmdf)' == 'true'">Default</CrtSysKmdfEntryPoint>

    <CrtSysEffectiveDriverModel Condition="'$(CrtSysIsKmdf)' == 'true'">$(CrtSysKmdfEntryPoint)</CrtSysEffectiveDriverModel>
    <CrtSysEffectiveDriverModel Condition="'$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true'">$(CrtSysWdmEntryPoint)</CrtSysEffectiveDriverModel>
    <CrtSysEffectiveDriverModel Condition="'$(CrtSysIsExportDriver)' == 'true'">Default</CrtSysEffectiveDriverModel>
    <CrtSysUseNtlMain Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlWdm'">true</CrtSysUseNtlMain>
    <CrtSysUseNtlMain Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlWfp'">true</CrtSysUseNtlMain>
    <CrtSysUseNtlMain Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlNdis'">true</CrtSysUseNtlMain>
    <CrtSysUseNtlMain Condition="'$(CrtSysEffectiveDriverModel)' == 'Default'">false</CrtSysUseNtlMain>
    <CrtSysIsMinifilter Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlMinifilter'">true</CrtSysIsMinifilter>
    <CrtSysIsWfp Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlWfp'">true</CrtSysIsWfp>
    <CrtSysIsNdis Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlNdis'">true</CrtSysIsNdis>
    <CrtSysUseNtlFltMain Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlMinifilter'">true</CrtSysUseNtlFltMain>
    <CrtSysUseNtlKmdfMain Condition="'$(CrtSysEffectiveDriverModel)' == 'NtlKmdf'">true</CrtSysUseNtlKmdfMain>
    <CrtSysIsMinifilter Condition="'$(CrtSysIsMinifilter)' == '' and '$(CrtSysUseNtlFltMain)' == 'true'">true</CrtSysIsMinifilter>
    <CrtSysIsMinifilter Condition="'$(CrtSysIsMinifilter)' == ''">false</CrtSysIsMinifilter>
    <CrtSysIsWfp Condition="'$(CrtSysIsWfp)' == ''">false</CrtSysIsWfp>
    <CrtSysIsNdis Condition="'$(CrtSysIsNdis)' == ''">false</CrtSysIsNdis>
    <CrtSysUseNtlKernelContentCodecs Condition="'$(CrtSysUseNtlKernelContentCodecs)' == '' and '$(CrtSysIsWfp)' == 'true'">true</CrtSysUseNtlKernelContentCodecs>
    <CrtSysUseNtlKernelContentCodecs Condition="'$(CrtSysUseNtlKernelContentCodecs)' == ''">false</CrtSysUseNtlKernelContentCodecs>
    <CrtSysUseNtlMain Condition="'$(CrtSysUseNtlMain)' == '' and ('$(CrtSysIsKmdf)' == 'true' or '$(CrtSysIsMinifilter)' == 'true' or '$(CrtSysIsExportDriver)' == 'true')">false</CrtSysUseNtlMain>
    <CrtSysUseNtlMain Condition="'$(CrtSysUseNtlMain)' == ''">true</CrtSysUseNtlMain>
    <CrtSysWfpNdisVersion Condition="'$(CrtSysWfpNdisVersion)' == '' and ('$(CrtSysLibPlatform)' == 'ARM' or '$(CrtSysLibPlatform)' == 'ARM64')">NDIS630</CrtSysWfpNdisVersion>
    <CrtSysWfpNdisVersion Condition="'$(CrtSysWfpNdisVersion)' == ''">NDIS60</CrtSysWfpNdisVersion>
    <CrtSysWfpNtddiVersion Condition="'$(CrtSysWfpNtddiVersion)' == '' and '$(CrtSysUseNtlKernelMsQuic)' == 'true'">NTDDI_WIN10_VB</CrtSysWfpNtddiVersion>
    <CrtSysWfpNtddiVersion Condition="'$(CrtSysWfpNtddiVersion)' == ''">NTDDI_WIN8</CrtSysWfpNtddiVersion>
    <CrtSysNdisVersion Condition="'$(CrtSysNdisVersion)' == ''">NDIS630</CrtSysNdisVersion>
    <CrtSysUseLibcntpr Condition="'$(CrtSysUseLibcntpr)' == ''">true</CrtSysUseLibcntpr>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysDriverPreprocessorDefinitions)' == ''">_KERNEL32_;_ITERATOR_DEBUG_LEVEL=0;_HAS_EXCEPTIONS</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysUseLibcntpr)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_LIBCNTPR</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysUseNtlMain)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_NTL_MAIN</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysUseNtlKmdfMain)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_NTL_KMDF_MAIN</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysUseNtlFltMain)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_NTL_FLT_MAIN</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysIsKmdf)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_KMDF</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysIsMinifilter)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_MINIFILTER</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysIsWfp)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_WFP;$(CrtSysWfpNdisVersion);NDIS_SUPPORT_NDIS6;NTDDI_VERSION=$(CrtSysWfpNtddiVersion)</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysIsNdis)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);CRTSYS_USE_NDIS;$(CrtSysNdisVersion);NDIS_SUPPORT_NDIS6;NDIS_WDM;NDISLWF;NTDDI_VERSION=NTDDI_WIN8</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysIsWfp)' != 'true' and '$(CrtSysUseNtlKernelMsQuic)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);NTDDI_VERSION=NTDDI_WIN10_VB</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverPreprocessorDefinitions Condition="'$(CrtSysUseNtlKernelContentCodecs)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);Z_SOLO</CrtSysDriverPreprocessorDefinitions>
    <CrtSysDriverLibraries>crtsys.lib;Ldk.lib;cng.lib;aux_klib.lib;wdmsec.lib;netio.lib;uuid.lib</CrtSysDriverLibraries>
    <CrtSysDriverLibraries Condition="'$(CrtSysUseLibcntpr)' == 'true'">$(CrtSysDriverLibraries);libcntpr.lib</CrtSysDriverLibraries>
    <CrtSysDriverLibraries Condition="'$(CrtSysIsMinifilter)' == 'true'">$(CrtSysDriverLibraries);fltmgr.lib</CrtSysDriverLibraries>
    <CrtSysDriverLibraries Condition="'$(CrtSysIsWfp)' == 'true'">$(CrtSysDriverLibraries);fwpkclnt.lib</CrtSysDriverLibraries>
    <CrtSysDriverLibraries Condition="'$(CrtSysIsNdis)' == 'true'">$(CrtSysDriverLibraries);ndis.lib</CrtSysDriverLibraries>
    <DisableKernelFlag Condition="'$(CrtSysUseDriverSupport)' == 'true'">true</DisableKernelFlag>
    <Inf2CatUseLocalTime Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(Inf2CatUseLocalTime)' == ''">true</Inf2CatUseLocalTime>
  </PropertyGroup>

  <ItemGroup Condition="'$(CrtSysIsDriverProject)' == 'true' and '$(CrtSysIsKmdf)' == 'true'">
    <PropertyPageSchema Include="$(CrtSysPropertyPageRoot)crtsys-kmdf.xml" />
  </ItemGroup>
  <ItemGroup Condition="'$(CrtSysIsDriverProject)' == 'true' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysIsExportDriver)' != 'true'">
    <PropertyPageSchema Include="$(CrtSysPropertyPageRoot)crtsys.xml" />
  </ItemGroup>

  <Target Name="CrtSysValidateNativePackage" BeforeTargets="PrepareForBuild">
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsKmdf)' == 'true' and '$(CrtSysUseNtlMain)' == 'true'"
      Text="KMDF projects cannot enable the WDM-only CrtSysUseNtlMain property. Use CrtSysUseNtlKmdfMain instead." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysUseNtlKmdfMain)' == 'true' and '$(CrtSysIsKmdf)' != 'true'"
      Text="CrtSysUseNtlKmdfMain requires a KMDF driver project." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsExportDriver)' == 'true' and ('$(CrtSysUseNtlMain)' == 'true' or '$(CrtSysUseNtlKmdfMain)' == 'true' or '$(CrtSysUseNtlFltMain)' == 'true' or '$(CrtSysIsWfp)' == 'true' or '$(CrtSysIsNdis)' == 'true')"
      Text="Export driver projects cannot use an NTL WDM, KMDF, minifilter, WFP, or NDIS entry point. Use the export driver's DllInitialize/DllUnload model." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsKmdf)' == 'true' and '$(CrtSysIsMinifilter)' == 'true'"
      Text="A driver cannot select both KMDF and minifilter entry models." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsMinifilter)' == 'true' and '$(CrtSysUseNtlMain)' == 'true'"
      Text="Minifilter projects cannot enable the WDM-only CrtSysUseNtlMain property. Use CrtSysUseNtlFltMain instead." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysUseNtlFltMain)' == 'true' and '$(CrtSysIsMinifilter)' != 'true'"
      Text="CrtSysUseNtlFltMain requires a minifilter driver project." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysUseNtlFltMain)' == 'true' and ('$(CrtSysUseNtlKmdfMain)' == 'true' or '$(CrtSysUseNtlMain)' == 'true')"
      Text="CrtSysUseNtlFltMain cannot be combined with another crtsys entry model." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsWfp)' == 'true' and ('$(CrtSysIsKmdf)' == 'true' or '$(CrtSysIsMinifilter)' == 'true' or '$(CrtSysIsExportDriver)' == 'true' or '$(CrtSysIsNdis)' == 'true')"
      Text="The NTL WFP callout model cannot be combined with KMDF, minifilter, ExportDriver, or NDIS." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsWfp)' == 'true' and '$(CrtSysUseNtlMain)' != 'true'"
      Text="The NTL WFP callout model requires the ntl::main entry point." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsNdis)' == 'true' and ('$(CrtSysIsKmdf)' == 'true' or '$(CrtSysIsMinifilter)' == 'true' or '$(CrtSysIsExportDriver)' == 'true' or '$(CrtSysIsWfp)' == 'true')"
      Text="The NTL NDIS lightweight-filter model cannot be combined with KMDF, minifilter, ExportDriver, or WFP." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysIsNdis)' == 'true' and '$(CrtSysUseNtlMain)' != 'true'"
      Text="The NTL NDIS lightweight-filter model requires the ntl::main entry point." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysLibPlatform)' != 'x86' and '$(CrtSysLibPlatform)' != 'x64' and '$(CrtSysLibPlatform)' != 'ARM' and '$(CrtSysLibPlatform)' != 'ARM64'"
      Text="crtsys NuGet package contains prebuilt driver libraries for x86, x64, ARM, and ARM64 depending on the selected MSVC toolset. Current platform is '$(Platform)'." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and '$(CrtSysExpectedLibToolset)' != '' and '$(CrtSysLibToolset)' != '$(CrtSysExpectedLibToolset)'"
      Text="crtsys selected MSVC toolset '$(CrtSysLibToolset)', but the consumer expected '$(CrtSysExpectedLibToolset)'." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and !Exists('$(CrtSysLibDir)crtsys.lib')"
      Text="crtsys.lib was not found under '$(CrtSysLibDir)' for MSVC toolset '$(CrtSysLibToolset)'. Install a package that contains build\native\lib\native\$(CrtSysLibToolset)\$(CrtSysLibPlatform)\$(CrtSysLibraryConfiguration), or set CrtSysLibToolset explicitly." />
    <Error
      Condition="'$(CrtSysUseDriverSupport)' == 'true' and !Exists('$(CrtSysLibDir)Ldk.lib')"
      Text="Ldk.lib was not found under '$(CrtSysLibDir)' for MSVC toolset '$(CrtSysLibToolset)'." />
    <Error
      Condition="'$(CrtSysUseNtlContentCodecs)' == 'true' and !Exists('$(CrtSysContentCodecRoot)include\zlib.h')"
      Text="NTL content codec headers were not found under '$(CrtSysContentCodecRoot)include'. Reinstall a complete crtsys package or disable CrtSysUseNtlContentCodecs." />
    <Error
      Condition="'$(CrtSysUseNtlContentCodecs)' == 'true' and !Exists('$(CrtSysContentCodecLibDir)zlibstatic.lib')"
      Text="NTL content codec libraries were not found under '$(CrtSysContentCodecLibDir)' for MSVC toolset '$(CrtSysLibToolset)', platform '$(CrtSysLibPlatform)', and configuration '$(CrtSysLibraryConfiguration)'." />
    <Error
      Condition="'$(CrtSysUseNtlKernelContentCodecs)' == 'true' and '$(CrtSysIsDriverProject)' != 'true'"
      Text="CrtSysUseNtlKernelContentCodecs is valid only for a kernel driver project." />
    <Error
      Condition="'$(CrtSysUseNtlKernelMsQuic)' == 'true' and '$(CrtSysIsDriverProject)' != 'true'"
      Text="CrtSysUseNtlKernelMsQuic is valid only for a kernel driver project." />
    <Error
      Condition="'$(CrtSysUseNtlKernelMsQuic)' == 'true' and '$(CrtSysUseNtlMsQuicHeaders)' != 'true'"
      Text="CrtSysUseNtlKernelMsQuic requires CrtSysUseNtlMsQuicHeaders so the pinned public ABI is available." />
    <Error
      Condition="'$(CrtSysUseNtlKernelContentCodecs)' == 'true' and !Exists('$(CrtSysContentCodecRoot)include\zlib.h')"
      Text="NTL kernel codec headers were not found under '$(CrtSysContentCodecRoot)include'. Reinstall a complete crtsys package." />
    <Error
      Condition="'$(CrtSysUseNtlKernelContentCodecs)' == 'true' and !Exists('$(CrtSysKernelContentCodecLibDir)crtsys_ntl_kernel_zlib.lib')"
      Text="NTL kernel codec libraries were not found under '$(CrtSysKernelContentCodecLibDir)' for MSVC toolset '$(CrtSysLibToolset)', platform '$(CrtSysLibPlatform)', and configuration '$(CrtSysLibraryConfiguration)'." />
    <Error
      Condition="'$(CrtSysUseNtlMsQuicHeaders)' == 'true' and !Exists('$(CrtSysMsQuicIncludeDir)msquic.h')"
      Text="The pinned NTL MsQuic public header was not found under '$(CrtSysMsQuicIncludeDir)'. Reinstall a complete crtsys package or disable CrtSysUseNtlMsQuicHeaders." />
    <Error
      Condition="'$(CrtSysUseNtlMsQuicHeaders)' == 'true' and (!Exists('$(CrtSysMsQuicIncludeDir)msquic_winuser.h') or !Exists('$(CrtSysMsQuicIncludeDir)msquic_winkernel.h'))"
      Text="The pinned NTL MsQuic platform headers were not found under '$(CrtSysMsQuicIncludeDir)'. Reinstall a complete crtsys package or disable CrtSysUseNtlMsQuicHeaders." />
    <Message
      Importance="high"
      Condition="'$(CrtSysUseDriverSupport)' == 'true'"
      Text="crtsys NuGet package selected $(CrtSysLibDir) for MSVC toolset $(CrtSysLibToolset)." />
    <Message
      Importance="high"
      Condition="'$(CrtSysUseDriverSupport)' != 'true'"
      Text="crtsys NuGet package is being used in header-only app mode because CrtSysUseDriverSupport is '$(CrtSysUseDriverSupport)'." />
  </Target>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories Condition="'$(CrtSysUseDriverSupport)' == 'true'">$(CrtSysRoot)include;$(CrtSysRoot)include\.internal\msvc\$(VCToolsVersion);$(CrtSysRoot)include\.internal\msvc\$(PlatformToolsetVersion);$(CrtSysRoot)include\.internal\msvc\$(VCToolsVersion)\stl;$(CrtSysRoot)include\.internal\msvc\$(PlatformToolsetVersion)\stl;$(CrtSysRoot)include\.internal\msvc\143;$(CrtSysRoot)include\.internal\msvc\143\stl;$(CrtSysRoot)include\.internal\msvc\142;$(CrtSysRoot)include\.internal\msvc\142\stl;$(CrtSysRoot)include\.internal\msvc\141;$(CrtSysRoot)include\.internal\msvc\141\stl;$(VC_IncludePath);$(WindowsSDK_IncludePath);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories Condition="'$(CrtSysUseDriverSupport)' != 'true'">$(CrtSysRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories Condition="'$(CrtSysUseNtlContentCodecs)' == 'true'">$(CrtSysContentCodecRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalIncludeDirectories Condition="'$(CrtSysUseNtlKernelContentCodecs)' == 'true'">$(CrtSysContentCodecRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <AdditionalOptions Condition="'$(CrtSysUseNtlMsQuicHeaders)' == 'true'">/external:I&quot;$(CrtSysMsQuicIncludeDir).&quot; %(AdditionalOptions)</AdditionalOptions>
      <ExternalWarningLevel Condition="'$(CrtSysUseNtlMsQuicHeaders)' == 'true'">TurnOffAllWarnings</ExternalWarningLevel>
      <ForcedIncludeFiles Condition="'$(CrtSysUseDriverSupport)' == 'true'">$(CrtSysRoot)include\.internal\adjust_link_order;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <PreprocessorDefinitions Condition="'$(CrtSysUseDriverSupport)' == 'true'">$(CrtSysDriverPreprocessorDefinitions);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(CrtSysUseDriverSupport)' != 'true'">$(CrtSysTargetArchitectureDefinition);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions Condition="'$(CrtSysUseDriverSupport)' == 'true'">/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(CrtSysUseDriverSupport)' != 'true'">/Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <TreatWChar_tAsBuiltInType>true</TreatWChar_tAsBuiltInType>
      <RuntimeLibrary Condition="'$(CrtSysUseDriverSupport)' == 'true'">MultiThreaded</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(CrtSysUseNtlContentCodecs)' == 'true' and '$(Configuration)' == 'Debug'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(CrtSysUseNtlContentCodecs)' == 'true' and '$(Configuration)' != 'Debug'">MultiThreaded</RuntimeLibrary>
      <ExceptionHandling Condition="'$(CrtSysUseDriverSupport)' == 'true'">Sync</ExceptionHandling>
    </ClCompile>
    <Link Condition="'$(CrtSysUseDriverSupport)' == 'true'">
      <AdditionalLibraryDirectories>$(CrtSysLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(CrtSysDriverLibraries);%(AdditionalDependencies)</AdditionalDependencies>
      <EntryPointSymbol Condition="'$(CrtSysIsMinifilter)' == 'true' and '$(CrtSysUseNtlFltMain)' == 'true'">CrtSysNtlFltDriverEntry$(CrtSysEntryPointSuffix)</EntryPointSymbol>
      <EntryPointSymbol Condition="'$(CrtSysIsMinifilter)' == 'true' and '$(CrtSysUseNtlFltMain)' != 'true'">CrtSysWdmDriverEntry$(CrtSysEntryPointSuffix)</EntryPointSymbol>
      <EntryPointSymbol Condition="'$(CrtSysIsMinifilter)' != 'true' and '$(CrtSysIsKmdf)' == 'true' and '$(CrtSysUseNtlKmdfMain)' == 'true'">CrtSysNtlKmdfDriverEntry$(CrtSysEntryPointSuffix)</EntryPointSymbol>
      <EntryPointSymbol Condition="'$(CrtSysIsMinifilter)' != 'true' and '$(CrtSysIsKmdf)' == 'true' and '$(CrtSysUseNtlKmdfMain)' != 'true'">CrtSysKmdfDriverEntry$(CrtSysEntryPointSuffix)</EntryPointSymbol>
      <EntryPointSymbol Condition="'$(CrtSysIsMinifilter)' != 'true' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysUseNtlMain)' == 'true'">CrtSysDriverEntry$(CrtSysEntryPointSuffix)</EntryPointSymbol>
      <EntryPointSymbol Condition="'$(CrtSysIsMinifilter)' != 'true' and '$(CrtSysIsKmdf)' != 'true' and '$(CrtSysUseNtlMain)' != 'true'">CrtSysWdmDriverEntry$(CrtSysEntryPointSuffix)</EntryPointSymbol>
      <ImageHasSafeExceptionHandlers Condition="'$(CrtSysLibPlatform)' == 'x86'">false</ImageHasSafeExceptionHandlers>
      <AdditionalOptions>/FORCE:MULTIPLE %(AdditionalOptions)</AdditionalOptions>
      <TreatLinkerWarningAsErrors>false</TreatLinkerWarningAsErrors>
    </Link>
    <Link Condition="'$(CrtSysUseNtlContentCodecs)' == 'true'">
      <AdditionalLibraryDirectories>$(CrtSysContentCodecLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>zlibstatic.lib;brotlidec.lib;brotlienc.lib;brotlicommon.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Link Condition="'$(CrtSysUseNtlKernelContentCodecs)' == 'true'">
      <AdditionalLibraryDirectories>$(CrtSysKernelContentCodecLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>crtsys_ntl_kernel_zlib.lib;crtsys_ntl_kernel_brotli.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
