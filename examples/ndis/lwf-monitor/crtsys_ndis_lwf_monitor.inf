[Version]
Signature="$Windows NT$"
Class=NetService
ClassGUID={4D36E974-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=07/29/2026,1.0.0.0
CatalogFile=crtsys_ndis_lwf_monitor.cat
PnpLockdown=1

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%FilterDescription%=Install,crtsys_ntl_lwf_monitor

[Install]
AddReg=LwfNdi
Characteristics=0x40000
NetCfgInstanceId="{F620ED22-5CC9-498A-97AE-391880901A67}"
CopyFiles=DriverCopyFiles

[SourceDisksNames]
1=%FilterDescription%,"",,

[SourceDisksFiles]
crtsys_ndis_lwf_monitor.sys=1

[DestinationDirs]
DriverCopyFiles=12

[DriverCopyFiles]
crtsys_ndis_lwf_monitor.sys,,,2

[LwfNdi]
HKR,Ndi,Service,,"crtsys_ndis_lwf_monitor"
HKR,Ndi,CoServices,0x00010000,"crtsys_ndis_lwf_monitor"
HKR,Ndi,HelpText,,%FilterHelpText%
HKR,Ndi,FilterClass,,diagnostic
HKR,Ndi,FilterType,0x00010001,1
HKR,Ndi\Interfaces,UpperRange,,"noupper"
HKR,Ndi\Interfaces,LowerRange,,"nolower"
HKR,Ndi\Interfaces,FilterMediaTypes,,"ethernet,wan,wlan"
HKR,Ndi,FilterRunType,0x00010001,2
HKR,Ndi,UnbindOnAttach,0x00010001,0
HKR,Ndi,UnbindOnDetach,0x00010001,0

[Install.Services]
AddService=crtsys_ndis_lwf_monitor,0x800,ServiceInstall

[ServiceInstall]
DisplayName=%FilterDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\crtsys_ndis_lwf_monitor.sys
LoadOrderGroup=NDIS
Description=%FilterDescription%

[Install.Remove.Services]
DelService=crtsys_ndis_lwf_monitor,0x200

[Strings]
ProviderName="crtsys"
ManufacturerName="crtsys"
FilterDescription="crtsys NTL NDIS LWF monitor"
FilterHelpText="Read-only NDIS lightweight filter lifecycle and NBL metadata monitor"
