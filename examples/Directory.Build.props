<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- CMake-generated projects already receive crtsys from their CMake
       targets. Importing the Visual Studio development package as well can
       mix two different header/library revisions in one build. -->
  <PropertyGroup>
    <CrtSysIsCMakeProbe Condition="'$(MSBuildProjectName)' == 'VCTargetsPath'">true</CrtSysIsCMakeProbe>
    <CrtSysIsCMakeProbe Condition="$([System.String]::Copy('$(MSBuildProjectName)').StartsWith('CompilerId'))">true</CrtSysIsCMakeProbe>
    <CrtSysIsCMakeProbe Condition="'$(CrtSysIsCMakeProbe)' == ''">false</CrtSysIsCMakeProbe>
  </PropertyGroup>

  <PropertyGroup Condition="'$(VCProjectUpgraderObjectName)' != 'NoUpgrade' and '$(CrtSysIsCMakeProbe)' != 'true'">
    <CrtSysRepositoryRoot Condition="'$(CrtSysRepositoryRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</CrtSysRepositoryRoot>
    <CrtSysDevelopmentPackageRoot Condition="'$(CrtSysDevelopmentPackageRoot)' == ''">$(CrtSysRepositoryRoot)artifacts\development-package\</CrtSysDevelopmentPackageRoot>
    <CrtSysUseRepositoryDevelopmentFiles Condition="'$(CrtSysPackageRoot)' == '' and Exists('$(CrtSysDevelopmentPackageRoot)build\native\crtsys.props')">true</CrtSysUseRepositoryDevelopmentFiles>
    <CrtSysPackageRoot Condition="'$(CrtSysPackageRoot)' == '' and Exists('$(CrtSysDevelopmentPackageRoot)build\native\crtsys.props')">$(CrtSysDevelopmentPackageRoot)</CrtSysPackageRoot>
    <CrtSysPropertyPageRoot Condition="'$(CrtSysPropertyPageRoot)' == '' and '$(CrtSysUseRepositoryDevelopmentFiles)' == 'true'">$(CrtSysRepositoryRoot)nuget\build\native\</CrtSysPropertyPageRoot>
    <CrtSysUsePackageReference Condition="'$(CrtSysPackageRoot)' == ''">true</CrtSysUsePackageReference>
    <CrtSysUsePackageReference Condition="'$(CrtSysUsePackageReference)' == ''">false</CrtSysUsePackageReference>
    <CrtSysPackageVersion Condition="'$(CrtSysPackageVersion)' == ''">*</CrtSysPackageVersion>
    <!-- A project that also consumes an unrelated native NuGet package must
         keep that package's generated .props/.targets imports enabled. -->
    <ExcludeRestorePackageImports Condition="'$(CrtSysPackageRoot)' != '' and '$(CrtSysAllowExternalPackageImports)' != 'true'">true</ExcludeRestorePackageImports>
    <ExcludeRestorePackageImports Condition="'$(CrtSysAllowExternalPackageImports)' == 'true'">false</ExcludeRestorePackageImports>
    <RestoreProjectStyle Condition="'$(RestoreProjectStyle)' == ''">PackageReference</RestoreProjectStyle>
  </PropertyGroup>

  <Import Project="$(CrtSysPackageRoot)build\native\crtsys.props"
          Condition="'$(VCProjectUpgraderObjectName)' != 'NoUpgrade' and '$(CrtSysIsCMakeProbe)' != 'true' and Exists('$(CrtSysPackageRoot)build\native\crtsys.props')" />
</Project>
