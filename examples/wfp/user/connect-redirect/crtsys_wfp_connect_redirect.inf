[Version]
Signature="$WINDOWS NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%ProviderName%
DriverVer=07/28/2026,1.0.0.0
CatalogFile=crtsys_wfp_connect_redirect.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=crtsys_wfp_connect_redirect,0x00000002,ServiceInstall

[DefaultInstall.NTarm64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTarm64.Services]
AddService=crtsys_wfp_connect_redirect,0x00000002,ServiceInstall

[DriverCopyFiles]
crtsys_wfp_connect_redirect.sys

[ServiceInstall]
DisplayName=%ServiceName%
Description=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\crtsys_wfp_connect_redirect.sys

[SourceDisksFiles]
crtsys_wfp_connect_redirect.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
DiskName="crtsys NTL WFP connect redirect media"
ProviderName="crtsys"
ServiceName="crtsys NTL WFP connect redirect"
ServiceDescription="Redirects selected outbound IPv4 and IPv6 TCP connects through a coroutine local proxy"
