[Version]
Signature="$WINDOWS NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%ProviderName%
DriverVer=08/01/2026,1.0.0.0
CatalogFile=crtsys_wfp_http3_inspection_driver.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=crtsys_wfp_http3_inspection_driver,0x00000002,ServiceInstall

[DefaultInstall.NTarm64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTarm64.Services]
AddService=crtsys_wfp_http3_inspection_driver,0x00000002,ServiceInstall

[DriverCopyFiles]
crtsys_wfp_http3_inspection_driver.sys

[ServiceInstall]
DisplayName=%ServiceName%
Description=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\crtsys_wfp_http3_inspection_driver.sys

[SourceDisksFiles]
crtsys_wfp_http3_inspection_driver.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
ProviderName="crtsys"
ServiceName="crtsys NTL WFP user HTTP/3 gate"
ServiceDescription="Captures and gates app-scoped IPv4 and IPv6 UDP connects before user-mode MsQuic inspection"
DiskName="crtsys NTL WFP user HTTP/3 gate media"
