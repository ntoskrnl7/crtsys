[Version]
Signature="$WINDOWS NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%ProviderName%
DriverVer=07/27/2026,1.0.0.0
CatalogFile=crtsys_wfp_flow_monitor.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=12

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=crtsys_wfp_flow_monitor,0x00000002,ServiceInstall

[DriverCopyFiles]
crtsys_wfp_flow_monitor.sys

[ServiceInstall]
DisplayName=%ServiceName%
Description=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\crtsys_wfp_flow_monitor.sys

[Strings]
ProviderName="crtsys"
ServiceName="crtsys NTL WFP flow monitor"
ServiceDescription="Observes selected outbound TCP flow lifetime and stream byte counts without modifying traffic"
