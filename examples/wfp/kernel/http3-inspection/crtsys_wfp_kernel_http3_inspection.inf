[Version]
Signature="$WINDOWS NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%ProviderName%
DriverVer=08/01/2026,1.0.0.0
CatalogFile=crtsys_wfp_kernel_http3_inspection.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=crtsys_wfp_kernel_http3_inspection,,ServiceInstall

[DefaultInstall.NTarm64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTarm64.Services]
AddService=crtsys_wfp_kernel_http3_inspection,,ServiceInstall

[DriverCopyFiles]
crtsys_wfp_kernel_http3_inspection.sys

[ServiceInstall]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\crtsys_wfp_kernel_http3_inspection.sys

[SourceDisksFiles]
crtsys_wfp_kernel_http3_inspection.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
ProviderName="NTL Samples"
ServiceName="crtsys WFP kernel HTTP/3 inspection"
DiskName="crtsys WFP kernel HTTP/3 inspection media"
