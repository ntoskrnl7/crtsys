[Version]
Signature="$WINDOWS NT$"
Class=ActivityMonitor
ClassGuid={b86dff51-a31e-4bac-b3cf-e8cfe75c9fc2}
Provider=%ProviderName%
DriverVer=07/27/2026,1.0.0.0
CatalogFile=crtsys_wfp_ale_connect_block.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[DefaultInstall.NTamd64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=crtsys_wfp_ale_connect_block,0x00000002,ServiceInstall

[DefaultInstall.NTarm64]
CopyFiles=DriverCopyFiles

[DefaultInstall.NTarm64.Services]
AddService=crtsys_wfp_ale_connect_block,0x00000002,ServiceInstall

[DriverCopyFiles]
crtsys_wfp_ale_connect_block.sys

[ServiceInstall]
DisplayName=%ServiceName%
Description=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\crtsys_wfp_ale_connect_block.sys

[SourceDisksFiles]
crtsys_wfp_ale_connect_block.sys=1

[SourceDisksNames]
1=%DiskName%,,,

[Strings]
DiskName="crtsys NTL WFP ALE connect block media"
ProviderName="crtsys"
ServiceName="crtsys NTL WFP ALE connect block"
ServiceDescription="Blocks one selected outbound IPv4 TCP connection through a typed WFP callout"
