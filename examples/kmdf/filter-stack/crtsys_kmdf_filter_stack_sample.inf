[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
CatalogFile=crtsys_kmdf_filter_stack_sample.cat
DriverVer=06/21/2006,1.0.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
crtsys_kmdf_filter_stack_target.sys=1
crtsys_kmdf_filter_stack_filter.sys=1

[Manufacturer]
%ProviderName%=Models,NTamd64.10.0...16299,NTarm64.10.0...16299,NTx86.10.0...16299

[Models.NTamd64.10.0...16299]
%DeviceDescription%=Device_Install,Root\CrtSysKmdfNtlFilterStackSample

[Models.NTarm64.10.0...16299]
%DeviceDescription%=Device_Install,Root\CrtSysKmdfNtlFilterStackSample

[Models.NTx86.10.0...16299]
%DeviceDescription%=Device_Install,Root\CrtSysKmdfNtlFilterStackSample

[Device_Install.NT]
CopyFiles=TargetCopyFiles,FilterCopyFiles

[TargetCopyFiles]
crtsys_kmdf_filter_stack_target.sys

[FilterCopyFiles]
crtsys_kmdf_filter_stack_filter.sys

[Device_Install.NT.HW]
AddReg=Device_Install.AddReg

[Device_Install.AddReg]
HKR,,"UpperFilters",0x00010000,"crtsys_kmdf_filter_stack_filter"

[Device_Install.NT.Services]
AddService=crtsys_kmdf_filter_stack_filter,,Filter_Service_Install
AddService=crtsys_kmdf_filter_stack_target,0x00000002,Target_Service_Install

[Target_Service_Install]
DisplayName=%TargetServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\crtsys_kmdf_filter_stack_target.sys

[Filter_Service_Install]
DisplayName=%FilterServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\crtsys_kmdf_filter_stack_filter.sys

[Device_Install.NT.Wdf]
KmdfService=crtsys_kmdf_filter_stack_target,Kmdf_Install
KmdfService=crtsys_kmdf_filter_stack_filter,Kmdf_Install

[Kmdf_Install]
KmdfLibraryVersion=1.15

[Strings]
ProviderName="crtsys"
DeviceDescription="crtsys NTL KMDF filter-stack sample"
TargetServiceDescription="crtsys NTL KMDF filter-stack target"
FilterServiceDescription="crtsys NTL KMDF upper filter"
DiskName="crtsys NTL KMDF filter-stack installation media"
